// PrettyPrinterRuntimeTypes.dark - upstream runtime type-reference rendering API.

module Darklang.PrettyPrinter.RuntimeTypes

let __typeReferenceList
    (branchId: Uuid)
    (types: List<Darklang.LanguageTools.RuntimeTypes.TypeReference>)
    : List<String> =
    Stdlib.List.map<Darklang.LanguageTools.RuntimeTypes.TypeReference, String>
        (types)
        (fun typ -> Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (typ))

let typeReference
    (branchId: Uuid)
    (typ: Darklang.LanguageTools.RuntimeTypes.TypeReference)
    : String =
    match typ with
    | TVariable (name) -> "'" ++ name
    | TUnit -> "Unit"
    | TBool -> "Bool"
    | TInt8 -> "Int8"
    | TUInt8 -> "UInt8"
    | TInt16 -> "Int16"
    | TUInt16 -> "UInt16"
    | TInt32 -> "Int32"
    | TUInt32 -> "UInt32"
    | TInt64 -> "Int64"
    | TUInt64 -> "UInt64"
    | TInt128 -> "Int128"
    | TUInt128 -> "UInt128"
    | TInt -> "Int"
    | TFloat -> "Float"
    | TChar -> "Char"
    | TString -> "String"
    | TUuid -> "Uuid"
    | TDateTime -> "DateTime"
    | TBlob -> "Blob"
    | TStream (inner) ->
        "Stream<" ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (inner) ++ ">"
    | TTuple (first, second, rest) ->
        let all =
            Stdlib.List.push<Darklang.LanguageTools.RuntimeTypes.TypeReference>
                (Stdlib.List.push<Darklang.LanguageTools.RuntimeTypes.TypeReference> (rest) (second))
                (first) in
        "(" ++ Stdlib.String.join (Darklang.PrettyPrinter.RuntimeTypes.__typeReferenceList (branchId) (all)) (" * ") ++ ")"
    | TList (inner) ->
        "List<" ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (inner) ++ ">"
    | TDict (inner) ->
        "Dict<" ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (inner) ++ ">"
    | TCustomType (resolution, typeArgs) ->
        let renderedName = Stdlib.String.join (resolution.originalName) (".") in
        (match typeArgs with
        | [] -> renderedName
        | _ ->
            renderedName ++ "<" ++
            Stdlib.String.join (Darklang.PrettyPrinter.RuntimeTypes.__typeReferenceList (branchId) (typeArgs)) (", ") ++
            ">")
    | TFn (parameters, result) ->
        "(" ++
        Stdlib.String.join (Darklang.PrettyPrinter.RuntimeTypes.__typeReferenceList (branchId) (parameters)) (", ") ++
        ") -> " ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (result)
    | TDB (inner) ->
        "DB<" ++ Darklang.PrettyPrinter.RuntimeTypes.typeReference (branchId) (inner) ++ ">"
