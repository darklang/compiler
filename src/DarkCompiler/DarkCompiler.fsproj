<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base utilities -->
    <Compile Include="Crash.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="Platform.fs" />
    <Compile Include="RuntimeDataLayout.fs" />
    <Compile Include="AST.fs" />
    <Compile Include="NameSyntax.fs" />
    <Compile Include="ASTPrettyPrinter.fs" />
    <Compile Include="ListDisplay.fs" />
    <Compile Include="Stdlib.fs" />
    <Compile Include="NameResolution.fs" />
    <Compile Include="ResultList.fs" />
    <Compile Include="CallGraphReachability.fs" />
    <Compile Include="Bitset.fs" />

    <!-- Parsing and type checking -->
    <Compile Include="frontend/Parser.fs" />
    <Compile Include="frontend/TypeChecking.fs" />
    <Compile Include="frontend/ValueRendering.fs" />
    <Compile Include="frontend/JsonPlanning.fs" />

    <!-- AST -> ANF -->
    <Compile Include="memory/MemoryModel.fs" />
    <Compile Include="memory/ReleasePlanFingerprint.fs" />
    <Compile Include="memory/MemoryPlanning.fs" />
    <Compile Include="ANF.fs" />
    <Compile Include="passes/anf/ANFDeadCodeElimination.fs" />
    <Compile Include="SemanticIR.fs" />
    <Compile Include="ir/hir/ListRegion.fs" />
    <Compile Include="passes/ownership/ListAllocationBudget.fs" />
    <Compile Include="passes/hir/ExtractListRegions.fs" />
    <Compile Include="passes/storage/SelectListStorage.fs" />
    <Compile Include="passes/ownership/ListLiveness.fs" />
    <Compile Include="passes/ownership/ElaborateListOwnership.fs" />
    <Compile Include="passes/ownership/VerifyListOwnership.fs" />
    <Compile Include="passes/anf/LowerListRegions.fs" />
    <Compile Include="passes/anf/AST_to_ANF.fs" />
    <Compile Include="passes/anf/ANF_Optimize.fs" />
    <Compile Include="passes/anf/ANF_Inlining.fs" />
    <Compile Include="passes/anf/ANF_HigherOrderSpecialization.fs" />
    <Compile Include="passes/anf/ANF_DirectCallSpecialization.fs" />
    <Compile Include="passes/anf/ANF_EscapeAnalysis.fs" />
    <Compile Include="passes/anf/ownership/TypeFacts.fs" />
    <Compile Include="passes/anf/ownership/ReturnAnalysis.fs" />
    <Compile Include="passes/anf/ownership/ShapePlanning.fs" />
    <Compile Include="passes/anf/ownership/Cleanup.fs" />
    <Compile Include="passes/anf/ownership/InsertExpression.fs" />
    <Compile Include="passes/anf/RefCountInsertion.fs" />
    <Compile Include="passes/anf/PrintInsertion.fs" />
    <Compile Include="passes/anf/TailCallDetection.fs" />

    <!-- ANF -> MIR -->
    <Compile Include="MIR.fs" />
    <Compile Include="LiteralPool.fs" />
    <Compile Include="passes/anf/ANF_to_MIR.fs" />
    <Compile Include="passes/mir/SSA_Construction.fs" />
    <Compile Include="passes/mir/MIR_Optimize.fs" />

    <!-- MIR -> LIR -->
    <Compile Include="LIR.fs" />
    <Compile Include="ParallelMoves.fs" />
    <Compile Include="passes/mir/MIR_to_LIR.fs" />
    <Compile Include="passes/lir/LIR_Peephole.fs" />
    <Compile Include="passes/lir/DeadCodeElimination.fs" />
    <Compile Include="passes/lir/FunctionTreeShaking.fs" />

    <!-- Register allocation -->
    <Compile Include="passes/lir/RegisterAllocation.fs" />

    <!-- Architecture support: ISA types, calling conventions, runtime -->
    <Compile Include="ARM64.fs" />
    <Compile Include="X86_64.fs" />
    <Compile Include="ARM64Symbolic.fs" />
    <Compile Include="Runtime.fs" />

    <!-- ARM64 backend -->
    <Compile Include="backend/arm64/CodeGen.fs" />
    <Compile Include="backend/arm64/Resolve.fs" />
    <Compile Include="backend/arm64/Encoding.fs" />

    <!-- x64 backend -->
    <Compile Include="backend/x64/CodeGen.fs" />
    <Compile Include="backend/x64/Encoding.fs" />
    <Compile Include="backend/x64/Resolve.fs" />

    <!-- Shared binary output helpers -->
    <Compile Include="Binary.fs" />
    <Compile Include="Binary_ELF.fs" />

    <!-- ARM64 binary generation -->
    <Compile Include="backend/arm64/Binary_Generation_MachO.fs" />
    <Compile Include="backend/arm64/Binary_Generation_ELF.fs" />
    <Compile Include="backend/arm64/Emit.fs" />

    <!-- x64 binary generation -->
    <Compile Include="backend/x64/Binary_Generation_ELF.fs" />

    <!-- Top-level driver -->
    <Compile Include="IRPrinter.fs" />
    <Compile Include="CompilerLibrary.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup />

</Project>
