// PackageManager.dark - canonical immutable location-selection rules.

module Darklang.LanguageTools.PackageManager

// preferredLocation (darklang/dark main): the asked-for name wins outright
// when it is one of the candidates.
type PickContext =
    { currentModule: List<String>,
      preferredLocation: Stdlib.Option.Option<Darklang.LanguageTools.ProgramTypes.PackageLocation> }

let __countMatchingPrefixInt (a: List<String>) (b: List<String>) : Int =
    match (a, b) with
    | (aHead :: aTail, bHead :: bTail) ->
        if aHead == bHead then 1 + Darklang.LanguageTools.PackageManager.__countMatchingPrefixInt aTail bTail
        else 0
    | _ -> 0

let __asked (preferred: Stdlib.Option.Option<Darklang.LanguageTools.ProgramTypes.PackageLocation>) (locations: List<Darklang.LanguageTools.ProgramTypes.PackageLocation>) : Stdlib.Option.Option<Darklang.LanguageTools.ProgramTypes.PackageLocation> =
    match preferred with
    | Some p ->
        Stdlib.List.findFirst locations (fun l ->
            l.owner == p.owner && l.modules == p.modules && l.name == p.name)
    | None -> Stdlib.Option.Option.None

let pickLocation (ctx: Darklang.LanguageTools.PackageManager.PickContext) (locations: List<Darklang.LanguageTools.ProgramTypes.PackageLocation>) : Stdlib.Option.Option<Darklang.LanguageTools.ProgramTypes.PackageLocation> =
    match Darklang.LanguageTools.PackageManager.__asked ctx.preferredLocation locations with
    | Some asked -> Stdlib.Option.Option.Some asked
    | None ->
    match locations with
    | [] -> Stdlib.Option.Option.None
    | [single] -> Stdlib.Option.Option.Some single
    | first :: rest ->
        let firstPath = Stdlib.List.push first.modules first.owner in
        let firstScore = Darklang.LanguageTools.PackageManager.__countMatchingPrefixInt ctx.currentModule firstPath in
        let firstLength = Stdlib.List.__lengthInt firstPath in
        let (_bestScore, _bestLength, bestLocation) =
            Stdlib.List.fold rest ((firstScore, firstLength, first)) (fun acc location ->
                    let (bestScore, bestLength, best) = acc in
                    let locationPath = Stdlib.List.push location.modules location.owner in
                    let score = Darklang.LanguageTools.PackageManager.__countMatchingPrefixInt ctx.currentModule locationPath in
                    let length = Stdlib.List.__lengthInt locationPath in
                    if score > bestScore then (score, length, location)
                    else if score == bestScore && length < bestLength then (score, length, location)
                    else (bestScore, bestLength, best)) in
        Stdlib.Option.Option.Some bestLocation

let countMatchingPrefix (a: List<String>) (b: List<String>) : Int64 =
  Builtin.unwrap (Stdlib.Int.toInt64 (Darklang.LanguageTools.PackageManager.__countMatchingPrefixInt a b))
