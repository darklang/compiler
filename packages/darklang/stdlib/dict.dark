// Stdlib/Dict.dark - Generic persistent dictionary operations.

module Darklang.Stdlib.Dict

val empty = Dict { }

let isEmpty (dict: Dict<'k, 'v>) : Bool = dict == Dict.empty

// Compare entries by lookup so dictionary equality does not require ordering
// its keys. In particular, runtime values can be structurally equal without
// having an ordering defined for every value variant.
let __equals<'k, 'v> (left: Dict<k, v>) (right: Dict<k, v>) : Bool =
    if Stdlib.Dict.__size<k, v> left != Stdlib.Dict.__size<k, v> right then false
    else
        Stdlib.Dict.__foldHelper<k, v, Bool>
            left
            true
            (fun equal key value ->
                if equal then
                    match Stdlib.Dict.__get<k, v> right key with
                    | None -> false
                    | Some rightValue -> value == rightValue
                else false)

let singleton (key: 'k) (value: 'v) : Dict<'k, 'v> =
  Stdlib.Dict.set (Dict { }) key value

// A dictionary used as a key compares both its keys and values with key equality.
let __keyEquals<'k, 'v> (left: Dict<k, v>) (right: Dict<k, v>) : Bool =
    if Stdlib.Dict.__size<k, v> left != Stdlib.Dict.__size<k, v> right then false
    else
        Stdlib.Dict.__foldHelper<k, v, Bool>
            left
            true
            (fun equal key value ->
                if equal then
                    match Stdlib.Dict.__get<k, v> right key with
                    | None -> false
                    | Some rightValue -> __key_eq<v> value rightValue
                else false)

let size<'k, 'v> (dict: Dict<k, v>) : Int64 =
    Stdlib.Dict.__size<k, v> dict

let get<'k, 'v> (dict: Dict<k, v>) (key: k) : Stdlib.Option.Option<v> =
    Stdlib.Dict.__get<k, v> dict (__dict_check_key key)

let set<'k, 'v> (dict: Dict<k, v>) (key: k) (value: v) : Dict<k, v> =
    Stdlib.Dict.__setOverwriting<k, v> dict (__dict_check_key key) value

// Concrete specializations receive the shared value renderer before ANF.
let __renderGenericKey<'k> (key: k) : String =
    Builtin.crash "Dictionary key renderer was not specialized"

// NaN is the only key value unequal to itself, and a key holding one could never be found.
let __refuseNaNKey<'k> (key: k) : k =
    if key == key then key
    else
        Builtin.crash
            ("Cannot use " + Stdlib.Dict.__renderGenericKey key + " as a dict key. NaN is not equal to itself, so a key holding it could never be found.")

// Dict literals are built entry by entry with this, so a key that two
// entries compute equal is refused at run time.
let __setRejectingDuplicate<'k, 'v> (dict: Dict<k, v>) (key: k) (value: v) : Dict<k, v> =
    let key = __dict_check_key key in
    if Stdlib.Dict.__contains<k, v> dict key then
        Builtin.crash
            ("Cannot add two dictionary entries with the same key " + Stdlib.Dict.__renderGenericKey key)
    else
        Stdlib.Dict.__setOverwriting<k, v> dict key value

let setOverridingDuplicates<'k, 'v> (dict: Dict<k, v>) (key: k) (value: v) : Dict<k, v> =
    Stdlib.Dict.__setOverwriting<k, v> dict (__dict_check_key key) value

let remove<'k, 'v> (dict: Dict<k, v>) (key: k) : Dict<k, v> =
    Stdlib.Dict.__remove<k, v> dict (__dict_check_key key)

// Code point order, which is UTF-8 byte order: how the interpreter orders
// Strings, both for `<` and sorting and for a Dict's keys.
let __compareString (left: String) (right: String) : Int32 =
    Stdlib.Dict.__compareStringFrom left right 0L

let __compareStringFrom (left: String) (right: String) (index: Int64) : Int32 =
    if index >= Stdlib.String.__byteLength left then
        if index >= Stdlib.String.__byteLength right then 0l else -1l
    else if index >= Stdlib.String.__byteLength right then 1l
    else
        let leftByte = Stdlib.String.__byteAtUnchecked left index in
        let rightByte = Stdlib.String.__byteAtUnchecked right index in
        if leftByte < rightByte then -1l
        else if leftByte > rightByte then 1l
        else Stdlib.Dict.__compareStringFrom left right (index + 1L)

let __isIdentifierStart (byte: Int64) : Bool =
    (byte >= 65L && byte <= 90L) || (byte >= 97L && byte <= 122L) || byte == 95L

let __isIdentifierRest (byte: Int64) : Bool =
    Stdlib.Dict.__isIdentifierStart byte || (byte >= 48L && byte <= 57L) || byte == 39L

let __isIdentifierAt (key: String) (index: Int64) : Bool =
    if index >= Stdlib.String.__byteLength key then true
    else if Stdlib.Dict.__isIdentifierRest (Stdlib.String.__byteAtUnchecked key index) then
        Stdlib.Dict.__isIdentifierAt key (index + 1L)
    else false

let __renderKey (key: String) : String =
    if key == "" then "___"
    else if key != "___" && Stdlib.Dict.__isIdentifierStart (Stdlib.String.__byteAtUnchecked key 0L) && Stdlib.Dict.__isIdentifierAt key 1L then "" + key
    else "``" + key + "``"

let __copyKey (key: String) : String =
    Stdlib.String.__byteSlice key 0L (Stdlib.String.__byteLength key)

let __insertEntry<'k, 'v> (entry: (k * v)) (sorted: List<(k * v)>) : List<(k * v)> =
    match sorted with
    | [] -> [entry]
    | head :: tail ->
        let (entryKey, _) = entry in
        let (headKey, _) = head in
        if __compare<k> entryKey headKey < 0L then Stdlib.List.push sorted entry
        else Stdlib.List.push (Stdlib.Dict.__insertEntry<k, v> entry tail) head

let __sortEntries<'k, 'v> (entries: List<(k * v)>) (sorted: List<(k * v)>) : List<(k * v)> =
    match entries with
    | [] -> sorted
    | head :: tail -> Stdlib.Dict.__sortEntries<k, v> tail (Stdlib.Dict.__insertEntry<k, v> head sorted)

let toList<'k, 'v> (dict: Dict<k, v>) : List<(k * v)> =
    Stdlib.Dict.__sortEntries (Stdlib.Dict.__entries<k, v> dict) []

let __keysFromEntries<'k, 'v> (entries: List<(k * v)>) : List<k> =
    match entries with
    | [] -> []
    | (key, _) :: tail -> Stdlib.List.push (Stdlib.Dict.__keysFromEntries<k, v> tail) key

let keys<'k, 'v> (dict: Dict<k, v>) : List<k> =
    Stdlib.Dict.__keysFromEntries<k, v> (Stdlib.Dict.toList<k, v> dict)

let __valuesFromEntries<'k, 'v> (entries: List<(k * v)>) : List<v> =
    match entries with
    | [] -> []
    | (_, value) :: tail -> Stdlib.List.push (Stdlib.Dict.__valuesFromEntries<k, v> tail) value

let values<'k, 'v> (dict: Dict<k, v>) : List<v> =
    Stdlib.Dict.__valuesFromEntries<k, v> (Stdlib.Dict.toList<k, v> dict)

let __fromListOverwritingPublic<'k, 'v> (entries: List<(k * v)>) (dict: Dict<k, v>) : Dict<k, v> =
    match entries with
    | [] -> dict
    | (key, value) :: tail ->
        Stdlib.Dict.__fromListOverwritingPublic<k, v> tail (Stdlib.Dict.__setOverwriting dict (__dict_check_key key) value)

let fromListOverwritingDuplicates<'k, 'v> (entries: List<(k * v)>) : Dict<k, v> =
    Stdlib.Dict.__fromListOverwritingPublic<k, v> entries (Stdlib.Dict.__empty<k, v> ())

let __fromListRejecting<'k, 'v> (entries: List<(k * v)>) (dict: Dict<k, v>) : Stdlib.Option.Option<Dict<k, v>> =
    match entries with
    | [] -> Some dict
    | (key, value) :: tail ->
        let key = __dict_check_key key in
        if Stdlib.Dict.__contains dict key then None
        else
            Stdlib.Dict.__fromListRejecting<k, v> tail (Stdlib.Dict.__setOverwriting dict key value)

// The last entry of a repeated key wins, as in the interpreter.
let fromList<'k, 'v> (entries: List<(k * v)>) : Dict<k, v> =
    Stdlib.Dict.__fromListOverwritingPublic<k, v> entries (Stdlib.Dict.__empty<k, v> ())

let member<'k, 'v> (dict: Dict<k, v>) (key: k) : Bool =
    Stdlib.Dict.__contains<k, v> dict (__dict_check_key key)

let __mergeEntries<'k, 'v> (entries: List<(k * v)>) (result: Dict<k, v>) : Dict<k, v> =
    match entries with
    | [] -> result
    | (key, value) :: tail ->
        Stdlib.Dict.__mergeEntries<k, v> tail (Stdlib.Dict.__setOverwriting result key value)

let merge<'k, 'v> (left: Dict<k, v>) (right: Dict<k, v>) : Dict<k, v> =
    Stdlib.Dict.__mergeEntries<k, v> (Stdlib.Dict.toList<k, v> right) left

let __mapEntries<'k, 'a, 'b> (entries: List<(k * a)>) (fn: k -> a -> b) (result: Dict<k, b>) : Dict<k, b> =
    match entries with
    | [] -> result
    | (key, value) :: tail ->
        Stdlib.Dict.__mapEntries<k, a, b> tail fn (Stdlib.Dict.__setOverwriting result key (fn key value))

let map (dict: Dict<'k, 'v>) (fn: 'k -> 'v -> 'b) : Dict<'k, 'b> =
  dict
  |> Stdlib.Dict.toList
  |> List.map (fun (k, v) -> (k, fn k v))
  |> Dict.fromListOverwritingDuplicates

let __iterEntries<'k, 'a> (entries: List<(k * a)>) (fn: k -> a -> Unit) : Unit =
    match entries with
    | [] -> ()
    | (key, value) :: tail ->
        let _ = fn key value in
        Stdlib.Dict.__iterEntries<k, a> tail fn

let iter (dict: Dict<'k, 'v>) (fn: 'k -> 'v -> Unit) : Unit =
  dict |> Stdlib.Dict.toList |> List.iter (fun (k, v) -> fn k v)

let __filterEntries<'k, 'a> (entries: List<(k * a)>) (fn: k -> a -> Bool) (result: Dict<k, a>) : Dict<k, a> =
    match entries with
    | [] -> result
    | (key, value) :: tail ->
        let next =
            if fn key value then Stdlib.Dict.__setOverwriting result key value
            else result in
        Stdlib.Dict.__filterEntries<k, a> tail fn next

let filter (dict: Dict<'k, 'v>) (fn: 'k -> 'v -> Bool) : Dict<'k, 'v> =
  dict
  |> Stdlib.Dict.toList
  |> List.filter (fun (k, v) -> fn k v)
  |> Dict.fromListOverwritingDuplicates

let __filterMapEntries<'k, 'a, 'b> (entries: List<(k * a)>) (fn: k -> a -> Stdlib.Option.Option<b>) (result: Dict<k, b>) : Dict<k, b> =
    match entries with
    | [] -> result
    | (key, originalValue) :: tail ->
        let next =
            match fn key originalValue with
            | None -> result
            | Some value -> Stdlib.Dict.__setOverwriting result key value in
        Stdlib.Dict.__filterMapEntries<k, a, b> tail fn next

let filterMap
  (dict: Dict<'k, 'v>)
  (fn: 'k -> 'v -> Option.Option<'b>)
  : Dict<'k, 'b> =
  dict
  |> Stdlib.Dict.toList
  |> List.filterMap (fun (k, v) ->
    match fn k v with
    | None -> Option.Option.None
    | Some newValue -> Option.Option.Some ((k, newValue)))
  |> Dict.fromListOverwritingDuplicates
