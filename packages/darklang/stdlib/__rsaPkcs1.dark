// RsaPkcs1.dark - RSA PKCS#1 v1.5 SHA-256/384 certificate signature checks.

module Darklang.Stdlib.__RsaPkcs1

let __same (a: Blob) (b: Blob) (index: Int64) (difference: Int64) : Bool =
  if index == Stdlib.Blob.__byteLength a then difference == 0
  else Stdlib.__RsaPkcs1.__same a b (index + 1)
         (Stdlib.Int64.bitwiseOr difference
           (Stdlib.Int64.bitwiseXor (Stdlib.Blob.__getByte a index)
             (Stdlib.Blob.__getByte b index)))

let __padding (em: Blob) (index: Int64) (end_: Int64) : Bool =
  if index == end_ then true
  else if Stdlib.Blob.__getByte em index != 255 then false
  else Stdlib.__RsaPkcs1.__padding em (index + 1) end_

let __digestInfo (algorithm: Int64) (message: Blob) : Stdlib.Result.Result<Blob, String> =
  if algorithm == 256 then
    Ok (Stdlib.Blob.concat [
      Stdlib.Blob.__fromInt64List
        [48, 49, 48, 13, 6, 9, 96, 134, 72, 1,
         101, 3, 4, 2, 1, 5, 0, 4, 32],
      Stdlib.Crypto.sha256 message])
  else if algorithm == 384 then
    Ok (Stdlib.Blob.concat [
      Stdlib.Blob.__fromInt64List
        [48, 65, 48, 13, 6, 9, 96, 134, 72, 1,
         101, 3, 4, 2, 2, 5, 0, 4, 48],
      Stdlib.Crypto.sha384 message])
  else Error "Unsupported RSA certificate signature algorithm"

let verify (algorithm: Int64) (modulus: Blob) (exponent: Blob)
           (message: Blob) (signature: Blob) : Stdlib.Result.Result<Bool, String> =
  let length = Stdlib.Blob.__byteLength modulus in
  if length < 256 || length > 1024 ||
     Stdlib.Blob.__byteLength signature != length then Ok false
  else
    match Stdlib.__RsaPkcs1.__digestInfo algorithm message with
    | Error error -> Error error
    | Ok digestInfo ->
      let n = Stdlib.__RsaPss.__fromBytes modulus 0 (Stdlib.Int.fromInt64 0) in
      let s = Stdlib.__RsaPss.__fromBytes signature 0 (Stdlib.Int.fromInt64 0) in
      if Stdlib.Int.greaterThanOrEqualTo s n then Ok false
      else
        Stdlib.__RsaMontgomery.publicPow signature exponent modulus |> Stdlib.Result.map (fun em ->
        let digestLength = Stdlib.Blob.__byteLength digestInfo in
        let delimiter = length - digestLength - 1 in
        let actual = Stdlib.Blob.slice em (Stdlib.Int.fromInt64 (delimiter + 1))
                       (Stdlib.Int.fromInt64 digestLength) in
        (delimiter >= 10 &&
            Stdlib.Blob.__getByte em 0 == 0 &&
            Stdlib.Blob.__getByte em 1 == 1 &&
            Stdlib.__RsaPkcs1.__padding em 2 delimiter &&
            Stdlib.Blob.__getByte em delimiter == 0 &&
            Stdlib.__RsaPkcs1.__same actual digestInfo 0 0))
