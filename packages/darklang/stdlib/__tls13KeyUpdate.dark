// __Tls13KeyUpdate.dark - Pure bounded post-handshake TLS messages and directional traffic-secret updates.
module Darklang.Stdlib.__Tls13KeyUpdate

type State = { receiveSecret: Blob, sendSecret: Blob, send: Stdlib.__Tls13.TrafficKeys, pending: Blob, fromServer: Bool, tickets: Int64, ticketBytes: Int64, updates: Int64 }
type Processed = { state: Stdlib.__Tls13KeyUpdate.State, receive: Stdlib.__Tls13.TrafficKeys, data: Stdlib.Option.Option<Blob>, closed: Bool, reply: Stdlib.Option.Option<Blob> }

let create(receive: Blob, send: Blob, keys: Stdlib.__Tls13.TrafficKeys, fromServer: Bool): Stdlib.__Tls13KeyUpdate.State =
  Stdlib.__Tls13KeyUpdate.State { receiveSecret = receive, sendSecret = send, send = keys, pending = Stdlib.Blob.empty, fromServer = fromServer, tickets = 0, ticketBytes = 0, updates = 0 }

let __next(secret: Blob, suite: Int64): Stdlib.Result.Result<(Blob * Stdlib.__Tls13.TrafficKeys), String> =
  let expand = if suite == 4866 then Stdlib.__Tls13.hkdfExpandLabel384 else Stdlib.__Tls13.hkdfExpandLabel in
  let traffic = if suite == 4866 then Stdlib.__Tls13.trafficKeys384 else if suite == 4867 then Stdlib.__Tls13.trafficKeysChaCha else Stdlib.__Tls13.trafficKeys in
  if (suite != 4865 && suite != 4866 && suite != 4867) || Stdlib.Blob.__byteLength(secret) != (if suite == 4866 then 48 else 32) then Error("Invalid TLS update secret or cipher suite")
  else expand(secret, "traffic upd", Stdlib.Blob.empty, if suite == 4866 then 48 else 32) |> Stdlib.Result.andThen(fun secret -> traffic(secret) |> Stdlib.Result.map(fun keys -> ((secret, keys))))

let __updated(state: Stdlib.__Tls13KeyUpdate.State, keys: Stdlib.__Tls13.TrafficKeys, request: Int64): Stdlib.Result.Result<Stdlib.__Tls13KeyUpdate.Processed, String> =
  if state.updates >= 64 || request > 1 || request < 0 || state.send.cipherSuite != keys.cipherSuite then Error("Invalid or excessive TLS KeyUpdate")
  else Stdlib.__Tls13KeyUpdate.__next(state.receiveSecret, keys.cipherSuite) |> Stdlib.Result.andThen(fun received ->
    let (secret, receive) = received in
    let next = { state with receiveSecret = secret, pending = Stdlib.Blob.empty, updates = state.updates + 1 } in
    if request == 0 then Ok(Stdlib.__Tls13KeyUpdate.Processed { state = next, receive = receive, data = None, closed = false, reply = None })
    else Stdlib.__Tls13.sealRecord(state.send, 22, Stdlib.Blob.__fromInt64List([24,0,0,1,0])) |> Stdlib.Result.andThen(fun sealed ->
      Stdlib.__Tls13KeyUpdate.__next(state.sendSecret, state.send.cipherSuite) |> Stdlib.Result.map(fun sending ->
        let (secret, send) = sending in
        Stdlib.__Tls13KeyUpdate.Processed { state = { next with sendSecret = secret, send = send }, receive = receive, data = None, closed = false, reply = Some(sealed.bytes) })))

let __extensions(data: Blob, position: Int64, seen: List<Int64>): Bool =
  let length = Stdlib.Blob.__byteLength(data) in
  if position == length then true
  else if position + 4 > length || Stdlib.List.__lengthInt(seen) >= 64z then false
  else
    let kind = Stdlib.__Tls13.__read16(data, position) in
    let size = Stdlib.__Tls13.__read16(data, position + 2) in
    if position + 4 + size > length || Stdlib.List.contains(seen, kind) || (kind == 42 && size != 4) then false
    else Stdlib.__Tls13KeyUpdate.__extensions(data, position + 4 + size, Stdlib.List.push(seen, kind))

let __ticket(body: Blob): Bool =
  let length = Stdlib.Blob.__byteLength(body) in
  if length < 13 then false
  else
    let ticketOffset = 9 + Stdlib.Blob.__getByte(body, 8) in
    if ticketOffset + 2 > length then false
    else
      let size = Stdlib.__Tls13.__read16(body, ticketOffset) in
      let extensionOffset = ticketOffset + 2 + size in
      if size == 0 || extensionOffset + 2 > length || Stdlib.__Tls13.__read16(body, extensionOffset) != length - extensionOffset - 2 then false
      else Stdlib.__Tls13KeyUpdate.__extensions(Stdlib.__Http2Wire.__slice(body, extensionOffset + 2, length - extensionOffset - 2), 0, [])

let __messages(state: Stdlib.__Tls13KeyUpdate.State, keys: Stdlib.__Tls13.TrafficKeys, bytes: Blob): Stdlib.Result.Result<Stdlib.__Tls13KeyUpdate.Processed, String> =
  if Stdlib.Blob.__byteLength(bytes) == 0 then Ok(Stdlib.__Tls13KeyUpdate.Processed { state = { state with pending = bytes }, receive = keys, data = None, closed = false, reply = None })
  else if Stdlib.Blob.__byteLength(bytes) > 1048576 then Error("TLS post-handshake buffer exhausted")
  else match Stdlib.__Tls13Handshake.parseHandshakeFrame(bytes) with
  | Error(Incomplete) -> Ok(Stdlib.__Tls13KeyUpdate.Processed { state = { state with pending = bytes }, receive = keys, data = None, closed = false, reply = None })
  | Error(_) -> Error("Invalid TLS post-handshake framing")
  | Ok(frame) ->
    if frame.kind == 24 then
      if Stdlib.Blob.__byteLength(frame.body) != 1 || Stdlib.Blob.__byteLength(frame.remaining) != 0 then Error("Invalid TLS KeyUpdate boundary")
      else Stdlib.__Tls13KeyUpdate.__updated(state, keys, Stdlib.Blob.__getByte(frame.body, 0))
    else if frame.kind == 4 && state.fromServer then
      if state.tickets >= 64 || state.ticketBytes + Stdlib.Blob.__byteLength(frame.raw) > 1048576 || Stdlib.Bool.not(Stdlib.__Tls13KeyUpdate.__ticket(frame.body)) then Error("Invalid or excessive TLS session ticket")
      else Stdlib.__Tls13KeyUpdate.__messages({ state with tickets = state.tickets + 1, ticketBytes = state.ticketBytes + Stdlib.Blob.__byteLength(frame.raw) }, keys, frame.remaining)
    else Error("Forbidden TLS post-handshake message")

let process(state: Stdlib.__Tls13KeyUpdate.State, keys: Stdlib.__Tls13.TrafficKeys, record: Stdlib.__Tls13.Record): Stdlib.Result.Result<Stdlib.__Tls13KeyUpdate.Processed, String> =
  if record.contentType != 23 then Error("Expected encrypted TLS application record")
  else Stdlib.__Tls13.openRecord(keys, record) |> Stdlib.Result.andThen(fun opened ->
    if opened.contentType == 22 then
      if Stdlib.Blob.__byteLength(opened.content) == 0 then Error("Empty TLS handshake record")
      else Stdlib.__Tls13KeyUpdate.__messages(state, opened.nextKeys, Stdlib.Blob.concat([state.pending, opened.content]))
    else if Stdlib.Blob.__byteLength(state.pending) != 0 then Error("TLS application data interleaved with a handshake message")
    else if opened.contentType == 23 then Ok(Stdlib.__Tls13KeyUpdate.Processed { state = state, receive = opened.nextKeys, data = Some(opened.content), closed = false, reply = None })
    else if opened.contentType == 21 && Stdlib.Blob.__byteLength(opened.content) == 2 && Stdlib.Blob.__getByte(opened.content, 1) == 0 then Ok(Stdlib.__Tls13KeyUpdate.Processed { state = state, receive = opened.nextKeys, data = None, closed = true, reply = None })
    else Error("Unexpected TLS post-handshake record"))
