// Stdlib.Crypto.dark - Stdlib.Crypto definitions
//
// Cryptographic hash functions: MD5, SHA-1, SHA-256, SHA-384, and HMAC variants
// All implemented in pure Darklang without external dependencies.

module Darklang.Stdlib.Crypto

// =============================================================================
// 32-bit Arithmetic Helpers
// =============================================================================
// Hash algorithms use 32-bit arithmetic with wraparound. Since we have Int64,
// we mask to 32 bits after operations.

let __mask32(): Int64 = 4294967295

let __add32(a: Int64, b: Int64): Int64 =
    Stdlib.Int64.bitwiseAnd(a + b, Stdlib.Crypto.__mask32())

let __rotr32(x: Int64, n: Int64): Int64 =
    let masked = Stdlib.Int64.bitwiseAnd(x, Stdlib.Crypto.__mask32()) in
    Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseOr(Stdlib.Int64.shiftRight(masked, n), Stdlib.Int64.shiftLeft(masked, 32 - n)), Stdlib.Crypto.__mask32())

let __rotl32(x: Int64, n: Int64): Int64 =
    let masked = Stdlib.Int64.bitwiseAnd(x, Stdlib.Crypto.__mask32()) in
    Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseOr(Stdlib.Int64.shiftLeft(masked, n), Stdlib.Int64.shiftRight(masked, 32 - n)), Stdlib.Crypto.__mask32())

let __not32(x: Int64): Int64 =
    Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseNot(x), Stdlib.Crypto.__mask32())

// =============================================================================
// Byte Packing/Unpacking
// =============================================================================

// Read 32-bit big-endian word from bytes at offset
let __getBE32(b: Blob, offset: Int64): Int64 =
    let b0 = Stdlib.Blob.__getByte(b, offset) in
    let b1 = Stdlib.Blob.__getByte(b, offset + 1) in
    let b2 = Stdlib.Blob.__getByte(b, offset + 2) in
    let b3 = Stdlib.Blob.__getByte(b, offset + 3) in
    Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseOr(Stdlib.Int64.shiftLeft(b0, 24), Stdlib.Int64.shiftLeft(b1, 16)), Stdlib.Int64.shiftLeft(b2, 8)), b3)

// Read 32-bit little-endian word from bytes at offset
let __getLE32(b: Blob, offset: Int64): Int64 =
    let b0 = Stdlib.Blob.__getByte(b, offset) in
    let b1 = Stdlib.Blob.__getByte(b, offset + 1) in
    let b2 = Stdlib.Blob.__getByte(b, offset + 2) in
    let b3 = Stdlib.Blob.__getByte(b, offset + 3) in
    Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseOr(b0, Stdlib.Int64.shiftLeft(b1, 8)), Stdlib.Int64.shiftLeft(b2, 16)), Stdlib.Int64.shiftLeft(b3, 24))

// Read 64-bit big-endian word from bytes at offset
let __getBE64(b: Blob, offset: Int64): Int64 =
    let hi = Stdlib.Crypto.__getBE32(b, offset) in
    let lo = Stdlib.Crypto.__getBE32(b, offset + 4) in
    Stdlib.Int64.bitwiseOr(Stdlib.Int64.shiftLeft(hi, 32), lo)

// Convert 32-bit value to 4-byte list (big-endian)
let __int32ToBE(v: Int64): List<Int64> =
    [Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 24), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 16), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 8), 255), Stdlib.Int64.bitwiseAnd(v, 255)]

// Convert 32-bit value to 4-byte list (little-endian)
let __int32ToLE(v: Int64): List<Int64> =
    [Stdlib.Int64.bitwiseAnd(v, 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 8), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 16), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 24), 255)]

// Convert 64-bit value to 8-byte list (big-endian)
let __int64ToBE(v: Int64): List<Int64> =
    [Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 56), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 48), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 40), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 32), 255),
     Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 24), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 16), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 8), 255), Stdlib.Int64.bitwiseAnd(v, 255)]

// Convert 64-bit value to 8-byte list (little-endian)
let __int64ToLE(v: Int64): List<Int64> =
    [Stdlib.Int64.bitwiseAnd(v, 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 8), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 16), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 24), 255),
     Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 32), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 40), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 48), 255), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(v, 56), 255)]

let __listGet(list: List<Int64>, index: Int64): Int64 =
    match Stdlib.List.__getAtInt(list, Stdlib.Int.fromInt64(index)) with
    | Some(v) -> v
    | None -> 0

// =============================================================================
// Blob Utilities
// =============================================================================

// Copy bytes to list starting at index
let __bytesToListFrom(b: Blob, index: Int64, len: Int64, acc: List<Int64>): List<Int64> =
    if index >= len then
        Stdlib.List.reverse(acc)
    else
        let byte = Stdlib.Blob.__getByte(b, index) in
        Stdlib.Crypto.__bytesToListFrom(b, index + 1, len, Stdlib.List.push(acc, byte))

// XOR two byte lists of same length
// Note: Using nested matches because tuple+cons patterns in recursive functions with accumulators
// can cause issues. A simple tuple match passes, but this recursive version crashes.
let __xorByteLists(a: List<Int64>, b: List<Int64>, acc: List<Int64>): List<Int64> =
    match a with
    | [] -> Stdlib.List.reverse(acc)
    | x :: xs ->
        match b with
        | [] -> Stdlib.List.reverse(acc)
        | y :: ys -> Stdlib.Crypto.__xorByteLists(xs, ys, Stdlib.List.push(acc, Stdlib.Int64.bitwiseXor(x, y)))

// Create a list of N zeros
let __zeros(n: Int64, acc: List<Int64>): List<Int64> =
    if n <= 0 then acc
    else Stdlib.Crypto.__zeros(n - 1, Stdlib.List.push(acc, 0))

// Create a list of N copies of a byte
let __repeat(byte: Int64, n: Int64, acc: List<Int64>): List<Int64> =
    if n <= 0 then acc
    else Stdlib.Crypto.__repeat(byte, n - 1, Stdlib.List.push(acc, byte))

// =============================================================================
// MD5 Implementation
// =============================================================================

// MD5 K constants (from sine function)
let __md5K(i: Int64): Int64 =
    match i with

    | 0 -> 3614090360
    | 1 -> 3905402710
    | 2 -> 606105819
    | 3 -> 3250441966

    | 4 -> 4118548399
    | 5 -> 1200080426
    | 6 -> 2821735955
    | 7 -> 4249261313

    | 8 -> 1770035416
    | 9 -> 2336552879
    | 10 -> 4294925233
    | 11 -> 2304563134

    | 12 -> 1804603682
    | 13 -> 4254626195
    | 14 -> 2792965006
    | 15 -> 1236535329

    | 16 -> 4129170786
    | 17 -> 3225465664
    | 18 -> 643717713
    | 19 -> 3921069994

    | 20 -> 3593408605
    | 21 -> 38016083
    | 22 -> 3634488961
    | 23 -> 3889429448

    | 24 -> 568446438
    | 25 -> 3275163606
    | 26 -> 4107603335
    | 27 -> 1163531501

    | 28 -> 2850285829
    | 29 -> 4243563512
    | 30 -> 1735328473
    | 31 -> 2368359562

    | 32 -> 4294588738
    | 33 -> 2272392833
    | 34 -> 1839030562
    | 35 -> 4259657740

    | 36 -> 2763975236
    | 37 -> 1272893353
    | 38 -> 4139469664
    | 39 -> 3200236656

    | 40 -> 681279174
    | 41 -> 3936430074
    | 42 -> 3572445317
    | 43 -> 76029189

    | 44 -> 3654602809
    | 45 -> 3873151461
    | 46 -> 530742520
    | 47 -> 3299628645

    | 48 -> 4096336452
    | 49 -> 1126891415
    | 50 -> 2878612391
    | 51 -> 4237533241

    | 52 -> 1700485571
    | 53 -> 2399980690
    | 54 -> 4293915773
    | 55 -> 2240044497

    | 56 -> 1873313359
    | 57 -> 4264355552
    | 58 -> 2734768916
    | 59 -> 1309151649

    | 60 -> 4149444226
    | 61 -> 3174756917
    | 62 -> 718787259
    | 63 -> 3951481745
    | _ -> 0

// MD5 shift amounts
let __md5S(i: Int64): Int64 =
    match i % 16 with

    | 0 -> 7
    | 1 -> 12
    | 2 -> 17
    | 3 -> 22

    | 4 -> 7
    | 5 -> 12
    | 6 -> 17
    | 7 -> 22

    | 8 -> 7
    | 9 -> 12
    | 10 -> 17
    | 11 -> 22

    | 12 -> 7
    | 13 -> 12
    | 14 -> 17
    | 15 -> 22
    | _ -> 7

let __md5S2(i: Int64): Int64 =
    match i % 16 with

    | 0 -> 5
    | 1 -> 9
    | 2 -> 14
    | 3 -> 20

    | 4 -> 5
    | 5 -> 9
    | 6 -> 14
    | 7 -> 20

    | 8 -> 5
    | 9 -> 9
    | 10 -> 14
    | 11 -> 20

    | 12 -> 5
    | 13 -> 9
    | 14 -> 14
    | 15 -> 20
    | _ -> 5

let __md5S3(i: Int64): Int64 =
    match i % 16 with

    | 0 -> 4
    | 1 -> 11
    | 2 -> 16
    | 3 -> 23

    | 4 -> 4
    | 5 -> 11
    | 6 -> 16
    | 7 -> 23

    | 8 -> 4
    | 9 -> 11
    | 10 -> 16
    | 11 -> 23

    | 12 -> 4
    | 13 -> 11
    | 14 -> 16
    | 15 -> 23
    | _ -> 4

let __md5S4(i: Int64): Int64 =
    match i % 16 with

    | 0 -> 6
    | 1 -> 10
    | 2 -> 15
    | 3 -> 21

    | 4 -> 6
    | 5 -> 10
    | 6 -> 15
    | 7 -> 21

    | 8 -> 6
    | 9 -> 10
    | 10 -> 15
    | 11 -> 21

    | 12 -> 6
    | 13 -> 10
    | 14 -> 15
    | 15 -> 21
    | _ -> 6

// Get shift amount for MD5 round
let __md5Shift(i: Int64): Int64 =
    if i < 16 then Stdlib.Crypto.__md5S(i)
    else if i < 32 then Stdlib.Crypto.__md5S2(i)
    else if i < 48 then Stdlib.Crypto.__md5S3(i)
    else Stdlib.Crypto.__md5S4(i)

// Get message word index for MD5 round
let __md5G(i: Int64): Int64 =
    if i < 16 then i
    else if i < 32 then (5 * i + 1) % 16
    else if i < 48 then (3 * i + 5) % 16
    else (7 * i) % 16

// MD5 round functions
let __md5F(i: Int64, b: Int64, c: Int64, d: Int64): Int64 =
    if i < 16 then
        // F = (B and C) or ((not B) and D)
        Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseAnd(b, c), Stdlib.Int64.bitwiseAnd(Stdlib.Crypto.__not32(b), d)), Stdlib.Crypto.__mask32())
    else if i < 32 then
        // G = (D and B) or ((not D) and C)
        Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseOr(Stdlib.Int64.bitwiseAnd(d, b), Stdlib.Int64.bitwiseAnd(Stdlib.Crypto.__not32(d), c)), Stdlib.Crypto.__mask32())
    else if i < 48 then
        // H = B xor C xor D
        Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(b, c), d), Stdlib.Crypto.__mask32())
    else
        // I = C xor (B or (not D))
        Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(c, Stdlib.Int64.bitwiseOr(b, Stdlib.Crypto.__not32(d))), Stdlib.Crypto.__mask32())

// MD5 reads 16 words from a 64-byte block
let __md5GetWord(block: Blob, blockOffset: Int64, wordIndex: Int64): Int64 =
    Stdlib.Crypto.__getLE32(block, blockOffset + wordIndex * 4)

// MD5 single round step
let __md5Step(a: Int64, b: Int64, c: Int64, d: Int64, i: Int64, block: Blob, blockOffset: Int64): (Int64 * Int64 * Int64 * Int64) =
    let f = Stdlib.Crypto.__md5F(i, b, c, d) in
    let g = Stdlib.Crypto.__md5G(i) in
    let m = Stdlib.Crypto.__md5GetWord(block, blockOffset, g) in
    let k = Stdlib.Crypto.__md5K(i) in
    let s = Stdlib.Crypto.__md5Shift(i) in
    let temp = Stdlib.Crypto.__add32(Stdlib.Crypto.__add32(Stdlib.Crypto.__add32(a, f), k), m) in
    let newB = Stdlib.Crypto.__add32(b, Stdlib.Crypto.__rotl32(temp, s)) in
    (d, newB, b, c)

// Run 64 MD5 rounds
let __md5Rounds(a: Int64, b: Int64, c: Int64, d: Int64, i: Int64, block: Blob, blockOffset: Int64): (Int64 * Int64 * Int64 * Int64) =
    if i >= 64 then
        (a, b, c, d)
    else
        let result = Stdlib.Crypto.__md5Step(a, b, c, d, i, block, blockOffset) in
        match result with
        | (na, nb, nc, nd) -> Stdlib.Crypto.__md5Rounds(na, nb, nc, nd, i + 1, block, blockOffset)

// Process one 64-byte block of MD5
let __md5ProcessBlock(h0: Int64, h1: Int64, h2: Int64, h3: Int64, block: Blob, blockOffset: Int64): (Int64 * Int64 * Int64 * Int64) =
    let result = Stdlib.Crypto.__md5Rounds(h0, h1, h2, h3, 0, block, blockOffset) in
    match result with
    | (a, b, c, d) ->
        (Stdlib.Crypto.__add32(h0, a),
         Stdlib.Crypto.__add32(h1, b),
         Stdlib.Crypto.__add32(h2, c),
         Stdlib.Crypto.__add32(h3, d))

// Build MD5 padded message as byte list
let __md5BuildPadding(dataLen: Int64): List<Int64> =
    // Padding: 0x80 followed by zeros, then 64-bit LE length in bits
    // Total padded length must be multiple of 64 bytes
    // We need: dataLen + 1 + zeros + 8 = multiple of 64
    let bitLen = dataLen * 8 in
    let padded = dataLen + 1 in
    let remainder = padded % 64 in
    let zerosNeeded = if remainder <= 56 then 56 - remainder else 120 - remainder in
    let zeros = Stdlib.Crypto.__zeros(zerosNeeded, []) in
    // 0x80 + zeros + 8-byte little-endian length
    // Use cons and append instead of flatten to avoid compiler bug with list-of-lists
    let part1 = Stdlib.List.push(zeros, 128) in
    Stdlib.List.concat(part1, Stdlib.Crypto.__int64ToLE(bitLen))

// Copy data bytes to list
let __copyDataToList(data: Blob, index: Int64, len: Int64, acc: List<Int64>): List<Int64> =
    if index >= len then
        Stdlib.List.reverse(acc)
    else
        let byte = Stdlib.Blob.__getByte(data, index) in
        Stdlib.Crypto.__copyDataToList(data, index + 1, len, Stdlib.List.push(acc, byte))

// Process all 64-byte blocks
let __md5ProcessBlocks(h0: Int64, h1: Int64, h2: Int64, h3: Int64, padded: Blob, offset: Int64, totalLen: Int64): (Int64 * Int64 * Int64 * Int64) =
    if offset >= totalLen then
        (h0, h1, h2, h3)
    else
        let result = Stdlib.Crypto.__md5ProcessBlock(h0, h1, h2, h3, padded, offset) in
        match result with
        | (nh0, nh1, nh2, nh3) ->
            Stdlib.Crypto.__md5ProcessBlocks(nh0, nh1, nh2, nh3, padded, offset + 64, totalLen)

// MD5 hash function
let md5(data: Blob): Blob =
    // Initial hash values
    let h0 = 1732584193 in   // 0x67452301
    let h1 = 4023233417 in   // 0xEFCDAB89
    let h2 = 2562383102 in   // 0x98BADCFE
    let h3 = 271733878 in    // 0x10325476
    let dataLen = Stdlib.Blob.__byteLength(data) in
    // Build padded message
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0, dataLen, []) in
    let padding = Stdlib.Crypto.__md5BuildPadding(dataLen) in
    // Use Stdlib.List.concat instead of Stdlib.List.flatten to avoid compiler bug with list-of-lists
    let paddedList = Stdlib.List.concat(dataList, padding) in
    let padded = Stdlib.Blob.__fromInt64List(paddedList) in
    let paddedLen = Stdlib.Blob.__byteLength(padded) in
    // Process all blocks
    let result = Stdlib.Crypto.__md5ProcessBlocks(h0, h1, h2, h3, padded, 0, paddedLen) in
    match result with
    | (rh0, rh1, rh2, rh3) ->
        // Output as little-endian bytes
        // Use multiple appends instead of flatten for output
        let out1 = Stdlib.List.concat(Stdlib.Crypto.__int32ToLE(rh0), Stdlib.Crypto.__int32ToLE(rh1)) in
        let out2 = Stdlib.List.concat(out1, Stdlib.Crypto.__int32ToLE(rh2)) in
        let out3 = Stdlib.List.concat(out2, Stdlib.Crypto.__int32ToLE(rh3)) in
        Stdlib.Blob.__fromInt64List(out3)

// =============================================================================
// SHA-1 Implementation
// =============================================================================

// SHA-1 K constants
let __sha1K(i: Int64): Int64 =
    if i < 20 then 1518500249       // 0x5A827999
    else if i < 40 then 1859775393  // 0x6ED9EBA1
    else if i < 60 then 2400959708  // 0x8F1BBCDC
    else 3395469782                 // 0xCA62C1D6

// SHA-1 round function
let __sha1F(i: Int64, b: Int64, c: Int64, d: Int64): Int64 =
    if i < 20 then
        Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseAnd(b, c), Stdlib.Int64.bitwiseAnd(Stdlib.Crypto.__not32(b), d)), Stdlib.Crypto.__mask32())
    else if i < 40 then
        Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(b, c), d), Stdlib.Crypto.__mask32())
    else if i < 60 then
        Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseAnd(b, c), Stdlib.Int64.bitwiseAnd(b, d)), Stdlib.Int64.bitwiseAnd(c, d)), Stdlib.Crypto.__mask32())
    else
        Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(b, c), d), Stdlib.Crypto.__mask32())

// SHA-1 message schedule - expand 16 words to 80
let __sha1ExpandWord(w: List<Int64>, i: Int64): Int64 =
    // w[i] = ROTL32((w[i-3] XOR w[i-8] XOR w[i-14] XOR w[i-16]), 1)
    let w3 = Stdlib.Crypto.__listGet(w, i - 3) in
    let w8 = Stdlib.Crypto.__listGet(w, i - 8) in
    let w14 = Stdlib.Crypto.__listGet(w, i - 14) in
    let w16 = Stdlib.Crypto.__listGet(w, i - 16) in
    Stdlib.Crypto.__rotl32(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(w3, w8), w14), w16), 1)

// Build the full 80-word message schedule from 64-byte block
let __sha1Schedule(block: Blob, blockOffset: Int64, w: List<Int64>, i: Int64): List<Int64> =
    if i >= 80 then
        w
    else if i < 16 then
        let word = Stdlib.Crypto.__getBE32(block, blockOffset + i * 4) in
        Stdlib.Crypto.__sha1Schedule(block, blockOffset, Stdlib.List.pushBack(w, word), i + 1)
    else
        let word = Stdlib.Crypto.__sha1ExpandWord(w, i) in
        Stdlib.Crypto.__sha1Schedule(block, blockOffset, Stdlib.List.pushBack(w, word), i + 1)

// SHA-1 single round - uses paired tuples to avoid 5-tuple issues
// state1 = (a, b, c), state2 = (d, e)
let __sha1Round(state1: (Int64 * Int64 * Int64), state2: (Int64 * Int64), i: Int64, w: List<Int64>): ((Int64 * Int64 * Int64) * (Int64 * Int64)) =
    match (state1, state2) with
    | ((a, b, c), (d, e)) ->
        let f = Stdlib.Crypto.__sha1F(i, b, c, d) in
        let k = Stdlib.Crypto.__sha1K(i) in
        let wi = Stdlib.Crypto.__listGet(w, i) in
        let temp = Stdlib.Crypto.__add32(Stdlib.Crypto.__add32(Stdlib.Crypto.__add32(Stdlib.Crypto.__add32(Stdlib.Crypto.__rotl32(a, 5), f), e), k), wi) in
        // new state: (temp, a, ROTL(b,30)), (c, d)
        ((temp, a, Stdlib.Crypto.__rotl32(b, 30)), (c, d))

// Run 80 SHA-1 rounds
let __sha1Rounds(state1: (Int64 * Int64 * Int64), state2: (Int64 * Int64), i: Int64, w: List<Int64>): ((Int64 * Int64 * Int64) * (Int64 * Int64)) =
    if i >= 80 then
        (state1, state2)
    else
        let result = Stdlib.Crypto.__sha1Round(state1, state2, i, w) in
        match result with
        | (ns1, ns2) -> Stdlib.Crypto.__sha1Rounds(ns1, ns2, i + 1, w)

// Process one 64-byte block of SHA-1
let __sha1ProcessBlock(state1: (Int64 * Int64 * Int64), state2: (Int64 * Int64), block: Blob, blockOffset: Int64): ((Int64 * Int64 * Int64) * (Int64 * Int64)) =
    let w = Stdlib.Crypto.__sha1Schedule(block, blockOffset, [], 0) in
    let result = Stdlib.Crypto.__sha1Rounds(state1, state2, 0, w) in
    // Destructure sequentially to avoid complex nested pattern match
    match state1 with
    | (h0, h1, h2) ->
        match state2 with
        | (h3, h4) ->
            match result with
            | ((a, b, c), (d, e)) ->
                ((Stdlib.Crypto.__add32(h0, a),
                  Stdlib.Crypto.__add32(h1, b),
                  Stdlib.Crypto.__add32(h2, c)),
                 (Stdlib.Crypto.__add32(h3, d),
                  Stdlib.Crypto.__add32(h4, e)))

// Build SHA-1/SHA-256 padding (big-endian length)
let __sha256BuildPadding(dataLen: Int64): List<Int64> =
    let bitLen = dataLen * 8 in
    let padded = dataLen + 1 in
    let remainder = padded % 64 in
    let zerosNeeded = if remainder <= 56 then 56 - remainder else 120 - remainder in
    let zeros = Stdlib.Crypto.__zeros(zerosNeeded, []) in
    // Use cons and append instead of flatten to avoid compiler bug with list-of-lists
    let part1 = Stdlib.List.push(zeros, 128) in
    Stdlib.List.concat(part1, Stdlib.Crypto.__int64ToBE(bitLen))

// Process all 64-byte blocks for SHA-1 (using paired tuples)
let __sha1ProcessBlocks(state1: (Int64 * Int64 * Int64), state2: (Int64 * Int64), padded: Blob, offset: Int64, totalLen: Int64): ((Int64 * Int64 * Int64) * (Int64 * Int64)) =
    if offset >= totalLen then
        (state1, state2)
    else
        let result = Stdlib.Crypto.__sha1ProcessBlock(state1, state2, padded, offset) in
        match result with
        | (ns1, ns2) -> Stdlib.Crypto.__sha1ProcessBlocks(ns1, ns2, padded, offset + 64, totalLen)

// SHA-1 hash function
let __sha1(data: Blob): Blob =
    // Initial hash values
    let state1 = (1732584193, 4023233417, 2562383102) in   // h0, h1, h2
    let state2 = (271733878, 3285377520) in                // h3, h4
    let dataLen = Stdlib.Blob.__byteLength(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0, dataLen, []) in
    let padding = Stdlib.Crypto.__sha256BuildPadding(dataLen) in
    // Use Stdlib.List.concat instead of Stdlib.List.flatten to avoid compiler bug with list-of-lists
    let paddedList = Stdlib.List.concat(dataList, padding) in
    let padded = Stdlib.Blob.__fromInt64List(paddedList) in
    let paddedLen = Stdlib.Blob.__byteLength(padded) in
    let result = Stdlib.Crypto.__sha1ProcessBlocks(state1, state2, padded, 0, paddedLen) in
    match result with
    | ((rh0, rh1, rh2), (rh3, rh4)) ->
        // Use multiple appends instead of flatten for output
        let out1 = Stdlib.List.concat(Stdlib.Crypto.__int32ToBE(rh0), Stdlib.Crypto.__int32ToBE(rh1)) in
        let out2 = Stdlib.List.concat(out1, Stdlib.Crypto.__int32ToBE(rh2)) in
        let out3 = Stdlib.List.concat(out2, Stdlib.Crypto.__int32ToBE(rh3)) in
        let out4 = Stdlib.List.concat(out3, Stdlib.Crypto.__int32ToBE(rh4)) in
        Stdlib.Blob.__fromInt64List(out4)

