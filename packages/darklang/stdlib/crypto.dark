// SHA-384/512 sigma functions (64-bit versions)
let __sha512Sigma0(x: Int64): Int64 =
    Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Crypto.__rotr64(x, 28), Stdlib.Crypto.__rotr64(x, 34)), Stdlib.Crypto.__rotr64(x, 39))

let __sha512Sigma1(x: Int64): Int64 =
    Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Crypto.__rotr64(x, 14), Stdlib.Crypto.__rotr64(x, 18)), Stdlib.Crypto.__rotr64(x, 41))

let __sha512sigma0(x: Int64): Int64 =
    Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Crypto.__rotr64(x, 1), Stdlib.Crypto.__rotr64(x, 8)), Stdlib.Crypto.__shr64(x, 7))

let __sha512sigma1(x: Int64): Int64 =
    Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Crypto.__rotr64(x, 19), Stdlib.Crypto.__rotr64(x, 61)), Stdlib.Crypto.__shr64(x, 6))

// SHA-384/512 Ch function
let __sha512Ch(x: Int64, y: Int64, z: Int64): Int64 =
    Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseAnd(x, y), Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseNot(x), z))

// SHA-384/512 Maj function
let __sha512Maj(x: Int64, y: Int64, z: Int64): Int64 =
    Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseAnd(x, y), Stdlib.Int64.bitwiseAnd(x, z)), Stdlib.Int64.bitwiseAnd(y, z))

// Read 64-bit big-endian word from bytes
let __sha384GetWord(block: Blob, offset: Int64): Int64 =
    Stdlib.Crypto.__getBE64(block, offset)

// SHA-384/512 message schedule expansion
let __sha512ExpandWord(w: List<Int64>, i: Int64): Int64 =
    let w2 = Stdlib.Crypto.__listGet(w, i - 2) in
    let w7 = Stdlib.Crypto.__listGet(w, i - 7) in
    let w15 = Stdlib.Crypto.__listGet(w, i - 15) in
    let w16 = Stdlib.Crypto.__listGet(w, i - 16) in
    Stdlib.Crypto.__add64(Stdlib.Crypto.__add64(Stdlib.Crypto.__add64(Stdlib.Crypto.__sha512sigma1(w2), w7), Stdlib.Crypto.__sha512sigma0(w15)), w16)

// Build 80-word message schedule from 128-byte block
let __sha512Schedule(block: Blob, blockOffset: Int64, w: List<Int64>, i: Int64): List<Int64> =
    if i >= 80 then
        w
    else if i < 16 then
        let word = Stdlib.Crypto.__sha384GetWord(block, blockOffset + i * 8) in
        Stdlib.Crypto.__sha512Schedule(block, blockOffset, Stdlib.List.pushBack(w, word), i + 1)
    else
        let word = Stdlib.Crypto.__sha512ExpandWord(w, i) in
        Stdlib.Crypto.__sha512Schedule(block, blockOffset, Stdlib.List.pushBack(w, word), i + 1)

// SHA-384/512 single round - uses two 4-tuples for state (ARM64 8-param limit)
let __sha512Round(state1: (Int64 * Int64 * Int64 * Int64), state2: (Int64 * Int64 * Int64 * Int64), i: Int64, w: List<Int64>): ((Int64 * Int64 * Int64 * Int64) * (Int64 * Int64 * Int64 * Int64)) =
    match (state1, state2) with
    | ((a, b, c, d), (e, f, g, h)) ->
        let wi = Stdlib.Crypto.__listGet(w, i) in
        let ki = Stdlib.Crypto.__sha512K(i) in
        let ch = Stdlib.Crypto.__sha512Ch(e, f, g) in
        let sig1 = Stdlib.Crypto.__sha512Sigma1(e) in
        let t1 = Stdlib.Crypto.__add64(Stdlib.Crypto.__add64(Stdlib.Crypto.__add64(Stdlib.Crypto.__add64(h, sig1), ch), ki), wi) in
        let maj = Stdlib.Crypto.__sha512Maj(a, b, c) in
        let sig0 = Stdlib.Crypto.__sha512Sigma0(a) in
        let t2 = Stdlib.Crypto.__add64(sig0, maj) in
        let newA = Stdlib.Crypto.__add64(t1, t2) in
        let newE = Stdlib.Crypto.__add64(d, t1) in
        ((newA, a, b, c), (newE, e, f, g))

// Run 80 SHA-384/512 rounds
let __sha512Rounds(state1: (Int64 * Int64 * Int64 * Int64), state2: (Int64 * Int64 * Int64 * Int64), i: Int64, w: List<Int64>): ((Int64 * Int64 * Int64 * Int64) * (Int64 * Int64 * Int64 * Int64)) =
    if i >= 80 then
        (state1, state2)
    else
        let result = Stdlib.Crypto.__sha512Round(state1, state2, i, w) in
        match result with
        | (ns1, ns2) -> Stdlib.Crypto.__sha512Rounds(ns1, ns2, i + 1, w)

// Process one 128-byte block of SHA-384 (using tuples for state)
let __sha384ProcessBlock(state1: (Int64 * Int64 * Int64 * Int64), state2: (Int64 * Int64 * Int64 * Int64), block: Blob, blockOffset: Int64): ((Int64 * Int64 * Int64 * Int64) * (Int64 * Int64 * Int64 * Int64)) =
    let w = Stdlib.Crypto.__sha512Schedule(block, blockOffset, [], 0) in
    let result = Stdlib.Crypto.__sha512Rounds(state1, state2, 0, w) in
    // Destructure sequentially to avoid complex nested pattern match
    match state1 with
    | (h0, h1, h2, h3) ->
        match state2 with
        | (h4, h5, h6, h7) ->
            match result with
            | ((a, b, c, d), (e, f, g, h)) ->
                ((Stdlib.Crypto.__add64(h0, a),
                  Stdlib.Crypto.__add64(h1, b),
                  Stdlib.Crypto.__add64(h2, c),
                  Stdlib.Crypto.__add64(h3, d)),
                 (Stdlib.Crypto.__add64(h4, e),
                  Stdlib.Crypto.__add64(h5, f),
                  Stdlib.Crypto.__add64(h6, g),
                  Stdlib.Crypto.__add64(h7, h)))

// SHA-384 padding: same as SHA-512 (128-byte blocks, 128-bit length field)
let __sha384BuildPadding(dataLen: Int64): List<Int64> =
    let bitLen = dataLen * 8 in
    let padded = dataLen + 1 in
    let remainder = padded % 128 in
    let zerosNeeded = if remainder <= 112 then 112 - remainder else 240 - remainder in
    let zeros = Stdlib.Crypto.__zeros(zerosNeeded, []) in
    // 8 bytes of zeros for high 64 bits of length (we only support < 2^64 bit messages)
    let highLen = Stdlib.Crypto.__zeros(8, []) in
    // Use cons and append instead of flatten to avoid compiler bug with list-of-lists
    let part1 = Stdlib.List.push(zeros, 128) in
    let part2 = Stdlib.List.concat(part1, highLen) in
    Stdlib.List.concat(part2, Stdlib.Crypto.__int64ToBE(bitLen))

// Process all 128-byte blocks for SHA-384 (using tuples for state)
let __sha384ProcessBlocks(state1: (Int64 * Int64 * Int64 * Int64), state2: (Int64 * Int64 * Int64 * Int64), padded: Blob, offset: Int64, totalLen: Int64): ((Int64 * Int64 * Int64 * Int64) * (Int64 * Int64 * Int64 * Int64)) =
    if offset >= totalLen then
        (state1, state2)
    else
        let result = Stdlib.Crypto.__sha384ProcessBlock(state1, state2, padded, offset) in
        match result with
        | (ns1, ns2) -> Stdlib.Crypto.__sha384ProcessBlocks(ns1, ns2, padded, offset + 128, totalLen)

// SHA-384 hash function
let sha384(data: Blob): Blob =
    // SHA-384 initial hash values (different from SHA-512)
    let state1 = ((-3766243637369397544), 7105036623409894663, (-7973340178411365097), 1526699215303891257) in   // h0-h3
    let state2 = (7436329637833083697, (-8163818279084223215), (-2662702644619276377), 5167115440072839076) in   // h4-h7
    let dataLen = Stdlib.Blob.__byteLength(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0, dataLen, []) in
    let padding = Stdlib.Crypto.__sha384BuildPadding(dataLen) in
    // Use Stdlib.List.concat instead of Stdlib.List.flatten to avoid compiler bug with list-of-lists
    let paddedList = Stdlib.List.concat(dataList, padding) in
    let padded = Stdlib.Blob.__fromInt64List(paddedList) in
    let paddedLen = Stdlib.Blob.__byteLength(padded) in
    let result = Stdlib.Crypto.__sha384ProcessBlocks(state1, state2, padded, 0, paddedLen) in
    match result with
    | ((rh0, rh1, rh2, rh3), (rh4, rh5, _rh6, _rh7)) ->
        // SHA-384 outputs first 48 bytes (6 of the 8 64-bit words)
        // Use multiple appends instead of flatten for output
        let out1 = Stdlib.List.concat(Stdlib.Crypto.__int64ToBE(rh0), Stdlib.Crypto.__int64ToBE(rh1)) in
        let out2 = Stdlib.List.concat(out1, Stdlib.Crypto.__int64ToBE(rh2)) in
        let out3 = Stdlib.List.concat(out2, Stdlib.Crypto.__int64ToBE(rh3)) in
        let out4 = Stdlib.List.concat(out3, Stdlib.Crypto.__int64ToBE(rh4)) in
        let out5 = Stdlib.List.concat(out4, Stdlib.Crypto.__int64ToBE(rh5)) in
        Stdlib.Blob.__fromInt64List(out5)

// =============================================================================
// HMAC Implementation
// =============================================================================
// HMAC(K, m) = H((K' XOR opad) || H((K' XOR ipad) || m))
// ipad = 0x36 repeated, opad = 0x5c repeated
// Block size: 64 bytes for MD5/SHA-1/SHA-256, 128 bytes for SHA-384

// Pad or hash key to block size
let __hmacPrepareKey(key: Blob, blockSize: Int64, hashFn: Blob -> Blob): List<Int64> =
    let keyLen = Stdlib.Blob.__byteLength(key) in
    if keyLen > blockSize then
        // Hash the key if it's too long
        let hashedKey = hashFn(key) in
        let hashedKeyList = Stdlib.Crypto.__copyDataToList(hashedKey, 0, Stdlib.Blob.__byteLength(hashedKey), []) in
        let padding = Stdlib.Crypto.__zeros(blockSize - Stdlib.Blob.__byteLength(hashedKey), []) in
        // Use Stdlib.List.concat instead of Stdlib.List.flatten to avoid compiler bug with list-of-lists
        Stdlib.List.concat(hashedKeyList, padding)
    else if keyLen < blockSize then
        // Pad with zeros
        let keyList = Stdlib.Crypto.__copyDataToList(key, 0, keyLen, []) in
        let padding = Stdlib.Crypto.__zeros(blockSize - keyLen, []) in
        // Use Stdlib.List.concat instead of Stdlib.List.flatten to avoid compiler bug with list-of-lists
        Stdlib.List.concat(keyList, padding)
    else
        Stdlib.Crypto.__copyDataToList(key, 0, keyLen, [])

// Create ipad (0x36 repeated) or opad (0x5c repeated)
let __hmacCreatePad(padByte: Int64, size: Int64): List<Int64> =
    Stdlib.Crypto.__repeat(padByte, size, [])

// Generic HMAC implementation
let __hmac(key: Blob, data: Blob, blockSize: Int64, hashFn: Blob -> Blob): Blob =
    let keyPadded = Stdlib.Crypto.__hmacPrepareKey(key, blockSize, hashFn) in
    let ipad = Stdlib.Crypto.__hmacCreatePad(54, blockSize) in  // 0x36
    let opad = Stdlib.Crypto.__hmacCreatePad(92, blockSize) in  // 0x5c
    // XOR key with ipad and opad
    let keyXorIpad = Stdlib.Crypto.__xorByteLists(keyPadded, ipad, []) in
    let keyXorOpad = Stdlib.Crypto.__xorByteLists(keyPadded, opad, []) in
    // Inner hash: H((K XOR ipad) || message)
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0, Stdlib.Blob.__byteLength(data), []) in
    // Use Stdlib.List.concat instead of Stdlib.List.flatten to avoid compiler bug with list-of-lists
    let innerInput = Stdlib.Blob.__fromInt64List(Stdlib.List.concat(keyXorIpad, dataList)) in
    let innerHash = hashFn(innerInput) in
    // Outer hash: H((K XOR opad) || inner_hash)
    let innerHashList = Stdlib.Crypto.__copyDataToList(innerHash, 0, Stdlib.Blob.__byteLength(innerHash), []) in
    // Use Stdlib.List.concat instead of Stdlib.List.flatten to avoid compiler bug with list-of-lists
    let outerInput = Stdlib.Blob.__fromInt64List(Stdlib.List.concat(keyXorOpad, innerHashList)) in
    hashFn(outerInput)

// HMAC-SHA256
let sha256hmac(key: Blob, data: Blob): Blob =
    Stdlib.Crypto.__hmac(key, data, 64, Stdlib.Crypto.sha256)

let __sha384hmac(key: Blob, data: Blob): Blob =
    Stdlib.Crypto.__hmac(key, data, 128, Stdlib.Crypto.sha384)

let digest(algorithm: Stdlib.Crypto.DigestAlgorithm, data: Blob): Blob =
    match algorithm with
    | Md5 -> Stdlib.Crypto.md5(data)
    | Sha1 -> Stdlib.Crypto.__sha1(data)
    | Sha256 -> Stdlib.Crypto.sha256(data)
    | Sha384 -> Stdlib.Crypto.sha384(data)

// HMAC-SHA1
let sha1hmac(key: Blob, data: Blob): Blob =
    Stdlib.Crypto.__hmac(key, data, 64, Stdlib.Crypto.__sha1)

// Native lowering fills at most 256 bytes through getrandom/getentropy.
let __secureRandomFill(buffer: RawPtr, length: Int64): Int64 = -38

let __secureRandomRead(buffer: RawPtr, index: Int64, length: Int64, acc: List<Int64>): Blob =
    if index == length then Stdlib.Blob.__fromInt64List(Stdlib.List.reverse(acc))
    else Stdlib.Crypto.__secureRandomRead(buffer, index + 1, length,
           Stdlib.List.push(acc, __raw_get_byte(buffer, index)))

let __secureRandomBytes(length: Int64): Stdlib.Result.Result<Blob, String> =
    if length < 0 || length > 256 then
        Error("Secure random length must be between 0 and 256")
    else if length == 0 then Ok(Stdlib.Blob.empty)
    else
        let buffer = __raw_alloc(length) in
        let received = Stdlib.Crypto.__secureRandomFill(buffer, length) in
        let result =
            if received < 0 then
                Error("OS entropy errno " + Stdlib.Int64.toString(0 - received))
            else if received != length then
                Error("OS entropy returned fewer bytes than requested")
            else Ok(Stdlib.Crypto.__secureRandomRead(buffer, 0, length, [])) in
        let _ = __raw_free_sized(buffer, length) in
        result
