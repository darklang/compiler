// SHA-256 sigma functions
let __sha256Sigma0(x: Int64): Int64 =
    Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Crypto.__rotr32(x, 2), Stdlib.Crypto.__rotr32(x, 13)), Stdlib.Crypto.__rotr32(x, 22)), Stdlib.Crypto.__mask32())

let __sha256Sigma1(x: Int64): Int64 =
    Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Crypto.__rotr32(x, 6), Stdlib.Crypto.__rotr32(x, 11)), Stdlib.Crypto.__rotr32(x, 25)), Stdlib.Crypto.__mask32())

let __sha256sigma0(x: Int64): Int64 =
    Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Crypto.__rotr32(x, 7), Stdlib.Crypto.__rotr32(x, 18)), Stdlib.Int64.shiftRight(Stdlib.Int64.bitwiseAnd(x, Stdlib.Crypto.__mask32()), 3)), Stdlib.Crypto.__mask32())

let __sha256sigma1(x: Int64): Int64 =
    Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Crypto.__rotr32(x, 17), Stdlib.Crypto.__rotr32(x, 19)), Stdlib.Int64.shiftRight(Stdlib.Int64.bitwiseAnd(x, Stdlib.Crypto.__mask32()), 10)), Stdlib.Crypto.__mask32())

// SHA-256 Ch function: (x AND y) XOR ((NOT x) AND z)
let __sha256Ch(x: Int64, y: Int64, z: Int64): Int64 =
    Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseAnd(x, y), Stdlib.Int64.bitwiseAnd(Stdlib.Crypto.__not32(x), z)), Stdlib.Crypto.__mask32())

// SHA-256 Maj function: (x AND y) XOR (x AND z) XOR (y AND z)
let __sha256Maj(x: Int64, y: Int64, z: Int64): Int64 =
    Stdlib.Int64.bitwiseAnd(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseXor(Stdlib.Int64.bitwiseAnd(x, y), Stdlib.Int64.bitwiseAnd(x, z)), Stdlib.Int64.bitwiseAnd(y, z)), Stdlib.Crypto.__mask32())

// SHA-256 message schedule expansion
let __sha256ExpandWord(w: List<Int64>, i: Int64): Int64 =
    let w2 = Stdlib.Crypto.__listGet(w, i - 2) in
    let w7 = Stdlib.Crypto.__listGet(w, i - 7) in
    let w15 = Stdlib.Crypto.__listGet(w, i - 15) in
    let w16 = Stdlib.Crypto.__listGet(w, i - 16) in
    Stdlib.Crypto.__add32(Stdlib.Crypto.__add32(Stdlib.Crypto.__add32(Stdlib.Crypto.__sha256sigma1(w2), w7), Stdlib.Crypto.__sha256sigma0(w15)), w16)

// Build the full 64-word message schedule
let __sha256Schedule(block: Blob, blockOffset: Int64, w: List<Int64>, i: Int64): List<Int64> =
    if i >= 64 then
        w
    else if i < 16 then
        let word = Stdlib.Crypto.__getBE32(block, blockOffset + i * 4) in
        Stdlib.Crypto.__sha256Schedule(block, blockOffset, Stdlib.List.pushBack(w, word), i + 1)
    else
        let word = Stdlib.Crypto.__sha256ExpandWord(w, i) in
        Stdlib.Crypto.__sha256Schedule(block, blockOffset, Stdlib.List.pushBack(w, word), i + 1)

// SHA-256 single round - uses two 4-tuples for state (ARM64 8-param limit)
let __sha256Round(state1: (Int64 * Int64 * Int64 * Int64), state2: (Int64 * Int64 * Int64 * Int64), i: Int64, w: List<Int64>): ((Int64 * Int64 * Int64 * Int64) * (Int64 * Int64 * Int64 * Int64)) =
    match (state1, state2) with
    | ((a, b, c, d), (e, f, g, h)) ->
        let wi = Stdlib.Crypto.__listGet(w, i) in
        let ki = Stdlib.Crypto.__sha256K(i) in
        let ch = Stdlib.Crypto.__sha256Ch(e, f, g) in
        let sig1 = Stdlib.Crypto.__sha256Sigma1(e) in
        // t1 = h + Σ1(e) + Ch(e,f,g) + Ki + Wi - computed step by step
        let t1_1 = Stdlib.Crypto.__add32(h, sig1) in
        let t1_2 = Stdlib.Crypto.__add32(t1_1, ch) in
        let t1_3 = Stdlib.Crypto.__add32(t1_2, ki) in
        let t1 = Stdlib.Crypto.__add32(t1_3, wi) in
        let maj = Stdlib.Crypto.__sha256Maj(a, b, c) in
        let sig0 = Stdlib.Crypto.__sha256Sigma0(a) in
        let t2 = Stdlib.Crypto.__add32(sig0, maj) in
        let newA = Stdlib.Crypto.__add32(t1, t2) in
        let newE = Stdlib.Crypto.__add32(d, t1) in
        ((newA, a, b, c), (newE, e, f, g))

// Run 64 SHA-256 rounds
let __sha256Rounds(state1: (Int64 * Int64 * Int64 * Int64), state2: (Int64 * Int64 * Int64 * Int64), i: Int64, w: List<Int64>): ((Int64 * Int64 * Int64 * Int64) * (Int64 * Int64 * Int64 * Int64)) =
    if i >= 64 then
        (state1, state2)
    else
        let result = Stdlib.Crypto.__sha256Round(state1, state2, i, w) in
        match result with
        | (ns1, ns2) -> Stdlib.Crypto.__sha256Rounds(ns1, ns2, i + 1, w)

// Process one 64-byte block of SHA-256 (using tuples for state)
let __sha256ProcessBlock(state1: (Int64 * Int64 * Int64 * Int64), state2: (Int64 * Int64 * Int64 * Int64), block: Blob, blockOffset: Int64): ((Int64 * Int64 * Int64 * Int64) * (Int64 * Int64 * Int64 * Int64)) =
    let w = Stdlib.Crypto.__sha256Schedule(block, blockOffset, [], 0) in
    let result = Stdlib.Crypto.__sha256Rounds(state1, state2, 0, w) in
    // Destructure sequentially to avoid complex nested pattern match
    match state1 with
    | (h0, h1, h2, h3) ->
        match state2 with
        | (h4, h5, h6, h7) ->
            match result with
            | ((a, b, c, d), (e, f, g, h)) ->
                ((Stdlib.Crypto.__add32(h0, a),
                  Stdlib.Crypto.__add32(h1, b),
                  Stdlib.Crypto.__add32(h2, c),
                  Stdlib.Crypto.__add32(h3, d)),
                 (Stdlib.Crypto.__add32(h4, e),
                  Stdlib.Crypto.__add32(h5, f),
                  Stdlib.Crypto.__add32(h6, g),
                  Stdlib.Crypto.__add32(h7, h)))

// Process all 64-byte blocks for SHA-256 (using tuples for state)
let __sha256ProcessBlocks(state1: (Int64 * Int64 * Int64 * Int64), state2: (Int64 * Int64 * Int64 * Int64), padded: Blob, offset: Int64, totalLen: Int64): ((Int64 * Int64 * Int64 * Int64) * (Int64 * Int64 * Int64 * Int64)) =
    if offset >= totalLen then
        (state1, state2)
    else
        let result = Stdlib.Crypto.__sha256ProcessBlock(state1, state2, padded, offset) in
        match result with
        | (ns1, ns2) -> Stdlib.Crypto.__sha256ProcessBlocks(ns1, ns2, padded, offset + 64, totalLen)

// SHA-256 hash function
let sha256(data: Blob): Blob =
    // Initial hash values (first 32 bits of fractional parts of square roots of first 8 primes)
    let state1 = (1779033703, 3144134277, 1013904242, 2773480762) in   // h0-h3
    let state2 = (1359893119, 2600822924, 528734635, 1541459225) in    // h4-h7
    let dataLen = Stdlib.Blob.__byteLength(data) in
    let dataList = Stdlib.Crypto.__copyDataToList(data, 0, dataLen, []) in
    let padding = Stdlib.Crypto.__sha256BuildPadding(dataLen) in
    // Use Stdlib.List.concat instead of Stdlib.List.flatten to avoid compiler bug with list-of-lists
    let paddedList = Stdlib.List.concat(dataList, padding) in
    let padded = Stdlib.Blob.__fromInt64List(paddedList) in
    let paddedLen = Stdlib.Blob.__byteLength(padded) in
    let result = Stdlib.Crypto.__sha256ProcessBlocks(state1, state2, padded, 0, paddedLen) in
    match result with
    | ((rh0, rh1, rh2, rh3), (rh4, rh5, rh6, rh7)) ->
        // Use multiple appends instead of flatten for output
        let out1 = Stdlib.List.concat(Stdlib.Crypto.__int32ToBE(rh0), Stdlib.Crypto.__int32ToBE(rh1)) in
        let out2 = Stdlib.List.concat(out1, Stdlib.Crypto.__int32ToBE(rh2)) in
        let out3 = Stdlib.List.concat(out2, Stdlib.Crypto.__int32ToBE(rh3)) in
        let out4 = Stdlib.List.concat(out3, Stdlib.Crypto.__int32ToBE(rh4)) in
        let out5 = Stdlib.List.concat(out4, Stdlib.Crypto.__int32ToBE(rh5)) in
        let out6 = Stdlib.List.concat(out5, Stdlib.Crypto.__int32ToBE(rh6)) in
        let out7 = Stdlib.List.concat(out6, Stdlib.Crypto.__int32ToBE(rh7)) in
        Stdlib.Blob.__fromInt64List(out7)

