// Stdlib.PrintError.dark - stderr helpers, the interpreter Stdlib.printError and printErrorLine.

module Darklang.Stdlib

let printError (str: String) : Unit =
    let _ = Stdlib.Cli.Posix.fdWrite (Stdlib.Int.fromInt64 2L) (Stdlib.String.toBlob str) in
    ()

let printErrorLine (str: String) : Unit = Stdlib.printError (str + "\n")
