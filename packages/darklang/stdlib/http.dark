// Stdlib.Http - canonical portable HTTP request, response, parser, and cookie values.

module Darklang.Stdlib.Http

type Request =
  { method: String
    url: String
    headers: List<String * String>
    body: Blob }

// Decode URL form fields at the byte level, matching upstream PR #5727.
// '+' represents a space; invalid percent escapes are preserved verbatim.
let urlDecode (value: String) : String =
    match Stdlib.String.split (Stdlib.String.replaceAll value "+" " ") "%" with
    | [] -> ""
    | first :: rest ->
        let decodedBytes =
            Stdlib.List.fold rest (Stdlib.String.toBytes first) (fun acc piece ->
                let hex = Stdlib.String.__sliceInt piece 0 2 in
                let parsed =
                    if Stdlib.String.__lengthInt hex == 2 then Stdlib.Blob.fromHex hex
                    else Error "not an escape" in
                match parsed with
                | Ok blob ->
                    Stdlib.List.concat
                        (Stdlib.List.concat acc (Stdlib.Blob.toList blob))
                        (Stdlib.String.toBytes (Stdlib.String.__dropFirstInt piece 2))
                | Error _ ->
                    Stdlib.List.concat acc (Stdlib.String.toBytes ("%" + piece))) in
        Stdlib.String.fromBytesWithReplacement decodedBytes

let __parseQueryParam (param: String) : Stdlib.Option.Option<(String * String)> =
    if param == "" then None
    else
        match Stdlib.String.split param "=" with
        | [key, value] -> Some ((Stdlib.Http.urlDecode key, Stdlib.Http.urlDecode value))
        | [key] -> Some ((Stdlib.Http.urlDecode key, ""))
        | key :: valueParts -> Some ((Stdlib.Http.urlDecode key, Stdlib.Http.urlDecode (Stdlib.String.join valueParts "=")))
        | [] -> None

let __queryParamsToDict (params: List<String>) (result: Dict<String, String>) : Dict<String, String> =
    match params with
    | [] -> result
    | param :: rest ->
        let next =
            match Stdlib.Http.__parseQueryParam param with
            | None -> result
            | Some ((key, value)) ->
                Stdlib.Dict.setOverridingDuplicates result key value in
        Stdlib.Http.__queryParamsToDict rest next

let parseQueryString (url: String) : Dict<String, String> =
    match Stdlib.String.split url "?" with
    | [] -> Stdlib.Dict.empty
    | [_] -> Stdlib.Dict.empty
    | _ :: queryParts ->
        Stdlib.Http.__queryParamsToDict (Stdlib.String.split (Stdlib.String.join queryParts "?") "&") Stdlib.Dict.empty

let __parseHeaderLine (line: String) : Stdlib.Option.Option<(String * String)> =
    let trimmed = Stdlib.String.trim line in
    if trimmed == "" then None
    else
        match Stdlib.String.split trimmed ":" with
        | [] -> None
        | [_] -> None
        | name :: valueParts ->
            Some ((
                Stdlib.String.trim name,
                Stdlib.String.trim (Stdlib.String.join valueParts ":")))

let __headerLinesToDict (lines: List<String>) (result: Dict<String, String>) : Dict<String, String> =
    match lines with
    | [] -> result
    | line :: rest ->
        let next =
            match Stdlib.Http.__parseHeaderLine line with
            | None -> result
            | Some ((name, value)) ->
                Stdlib.Dict.setOverridingDuplicates result name value in
        Stdlib.Http.__headerLinesToDict rest next

let parseHeaders (value: String) : Dict<String, String> =
    let lines = Stdlib.String.split (Stdlib.String.replaceAll value "\r\n" "\n") "\n" in
    Stdlib.Http.__headerLinesToDict lines Stdlib.Dict.empty

type Response =
  { statusCode: Int64
    headers: List<String * String>
    body: Blob }

// The compiler's own servers answer through these, body first and an Int status.
let __responseInt (body: Blob) (statusCode: Int) : Stdlib.Http.Response =
    Stdlib.Http.Response { statusCode = Builtin.unwrap (Stdlib.Int.toInt64 statusCode), headers = [], body = body }

let __responseWithHeadersInt (body: Blob) (headers: List<(String * String)>) (statusCode: Int) : Stdlib.Http.Response =
    Stdlib.Http.Response { statusCode = Builtin.unwrap (Stdlib.Int.toInt64 statusCode), headers = headers, body = body }

let __responseWithHtmlInt (body: String) (statusCode: Int) : Stdlib.Http.Response =
    Stdlib.Http.__responseWithHeadersInt (Stdlib.String.toBlob body) ([("Content-Type", "text/html; charset=utf-8")]) statusCode

let __responseWithTextInt (text: String) (statusCode: Int) : Stdlib.Http.Response =
    Stdlib.Http.__responseWithHeadersInt (Stdlib.String.toBlob text) ([("Content-Type", "text/plain; charset=utf-8")]) statusCode

let __responseWithJsonInt (json: String) (statusCode: Int) : Stdlib.Http.Response =
    Stdlib.Http.__responseWithHeadersInt (Stdlib.String.toBlob json) ([("Content-Type", "application/json")]) statusCode

let response (statusCode: Int64) (body: Blob) : Stdlib.Http.Response =
    Stdlib.Http.Response { statusCode = statusCode, headers = [], body = body }

let responseWithHeaders (statusCode: Int64) (headers: List<(String * String)>) (body: Blob) : Stdlib.Http.Response =
    Stdlib.Http.Response { statusCode = statusCode, headers = headers, body = body }

let success (body: Blob) : Stdlib.Http.Response =
    Stdlib.Http.__responseInt body 200

let responseWithHtml (statusCode: Int64) (body: String) : Stdlib.Http.Response =
    Stdlib.Http.responseWithHeaders statusCode ([("Content-Type", "text/html; charset=utf-8")]) (Stdlib.String.toBlob body)

let responseWithText (statusCode: Int64) (text: String) : Stdlib.Http.Response =
    Stdlib.Http.responseWithHeaders statusCode ([("Content-Type", "text/plain; charset=utf-8")]) (Stdlib.String.toBlob text)

let responseWithJson (statusCode: Int64) (json: String) : Stdlib.Http.Response =
    Stdlib.Http.responseWithHeaders statusCode ([("Content-Type", "application/json")]) (Stdlib.String.toBlob json)

let redirectTo (url: String) : Stdlib.Http.Response =
    Stdlib.Http.__responseWithHeadersInt Stdlib.Blob.empty ([("Location", url)]) 302

let badRequest (error: String) : Stdlib.Http.Response =
    Stdlib.Http.__responseInt (Stdlib.String.toBlob error) 400

let notFound () : Stdlib.Http.Response =
    Stdlib.Http.__responseInt Stdlib.Blob.empty 404

let unauthorized () : Stdlib.Http.Response =
    Stdlib.Http.__responseInt Stdlib.Blob.empty 401

let forbidden () : Stdlib.Http.Response =
    Stdlib.Http.__responseInt Stdlib.Blob.empty 403

let serverError (error: String) : Stdlib.Http.Response =
    Stdlib.Http.__responseInt (Stdlib.String.toBlob error) 500

type Cookie =
  { expires: DateTime
    maxAge: Int64
    domain: String
    path: String
    secure: Bool
    httpOnly: Bool
    sameSite: String }
