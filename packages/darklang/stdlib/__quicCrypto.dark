// __QuicCrypto.dark - QUIC v1 AES-128 packet protection and initial key derivation.
module Darklang.Stdlib.__QuicCrypto

type Keys = { key: Blob, iv: Blob, hp: Blob }
type Initial = { client: Stdlib.__QuicCrypto.Keys, server: Stdlib.__QuicCrypto.Keys }
type Opened = { header: Blob, payload: Blob, number: Int64 }

let derive(secret: Blob): Stdlib.Result.Result<Stdlib.__QuicCrypto.Keys, String> =
  if Stdlib.Blob.__byteLength(secret) != 32 then Error("QUIC SHA-256 traffic secret must have 32 bytes")
  else
    match Stdlib.__Tls13.hkdfExpandLabel(secret, "quic key", Stdlib.Blob.empty, 16),
          Stdlib.__Tls13.hkdfExpandLabel(secret, "quic iv", Stdlib.Blob.empty, 12),
          Stdlib.__Tls13.hkdfExpandLabel(secret, "quic hp", Stdlib.Blob.empty, 16) with
    | Ok(key), Ok(iv), Ok(hp) -> Ok(Stdlib.__QuicCrypto.Keys { key = key, iv = iv, hp = hp })
    | _, _, _ -> Error("QUIC key derivation failed")

let initial(connectionId: Blob): Stdlib.Result.Result<Stdlib.__QuicCrypto.Initial, String> =
  if Stdlib.Blob.__byteLength(connectionId) > 20 then Error("QUIC connection ID exceeds 20 bytes")
  else
    let salt = Stdlib.Blob.__fromInt64List([56, 118, 44, 247, 245, 89, 52, 179,
      77, 23, 154, 230, 164, 200, 12, 173, 204, 187, 127, 10]) in
    let secret = Stdlib.__Tls13.hkdfExtract(salt, connectionId) in
    match Stdlib.__Tls13.hkdfExpandLabel(secret, "client in", Stdlib.Blob.empty, 32),
          Stdlib.__Tls13.hkdfExpandLabel(secret, "server in", Stdlib.Blob.empty, 32) with
    | Ok(clientSecret), Ok(serverSecret) ->
      match Stdlib.__QuicCrypto.derive(clientSecret), Stdlib.__QuicCrypto.derive(serverSecret) with
      | Ok(client), Ok(server) -> Ok(Stdlib.__QuicCrypto.Initial { client = client, server = server })
      | _, _ -> Error("QUIC initial key derivation failed")
    | _, _ -> Error("QUIC initial secret derivation failed")

let nonce(iv: Blob, number: Int64): Stdlib.Result.Result<Blob, String> =
  if Stdlib.Blob.__byteLength(iv) != 12 then Error("QUIC IV must have 12 bytes")
  else if number < 0 || number > 4611686018427387903 then Error("Invalid QUIC packet number")
  else Ok(Stdlib.__Tls13.__nonceBytes(iv, number, 0, []))

let headerMask(key: Blob, sample: Blob): Stdlib.Result.Result<Blob, String> =
  if Stdlib.Blob.__byteLength(key) != 16 || Stdlib.Blob.__byteLength(sample) != 16 then
    Error("QUIC AES-128 header protection requires 16-byte key and sample")
  else
    let expanded = Stdlib.__AesGcm.__expandKey(Stdlib.Blob.__toInt64List(key), 4, 4, 1) in
    Ok(Stdlib.__Http2Wire.__slice(Stdlib.__AesGcm.__encryptBlock(expanded, sample), 0, 5))

// RFC 9000 Appendix A.3: choose the full packet number nearest the expected
// next number. The bounds also keep every intermediate below Int64 overflow.
let packetNumber(truncated: Int64, bytes: Int64, largest: Int64): Stdlib.Result.Result<Int64, String> =
  if bytes < 1 || bytes > 4 || largest < -1 || largest > 4611686018427387903 then
    Error("Invalid truncated QUIC packet number")
  else
    let window = Stdlib.__Hpack.__pow2(bytes * 8) in
    if truncated < 0 || truncated >= window then Error("Invalid truncated QUIC packet number")
    else
      let expected = largest + 1 in
      let candidate = (expected / window) * window + truncated in
      let number =
        if candidate <= expected - window / 2 && candidate < 4611686018427387904 - window then candidate + window
        else if candidate > expected + window / 2 && candidate >= window then candidate - window
        else candidate in
      if number > 4611686018427387903 then Error("Invalid QUIC packet number") else Ok(number)

let __numberBytes(data: Blob, position: Int64, remaining: Int64, value: Int64): Int64 =
  if remaining == 0 then value
  else Stdlib.__QuicCrypto.__numberBytes(data, position + 1, remaining - 1,
         value * 256 + Stdlib.Blob.__getByte(data, position))

let __maskedNumber(packet: Blob, offset: Int64, length: Int64, mask: Blob, index: Int64, bytes: List<Int64>): Blob =
  if index == length then Stdlib.Blob.__fromInt64List(Stdlib.List.reverse(bytes))
  else Stdlib.__QuicCrypto.__maskedNumber(packet, offset, length, mask, index + 1,
         Stdlib.List.push(bytes, Stdlib.Int64.bitwiseXor(Stdlib.Blob.__getByte(packet, offset + index),
           Stdlib.Blob.__getByte(mask, index + 1))))

let __firstMask(first: Int64, mask: Blob): Int64 =
  let bits = if first >= 128 then 15 else 31 in
  Stdlib.Int64.bitwiseXor(first, Stdlib.Int64.bitwiseAnd(Stdlib.Blob.__getByte(mask, 0), bits))

let __header(packet: Blob, offset: Int64, length: Int64, mask: Blob, first: Int64): Blob =
  Stdlib.Blob.concat([Stdlib.Blob.__fromInt64List([first]),
    Stdlib.__Http2Wire.__slice(packet, 1, offset - 1),
    Stdlib.__QuicCrypto.__maskedNumber(packet, offset, length, mask, 0, [])])

let __reserved(first: Int64): Bool =
  Stdlib.Int64.bitwiseAnd(first, if first >= 128 then 12 else 24) == 0

// The caller constructs a complete header, maintains unique packet numbers,
// and applies congestion/AEAD usage limits. These pure helpers do not own a
// connection, retransmission state, TLS authentication, or replay filtering.
let seal(keys: Stdlib.__QuicCrypto.Keys, header: Blob, payload: Blob, number: Int64, offset: Int64): Stdlib.Result.Result<Blob, String> =
  let size = Stdlib.Blob.__byteLength(header) in
  if size == 0 || offset < 1 || offset >= size || size + Stdlib.Blob.__byteLength(payload) + 16 > 16624 then
    Error("Invalid QUIC packet bounds")
  else
    let first = Stdlib.Blob.__getByte(header, 0) in
    let length = Stdlib.Int64.bitwiseAnd(first, 3) + 1 in
    if Stdlib.Int64.bitwiseAnd(first, 64) == 0 || Stdlib.Bool.not(Stdlib.__QuicCrypto.__reserved(first)) ||
       offset + length != size || Stdlib.Blob.__byteLength(payload) + length < 4 then
      Error("Invalid QUIC packet header or sample length")
    else if number < 0 || number > 4611686018427387903 ||
            Stdlib.__QuicCrypto.__numberBytes(header, offset, length, 0) != number % Stdlib.__Hpack.__pow2(length * 8) then
      Error("QUIC header packet number mismatch")
    else
      match Stdlib.__QuicCrypto.nonce(keys.iv, number) with
      | Error(message) -> Error(message)
      | Ok(nonce) ->
        match Stdlib.__AesGcm.encrypt(keys.key, nonce, header, payload) with
        | Error(message) -> Error(message)
        | Ok(ciphertext) ->
          let packet = Stdlib.Blob.concat([header, ciphertext]) in
          match Stdlib.__QuicCrypto.headerMask(keys.hp, Stdlib.__Http2Wire.__slice(packet, offset + 4, 16)) with
          | Error(message) -> Error(message)
          | Ok(mask) -> Ok(Stdlib.Blob.concat([Stdlib.__QuicCrypto.__header(packet, offset, length, mask, Stdlib.__QuicCrypto.__firstMask(first, mask)), ciphertext]))

// The packet boundary and packet-number offset must be parsed from invariant
// fields first; coalesced datagrams must be split before calling this helper.
let openPacket(keys: Stdlib.__QuicCrypto.Keys, packet: Blob, offset: Int64, largest: Int64): Stdlib.Result.Result<Stdlib.__QuicCrypto.Opened, String> =
  let size = Stdlib.Blob.__byteLength(packet) in
  if offset < 1 || size > 16624 || offset > size - 20 then Error("Invalid QUIC packet bounds")
  else if Stdlib.Int64.bitwiseAnd(Stdlib.Blob.__getByte(packet, 0), 64) == 0 then Error("Invalid QUIC fixed bit")
  else
    match Stdlib.__QuicCrypto.headerMask(keys.hp, Stdlib.__Http2Wire.__slice(packet, offset + 4, 16)) with
    | Error(message) -> Error(message)
    | Ok(mask) ->
      let first = Stdlib.__QuicCrypto.__firstMask(Stdlib.Blob.__getByte(packet, 0), mask) in
      let length = Stdlib.Int64.bitwiseAnd(first, 3) + 1 in
      let header = Stdlib.__QuicCrypto.__header(packet, offset, length, mask, first) in
      let truncated = Stdlib.__QuicCrypto.__numberBytes(header, offset, length, 0) in
      match Stdlib.__QuicCrypto.packetNumber(truncated, length, largest) with
      | Error(message) -> Error(message)
      | Ok(number) ->
        match Stdlib.__QuicCrypto.nonce(keys.iv, number) with
        | Error(message) -> Error(message)
        | Ok(nonce) ->
          let ciphertext = Stdlib.__Http2Wire.__slice(packet, offset + length, size - offset - length) in
          match Stdlib.__AesGcm.decrypt(keys.key, nonce, header, ciphertext) with
          | Error(message) -> Error(message)
          | Ok(payload) ->
            // Reserved bits are checked only after authentication.
            if Stdlib.Bool.not(Stdlib.__QuicCrypto.__reserved(first)) then Error("Invalid QUIC reserved bits")
            else Ok(Stdlib.__QuicCrypto.Opened { header = header, payload = payload, number = number })

// Retry uses public fixed keys: integrity binds it to the original connection
// ID, but does not authenticate a server. TLS must still authenticate the peer.
let retryTag(originalId: Blob, retry: Blob): Stdlib.Result.Result<Blob, String> =
  let idLength = Stdlib.Blob.__byteLength(originalId) in
  let size = Stdlib.Blob.__byteLength(retry) in
  if idLength > 20 || size < 7 || size > 4096 then Error("Invalid QUIC Retry bounds")
  else if Stdlib.Int64.bitwiseAnd(Stdlib.Blob.__getByte(retry, 0), 240) != 240 ||
          Stdlib.__Http2Wire.__read32(retry, 1) != 1 then Error("Invalid QUIC v1 Retry header")
  else
    let destinationLength = Stdlib.Blob.__getByte(retry, 5) in
    let sourceOffset = 6 + destinationLength in
    if destinationLength > 20 || sourceOffset >= size then Error("Invalid QUIC Retry connection ID")
    else
      let sourceLength = Stdlib.Blob.__getByte(retry, sourceOffset) in
      if sourceLength > 20 || sourceOffset + 1 + sourceLength >= size then Error("Invalid QUIC Retry token or connection ID")
      else
        let key = Stdlib.Blob.__fromInt64List([190, 12, 105, 11, 159, 102, 87, 90, 29, 118, 107, 84, 227, 104, 200, 78]) in
        let iv = Stdlib.Blob.__fromInt64List([70, 21, 153, 211, 93, 99, 43, 242, 35, 152, 37, 187]) in
        let pseudo = Stdlib.Blob.concat([Stdlib.Blob.__fromInt64List([idLength]), originalId, retry]) in
        Stdlib.__AesGcm.encrypt(key, iv, pseudo, Stdlib.Blob.empty)

let verifyRetry(originalId: Blob, packet: Blob): Stdlib.Result.Result<Bool, String> =
  let size = Stdlib.Blob.__byteLength(packet) in
  if size < 23 || size > 4112 then Error("Invalid QUIC Retry bounds")
  else
    match Stdlib.__QuicCrypto.retryTag(originalId, Stdlib.__Http2Wire.__slice(packet, 0, size - 16)) with
    | Error(message) -> Error(message)
    | Ok(expected) -> Ok(Stdlib.__AesGcm.__sameTag(expected, Stdlib.__Http2Wire.__slice(packet, size - 16, 16), 0, 0))
