// Env.dark - upstream-compatible process environment access.

module Darklang.Stdlib.Env

let __findEquals (entry: String) (offset: Int64) : Int64 =
    if offset >= Stdlib.String.__byteLength entry then -1
    else if Stdlib.String.__byteAtUnchecked entry offset == 61 then offset
    else Stdlib.Env.__findEquals entry (offset + 1)

let __addEntry (entry: String) (result: Dict<String, String>) : Dict<String, String> =
    let equals = Stdlib.Env.__findEquals entry 0 in
    if equals < 0 then result
    else
        let name = Stdlib.String.__byteSlice entry 0 equals in
        let value = Stdlib.String.__byteSlice entry (equals + 1) (Stdlib.String.__byteLength entry) in
        Stdlib.Dict.setOverridingDuplicates result name value

let __decodePackedFrom (packed: String) (offset: Int64) (start: Int64) (result: Dict<String, String>) : Dict<String, String> =
    if offset >= Stdlib.String.__byteLength packed then result
    else if Stdlib.String.__byteAtUnchecked packed offset == 0 then
        let entry = Stdlib.String.__byteSlice packed start offset in
        Stdlib.Env.__decodePackedFrom packed (offset + 1) (offset + 1) (Stdlib.Env.__addEntry entry result)
    else
        Stdlib.Env.__decodePackedFrom packed (offset + 1) start result

let __decodePacked (packed: String) : Dict<String, String> =
    Stdlib.Env.__decodePackedFrom packed 0 0 (Dict { })

let get (name: String) : Stdlib.Option.Option<String> = Builtin.runtimeEnvironmentGet name

let getAll () : Dict<String, String> = Builtin.runtimeEnvironmentGetAll ()
