// __Qpack.dark - RFC 9204 static/literal QPACK with zero dynamic-table capacity.
module Darklang.Stdlib.__Qpack

type Field = { name: String, value: String, next: Int64 }

// RFC 9204 Appendix A. Indices are zero-based, unlike HPACK.
let staticEntry(index: Int64): Stdlib.Option.Option<(String * String)> =
  match index with
  | 0 -> Some((":authority", ""))
  | 1 -> Some((":path", "/"))
  | 2 -> Some(("age", "0"))
  | 3 -> Some(("content-disposition", ""))
  | 4 -> Some(("content-length", "0"))
  | 5 -> Some(("cookie", ""))
  | 6 -> Some(("date", ""))
  | 7 -> Some(("etag", ""))
  | 8 -> Some(("if-modified-since", ""))
  | 9 -> Some(("if-none-match", ""))
  | 10 -> Some(("last-modified", ""))
  | 11 -> Some(("link", ""))
  | 12 -> Some(("location", ""))
  | 13 -> Some(("referer", ""))
  | 14 -> Some(("set-cookie", ""))
  | 15 -> Some((":method", "CONNECT"))
  | 16 -> Some((":method", "DELETE"))
  | 17 -> Some((":method", "GET"))
  | 18 -> Some((":method", "HEAD"))
  | 19 -> Some((":method", "OPTIONS"))
  | 20 -> Some((":method", "POST"))
  | 21 -> Some((":method", "PUT"))
  | 22 -> Some((":scheme", "http"))
  | 23 -> Some((":scheme", "https"))
  | 24 -> Some((":status", "103"))
  | 25 -> Some((":status", "200"))
  | 26 -> Some((":status", "304"))
  | 27 -> Some((":status", "404"))
  | 28 -> Some((":status", "503"))
  | 29 -> Some(("accept", "*/*"))
  | 30 -> Some(("accept", "application/dns-message"))
  | 31 -> Some(("accept-encoding", "gzip, deflate, br"))
  | 32 -> Some(("accept-ranges", "bytes"))
  | 33 -> Some(("access-control-allow-headers", "cache-control"))
  | 34 -> Some(("access-control-allow-headers", "content-type"))
  | 35 -> Some(("access-control-allow-origin", "*"))
  | 36 -> Some(("cache-control", "max-age=0"))
  | 37 -> Some(("cache-control", "max-age=2592000"))
  | 38 -> Some(("cache-control", "max-age=604800"))
  | 39 -> Some(("cache-control", "no-cache"))
  | 40 -> Some(("cache-control", "no-store"))
  | 41 -> Some(("cache-control", "public, max-age=31536000"))
  | 42 -> Some(("content-encoding", "br"))
  | 43 -> Some(("content-encoding", "gzip"))
  | 44 -> Some(("content-type", "application/dns-message"))
  | 45 -> Some(("content-type", "application/javascript"))
  | 46 -> Some(("content-type", "application/json"))
  | 47 -> Some(("content-type", "application/x-www-form-urlencoded"))
  | 48 -> Some(("content-type", "image/gif"))
  | 49 -> Some(("content-type", "image/jpeg"))
  | 50 -> Some(("content-type", "image/png"))
  | 51 -> Some(("content-type", "text/css"))
  | 52 -> Some(("content-type", "text/html; charset=utf-8"))
  | 53 -> Some(("content-type", "text/plain"))
  | 54 -> Some(("content-type", "text/plain;charset=utf-8"))
  | 55 -> Some(("range", "bytes=0-"))
  | 56 -> Some(("strict-transport-security", "max-age=31536000"))
  | 57 -> Some(("strict-transport-security", "max-age=31536000; includesubdomains"))
  | 58 -> Some(("strict-transport-security", "max-age=31536000; includesubdomains; preload"))
  | 59 -> Some(("vary", "accept-encoding"))
  | 60 -> Some(("vary", "origin"))
  | 61 -> Some(("x-content-type-options", "nosniff"))
  | 62 -> Some(("x-xss-protection", "1; mode=block"))
  | 63 -> Some((":status", "100"))
  | 64 -> Some((":status", "204"))
  | 65 -> Some((":status", "206"))
  | 66 -> Some((":status", "302"))
  | 67 -> Some((":status", "400"))
  | 68 -> Some((":status", "403"))
  | 69 -> Some((":status", "421"))
  | 70 -> Some((":status", "425"))
  | 71 -> Some((":status", "500"))
  | 72 -> Some(("accept-language", ""))
  | 73 -> Some(("access-control-allow-credentials", "FALSE"))
  | 74 -> Some(("access-control-allow-credentials", "TRUE"))
  | 75 -> Some(("access-control-allow-headers", "*"))
  | 76 -> Some(("access-control-allow-methods", "get"))
  | 77 -> Some(("access-control-allow-methods", "get, post, options"))
  | 78 -> Some(("access-control-allow-methods", "options"))
  | 79 -> Some(("access-control-expose-headers", "content-length"))
  | 80 -> Some(("access-control-request-headers", "content-type"))
  | 81 -> Some(("access-control-request-method", "get"))
  | 82 -> Some(("access-control-request-method", "post"))
  | 83 -> Some(("alt-svc", "clear"))
  | 84 -> Some(("authorization", ""))
  | 85 -> Some(("content-security-policy", "script-src 'none'; object-src 'none'; base-uri 'none'"))
  | 86 -> Some(("early-data", "1"))
  | 87 -> Some(("expect-ct", ""))
  | 88 -> Some(("forwarded", ""))
  | 89 -> Some(("if-range", ""))
  | 90 -> Some(("origin", ""))
  | 91 -> Some(("purpose", "prefetch"))
  | 92 -> Some(("server", ""))
  | 93 -> Some(("timing-allow-origin", "*"))
  | 94 -> Some(("upgrade-insecure-requests", "1"))
  | 95 -> Some(("user-agent", ""))
  | 96 -> Some(("x-forwarded-for", ""))
  | 97 -> Some(("x-frame-options", "deny"))
  | 98 -> Some(("x-frame-options", "sameorigin"))
  | _ -> None

let __value(name: String, data: Blob, position: Int64): Stdlib.Result.Result<Stdlib.__Qpack.Field, String> =
  match Stdlib.__Hpack.text(data, position) with
  | Error(message) -> Error(message)
  | Ok(text) -> Ok(Stdlib.__Qpack.Field { name = name, value = text.value, next = text.next })

let __nameReference(data: Blob, position: Int64): Stdlib.Result.Result<Stdlib.__Qpack.Field, String> =
  let first = Stdlib.Blob.__getByte(data, position) in
  if Stdlib.Int64.bitwiseAnd(first, 16) == 0 then Error("Dynamic QPACK references are disabled")
  else
    match Stdlib.__Hpack.integer(data, position, 4) with
    | Error(message) -> Error(message)
    | Ok(number) ->
      match Stdlib.__Qpack.staticEntry(number.value) with
      | None -> Error("Invalid QPACK static index")
      | Some(pair) -> let (name, _) = pair in Stdlib.__Qpack.__value(name, data, number.next)

let __literalName(data: Blob, position: Int64): Stdlib.Result.Result<Stdlib.__Hpack.Text, String> =
  match Stdlib.__Hpack.integer(data, position, 3) with
  | Error(message) -> Error(message)
  | Ok(number) ->
    if number.value == 0 then Error("Empty HTTP header name")
    else if number.value > 65536 then Error("QPACK string too large")
    else if number.value > Stdlib.Blob.__byteLength(data) - number.next then Error("Truncated QPACK name")
    else
      let encoded = Stdlib.__Http2Wire.__slice(data, number.next, number.value) in
      let decoded = if Stdlib.Int64.bitwiseAnd(Stdlib.Blob.__getByte(data, position), 8) == 0 then Ok(encoded)
                    else Stdlib.__Hpack.__huffman(encoded, 0, 0, 0, [], 0) in
      match decoded with
      | Error(message) -> Error(message)
      | Ok(bytes) ->
        match Stdlib.Blob.toString(bytes) with
        | Error(_) -> Error("Invalid UTF-8 in HTTP header")
        | Ok(name) ->
          if name == "" then Error("Empty HTTP header name")
          else Ok(Stdlib.__Hpack.Text { value = name, next = number.next + number.value })

let __field(data: Blob, position: Int64): Stdlib.Result.Result<Stdlib.__Qpack.Field, String> =
  let first = Stdlib.Blob.__getByte(data, position) in
  if first >= 128 then
    if Stdlib.Int64.bitwiseAnd(first, 64) == 0 then Error("Dynamic QPACK references are disabled")
    else
      match Stdlib.__Hpack.integer(data, position, 6) with
      | Error(message) -> Error(message)
      | Ok(number) ->
        match Stdlib.__Qpack.staticEntry(number.value) with
        | None -> Error("Invalid QPACK static index")
        | Some(pair) ->
          let (name, value) = pair in
          Ok(Stdlib.__Qpack.Field { name = name, value = value, next = number.next })
  else if first >= 64 then Stdlib.__Qpack.__nameReference(data, position)
  else if first >= 32 then
    match Stdlib.__Qpack.__literalName(data, position) with
    | Error(message) -> Error(message)
    | Ok(name) -> Stdlib.__Qpack.__value(name.value, data, name.next)
  else Error("Dynamic QPACK references are disabled")

let __decode(data: Blob, position: Int64, size: Int64, count: Int64, fields: List<(String * String)>): Stdlib.Result.Result<List<(String * String)>, String> =
  if position == Stdlib.Blob.__byteLength(data) then Ok(Stdlib.List.reverse(fields))
  else if count >= 256 then Error("QPACK header list too large")
  else
    match Stdlib.__Qpack.__field(data, position) with
    | Error(message) -> Error(message)
    | Ok(field) ->
      let entry = (field.name, field.value) in
      let nextSize = size + Stdlib.__Hpack.__entrySize(entry) in
      if nextSize > 65536 then Error("QPACK header list too large")
      else Stdlib.__Qpack.__decode(data, field.next, nextSize, count + 1, Stdlib.List.push(fields, entry))

let decode(data: Blob): Stdlib.Result.Result<List<(String * String)>, String> =
  if Stdlib.Blob.__byteLength(data) > 65536 then Error("QPACK field section too large")
  else
    match Stdlib.__Hpack.integer(data, 0, 8) with
    | Error(message) -> Error(message)
    | Ok(count) ->
      if count.value != 0 then Error("Dynamic QPACK references are disabled")
      else
        match Stdlib.__Hpack.integer(data, count.next, 7) with
        | Error(message) -> Error(message)
        | Ok(base) ->
          // With zero insert count a negative Base is invalid; positive Base
          // is irrelevant to static/literal fields and is explicitly allowed.
          if Stdlib.Blob.__getByte(data, count.next) >= 128 then Error("Invalid QPACK base")
          else Stdlib.__Qpack.__decode(data, base.next, 0, 0, [])

let __staticIndex(name: String, value: String, exact: Bool, index: Int64): Stdlib.Option.Option<Int64> =
  match Stdlib.__Qpack.staticEntry(index) with
  | None -> None
  | Some(entry) ->
    let (entryName, entryValue) = entry in
    if entryName == name && (Stdlib.Bool.not(exact) || entryValue == value) then Some(index)
    else Stdlib.__Qpack.__staticIndex(name, value, exact, index + 1)

let __encode(fields: List<(String * String)>, size: Int64, count: Int64, blocks: List<Blob>): Stdlib.Result.Result<Blob, String> =
  match fields with
  | [] -> Ok(Stdlib.Blob.concat(Stdlib.List.push(Stdlib.List.reverse(blocks), Stdlib.Blob.__fromInt64List([0, 0]))))
  | entry :: rest ->
    let (name, value) = entry in
    let nextSize = size + Stdlib.__Hpack.__entrySize(entry) in
    if name == "" then Error("Empty HTTP header name")
    else if count >= 256 || nextSize > 65536 then Error("QPACK header list too large")
    else
      let exact = if Stdlib.__Hpack.__sensitive(name) then None else Stdlib.__Qpack.__staticIndex(name, value, true, 0) in
      let block = match exact with
      | Some(index) -> Stdlib.__Hpack.encodeInteger(6, 192, index)
      | None ->
        let reference = match Stdlib.__Qpack.__staticIndex(name, value, false, 0) with
        | Some(index) -> Stdlib.__Hpack.encodeInteger(4, 112, index)
        | None ->
          let raw = Stdlib.String.toBlob(name) in
          let compressed = Stdlib.__Hpack.__encodeHuffman(raw, 0, 0, 0, []) in
          let huffman = Stdlib.Blob.__byteLength(compressed) < Stdlib.Blob.__byteLength(raw) in
          let bytes = if huffman then compressed else raw in
          Stdlib.Blob.concat([Stdlib.__Hpack.encodeInteger(3, (if huffman then 56 else 48), Stdlib.Blob.__byteLength(bytes)), bytes]) in
        Stdlib.Blob.concat([reference, Stdlib.__Hpack.encodeText(value)]) in
      Stdlib.__Qpack.__encode(rest, nextSize, count + 1, Stdlib.List.push(blocks, block))

let encode(fields: List<(String * String)>): Stdlib.Result.Result<Blob, String> =
  Stdlib.__Qpack.__encode(fields, 0, 0, [])

// Zero capacity permits only the one-byte capacity-zero instruction. Every
// other capacity has a nonzero prefix, so it can be rejected immediately.
let encoderInstructions(data: Blob, position: Int64): Stdlib.Result.Result<Int64, String> =
  if position < 0 || position > Stdlib.Blob.__byteLength(data) then Error("Invalid QPACK instruction offset")
  else if position == Stdlib.Blob.__byteLength(data) then Ok(position)
  else
    let first = Stdlib.Blob.__getByte(data, position) in
    if first < 32 || first >= 64 then Error("Dynamic QPACK instructions are disabled")
    else if first != 32 then Error("QPACK capacity exceeds advertised limit")
    else Stdlib.__Qpack.encoderInstructions(data, position + 1)
