// __Network.dark - Owned native TCP/UDP sockets, listeners, deadlines, and scoped shutdown signals.

module Darklang.Stdlib.__Network

// The Stream handle supplies shared, idempotent close and closes on last-owner
// release. The descriptor stays captured by its disposer, outside user values.
type Socket = { lifecycle: Stream<Unit> }

type UdpSocket = {
    lifecycle: Stream<Unit>,
    exchange4: List<Int64> -> Int64 -> Blob -> Int64 -> Stdlib.Result.Result<Blob, Int64>
}
type Udp6Socket = {
    lifecycle: Stream<Unit>,
    exchange6: List<Int64> -> Int64 -> Blob -> Int64 -> Stdlib.Result.Result<Blob, Int64>
}

// A readiness registration retains the descriptor owner. Virtual transports
// have no native watch; native callers never poll a released descriptor.
type Watch = { descriptor: Int64, lifecycle: Stream<Unit> }
type Interest = { watch: Stdlib.__Network.Watch, readable: Bool, writable: Bool }
type Ready = { index: Int64, readable: Bool, writable: Bool, closed: Bool, failed: Bool }

type TcpConnection = {
    lifecycle: Stream<Unit>,
    watch: Option<Stdlib.__Network.Watch>,
    read: Int64 -> Stdlib.Result.Result<Blob, Int64>,
    write: Blob -> Stdlib.Result.Result<Unit, Int64>
}

// Replaced by target-specific syscalls during native lowering. The fallback
// lets stdlib preparation typecheck without opening a socket.
let __tcp4Socket(): Int64 = -38
let __udp4Socket(): Int64 = -38
let __udp6Socket(): Int64 = -38
let __tcp6Socket(): Int64 = -38
let __connect4(descriptor: Int64, address: RawPtr): Int64 = -38
let __connect6(descriptor: Int64, address: RawPtr): Int64 = -38
let __send(descriptor: Int64, payload: Blob): Int64 = -38
let __sendWithMode(descriptor: Int64, payload: Blob, nonblocking: Bool): Int64 = -38
let __sendTo(descriptor: Int64, payload: Blob, address: RawPtr, addressLength: Int64): Int64 = -38
let __sendToWithMode(descriptor: Int64, payload: Blob, address: RawPtr, addressLength: Int64, nonblocking: Bool): Int64 = -38
// Peer storage holds a socklen word followed by the sockaddr at offset eight.
let __receiveFrom(descriptor: Int64, buffer: RawPtr, length: Int64, peer: RawPtr): Int64 = -38
let __receiveFromWithMode(descriptor: Int64, buffer: RawPtr, length: Int64, peer: RawPtr, nonblocking: Bool): Int64 = -38
let __bind6(descriptor: Int64, address: RawPtr): Int64 = -38
let __receive(descriptor: Int64, buffer: RawPtr, length: Int64): Int64 = -38
let __receiveWithMode(descriptor: Int64, buffer: RawPtr, length: Int64, nonblocking: Bool): Int64 = -38
let __receiveTimeout(descriptor: Int64, timeval: RawPtr): Int64 = -38
let __sendTimeout(descriptor: Int64, timeval: RawPtr): Int64 = -38
let __close(descriptor: Int64): Int64 = -38
let __bind4(descriptor: Int64, address: RawPtr): Int64 = -38
let __listen(descriptor: Int64): Int64 = -38
let __accept(descriptor: Int64): Int64 = -38
let __cloexec(descriptor: Int64): Int64 = -38
let __reuseAddress(descriptor: Int64, enabled: RawPtr): Int64 = -38
let __poll(pollfd: RawPtr, timeout: RawPtr): Int64 = -38
let __pollMany(pollfds: RawPtr, count: Int64, timeout: RawPtr): Int64 = -38
let __signalBlock(mask: RawPtr, previous: RawPtr): Int64 = -38
let __signalRestore(previous: RawPtr): Int64 = -38
let __signalPending(mask: RawPtr): Int64 = -38
let __signalWait(mask: RawPtr, info: RawPtr): Int64 = -38
let __monotonic(time: RawPtr): Int64 = -38

let openTcp4(): Stdlib.Result.Result<Stdlib.__Network.Socket, Int64> =
    let descriptor = Stdlib.__Network.__tcp4Socket() in
    if descriptor < 0 then Error(0 - descriptor)
    else
        let lifecycle =
            Stdlib.Stream.__new(
                (fun _unit -> None),
                fun _unit -> let _ = Stdlib.__Network.__close(descriptor) in ()) in
        Ok(Stdlib.__Network.Socket { lifecycle = lifecycle })

let close(socket: Stdlib.__Network.Socket): Unit =
    Stdlib.Stream.close(socket.lifecycle)

let __validBytes(bytes: List<Int64>): Bool =
    match bytes with
    | [] -> true
    | byte :: rest ->
        byte >= 0 && byte <= 255 && Stdlib.__Network.__validBytes(rest)

let __validAddress(ipv6: Bool, bytes: List<Int64>): Bool =
    Stdlib.List.__lengthInt(bytes) == (if ipv6 then 16z else 4z) &&
    Stdlib.__Network.__validBytes(bytes)

let __writeAddress(ptr: RawPtr, bytes: List<Int64>, offset: Int64): Unit =
    match bytes with
    | [] -> ()
    | byte :: rest ->
        let _ = __raw_write_byte(ptr, offset, byte) in
        Stdlib.__Network.__writeAddress(ptr, rest, offset + 1)

let __copyReceived(ptr: RawPtr, index: Int64, length: Int64, acc: List<Int64>): Blob =
    if index >= length then Stdlib.Blob.__fromInt64List(Stdlib.List.reverse(acc))
    else
        Stdlib.__Network.__copyReceived(ptr, index + 1, length,
            Stdlib.List.push(acc, __raw_get_byte(ptr, index)))

let __socketAddress(ipv6: Bool, address: List<Int64>, port: Int64): RawPtr =
    let ptr = __raw_alloc(if ipv6 then 32 else 16) in
    let _ = __raw_write_word(ptr, 0, 0) in
    let _ = __raw_write_word(ptr, 8, 0) in
    let _ = if ipv6 then __raw_write_word(ptr, 16, 0) else () in
    let _ = if ipv6 then __raw_write_word(ptr, 24, 0) else () in
    let _ =
        if Stdlib.Cli.__hostOSCode() == 2 then
            let _ = __raw_write_byte(ptr, 0, if ipv6 then 28 else 16) in
            __raw_write_byte(ptr, 1, if ipv6 then 30 else 2)
        else __raw_write_byte(ptr, 0, if ipv6 then 10 else 2) in
    let _ = __raw_write_byte(ptr, 2, port / 256) in
    let _ = __raw_write_byte(ptr, 3, port % 256) in
    let _ = Stdlib.__Network.__writeAddress(ptr, address, if ipv6 then 8 else 4) in
    ptr

let __setTimeout(descriptor: Int64, timeoutMs: Int64): Stdlib.Result.Result<Unit, Int64> =
    let timeval = __raw_alloc(16) in
    let _ = __raw_write_word(timeval, 0, timeoutMs / 1000) in
    let _ = __raw_write_word(timeval, 8, (timeoutMs % 1000) * 1000) in
    let receiveResult = Stdlib.__Network.__receiveTimeout(descriptor, timeval) in
    let sendResult =
        if receiveResult < 0 then receiveResult
        else Stdlib.__Network.__sendTimeout(descriptor, timeval) in
    let _ = __raw_free_sized(timeval, 16) in
    if sendResult < 0 then Error(0 - sendResult) else Ok()

let __writeAll(descriptor: Int64, lifecycle: Stream<Unit>, payload: Blob): Stdlib.Result.Result<Unit, Int64> =
    match Stdlib.Stream.next(lifecycle) with
    | None -> Error(9)
    | Some(_) ->
        let length = Stdlib.Blob.__byteLength(payload) in
        if length == 0 then Ok()
        else
            let sent = Stdlib.__Network.__send(descriptor, payload) in
            if sent < 0 then Error(0 - sent)
            else if sent == 0 then Error(32)
            else if sent >= length then Ok()
            else
                let remaining = Stdlib.Blob.slice(payload, Stdlib.Int.fromInt64(sent),
                                    Stdlib.Int.fromInt64(length - sent)) in
                Stdlib.__Network.__writeAll(descriptor, lifecycle, remaining)

let __readChunk(descriptor: Int64, lifecycle: Stream<Unit>, length: Int64): Stdlib.Result.Result<Blob, Int64> =
    if length <= 0 || length > 4096 then Error(22)
    else
        match Stdlib.Stream.next(lifecycle) with
        | None -> Error(9)
        | Some(_) ->
            let buffer = __raw_alloc(length) in
            let received = Stdlib.__Network.__receive(descriptor, buffer, length) in
            let result =
                if received < 0 then Error(0 - received)
                else Ok(Stdlib.__Network.__copyReceived(buffer, 0, received, [])) in
            let _ = __raw_free_sized(buffer, length) in
            result

let __connectTcp(ipv6: Bool, address: List<Int64>, port: Int64, timeoutMs: Int64): Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> =
    if Stdlib.Bool.not(Stdlib.__Network.__validAddress(ipv6, address)) ||
        port <= 0 || port > 65535 || timeoutMs <= 0 || timeoutMs > 10000 then Error(22)
    else
        let descriptor = if ipv6 then Stdlib.__Network.__tcp6Socket() else Stdlib.__Network.__tcp4Socket() in
        if descriptor < 0 then Error(0 - descriptor)
        else
            let lifecycle =
                Stdlib.Stream.__new(
                    (fun _unit -> Some()),
                    fun _unit -> let _ = Stdlib.__Network.__close(descriptor) in ()) in
            match Stdlib.__Network.__setTimeout(descriptor, timeoutMs) with
            | Error(code) ->
                let _ = Stdlib.Stream.close(lifecycle) in
                Error(code)
            | Ok() ->
                let sockaddr = Stdlib.__Network.__socketAddress(ipv6, address, port) in
                let connected =
                    if ipv6 then Stdlib.__Network.__connect6(descriptor, sockaddr)
                    else Stdlib.__Network.__connect4(descriptor, sockaddr) in
                let _ = __raw_free_sized(sockaddr, if ipv6 then 32 else 16) in
                if connected < 0 then
                    let _ = Stdlib.Stream.close(lifecycle) in
                    Error(0 - connected)
                else
                    let read = Stdlib.__Network.__readChunk(descriptor, lifecycle) in
                    let write = Stdlib.__Network.__writeAll(descriptor, lifecycle) in
                    Ok(Stdlib.__Network.TcpConnection { lifecycle = lifecycle,
                        watch = Some(Stdlib.__Network.Watch { descriptor = descriptor, lifecycle = lifecycle }),
                        read = read, write = write })

let connectTcp4(address: List<Int64>, port: Int64, timeoutMs: Int64): Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> =
    Stdlib.__Network.__connectTcp(false, address, port, timeoutMs)

let connectTcp6(address: List<Int64>, port: Int64, timeoutMs: Int64): Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> =
    Stdlib.__Network.__connectTcp(true, address, port, timeoutMs)

let closeTcp(connection: Stdlib.__Network.TcpConnection): Unit =
    Stdlib.Stream.close(connection.lifecycle)

let writeTcp(connection: Stdlib.__Network.TcpConnection, payload: Blob): Stdlib.Result.Result<Unit, Int64> =
    connection.write payload

let readTcp(connection: Stdlib.__Network.TcpConnection, length: Int64): Stdlib.Result.Result<Blob, Int64> =
    connection.read length

// Per-call nonblocking I/O does not change the descriptor mode used by existing
// blocking handshake/read helpers. None means retry after readiness, not EOF.
let pollReadTcp(connection: Stdlib.__Network.TcpConnection): Stdlib.Result.Result<Stdlib.Option.Option<Blob>, Int64> =
    match Stdlib.Stream.next(connection.lifecycle) with
    | None -> Error(9)
    | Some(_) -> match connection.watch with
      | None -> Error(22)
      | Some(watch) ->
        let buffer = __raw_alloc(4096) in
        let received = Stdlib.__Network.__receiveWithMode(watch.descriptor, buffer, 4096, true) in
        let result =
          if received == -4 || received == -11 || received == -35 then Ok(None)
          else if received < 0 then Error(0 - received)
          else Ok(Some(Stdlib.__Network.__copyReceived(buffer, 0, received, []))) in
        let _ = __raw_free_sized(buffer, 4096) in result

let pollWriteTcp(connection: Stdlib.__Network.TcpConnection, payload: Blob): Stdlib.Result.Result<Stdlib.Option.Option<Int64>, Int64> =
    match Stdlib.Stream.next(connection.lifecycle) with
    | None -> Error(9)
    | Some(_) -> match connection.watch with
      | None -> Error(22)
      | Some(watch) ->
        let length = Stdlib.Blob.__byteLength(payload) in
        if length > 16384 then Error(22)
        else if length == 0 then Ok(Some(0))
        else
          let sent = Stdlib.__Network.__sendWithMode(watch.descriptor, payload, true) in
          if sent == -4 || sent == -11 || sent == -35 then Ok(None)
          else if sent < 0 then Error(0 - sent)
          else if sent == 0 then Error(32)
          else Ok(Some(sent))

let __word(buffer: RawPtr, offset: Int64): Int64 = __raw_get(buffer, offset)

let monotonicMillis(): Stdlib.Result.Result<Int64, Int64> =
    let buffer = __raw_alloc(16) in
    let code = Stdlib.__Network.__monotonic(buffer) in
    let result =
        if code < 0 then Error(0 - code)
        else
            let seconds = Stdlib.__Network.__word(buffer, 0) in
            let nanos = Stdlib.__Network.__word(buffer, 8) in
            Ok(seconds * 1000 + nanos / 1000000) in
    let _ = __raw_free_sized(buffer, 16) in
    result

// Signal masks belong to the serving scope and are restored on its last-owner
// release. Blocking rather than an async handler keeps shutdown state in Dark.
type ShutdownSignals = { lifecycle: Stream<Unit> }

let shutdownSignals(): Stdlib.Result.Result<Stdlib.__Network.ShutdownSignals, Int64> =
    let mask = __raw_alloc(8) in
    let previous = __raw_alloc(8) in
    let _ = __raw_write_word(mask, 0, 16386) in
    let _ = __raw_write_word(previous, 0, 0) in
    let code = Stdlib.__Network.__signalBlock(mask, previous) in
    let _ = __raw_free(mask) in
    if code < 0 then
        let _ = __raw_free(previous) in
        Error(0 - code)
    else
        let lifecycle = Stdlib.Stream.__new((fun _ -> Some()), fun _ -> let _ = Stdlib.__Network.__consumeShutdown(false) in let _ = Stdlib.__Network.__signalRestore(previous) in __raw_free(previous)) in
        Ok(Stdlib.__Network.ShutdownSignals { lifecycle = lifecycle })

let __consumeShutdown(seen: Bool): Stdlib.Result.Result<Bool, Int64> =
    let mask = __raw_alloc(8) in
    let _ = __raw_write_word(mask, 0, 0) in
    let code = Stdlib.__Network.__signalPending(mask) in
    let pending = Stdlib.__Network.__word(mask, 0) in
    let _ = __raw_write_word(mask, 0, 16386) in
    if code < 0 then
        let _ = __raw_free(mask) in
        Error(0 - code)
    else if Stdlib.Int64.bitwiseAnd(pending, 16386) == 0 then
        let _ = __raw_free(mask) in
        Ok(seen)
    else
        let info = __raw_alloc(128) in
        let waited = Stdlib.__Network.__signalWait(mask, info) in
        let _ = __raw_free_sized(info, 128) in
        let _ = __raw_free(mask) in
        if waited < 0 then Error(0 - waited)
        else Stdlib.__Network.__consumeShutdown(true)

let shutdownRequested(signals: Stdlib.__Network.ShutdownSignals): Stdlib.Result.Result<Bool, Int64> =
    match Stdlib.Stream.next(signals.lifecycle) with
    | None -> Error(9)
    | Some(_) -> Stdlib.__Network.__consumeShutdown(false)

let closeShutdownSignals(signals: Stdlib.__Network.ShutdownSignals): Unit =
    Stdlib.Stream.close(signals.lifecycle)

type TcpListener = {
    lifecycle: Stream<Unit>,
    watch: Stdlib.__Network.Watch,
    accept: Int64 -> Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64>,
    wait: Unit -> Stdlib.Result.Result<Bool, Int64>
}

let __waitReadable(descriptor: Int64, lifecycle: Stream<Unit>): Stdlib.Result.Result<Bool, Int64> =
    match Stdlib.Stream.next(lifecycle) with
    | None -> Error(9)
    | Some(_) ->
        let pollfd = __raw_alloc(8) in
        let timeout = __raw_alloc(16) in
        let _ = __raw_write_word(pollfd, 0, descriptor + 4294967296) in
        let _ = __raw_write_word(timeout, 0, 0) in
        let _ = __raw_write_word(timeout, 8, 100000000) in
        let code = Stdlib.__Network.__poll(pollfd, timeout) in
        let events = Stdlib.__Network.__word(pollfd, 0) in
        let _ = __raw_free(pollfd) in
        let _ = __raw_free_sized(timeout, 16) in
        if code < 0 then Error(0 - code)
        else if code == 0 then Ok(false)
        else if Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(events, 48), 1) == 1 then Ok(true)
        else Error(9)

let __writeUntil(descriptor: Int64, lifecycle: Stream<Unit>, deadline: Int64, payload: Blob): Stdlib.Result.Result<Unit, Int64> =
    match Stdlib.Stream.next(lifecycle) with
    | None -> Error(9)
    | Some(_) ->
        match Stdlib.__Network.monotonicMillis() with
        | Error(code) -> Error(code)
        | Ok(now) ->
            if now >= deadline then Error(110)
            else if Stdlib.Blob.__byteLength(payload) == 0 then Ok()
            else
                let sent = Stdlib.__Network.__send(descriptor, payload) in
                if sent == -4 || sent == -11 || sent == -35 then
                    Stdlib.__Network.__writeUntil(descriptor, lifecycle, deadline, payload)
                else if sent < 0 then Error(0 - sent)
                else if sent == 0 then Error(32)
                else if sent >= Stdlib.Blob.__byteLength(payload) then Ok()
                else
                    let remaining = Stdlib.Blob.slice(payload, Stdlib.Int.fromInt64(sent), Stdlib.Int.fromInt64(Stdlib.Blob.__byteLength(payload) - sent)) in
                    Stdlib.__Network.__writeUntil(descriptor, lifecycle, deadline, remaining)

let __writeAccepted(descriptor: Int64, lifecycle: Stream<Unit>, payload: Blob): Stdlib.Result.Result<Unit, Int64> =
    match Stdlib.__Network.monotonicMillis() with
    | Error(code) -> Error(code)
    | Ok(now) -> Stdlib.__Network.__writeUntil(descriptor, lifecycle, now + 10000, payload)

let __acceptTcp(descriptor: Int64, lifecycle: Stream<Unit>, timeoutMs: Int64): Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> =
    if timeoutMs <= 0 || timeoutMs > 10000 then Error(22)
    else
        match Stdlib.Stream.next(lifecycle) with
        | None -> Error(9)
        | Some(_) ->
            match Stdlib.__Network.__setTimeout(descriptor, timeoutMs) with
            | Error(code) -> Error(code)
            | Ok() ->
                let accepted = Stdlib.__Network.__accept(descriptor) in
                if accepted < 0 then Error(0 - accepted)
                else
                    let owner = Stdlib.Stream.__new((fun _ -> Some()), fun _ -> let _ = Stdlib.__Network.__close(accepted) in ()) in
                    let flags = Stdlib.__Network.__cloexec(accepted) in
                    let setup =
                        if flags < 0 then Error(0 - flags)
                        else Stdlib.__Network.__setTimeout(accepted, timeoutMs) in
                    match setup with
                    | Error(code) -> let _ = Stdlib.Stream.close(owner) in Error(code)
                    | Ok() -> Ok(Stdlib.__Network.TcpConnection {
                        lifecycle = owner,
                        watch = Some(Stdlib.__Network.Watch { descriptor = accepted, lifecycle = owner }),
                        read = Stdlib.__Network.__readChunk(accepted, owner),
                        write = Stdlib.__Network.__writeAccepted(accepted, owner)
                    })

let __listenTcp(ipv6: Bool, address: List<Int64>, port: Int64): Stdlib.Result.Result<Stdlib.__Network.TcpListener, Int64> =
    if Stdlib.Bool.not(Stdlib.__Network.__validAddress(ipv6, address)) || port < 0 || port > 65535 then Error(22)
    else
        let descriptor = if ipv6 then Stdlib.__Network.__tcp6Socket() else Stdlib.__Network.__tcp4Socket() in
        if descriptor < 0 then Error(0 - descriptor)
        else
            let lifecycle = Stdlib.Stream.__new((fun _ -> Some()), fun _ -> let _ = Stdlib.__Network.__close(descriptor) in ()) in
            let enabled = __raw_alloc(8) in
            let _ = __raw_write_word(enabled, 0, 1) in
            let reused = Stdlib.__Network.__reuseAddress(descriptor, enabled) in
            let _ = __raw_free(enabled) in
            let sockaddr = Stdlib.__Network.__socketAddress(ipv6, address, port) in
            let bound = if reused < 0 then reused else if ipv6 then Stdlib.__Network.__bind6(descriptor, sockaddr) else Stdlib.__Network.__bind4(descriptor, sockaddr) in
            let _ = __raw_free_sized(sockaddr, if ipv6 then 32 else 16) in
            let listening = if bound < 0 then bound else Stdlib.__Network.__listen(descriptor) in
            if listening < 0 then
                let _ = Stdlib.Stream.close(lifecycle) in
                Error(0 - listening)
            else Ok(Stdlib.__Network.TcpListener {
                lifecycle = lifecycle,
                watch = Stdlib.__Network.Watch { descriptor = descriptor, lifecycle = lifecycle },
                accept = Stdlib.__Network.__acceptTcp(descriptor, lifecycle),
                wait = fun _ -> Stdlib.__Network.__waitReadable(descriptor, lifecycle)
            })

let listenTcp4(address: List<Int64>, port: Int64): Stdlib.Result.Result<Stdlib.__Network.TcpListener, Int64> =
    Stdlib.__Network.__listenTcp(false, address, port)

let listenTcp6(address: List<Int64>, port: Int64): Stdlib.Result.Result<Stdlib.__Network.TcpListener, Int64> =
    Stdlib.__Network.__listenTcp(true, address, port)

let acceptTcp(listener: Stdlib.__Network.TcpListener, timeoutMs: Int64): Stdlib.Result.Result<Stdlib.__Network.TcpConnection, Int64> = listener.accept timeoutMs

let waitListener(listener: Stdlib.__Network.TcpListener): Stdlib.Result.Result<Bool, Int64> = listener.wait ()

let closeListener(listener: Stdlib.__Network.TcpListener): Unit = Stdlib.Stream.close(listener.lifecycle)

let __pollEntries(entries: List<Stdlib.__Network.Interest>, buffer: RawPtr, index: Int64, closed: List<Stdlib.__Network.Ready>): List<Stdlib.__Network.Ready> =
    match entries with
    | [] -> Stdlib.List.reverse(closed)
    | entry :: rest ->
        match Stdlib.Stream.next(entry.watch.lifecycle) with
        | None ->
            let _ = __raw_write_word(buffer, index * 8, 4294967295) in
            Stdlib.__Network.__pollEntries(rest, buffer, index + 1,
                Stdlib.List.push(closed, Stdlib.__Network.Ready {
                    index = index, readable = false, writable = false, closed = true, failed = false }))
        | Some(_) ->
            let events = (if entry.readable then 1 else 0) + (if entry.writable then 4 else 0) in
            let _ = __raw_write_word(buffer, index * 8, entry.watch.descriptor + events * 4294967296) in
            Stdlib.__Network.__pollEntries(rest, buffer, index + 1, closed)

let __pollResults(buffer: RawPtr, count: Int64, index: Int64, ready: List<Stdlib.__Network.Ready>): List<Stdlib.__Network.Ready> =
    if index == count then Stdlib.List.reverse(ready)
    else
        let word = Stdlib.__Network.__word(buffer, index * 8) in
        let events = Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(word, 48), 65535) in
        let readable = Stdlib.Int64.bitwiseAnd(events, 1) != 0 in
        let writable = Stdlib.Int64.bitwiseAnd(events, 4) != 0 in
        let closed = Stdlib.Int64.bitwiseAnd(events, 16) != 0 in
        let failed = Stdlib.Int64.bitwiseAnd(events, 40) != 0 in
        let ready = if events == 0 then ready else Stdlib.List.push(ready, Stdlib.__Network.Ready { index = index, readable = readable, writable = writable, closed = closed, failed = failed }) in
        Stdlib.__Network.__pollResults(buffer, count, index + 1, ready)

// One kernel wait covers TCP listeners, accepted sockets and UDP together.
// Closed owners wake immediately; empty sets still support timer deadlines.
let waitSockets(entries: List<Stdlib.__Network.Interest>, milliseconds: Int64): Stdlib.Result.Result<List<Stdlib.__Network.Ready>, Int64> =
    let count = Stdlib.List.__lengthInt(entries) in
    if milliseconds < 0 || milliseconds > 60000 || count > 1024z ||
        Stdlib.List.any(entries, fun entry -> entry.watch.descriptor < 0 || entry.watch.descriptor > 2147483647) then Error(22)
    else
        let length = Stdlib.Int64.__fromIntUnchecked(count) in
        let buffer = __raw_alloc(if length == 0 then 8 else length * 8) in
        let timeout = __raw_alloc(16) in
        let closed = Stdlib.__Network.__pollEntries(entries, buffer, 0, []) in
        let duration = if closed == [] then milliseconds else 0 in
        let _ = __raw_write_word(timeout, 0, duration / 1000) in
        let _ = __raw_write_word(timeout, 8, (duration % 1000) * 1000000) in
        let code = Stdlib.__Network.__pollMany(buffer, length, timeout) in
        let ready = if code < 0 then Error(0 - code) else Ok(Stdlib.List.sortBy(closed @ Stdlib.__Network.__pollResults(buffer, length, 0, []), fun event -> event.index)) in
        let _ = __raw_free_sized(timeout, 16) in
        let _ = __raw_free_sized(buffer, if length == 0 then 8 else length * 8) in
        ready

let __udpExchange(descriptor: Int64, lifecycle: Stream<Unit>, ipv6: Bool, address: List<Int64>, port: Int64, payload: Blob, timeoutMs: Int64): Stdlib.Result.Result<Blob, Int64> =
    if Stdlib.Bool.not(Stdlib.__Network.__validAddress(ipv6, address)) ||
        port <= 0 || port > 65535 || timeoutMs <= 0 || timeoutMs > 10000 then Error(22)
    else if Stdlib.Blob.__byteLength(payload) == 0 || Stdlib.Blob.__byteLength(payload) > 4096 then Error(90)
    else
        match Stdlib.Stream.next(lifecycle) with
        | None -> Error(9)
        | Some(_) ->
            let sockaddr = Stdlib.__Network.__socketAddress(ipv6, address, port) in
            let connected =
                if ipv6 then Stdlib.__Network.__connect6(descriptor, sockaddr)
                else Stdlib.__Network.__connect4(descriptor, sockaddr) in
            let _ = __raw_free_sized(sockaddr, if ipv6 then 32 else 16) in
            if connected < 0 then Error(0 - connected)
            else
                let timeval = __raw_alloc(16) in
                let _ = __raw_write_word(timeval, 0, timeoutMs / 1000) in
                let _ = __raw_write_word(timeval, 8, (timeoutMs % 1000) * 1000) in
                let timed = Stdlib.__Network.__receiveTimeout(descriptor, timeval) in
                let _ = __raw_free_sized(timeval, 16) in
                if timed < 0 then Error(0 - timed)
                else
                    let sent = Stdlib.__Network.__send(descriptor, payload) in
                    if sent < 0 then Error(0 - sent)
                    else if sent != Stdlib.Blob.__byteLength(payload) then Error(90)
                    else
                        let buffer = __raw_alloc(4097) in
                        let received = Stdlib.__Network.__receive(descriptor, buffer, 4097) in
                        let result =
                            if received < 0 then Error(0 - received)
                            else if received > 4096 then Error(90)
                            else Ok(Stdlib.__Network.__copyReceived(buffer, 0, received, [])) in
                        let _ = __raw_free_sized(buffer, 4097) in
                        result

let openUdp4(): Stdlib.Result.Result<Stdlib.__Network.UdpSocket, Int64> =
    let descriptor = Stdlib.__Network.__udp4Socket() in
    if descriptor < 0 then Error(0 - descriptor)
    else
        let lifecycle =
            Stdlib.Stream.__new(
                (fun _unit -> Some()),
                fun _unit -> let _ = Stdlib.__Network.__close(descriptor) in ()) in
        let exchange4 = Stdlib.__Network.__udpExchange(descriptor, lifecycle, false) in
        Ok(Stdlib.__Network.UdpSocket { lifecycle = lifecycle, exchange4 = exchange4 })

let closeUdp(socket: Stdlib.__Network.UdpSocket): Unit =
    Stdlib.Stream.close(socket.lifecycle)

let exchangeUdp4(socket: Stdlib.__Network.UdpSocket, address: List<Int64>, port: Int64, payload: Blob, timeoutMs: Int64): Stdlib.Result.Result<Blob, Int64> =
    socket.exchange4 address port payload timeoutMs

let openUdp6(): Stdlib.Result.Result<Stdlib.__Network.Udp6Socket, Int64> =
    let descriptor = Stdlib.__Network.__udp6Socket() in
    if descriptor < 0 then Error(0 - descriptor)
    else
        let lifecycle =
            Stdlib.Stream.__new(
                (fun _unit -> Some()),
                fun _unit -> let _ = Stdlib.__Network.__close(descriptor) in ()) in
        let exchange6 = Stdlib.__Network.__udpExchange(descriptor, lifecycle, true) in
        Ok(Stdlib.__Network.Udp6Socket { lifecycle = lifecycle, exchange6 = exchange6 })

let closeUdp6(socket: Stdlib.__Network.Udp6Socket): Unit =
    Stdlib.Stream.close(socket.lifecycle)

let exchangeUdp6(socket: Stdlib.__Network.Udp6Socket, address: List<Int64>, port: Int64, payload: Blob, timeoutMs: Int64): Stdlib.Result.Result<Blob, Int64> =
    socket.exchange6 address port payload timeoutMs
