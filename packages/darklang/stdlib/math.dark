// Stdlib.Math.dark - portable deterministic Float mathematics.

module Darklang.Stdlib.Math

val pi = 3.141592653589793
val tau = 6.283185307179586

val e = 2.718281828459045
let degrees (angleInDegrees: Float) : Float =
  (angleInDegrees * Stdlib.Math.pi)
  |> (/) 180.0

let turns (angleInTurns: Float) : Float =
  Stdlib.Math.tau * angleInTurns
let radians (angleInRadians: Float) : Float = angleInRadians

// sin and cos as glibc 2.39 computes them with FMA, which is what .NET's Math.Sin
// and Math.Cos return under the interpreter on Linux x64 (and what the same
// source gives on arm64, where GCC contracts too): the table-driven kernels of
// sysdeps/ieee754/dbl-64/s_sin.c with each multiply-add GCC contracts rounded
// once, and __branred's reduction past 2^27 * pi/2. The fused multiply-add is
// emulated exactly in double arithmetic. Each helper takes and returns Floats so
// that nothing is allocated, except the rare __branred path.

// The rounding error of a + b.
let __sumError (a: Float) (b: Float) : Float =
    let s = a + b in
    let bb = s - a in
    (a - (s - bb)) + (b - bb)

let __splitHigh (a: Float) : Float =
    let c = 134217729.0 * a in
    c - (c - a)

// The rounding error of a * b.
let __productError (a: Float) (b: Float) : Float =
    let ah = Stdlib.Math.__splitHigh a in
    let al = a - ah in
    let bh = Stdlib.Math.__splitHigh b in
    let bl = b - bh in
    ((ah * bh - a * b) + ah * bl + al * bh) + al * bl

// a * b + c rounded once. The exact sum p + pl + c is summed as th + (tl + pl);
// the second rounding can only go wrong when th + v is exactly halfway between
// two Floats, and the bits lost from v then decide it.
let __fma (a: Float) (b: Float) (c: Float) : Float =
    let p = a * b in
    let pl = Stdlib.Math.__productError a b in
    let th = c + p in
    let tl = Stdlib.Math.__sumError c p in
    let v = tl + pl in
    let lost = Stdlib.Math.__sumError tl pl in
    let r = th + v in
    let err = Stdlib.Math.__sumError th v in
    let step = 2.0 * err in
    if lost != 0.0 && err != 0.0 && r + step != r && Stdlib.Math.__sumError r step == 0.0 && (lost > 0.0) == (err > 0.0) then
        r + step
    else r

let __copySign (magnitude: Float) (sign: Float) : Float =
    let m = Stdlib.Float.absoluteValue magnitude in
    if sign < 0.0 then Stdlib.Float.negate m else m

