// __X509Identity.dark - bounded DER leaf identity and DNS hostname checks.

module Darklang.Stdlib.__X509Identity

type Tlv = { tag: Int64, content: Int64, end_: Int64 }
// Name and time checks on this type do not authenticate a certificate chain.
type UnverifiedLeafIdentity = { notBefore: Int64, notAfter: Int64, dnsNames: List<String> }

let __readLengthBytes (data: Blob) (index: Int64) (remaining: Int64)
  (value: Int64) : Int64 =
  if remaining == 0 then value
  else Stdlib.__X509Identity.__readLengthBytes data (index + 1) (remaining - 1)
         (value * 256 + Stdlib.Blob.__getByte data index)

// DER uses definite, shortest-form lengths. The limit is the enclosing value.
let __tlv (data: Blob) (offset: Int64) (limit: Int64)
  : Stdlib.Result.Result<Stdlib.__X509Identity.Tlv, String> =
  if offset < 0 || offset + 2 > limit then Error "Truncated DER value"
  else
    let marker = Stdlib.Blob.__getByte data (offset + 1) in
    let count = Stdlib.Int64.bitwiseAnd marker 127 in
    let longForm = marker >= 128 in
    if Stdlib.Int64.bitwiseAnd (Stdlib.Blob.__getByte data offset) 31 == 31 then
      Error "Unsupported DER tag number"
    else if longForm && (count == 0 || count > 4 || offset + 2 + count > limit) then
      Error "Invalid DER length"
    else
      let length =
        if longForm then Stdlib.__X509Identity.__readLengthBytes data (offset + 2) count 0
        else marker in
      let content = if longForm then offset + 2 + count else offset + 2 in
      let minimum = if count == 1 then 128 else if count == 2 then 256
                    else if count == 3 then 65536 else 16777216 in
      if longForm && length < minimum then Error "Non-canonical DER length"
      else if length > limit - content then Error "DER value exceeds parent"
      else Ok (Stdlib.__X509Identity.Tlv {
        tag = Stdlib.Blob.__getByte data offset,
        content = content,
        end_ = content + length })

let __expect (data: Blob) (offset: Int64) (limit: Int64) (tag: Int64)
  : Stdlib.Result.Result<Stdlib.__X509Identity.Tlv, String> =
  match Stdlib.__X509Identity.__tlv data offset limit with
  | Error message -> Error message
  | Ok item -> if item.tag == tag then Ok item else Error "Unexpected DER tag"

let __slice (data: Blob) (start: Int64) (end_: Int64) : Blob =
  Stdlib.Blob.slice data (Stdlib.Int.fromInt64 start)
    (Stdlib.Int.fromInt64 (end_ - start))

let __digit (data: Blob) (index: Int64) : Int64 =
  Stdlib.Blob.__getByte data index - 48

let __digits (data: Blob) (start: Int64) (count: Int64)
  (index: Int64) (value: Int64) : Int64 =
  if index == count then value
  else Stdlib.__X509Identity.__digits data start count (index + 1)
         (value * 10 + Stdlib.__X509Identity.__digit data (start + index))

let __allDigits (data: Blob) (start: Int64) (count: Int64) (index: Int64) : Bool =
  if index == count then true
  else
    let byte = Stdlib.Blob.__getByte data (start + index) in
    byte >= 48 && byte <= 57 &&
    Stdlib.__X509Identity.__allDigits data start count (index + 1)

let __leap (year: Int64) : Bool =
  year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)

let __daysInMonth (year: Int64) (month: Int64) : Int64 =
  if month == 2 then if Stdlib.__X509Identity.__leap year then 29 else 28
  else if month == 4 || month == 6 || month == 9 || month == 11 then 30
  else 31

let __timestamp (year: Int64) (month: Int64) (day: Int64)
  (hour: Int64) (minute: Int64) (second: Int64) : Int64 =
  (((((year * 100 + month) * 100 + day) * 100 + hour) * 100 + minute) * 100 + second)

let __time (data: Blob) (item: Stdlib.__X509Identity.Tlv)
  : Stdlib.Result.Result<Int64, String> =
  let length = item.end_ - item.content in
  let digits = if item.tag == 23 then 12 else 14 in
  if (item.tag != 23 && item.tag != 24) || length != digits + 1 ||
     Stdlib.Blob.__getByte data (item.end_ - 1) != 90 ||
     Stdlib.Bool.not (Stdlib.__X509Identity.__allDigits data item.content digits 0) then
    Error "Invalid X.509 validity time"
  else
    let yearDigits = if item.tag == 23 then 2 else 4 in
    let encodedYear = Stdlib.__X509Identity.__digits data item.content yearDigits 0 0 in
    let year =
      if item.tag == 23 then
        if encodedYear >= 50 then 1900 + encodedYear else 2000 + encodedYear
      else encodedYear in
    let month = Stdlib.__X509Identity.__digits data (item.content + yearDigits) 2 0 0 in
    let day = Stdlib.__X509Identity.__digits data (item.content + yearDigits + 2) 2 0 0 in
    let hour = Stdlib.__X509Identity.__digits data (item.content + yearDigits + 4) 2 0 0 in
    let minute = Stdlib.__X509Identity.__digits data (item.content + yearDigits + 6) 2 0 0 in
    let second = Stdlib.__X509Identity.__digits data (item.content + yearDigits + 8) 2 0 0 in
    if year == 0 || month < 1 || month > 12 || day < 1 ||
       day > Stdlib.__X509Identity.__daysInMonth year month || hour > 23 ||
       minute > 59 || second > 59 then
      Error "Invalid X.509 calendar date"
    else Ok (Stdlib.__X509Identity.__timestamp year month day hour minute second)

let __validity (data: Blob) (item: Stdlib.__X509Identity.Tlv)
  : Stdlib.Result.Result<(Int64 * Int64), String> =
  match Stdlib.__X509Identity.__tlv data item.content item.end_ with
  | Error message -> Error message
  | Ok first ->
      match Stdlib.__X509Identity.__tlv data first.end_ item.end_ with
      | Error message -> Error message
      | Ok second ->
          if second.end_ != item.end_ then Error "Trailing X.509 validity data"
          else
            match (Stdlib.__X509Identity.__time data first,
                   Stdlib.__X509Identity.__time data second) with
            | (Ok before, Ok after) ->
                if before <= after then Ok ((before, after))
                else Error "Reversed X.509 validity interval"
            | _ -> Error "Invalid X.509 validity time"

let __validLabel (name: String) (index: Int64) (labelStart: Int64)
  (wildcard: Bool) : Bool =
  let length = Stdlib.String.__byteLength name in
  if index == length || Stdlib.String.__byteAtUnchecked name index == 46 then
    let labelLength = index - labelStart in
    if labelLength == 0 || labelLength > 63 ||
       Stdlib.String.__byteAtUnchecked name (index - 1) == 45 then false
    else if index == length then true
    else Stdlib.__X509Identity.__validLabel name (index + 1) (index + 1) false
  else
    let byte = Stdlib.String.__byteAtUnchecked name index in
    let isLetter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) in
    let isDigit = byte >= 48 && byte <= 57 in
    if (byte == 42 && wildcard && index == 0 &&
        index + 1 < length && Stdlib.String.__byteAtUnchecked name 1 == 46) ||
       isLetter || isDigit ||
       (byte == 45 && index > labelStart) then
      Stdlib.__X509Identity.__validLabel name (index + 1) labelStart wildcard
    else false

let __validName (name: String) (wildcard: Bool) : Bool =
  let length = Stdlib.String.__byteLength name in
  length > 0 && length <= 253 &&
  Stdlib.__X509Identity.__validLabel name 0 0 wildcard

let __generalNames (data: Blob) (position: Int64) (end_: Int64)
  (names: List<String>) : Stdlib.Result.Result<List<String>, String> =
  if position == end_ then Ok (Stdlib.List.reverse names)
  else
    match Stdlib.__X509Identity.__tlv data position end_ with
    | Error message -> Error message
    | Ok entry ->
        if entry.tag == 130 then
          let bytes = Stdlib.__X509Identity.__slice data entry.content entry.end_ in
          match Stdlib.String.fromBlob bytes with
          | None -> Error "Invalid X.509 DNS name"
          | Some name ->
              if Stdlib.Bool.not (Stdlib.__X509Identity.__validName name true) then
                Error "Invalid X.509 DNS name"
              else Stdlib.__X509Identity.__generalNames data entry.end_ end_
                     (Stdlib.List.push names name)
        else Stdlib.__X509Identity.__generalNames data entry.end_ end_ names

let __san (data: Blob) (octets: Stdlib.__X509Identity.Tlv)
  : Stdlib.Result.Result<List<String>, String> =
  match Stdlib.__X509Identity.__expect data octets.content octets.end_ 48 with
  | Error message -> Error message
  | Ok names ->
      if names.end_ != octets.end_ then Error "Trailing subjectAltName data"
      else Stdlib.__X509Identity.__generalNames data names.content names.end_ []

let __isSanOid (data: Blob) (oid: Stdlib.__X509Identity.Tlv) : Bool =
  oid.end_ - oid.content == 3 &&
  Stdlib.Blob.__getByte data oid.content == 85 &&
  Stdlib.Blob.__getByte data (oid.content + 1) == 29 &&
  Stdlib.Blob.__getByte data (oid.content + 2) == 17

let __extension (data: Blob) (item: Stdlib.__X509Identity.Tlv)
  : Stdlib.Result.Result<Stdlib.Option.Option<List<String>>, String> =
  match Stdlib.__X509Identity.__expect data item.content item.end_ 6 with
  | Error message -> Error message
  | Ok oid ->
      match Stdlib.__X509Identity.__tlv data oid.end_ item.end_ with
      | Error message -> Error message
      | Ok next ->
          let valueStart = if next.tag == 1 then next.end_ else oid.end_ in
          if next.tag == 1 &&
             (next.end_ - next.content != 1 ||
              Stdlib.Blob.__getByte data next.content != 255) then
            Error "Invalid X.509 critical extension flag"
          else match Stdlib.__X509Identity.__expect data valueStart item.end_ 4 with
          | Error message -> Error message
          | Ok octets ->
              if octets.end_ != item.end_ then Error "Trailing X.509 extension data"
              else if Stdlib.__X509Identity.__isSanOid data oid then
                match Stdlib.__X509Identity.__san data octets with
                | Error message -> Error message
                | Ok names -> Ok (Some names)
              else Ok None

let __extensions (data: Blob) (position: Int64) (end_: Int64)
  (san: Stdlib.Option.Option<List<String>>)
  : Stdlib.Result.Result<List<String>, String> =
  if position == end_ then
    match san with
    | None -> Error "X.509 subjectAltName missing"
    | Some [] -> Error "X.509 DNS subjectAltName missing"
    | Some names -> Ok names
  else
    match Stdlib.__X509Identity.__expect data position end_ 48 with
    | Error message -> Error message
    | Ok extension ->
        match Stdlib.__X509Identity.__extension data extension with
        | Error message -> Error message
        | Ok None -> Stdlib.__X509Identity.__extensions data extension.end_ end_ san
        | Ok (Some names) ->
            match san with
            | Some _ -> Error "Duplicate X.509 subjectAltName"
            | None -> Stdlib.__X509Identity.__extensions data extension.end_ end_ (Some names)

let __findExtensions (data: Blob) (position: Int64) (end_: Int64)
  : Stdlib.Result.Result<List<String>, String> =
  if position == end_ then Error "X.509 subjectAltName missing"
  else
    match Stdlib.__X509Identity.__tlv data position end_ with
    | Error message -> Error message
    | Ok field ->
        if field.tag == 163 then
          match Stdlib.__X509Identity.__expect data field.content field.end_ 48 with
          | Error message -> Error message
          | Ok extensions ->
              if extensions.end_ != field.end_ || field.end_ != end_ then
                Error "Invalid X.509 extensions"
              else Stdlib.__X509Identity.__extensions data extensions.content extensions.end_ None
        else if field.tag == 129 || field.tag == 130 then
          Stdlib.__X509Identity.__findExtensions data field.end_ end_
        else Error "Unexpected X.509 certificate field"

let __tbs (data: Blob) (tbs: Stdlib.__X509Identity.Tlv)
  : Stdlib.Result.Result<Stdlib.__X509Identity.UnverifiedLeafIdentity, String> =
  let first =
    match Stdlib.__X509Identity.__tlv data tbs.content tbs.end_ with
    | Ok version ->
        if version.tag == 160 && version.end_ - version.content == 3 &&
           Stdlib.Blob.__getByte data version.content == 2 &&
           Stdlib.Blob.__getByte data (version.content + 1) == 1 &&
           Stdlib.Blob.__getByte data (version.content + 2) == 2 then
          version.end_
        else -1
    | Error _ -> -1 in
  if first < 0 then Error "X.509 v3 certificate required"
  else match Stdlib.__X509Identity.__expect data first tbs.end_ 2 with
  | Error message -> Error message
  | Ok serial ->
      match Stdlib.__X509Identity.__expect data serial.end_ tbs.end_ 48 with
      | Error message -> Error message
      | Ok signature ->
          match Stdlib.__X509Identity.__expect data signature.end_ tbs.end_ 48 with
          | Error message -> Error message
          | Ok issuer ->
              match Stdlib.__X509Identity.__expect data issuer.end_ tbs.end_ 48 with
              | Error message -> Error message
              | Ok validity ->
                  match Stdlib.__X509Identity.__expect data validity.end_ tbs.end_ 48 with
                  | Error message -> Error message
                  | Ok subject ->
                      match Stdlib.__X509Identity.__expect data subject.end_ tbs.end_ 48 with
                      | Error message -> Error message
                      | Ok spki ->
                          match Stdlib.__X509Identity.__validity data validity with
                          | Error message -> Error message
                          | Ok ((before, after)) ->
                              match Stdlib.__X509Identity.__findExtensions data spki.end_ tbs.end_ with
                              | Error message -> Error message
                              | Ok names ->
                                  Ok (Stdlib.__X509Identity.UnverifiedLeafIdentity {
                                    notBefore = before, notAfter = after, dnsNames = names })

let parseUnverifiedLeaf (certificate: Blob)
  : Stdlib.Result.Result<Stdlib.__X509Identity.UnverifiedLeafIdentity, String> =
  let length = Stdlib.Blob.__byteLength certificate in
  if length < 16 || length > 65536 then Error "Invalid X.509 certificate size"
  else
    match Stdlib.__X509Identity.__expect certificate 0 length 48 with
    | Error message -> Error message
    | Ok outer ->
        if outer.end_ != length then Error "Trailing X.509 certificate data"
        else
          match Stdlib.__X509Identity.__expect certificate outer.content outer.end_ 48 with
          | Error message -> Error message
          | Ok tbs ->
              match Stdlib.__X509Identity.__expect certificate tbs.end_ outer.end_ 48 with
              | Error message -> Error message
              | Ok algorithm ->
                  match Stdlib.__X509Identity.__expect certificate algorithm.end_ outer.end_ 3 with
                  | Error message -> Error message
                  | Ok signature ->
                      if signature.end_ != outer.end_ ||
                         signature.content == signature.end_ ||
                         Stdlib.Blob.__getByte certificate signature.content != 0 then
                        Error "Invalid X.509 signature field"
                      else Stdlib.__X509Identity.__tbs certificate tbs

let __hasDot (value: String) (index: Int64) : Bool =
  if index == Stdlib.String.__byteLength value then false
  else if Stdlib.String.__byteAtUnchecked value index == 46 then true
  else Stdlib.__X509Identity.__hasDot value (index + 1)

let __matches (pattern: String) (host: String) : Bool =
  let expected = Stdlib.String.toLowercase pattern in
  let actual = Stdlib.String.toLowercase host in
  if Stdlib.String.startsWith expected "*." then
    let suffix = Stdlib.String.__byteDrop expected 1 in
    if Stdlib.Bool.not (Stdlib.String.endsWith actual suffix) then false
    else
      let prefixLength = Stdlib.String.__byteLength actual - Stdlib.String.__byteLength suffix in
      let prefix = Stdlib.String.__byteTake actual prefixLength in
      Stdlib.__X509Identity.__validName prefix false &&
      Stdlib.Bool.not (Stdlib.String.startsWith prefix "xn--") &&
      Stdlib.Bool.not (Stdlib.__X509Identity.__hasDot prefix 0)
  else expected == actual

let __anyMatch (names: List<String>) (host: String) : Bool =
  match names with
  | [] -> false
  | name :: rest ->
      Stdlib.__X509Identity.__matches name host ||
      Stdlib.__X509Identity.__anyMatch rest host

let __dateNumber (date: DateTime) : Int64 =
  Stdlib.__X509Identity.__timestamp
    (Stdlib.DateTime.__intToInt64 (Stdlib.DateTime.__yearInt date))
    (Stdlib.DateTime.__intToInt64 (Stdlib.DateTime.__monthInt date))
    (Stdlib.DateTime.__intToInt64 (Stdlib.DateTime.__dayInt date))
    (Stdlib.DateTime.__intToInt64 (Stdlib.DateTime.__hourInt date))
    (Stdlib.DateTime.__intToInt64 (Stdlib.DateTime.__minuteInt date))
    (Stdlib.DateTime.__intToInt64 (Stdlib.DateTime.__secondInt date))

// This checks identity metadata only. Chain signatures and trust must be
// verified before the result can authorize HTTPS application data.
let checkUnverifiedHostnameAt (leaf: Stdlib.__X509Identity.UnverifiedLeafIdentity)
  (host: String) (date: DateTime) : Stdlib.Result.Result<Unit, String> =
  if Stdlib.Bool.not (Stdlib.__X509Identity.__validName host false) then
    Error "Invalid DNS hostname"
  else
    let current = Stdlib.__X509Identity.__dateNumber date in
    if current < leaf.notBefore || current > leaf.notAfter then
      Error "X.509 certificate is outside its validity interval"
    else if Stdlib.Bool.not (Stdlib.__X509Identity.__anyMatch leaf.dnsNames host) then
      Error "X.509 certificate does not match hostname"
    else Ok ()
