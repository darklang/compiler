// HttpServerConfig.dark - Upstream HTTP serving configuration and defaults.

module Darklang.Stdlib.HttpServer

module Config =

  type Config =
    { address: String
      port: Stdlib.Net.Port
      /// Maximum request body size in bytes (over-limit → 413).
      maxBodyBytes: Int64
      /// Auto-add `Server: darklang` + HSTS unless the handler set them.
      injectStandardHeaders: Bool
      /// Rewrite request.url to https:// when X-Forwarded-Proto: https is present.
      canonicalizeFromForwardedProto: Bool
      /// Emit a per-request stdout line + telemetry event.
      logRequests: Bool }

  val defaultMaxBodyBytes = 31457280L

  let defaults (port: Stdlib.Net.Port) : Config =
    Config
      { address = "127.0.0.1"
        port = port
        maxBodyBytes = defaultMaxBodyBytes
        injectStandardHeaders = true
        canonicalizeFromForwardedProto = true
        logRequests = true }
