// Tls13.dark - TLS 1.3 key derivation and bounded record framing.

module Darklang.Stdlib.__Tls13

type Record = { contentType: Int64, payload: Blob, remaining: Blob }

type ServerHello = { random: Blob, keyShare: Blob, cipherSuite: Int64, remaining: Blob }

type TrafficKeys = { key: Blob, iv: Blob, sequence: Int64, cipherSuite: Int64 }
type OpenedRecord = { contentType: Int64, content: Blob, nextKeys: Stdlib.__Tls13.TrafficKeys }
type SealedRecord = { bytes: Blob, nextKeys: Stdlib.__Tls13.TrafficKeys }

type RecordError =
  | Incomplete
  | Invalid of String

let hkdfExtract(salt: Blob, inputKeyMaterial: Blob): Blob =
  Stdlib.Crypto.sha256hmac(salt, inputKeyMaterial)

let hkdfExtract384(salt: Blob, inputKeyMaterial: Blob): Blob =
  Stdlib.Crypto.__sha384hmac(salt, inputKeyMaterial)

let __expandNext(key: Blob, info: Blob, blocksRemaining: Int64, previous: Blob, blocks: List<Blob>, counter: Int64): Blob =
  if blocksRemaining == 0 then Stdlib.Blob.concat(Stdlib.List.reverse(blocks))
  else
    let input = Stdlib.Blob.concat(
                  [previous, info, Stdlib.Blob.__fromInt64List([counter])]) in
    let block = Stdlib.Crypto.sha256hmac(key, input) in
    Stdlib.__Tls13.__expandNext(key, info, blocksRemaining - 1, block,
      Stdlib.List.push(blocks, block), counter + 1)

// SHA-256 produces 32 bytes per block; RFC 5869 limits expansion to 255 blocks.
let hkdfExpand(pseudoRandomKey: Blob, info: Blob, length: Int64): Stdlib.Result.Result<Blob, String> =
  if length < 0 || length > 8160 then Error("Invalid HKDF output length")
  else if length == 0 then Ok(Stdlib.Blob.empty)
  else
    let blocks = (length + 31) / 32 in
    let expanded = Stdlib.__Tls13.__expandNext(pseudoRandomKey, info, blocks,
                     Stdlib.Blob.empty, [], 1) in
    Ok(Stdlib.Blob.slice(expanded, 0z, Stdlib.Int.fromInt64(length)))

let __expandNext384(key: Blob, info: Blob, blocksRemaining: Int64, previous: Blob, blocks: List<Blob>, counter: Int64): Blob =
  if blocksRemaining == 0 then Stdlib.Blob.concat(Stdlib.List.reverse(blocks))
  else
    let input = Stdlib.Blob.concat(
                  [previous, info, Stdlib.Blob.__fromInt64List([counter])]) in
    let block = Stdlib.Crypto.__sha384hmac(key, input) in
    Stdlib.__Tls13.__expandNext384(key, info, blocksRemaining - 1, block,
      Stdlib.List.push(blocks, block), counter + 1)

let hkdfExpand384(pseudoRandomKey: Blob, info: Blob, length: Int64): Stdlib.Result.Result<Blob, String> =
  if length < 0 || length > 12240 then Error("Invalid HKDF output length")
  else if length == 0 then Ok(Stdlib.Blob.empty)
  else
    let blocks = (length + 47) / 48 in
    let expanded = Stdlib.__Tls13.__expandNext384(pseudoRandomKey, info, blocks,
                     Stdlib.Blob.empty, [], 1) in
    Ok(Stdlib.Blob.slice(expanded, 0z, Stdlib.Int.fromInt64(length)))

let hkdfExpandLabel(secret: Blob, label: String, context: Blob, length: Int64): Stdlib.Result.Result<Blob, String> =
  let fullLabel = "tls13 " + label in
  let labelLength = Stdlib.String.__byteLength(fullLabel) in
  let contextLength = Stdlib.Blob.__byteLength(context) in
  if labelLength > 255 || contextLength > 255 then
    Error("TLS HKDF label or context is too long")
  else if length < 0 || length > 8160 then
    Error("Invalid HKDF output length")
  else
    let info = Stdlib.Blob.concat([
      Stdlib.Blob.__fromInt64List([length / 256, length % 256, labelLength]),
      Stdlib.String.toBlob(fullLabel),
      Stdlib.Blob.__fromInt64List([contextLength]), context ]) in
    Stdlib.__Tls13.hkdfExpand(secret, info, length)

let hkdfExpandLabel384(secret: Blob, label: String, context: Blob, length: Int64): Stdlib.Result.Result<Blob, String> =
  let fullLabel = "tls13 " + label in
  let labelLength = Stdlib.String.__byteLength(fullLabel) in
  let contextLength = Stdlib.Blob.__byteLength(context) in
  if labelLength > 255 || contextLength > 255 then
    Error("TLS HKDF label or context is too long")
  else if length < 0 || length > 12240 then
    Error("Invalid HKDF output length")
  else
    let info = Stdlib.Blob.concat([
      Stdlib.Blob.__fromInt64List([length / 256, length % 256, labelLength]),
      Stdlib.String.toBlob(fullLabel),
      Stdlib.Blob.__fromInt64List([contextLength]), context ]) in
    Stdlib.__Tls13.hkdfExpand384(secret, info, length)

let __read16(data: Blob, offset: Int64): Int64 =
  Stdlib.Blob.__getByte(data, offset) * 256 +
  Stdlib.Blob.__getByte(data, offset + 1)

let __read24(data: Blob, offset: Int64): Int64 =
  Stdlib.__Tls13.__read16(data, offset) * 256 +
  Stdlib.Blob.__getByte(data, offset + 2)

let __u16(value: Int64): Blob =
  Stdlib.Blob.__fromInt64List([value / 256, value % 256])

let __extension(kind: Int64, payload: Blob): Blob =
  Stdlib.Blob.concat([Stdlib.__Tls13.__u16(kind),
                      Stdlib.__Tls13.__u16(Stdlib.Blob.__byteLength(payload)), payload])

let __hostValid(host: String, index: Int64): Bool =
  if index >= Stdlib.String.__byteLength(host) then true
  else
    let byte = Stdlib.String.__byteAtUnchecked(host, index) in
    if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
       (byte >= 48 && byte <= 57) || byte == 45 || byte == 46 then
      Stdlib.__Tls13.__hostValid(host, index + 1)
    else false

let __allZero(bytes: Blob, index: Int64): Bool =
  if index >= Stdlib.Blob.__byteLength(bytes) then true
  else if Stdlib.Blob.__getByte(bytes, index) != 0 then false
  else Stdlib.__Tls13.__allZero(bytes, index + 1)

// The caller supplies fresh cryptographic random bytes and an X25519 public key.
let __clientHello(host: String, random: Blob, keyShare: Blob, protocols: List<String>, quicParameters: Stdlib.Option.Option<Blob>): Stdlib.Result.Result<Blob, String> =
  let hostLength = Stdlib.String.__byteLength(host) in
  if Stdlib.Blob.__byteLength(random) != 32 || Stdlib.Blob.__byteLength(keyShare) != 32 then
    Error("TLS ClientHello requires 32-byte random and key share")
  else if Stdlib.__Tls13.__allZero(keyShare, 0) then
    Error("TLS ClientHello key share is zero")
  else if hostLength == 0 || hostLength > 253 ||
          Stdlib.Bool.not(Stdlib.__Tls13.__hostValid(host, 0)) then
    Error("TLS ClientHello requires a DNS hostname")
  else
    let sniEntry = Stdlib.Blob.concat([
      Stdlib.Blob.__fromInt64List([0]), Stdlib.__Tls13.__u16(hostLength),
      Stdlib.String.toBlob(host) ]) in
    let sni = Stdlib.__Tls13.__extension(0,
                Stdlib.Blob.concat([Stdlib.__Tls13.__u16(hostLength + 3), sniEntry])) in
    let versions = Stdlib.__Tls13.__extension(43,
                     Stdlib.Blob.__fromInt64List([2, 3, 4])) in
    let groups = Stdlib.__Tls13.__extension(10,
                   Stdlib.Blob.__fromInt64List([0, 2, 0, 29])) in
    let signatures = Stdlib.__Tls13.__extension(13,
                       Stdlib.Blob.__fromInt64List([0, 4, 8, 4, 4, 3])) in
    // CertificateVerify supports RSA-PSS; certificate paths support RSA
    // PKCS#1 SHA-256/384, advertised separately as TLS 1.3 permits.
    let certificateSignatures = Stdlib.__Tls13.__extension(50,
                                  Stdlib.Blob.__fromInt64List([0, 6, 4, 1, 5, 1, 4, 3])) in
    let shareEntry = Stdlib.Blob.concat([Stdlib.__Tls13.__u16(29),
                                        Stdlib.__Tls13.__u16(32), keyShare]) in
    let shares = Stdlib.__Tls13.__extension(51,
                   Stdlib.Blob.concat([Stdlib.__Tls13.__u16(36), shareEntry])) in
    let baseExtensions = Stdlib.Blob.concat([sni, versions, groups, signatures, certificateSignatures, shares]) in
    match Stdlib.__TlsAlpn.offer(protocols) with
    | Error(message) -> Error(message)
    | Ok(alpn) ->
      let protocolExtensions = if protocols == [] then baseExtensions
                               else Stdlib.Blob.concat([baseExtensions, Stdlib.__Tls13.__extension(16, alpn)]) in
      let extensions =
        match quicParameters with
        | None -> protocolExtensions
        | Some(parameters) -> Stdlib.Blob.concat([protocolExtensions, Stdlib.__Tls13.__extension(57, parameters)]) in
      // The current QUIC protection profile is AES-128-GCM/SHA-256 only.
      // Ordinary TLS keeps its existing suite order and transcript vectors.
      let suites = match quicParameters with
                   | None -> Stdlib.Blob.__fromInt64List([0, 6, 19, 2, 19, 1, 19, 3])
                   | Some(_) -> Stdlib.Blob.__fromInt64List([0, 2, 19, 1]) in
      let body = Stdlib.Blob.concat([
        Stdlib.Blob.__fromInt64List([3, 3]), random,
        Stdlib.Blob.__fromInt64List([0]), suites, Stdlib.Blob.__fromInt64List([1, 0]),
        Stdlib.__Tls13.__u16(Stdlib.Blob.__byteLength(extensions)), extensions ]) in
      let bodyLength = Stdlib.Blob.__byteLength(body) in
      let handshake = Stdlib.Blob.concat([
        Stdlib.Blob.__fromInt64List([1, bodyLength / 65536,
                                       (bodyLength / 256) % 256, bodyLength % 256]),
        body ]) in
      Stdlib.__Tls13.serializePlaintext(22, handshake)

let clientHelloWithProtocols(host: String, random: Blob, keyShare: Blob, protocols: List<String>): Stdlib.Result.Result<Blob, String> =
  Stdlib.__Tls13.__clientHello(host, random, keyShare, protocols, None)

// RFC 9001: CRYPTO carries TLS handshake bytes without the TLS record layer.
// The owning QUIC connection must validate transport-parameter semantics.
let quicClientHello(host: String, random: Blob, keyShare: Blob, parameters: Blob): Stdlib.Result.Result<Blob, String> =
  if Stdlib.Blob.__byteLength(parameters) == 0 || Stdlib.Blob.__byteLength(parameters) > 4096 then
    Error("QUIC transport parameters must have 1..4096 bytes")
  else
    match Stdlib.__Tls13.__clientHello(host, random, keyShare, ["h3"], Some(parameters)) with
    | Error(message) -> Error(message)
    | Ok(wire) ->
      match Stdlib.__Tls13.parseRecord(wire) with
      | Error(_) -> Error("Invalid locally generated QUIC ClientHello")
      | Ok(record) -> Ok(record.payload)

let clientHello(host: String, random: Blob, keyShare: Blob): Stdlib.Result.Result<Blob, String> =
  Stdlib.__Tls13.clientHelloWithProtocols(host, random, keyShare, [])

let __parseServerExtensions(data: Blob, position: Int64, end_: Int64, versionSeen: Bool, keyShare: Stdlib.Option.Option<Blob>): Stdlib.Result.Result<Blob, String> =
  if position == end_ then
    if Stdlib.Bool.not(versionSeen) then Error("TLS 1.3 version missing")
    else
      match keyShare with
      | None -> Error("X25519 key share missing")
      | Some(share) -> Ok(share)
  else if position + 4 > end_ then Error("Truncated ServerHello extension")
  else
    let kind = Stdlib.__Tls13.__read16(data, position) in
    let length = Stdlib.__Tls13.__read16(data, position + 2) in
    let content = position + 4 in
    let next = content + length in
    if next > end_ then Error("ServerHello extension exceeds message")
    else if kind == 43 then
      if versionSeen then Error("Duplicate supported_versions extension")
      else if length != 2 || Stdlib.__Tls13.__read16(data, content) != 772 then
        Error("Server did not select TLS 1.3")
      else Stdlib.__Tls13.__parseServerExtensions(data, next, end_, true, keyShare)
    else if kind == 51 then
      match keyShare with
      | Some(_) -> Error("Duplicate key_share extension")
      | None ->
          if length != 36 || Stdlib.__Tls13.__read16(data, content) != 29 ||
             Stdlib.__Tls13.__read16(data, content + 2) != 32 then
            Error("Server did not select X25519")
          else
            let share = Stdlib.Blob.slice(data, Stdlib.Int.fromInt64(content + 4),
                          Stdlib.Int.fromInt64(32)) in
            if Stdlib.__Tls13.__allZero(share, 0) then Error("X25519 key share is zero")
            else Stdlib.__Tls13.__parseServerExtensions(data, next, end_, versionSeen, Some(share))
    else Error("Unexpected ServerHello extension")

let parseServerHello(data: Blob): Stdlib.Result.Result<Stdlib.__Tls13.ServerHello, Stdlib.__Tls13.RecordError> =
  let length = Stdlib.Blob.__byteLength(data) in
  if length < 4 then Error(Stdlib.__Tls13.RecordError.Incomplete)
  else if Stdlib.Blob.__getByte(data, 0) != 2 then
    Error(Stdlib.__Tls13.RecordError.Invalid("Expected ServerHello"))
  else
    let bodyLength = Stdlib.__Tls13.__read24(data, 1) in
    let bodyEnd = 4 + bodyLength in
    if bodyLength > 65535 then
      Error(Stdlib.__Tls13.RecordError.Invalid("ServerHello exceeds size limit"))
    else if length < bodyEnd then Error(Stdlib.__Tls13.RecordError.Incomplete)
    else if bodyLength < 40 || Stdlib.__Tls13.__read16(data, 4) != 771 then
      Error(Stdlib.__Tls13.RecordError.Invalid("Invalid ServerHello legacy version"))
    else
      let random = Stdlib.Blob.slice(data, Stdlib.Int.fromInt64(6),
                     Stdlib.Int.fromInt64(32)) in
      let sessionLength = Stdlib.Blob.__getByte(data, 38) in
      let cipherOffset = 39 + sessionLength in
      if Stdlib.Blob.toHex(random) ==
         "CF21AD74E59A6111BE1D8C021E65B891C2A211167ABB8C5E079E09E2C8A8339C" then
        Error(Stdlib.__Tls13.RecordError.Invalid("HelloRetryRequest is not supported"))
      else if sessionLength != 0 || cipherOffset + 5 > bodyEnd then
        Error(Stdlib.__Tls13.RecordError.Invalid("Invalid ServerHello session ID"))
      else if (Stdlib.__Tls13.__read16(data, cipherOffset) != 4865 &&
               Stdlib.__Tls13.__read16(data, cipherOffset) != 4866 &&
               Stdlib.__Tls13.__read16(data, cipherOffset) != 4867) ||
              Stdlib.Blob.__getByte(data, cipherOffset + 2) != 0 then
        Error(Stdlib.__Tls13.RecordError.Invalid("Unsupported ServerHello cipher or compression"))
      else
        let extensionLength = Stdlib.__Tls13.__read16(data, cipherOffset + 3) in
        let extensionStart = cipherOffset + 5 in
        if extensionStart + extensionLength != bodyEnd then
          Error(Stdlib.__Tls13.RecordError.Invalid("Invalid ServerHello extension length"))
        else
          match Stdlib.__Tls13.__parseServerExtensions(data, extensionStart, bodyEnd, false, None) with
          | Error(message) -> Error(Stdlib.__Tls13.RecordError.Invalid(message))
          | Ok(share) ->
              Ok(Stdlib.__Tls13.ServerHello {
                random = random, keyShare = share,
                cipherSuite = Stdlib.__Tls13.__read16(data, cipherOffset),
                remaining = Stdlib.Blob.slice(data, Stdlib.Int.fromInt64(bodyEnd),
                              Stdlib.Int.fromInt64(length - bodyEnd)) })

let serializePlaintext(contentType: Int64, payload: Blob): Stdlib.Result.Result<Blob, String> =
  let payloadLength = Stdlib.Blob.__byteLength(payload) in
  if contentType != 21 && contentType != 22 && contentType != 23 then
    Error("Invalid TLS record content type")
  else if payloadLength > 16384 then Error("TLS plaintext exceeds size limit")
  else
    Ok(Stdlib.Blob.concat([
      Stdlib.Blob.__fromInt64List([contentType, 3, 3,
                                     payloadLength / 256, payloadLength % 256]),
      payload ]))

let parseRecord(data: Blob): Stdlib.Result.Result<Stdlib.__Tls13.Record, Stdlib.__Tls13.RecordError> =
  let dataLength = Stdlib.Blob.__byteLength(data) in
  if dataLength < 5 then Error(Stdlib.__Tls13.RecordError.Incomplete)
  else
    let contentType = Stdlib.Blob.__getByte(data, 0) in
    let version = Stdlib.__Tls13.__read16(data, 1) in
    let payloadLength = Stdlib.__Tls13.__read16(data, 3) in
    if version != 771 then Error(Stdlib.__Tls13.RecordError.Invalid("Unsupported TLS record version"))
    else if contentType != 20 && contentType != 21 &&
            contentType != 22 && contentType != 23 then
      Error(Stdlib.__Tls13.RecordError.Invalid("Invalid TLS record content type"))
    else if payloadLength > 16640 then
      Error(Stdlib.__Tls13.RecordError.Invalid("TLS record exceeds size limit"))
    else if dataLength < 5 + payloadLength then
      Error(Stdlib.__Tls13.RecordError.Incomplete)
    else
      Ok(Stdlib.__Tls13.Record {
        contentType = contentType,
        payload = Stdlib.Blob.slice(data, Stdlib.Int.fromInt64(5),
                    Stdlib.Int.fromInt64(payloadLength)),
        remaining = Stdlib.Blob.slice(data, Stdlib.Int.fromInt64(5 + payloadLength),
                      Stdlib.Int.fromInt64(dataLength - 5 - payloadLength)) })

// Each traffic secret supplies a fresh AEAD key and static IV. Sequence numbers
// belong to one traffic direction and reset when the traffic secret changes.
let trafficKeys(secret: Blob): Stdlib.Result.Result<Stdlib.__Tls13.TrafficKeys, String> =
  if Stdlib.Blob.__byteLength(secret) != 32 then Error("TLS traffic secret must be 32 bytes")
  else
    match Stdlib.__Tls13.hkdfExpandLabel(secret, "key", Stdlib.Blob.empty, 16) with
    | Error(message) -> Error(message)
    | Ok(key) ->
        match Stdlib.__Tls13.hkdfExpandLabel(secret, "iv", Stdlib.Blob.empty, 12) with
        | Error(message) -> Error(message)
        | Ok(iv) -> Ok(Stdlib.__Tls13.TrafficKeys { key = key, iv = iv, sequence = 0,
                                                  cipherSuite = 4865 })

let trafficKeys384(secret: Blob): Stdlib.Result.Result<Stdlib.__Tls13.TrafficKeys, String> =
  if Stdlib.Blob.__byteLength(secret) != 48 then Error("TLS SHA-384 traffic secret must be 48 bytes")
  else
    match Stdlib.__Tls13.hkdfExpandLabel384(secret, "key", Stdlib.Blob.empty, 32) with
    | Error(message) -> Error(message)
    | Ok(key) ->
      match Stdlib.__Tls13.hkdfExpandLabel384(secret, "iv", Stdlib.Blob.empty, 12) with
      | Error(message) -> Error(message)
      | Ok(iv) -> Ok(Stdlib.__Tls13.TrafficKeys { key = key, iv = iv, sequence = 0,
                                                cipherSuite = 4866 })

let trafficKeysChaCha(secret: Blob): Stdlib.Result.Result<Stdlib.__Tls13.TrafficKeys, String> =
  if Stdlib.Blob.__byteLength(secret) != 32 then Error("TLS ChaCha20 traffic secret must be 32 bytes")
  else
    match Stdlib.__Tls13.hkdfExpandLabel(secret, "key", Stdlib.Blob.empty, 32) with
    | Error(message) -> Error(message)
    | Ok(key) ->
      match Stdlib.__Tls13.hkdfExpandLabel(secret, "iv", Stdlib.Blob.empty, 12) with
      | Error(message) -> Error(message)
      | Ok(iv) -> Ok(Stdlib.__Tls13.TrafficKeys { key = key, iv = iv, sequence = 0,
                                                cipherSuite = 4867 })

let __nonceBytes(iv: Blob, sequence: Int64, index: Int64, acc: List<Int64>): Blob =
  if index == 12 then Stdlib.Blob.__fromInt64List(Stdlib.List.reverse(acc))
  else
    let shift = (11 - index) * 8 in
    let sequenceByte =
      if index < 4 then 0
      else Stdlib.Int64.bitwiseAnd(Stdlib.Int64.shiftRight(sequence, shift), 255) in
    Stdlib.__Tls13.__nonceBytes(iv, sequence, index + 1,
      Stdlib.List.push(acc,
        Stdlib.Int64.bitwiseXor(Stdlib.Blob.__getByte(iv, index), sequenceByte)))

let __nextKeys(keys: Stdlib.__Tls13.TrafficKeys): Stdlib.__Tls13.TrafficKeys =
  Stdlib.__Tls13.TrafficKeys {
    key = keys.key, iv = keys.iv, sequence = keys.sequence + 1,
    cipherSuite = keys.cipherSuite }

let sealRecord(keys: Stdlib.__Tls13.TrafficKeys, contentType: Int64, content: Blob): Stdlib.Result.Result<Stdlib.__Tls13.SealedRecord, String> =
  let length = Stdlib.Blob.__byteLength(content) in
  if contentType != 21 && contentType != 22 && contentType != 23 then
    Error("Invalid TLS inner content type")
  else if length > 16384 then Error("TLS inner plaintext exceeds size limit")
  else if (keys.cipherSuite == 4865 && Stdlib.Blob.__byteLength(keys.key) != 16) ||
          (keys.cipherSuite == 4866 && Stdlib.Blob.__byteLength(keys.key) != 32) ||
          (keys.cipherSuite == 4867 && Stdlib.Blob.__byteLength(keys.key) != 32) ||
          (keys.cipherSuite != 4865 && keys.cipherSuite != 4866 &&
           keys.cipherSuite != 4867) ||
          Stdlib.Blob.__byteLength(keys.iv) != 12 ||
          keys.sequence < 0 || keys.sequence == 9223372036854775807 then
    Error("Invalid TLS traffic keys or sequence")
  else
    let payloadLength = length + 17 in
    let header = Stdlib.Blob.__fromInt64List(
                   [23, 3, 3, payloadLength / 256, payloadLength % 256]) in
    let inner = Stdlib.Blob.concat(
                  [content, Stdlib.Blob.__fromInt64List([contentType])]) in
    let nonce = Stdlib.__Tls13.__nonceBytes(keys.iv, keys.sequence, 0, []) in
    let encrypted = if keys.cipherSuite == 4867 then
                      Stdlib.__Chacha20Poly1305.encrypt(keys.key, nonce, header, inner)
                    else Stdlib.__AesGcm.encrypt(keys.key, nonce, header, inner) in
    match encrypted with
    | Error(message) -> Error(message)
    | Ok(payload) ->
        Ok(Stdlib.__Tls13.SealedRecord {
          bytes = Stdlib.Blob.concat([header, payload]),
          nextKeys = Stdlib.__Tls13.__nextKeys(keys) })

let __innerType(inner: Blob, index: Int64): Int64 =
  if index < 0 then -1
  else if Stdlib.Blob.__getByte(inner, index) == 0 then
    Stdlib.__Tls13.__innerType(inner, index - 1)
  else index

let openRecord(keys: Stdlib.__Tls13.TrafficKeys, record: Stdlib.__Tls13.Record): Stdlib.Result.Result<Stdlib.__Tls13.OpenedRecord, String> =
  let length = Stdlib.Blob.__byteLength(record.payload) in
  if record.contentType != 23 || length < 17 || length > 16640 then
    Error("Invalid TLS encrypted record")
  else if (keys.cipherSuite == 4865 && Stdlib.Blob.__byteLength(keys.key) != 16) ||
          (keys.cipherSuite == 4866 && Stdlib.Blob.__byteLength(keys.key) != 32) ||
          (keys.cipherSuite == 4867 && Stdlib.Blob.__byteLength(keys.key) != 32) ||
          (keys.cipherSuite != 4865 && keys.cipherSuite != 4866 &&
           keys.cipherSuite != 4867) ||
          Stdlib.Blob.__byteLength(keys.iv) != 12 ||
          keys.sequence < 0 || keys.sequence == 9223372036854775807 then
    Error("Invalid TLS traffic keys or sequence")
  else
    let header = Stdlib.Blob.__fromInt64List(
                   [23, 3, 3, length / 256, length % 256]) in
    let nonce = Stdlib.__Tls13.__nonceBytes(keys.iv, keys.sequence, 0, []) in
    let decrypted = if keys.cipherSuite == 4867 then
                      Stdlib.__Chacha20Poly1305.decrypt(keys.key, nonce, header, record.payload)
                    else Stdlib.__AesGcm.decrypt(keys.key, nonce, header, record.payload) in
    match decrypted with
    | Error(message) -> Error(message)
    | Ok(inner) ->
        let index = Stdlib.__Tls13.__innerType(inner, Stdlib.Blob.__byteLength(inner) - 1) in
        if index < 0 then Error("TLS inner content type missing")
        else
          let contentType = Stdlib.Blob.__getByte(inner, index) in
          if index > 16384 then Error("TLS inner plaintext exceeds size limit")
          else if contentType != 21 && contentType != 22 && contentType != 23 then
            Error("Invalid TLS inner content type")
          else Ok(Stdlib.__Tls13.OpenedRecord {
            contentType = contentType,
            content = Stdlib.Blob.slice(inner, 0z, Stdlib.Int.fromInt64(index)),
            nextKeys = Stdlib.__Tls13.__nextKeys(keys) })
