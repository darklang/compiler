// __Hpack.dark - Bounded RFC 7541 decoding, static header references and Huffman encoding.
// Static and Huffman tables are the protocol constants in RFC 7541 appendices A/B.
module Darklang.Stdlib.__Hpack

type State = { entries: List<(String * String)>, limit: Int64 }
type Decoded = { headers: List<(String * String)>, state: Stdlib.__Hpack.State }
type Number = { value: Int64, next: Int64 }
type Text = { value: String, next: Int64 }
type Encoder = { table: Stdlib.__Hpack.State, minimum: Stdlib.Option.Option<Int64> }
type Encoded = { bytes: Blob, state: Stdlib.__Hpack.Encoder }

let initial () : Stdlib.__Hpack.State = Stdlib.__Hpack.State { entries = [], limit = 4096 }

let __static (index: Int64) : Stdlib.Option.Option<(String * String)> =
  match index with
  | 1 -> Some ((":authority", ""))
  | 2 -> Some ((":method", "GET"))
  | 3 -> Some ((":method", "POST"))
  | 4 -> Some ((":path", "/"))
  | 5 -> Some ((":path", "/index.html"))
  | 6 -> Some ((":scheme", "http"))
  | 7 -> Some ((":scheme", "https"))
  | 8 -> Some ((":status", "200"))
  | 9 -> Some ((":status", "204"))
  | 10 -> Some ((":status", "206"))
  | 11 -> Some ((":status", "304"))
  | 12 -> Some ((":status", "400"))
  | 13 -> Some ((":status", "404"))
  | 14 -> Some ((":status", "500"))
  | 15 -> Some (("accept-charset", ""))
  | 16 -> Some (("accept-encoding", "gzip, deflate"))
  | 17 -> Some (("accept-language", ""))
  | 18 -> Some (("accept-ranges", ""))
  | 19 -> Some (("accept", ""))
  | 20 -> Some (("access-control-allow-origin", ""))
  | 21 -> Some (("age", ""))
  | 22 -> Some (("allow", ""))
  | 23 -> Some (("authorization", ""))
  | 24 -> Some (("cache-control", ""))
  | 25 -> Some (("content-disposition", ""))
  | 26 -> Some (("content-encoding", ""))
  | 27 -> Some (("content-language", ""))
  | 28 -> Some (("content-length", ""))
  | 29 -> Some (("content-location", ""))
  | 30 -> Some (("content-range", ""))
  | 31 -> Some (("content-type", ""))
  | 32 -> Some (("cookie", ""))
  | 33 -> Some (("date", ""))
  | 34 -> Some (("etag", ""))
  | 35 -> Some (("expect", ""))
  | 36 -> Some (("expires", ""))
  | 37 -> Some (("from", ""))
  | 38 -> Some (("host", ""))
  | 39 -> Some (("if-match", ""))
  | 40 -> Some (("if-modified-since", ""))
  | 41 -> Some (("if-none-match", ""))
  | 42 -> Some (("if-range", ""))
  | 43 -> Some (("if-unmodified-since", ""))
  | 44 -> Some (("last-modified", ""))
  | 45 -> Some (("link", ""))
  | 46 -> Some (("location", ""))
  | 47 -> Some (("max-forwards", ""))
  | 48 -> Some (("proxy-authenticate", ""))
  | 49 -> Some (("proxy-authorization", ""))
  | 50 -> Some (("range", ""))
  | 51 -> Some (("referer", ""))
  | 52 -> Some (("refresh", ""))
  | 53 -> Some (("retry-after", ""))
  | 54 -> Some (("server", ""))
  | 55 -> Some (("set-cookie", ""))
  | 56 -> Some (("strict-transport-security", ""))
  | 57 -> Some (("transfer-encoding", ""))
  | 58 -> Some (("user-agent", ""))
  | 59 -> Some (("vary", ""))
  | 60 -> Some (("via", ""))
  | 61 -> Some (("www-authenticate", ""))
  | _ -> None

let __dynamic (entries: List<(String * String)>) (index: Int64) : Stdlib.Option.Option<(String * String)> =
  match entries with
  | [] -> None
  | entry :: rest -> if index == 0 then Some entry else Stdlib.__Hpack.__dynamic rest (index - 1)

let __lookup (state: Stdlib.__Hpack.State) (index: Int64) : Stdlib.Option.Option<(String * String)> =
  if index <= 0 then None
  else if index <= 61 then Stdlib.__Hpack.__static index
  else Stdlib.__Hpack.__dynamic state.entries (index - 62)

let __pow2 (exponent: Int64) : Int64 =
  if exponent == 0 then 1 else 2 * Stdlib.__Hpack.__pow2 (exponent - 1)

let __integerRest (data: Blob) (position: Int64) (value: Int64) (factor: Int64)
  : Stdlib.Result.Result<Stdlib.__Hpack.Number, String> =
  if position >= Stdlib.Blob.__byteLength data then Error "Truncated HPACK integer"
  else if factor > 268435456 then Error "HPACK integer overflow"
  else
    let byte = Stdlib.Blob.__getByte data position in
    let nextValue = value + (byte % 128) * factor in
    if nextValue > 2147483647 then Error "HPACK integer overflow"
    else if byte < 128 then Ok (Stdlib.__Hpack.Number { value = nextValue, next = position + 1 })
    else Stdlib.__Hpack.__integerRest data (position + 1) nextValue (factor * 128)

let integer (data: Blob) (position: Int64) (prefix: Int64)
  : Stdlib.Result.Result<Stdlib.__Hpack.Number, String> =
  if prefix < 1 || prefix > 8 then Error "Invalid HPACK integer prefix"
  else if position < 0 || position >= Stdlib.Blob.__byteLength data then Error "Truncated HPACK integer"
  else
    let mask = Stdlib.__Hpack.__pow2 prefix - 1 in
    let value = Stdlib.Int64.bitwiseAnd (Stdlib.Blob.__getByte data position) mask in
    if value < mask then Ok (Stdlib.__Hpack.Number { value = value, next = position + 1 })
    else Stdlib.__Hpack.__integerRest data (position + 1) value 1

