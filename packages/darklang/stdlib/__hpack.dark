let __emitHuffman (bits: Int64) (length: Int64) (output: List<Int64>) : (Int64 * Int64 * List<Int64>) =
  if length < 8 then (bits, length, output)
  else
    let factor = Stdlib.__Hpack.__pow2 (length - 8) in
    Stdlib.__Hpack.__emitHuffman (bits % factor) (length - 8) (Stdlib.List.push output (bits / factor))

let __encodeHuffman (bytes: Blob) (position: Int64) (bits: Int64) (length: Int64) (output: List<Int64>) : Blob =
  if position == Stdlib.Blob.__byteLength bytes then
    let output = if length == 0 then output else
      let padding = Stdlib.__Hpack.__pow2 (8 - length) in
      Stdlib.List.push output (bits * padding + padding - 1) in
    Stdlib.Blob.__fromInt64List (Stdlib.List.reverse output)
  else
    let (code, width) = Stdlib.__Hpack.__huffmanCode (Stdlib.Blob.__getByte bytes position) in
    let (nextBits, nextLength, nextOutput) = Stdlib.__Hpack.__emitHuffman (bits * Stdlib.__Hpack.__pow2 width + code) (length + width) output in
    Stdlib.__Hpack.__encodeHuffman bytes (position + 1) nextBits nextLength nextOutput

let __sensitive (name: String) : Bool =
  name == "authorization" || name == "proxy-authorization" || name == "cookie" || name == "set-cookie"

let __staticIndex (name: String) (value: String) (exact: Bool) (index: Int64) : Stdlib.Option.Option<Int64> =
  match Stdlib.__Hpack.__static index with
  | None -> None
  | Some entry ->
    let (entryName, entryValue) = entry in
    if entryName == name && (Stdlib.Bool.not exact || entryValue == value) then Some index
    else Stdlib.__Hpack.__staticIndex name value exact (index + 1)

let encodeText (value: String) : Blob =
  let raw = Stdlib.String.toBlob value in
  let compressed = Stdlib.__Hpack.__encodeHuffman raw 0 0 0 [] in
  let huffman = Stdlib.Blob.__byteLength compressed < Stdlib.Blob.__byteLength raw in
  let bytes = if huffman then compressed else raw in
  Stdlib.Blob.concat [Stdlib.__Hpack.encodeInteger 7 (if huffman then 128 else 0) (Stdlib.Blob.__byteLength bytes), bytes]

let __encode (headers: List<(String * String)>) (size: Int64) (count: Int64)
  (blocks: List<Blob>) : Stdlib.Result.Result<Blob, String> =
  match headers with
  | [] -> Ok (Stdlib.Blob.concat (Stdlib.List.reverse blocks))
  | entry :: rest ->
    let (name, value) = entry in
    let nextSize = size + Stdlib.__Hpack.__entrySize entry in
    if count >= 256 || nextSize > 65536 then Error "HPACK header list too large"
    else if name == "" then Error "Empty HTTP header name"
    else
      let exact = if Stdlib.__Hpack.__sensitive name then None else Stdlib.__Hpack.__staticIndex name value true 1 in
      let encoded = match exact with
      | Some index -> Stdlib.__Hpack.encodeInteger 7 128 index
      | None ->
        // Name references still carry never-indexed values for sensitive fields.
        let reference = match Stdlib.__Hpack.__staticIndex name value false 1 with
        | Some index -> Stdlib.__Hpack.encodeInteger 4 16 index
        | None -> Stdlib.Blob.concat [Stdlib.Blob.__fromInt64List [16], Stdlib.__Hpack.encodeText name] in
        Stdlib.Blob.concat [reference, Stdlib.__Hpack.encodeText value] in
      Stdlib.__Hpack.__encode rest nextSize (count + 1) (Stdlib.List.push blocks encoded)

let encode (headers: List<(String * String)>) : Stdlib.Result.Result<Blob, String> =
  Stdlib.__Hpack.__encode headers 0 0 []

let encoder () : Stdlib.__Hpack.Encoder =
  Stdlib.__Hpack.Encoder { table = Stdlib.__Hpack.initial (), minimum = None }

// A bounded encoder may choose less capacity than the peer permits. Preserve
// the smallest intermediate capacity so a shrink/grow cannot hide evictions.
let resizeEncoder (state: Stdlib.__Hpack.Encoder) (maximum: Int64) : Stdlib.Result.Result<Stdlib.__Hpack.Encoder, String> =
  if maximum < 0 || maximum > 4294967295 then Error "Invalid HPACK encoder capacity"
  else
    let limit = if maximum > 4096 then 4096 else maximum in
    if limit == state.table.limit then Ok state
    else
      let minimum = match state.minimum with | Some value -> if value < limit then value else limit | None -> limit in
      Ok (Stdlib.__Hpack.Encoder { table = Stdlib.__Hpack.State { entries = Stdlib.__Hpack.__retain state.table.entries limit, limit = limit }, minimum = Some minimum })

let __dynamicIndex (entries: List<(String * String)>) (name: String) (value: String) (exact: Bool) (index: Int64) : Stdlib.Option.Option<Int64> =
  match entries with
  | [] -> None
  | entry :: rest ->
    let (entryName, entryValue) = entry in
    if entryName == name && (Stdlib.Bool.not exact || entryValue == value) then Some index
    else Stdlib.__Hpack.__dynamicIndex rest name value exact (index + 1)

let __encoderIndex (table: Stdlib.__Hpack.State) (name: String) (value: String) (exact: Bool) : Stdlib.Option.Option<Int64> =
  match Stdlib.__Hpack.__staticIndex name value exact 1 with
  | Some index -> Some index
  | None -> Stdlib.__Hpack.__dynamicIndex table.entries name value exact 62

let __encodeDynamic (state: Stdlib.__Hpack.Encoder) (headers: List<(String * String)>) (size: Int64) (count: Int64) (blocks: List<Blob>) : Stdlib.Result.Result<Stdlib.__Hpack.Encoded, String> =
  match headers with
  | [] -> Ok (Stdlib.__Hpack.Encoded { bytes = Stdlib.Blob.concat (Stdlib.List.reverse blocks), state = state })
  | entry :: rest ->
    let (name, value) = entry in
    let nextSize = size + Stdlib.__Hpack.__entrySize entry in
    if name == "" then Error "Empty HTTP header name"
    else if count >= 256 || nextSize > 65536 then Error "HPACK header list too large"
    else
      let sensitive = Stdlib.__Hpack.__sensitive name in
      let exact = if sensitive then None else Stdlib.__Hpack.__encoderIndex state.table name value true in
      let indexed = Stdlib.Bool.not sensitive && Stdlib.__Hpack.__entrySize entry <= state.table.limit in
      let bytes = match exact with
      | Some index -> Stdlib.__Hpack.encodeInteger 7 128 index
      | None ->
        let prefix = if indexed then 6 else 4 in
        let flags = if indexed then 64 else 16 in
        let reference = match Stdlib.__Hpack.__encoderIndex state.table name value false with
        | Some index -> Stdlib.__Hpack.encodeInteger prefix flags index
        | None -> Stdlib.Blob.concat [Stdlib.__Hpack.encodeInteger prefix flags 0, Stdlib.__Hpack.encodeText name] in
        Stdlib.Blob.concat [reference, Stdlib.__Hpack.encodeText value] in
      let table = if indexed && Stdlib.Option.isNone exact then Stdlib.__Hpack.__add state.table entry else state.table in
      Stdlib.__Hpack.__encodeDynamic { state with table = table } rest nextSize (count + 1) (Stdlib.List.push blocks bytes)

let encodeDynamic (state: Stdlib.__Hpack.Encoder) (headers: List<(String * String)>) : Stdlib.Result.Result<Stdlib.__Hpack.Encoded, String> =
  let updates = match state.minimum with
  | None -> []
  | Some minimum ->
    if minimum == state.table.limit then [Stdlib.__Hpack.encodeInteger 5 32 minimum]
    else [Stdlib.__Hpack.encodeInteger 5 32 state.table.limit, Stdlib.__Hpack.encodeInteger 5 32 minimum] in
  Stdlib.__Hpack.__encodeDynamic { state with minimum = None } headers 0 0 updates

