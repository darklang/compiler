// __Types.dark - Root public types which have no module of their own.
//
// Uuid is an ordinary single-case Dark sum. Its UInt128 payload gives UUID
// values a nominal boundary from String while retaining all normal sum-type
// behavior for equality, containers, closures, and Result values.

type Uuid = UUID of UInt128

// Float32 is binary32, held as the binary64 of the same value; see Stdlib.Float32.
type Float32 = FLOAT32 of Float

// Decimal is .NET decimal: a 96-bit unscaled integer and a scale; see Stdlib.Decimal.
type Decimal = DECIMAL of Int * Int64
