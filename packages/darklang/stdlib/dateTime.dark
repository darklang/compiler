// Stdlib.DateTime.dark - Portable UTC DateTime wrappers over native 100ns Unix ticks.
//
// Calendar conversion uses the proleptic Gregorian civil-date algorithms. The
// only representation casts and host-clock access are private compiler
// intrinsics, so DateTime remains statically distinct from every integer type.

module Darklang.Stdlib.DateTime

impl Stdlib.Display for DateTime =
  let display = Stdlib.DateTime.toString

impl Stdlib.Compare for DateTime =
  let lessThan = Stdlib.DateTime.lessThan
  let lessThanOrEqualTo = Stdlib.DateTime.lessThanOrEqualTo
  let greaterThan = Stdlib.DateTime.greaterThan
  let greaterThanOrEqualTo = Stdlib.DateTime.greaterThanOrEqualTo

let __ticksPerMillisecond () : Int64 = 10000
let __ticksPerSecond () : Int64 = 10000000
let __ticksPerMinute () : Int64 = 600000000
let __ticksPerHour () : Int64 = 36000000000
let __ticksPerDay () : Int64 = 864000000000

// NodaTime 3.2.2 Instant bounds used by the pinned interpreter.
let __minimumTicks () : Int64 = -3776735808000000000
let __maximumTicks () : Int64 = 2534023007999999999
let __maximumDeltaMilliseconds () : Int64 = 631075881599999
let __maximumDeltaSeconds () : Int64 = 631075881599

let __outOfRange () : DateTime =
    Builtin.crash "Encountered an out-of-range integer value"

let __intToInt64 (value: Int) : Int64 =
    match Stdlib.Int.toInt64 value with
    | Some converted -> converted
    | None -> Builtin.crash "Encountered an out-of-range integer value"

let __int64ToInt (value: Int64) : Int = Stdlib.Int.fromInt64 value

// Dark integer division truncates toward zero; epoch and calendar conversion
// require floor division for negative instants and negative proleptic years.
let __floorDiv (value: Int64) (divisor: Int64) : Int64 =
    let quotient = value / divisor in
    if value < 0 && value % divisor != 0 then quotient - 1 else quotient

let __floorMod (value: Int64) (divisor: Int64) : Int64 =
    let remainder = value % divisor in
    if remainder < 0 then remainder + divisor else remainder

let __ticks (date: DateTime) : Int64 =
    Stdlib.DateTime.__toUnixTimeTicks date

let __fromValidTicks (ticks: Int64) : DateTime =
    Stdlib.DateTime.__fromUnixTimeTicks ticks

let __checkedTicks (ticks: Int64) : DateTime =
    if ticks < Stdlib.DateTime.__minimumTicks () ||
       ticks > Stdlib.DateTime.__maximumTicks () then
        Stdlib.DateTime.__outOfRange ()
    else
        Stdlib.DateTime.__fromValidTicks ticks

let __fromMillisecondsInt (milliseconds: Int) : DateTime =
    let milliseconds = Stdlib.DateTime.__intToInt64 milliseconds in
    if milliseconds < Stdlib.DateTime.__floorDiv (Stdlib.DateTime.__minimumTicks ()) 10000 ||
       milliseconds > Stdlib.DateTime.__floorDiv (Stdlib.DateTime.__maximumTicks ()) 10000 then
        Stdlib.DateTime.__outOfRange ()
    else
        Stdlib.DateTime.__fromValidTicks (milliseconds * Stdlib.DateTime.__ticksPerMillisecond ())

let __toMillisecondsInt (date: DateTime) : Int =
    Stdlib.DateTime.__int64ToInt (
        Stdlib.DateTime.__floorDiv (Stdlib.DateTime.__ticks date) (Stdlib.DateTime.__ticksPerMillisecond ()))

let __fromSecondsInt (seconds: Int) : DateTime =
    let seconds = Stdlib.DateTime.__intToInt64 seconds in
    if seconds < Stdlib.DateTime.__floorDiv (Stdlib.DateTime.__minimumTicks ()) 10000000 ||
       seconds > Stdlib.DateTime.__floorDiv (Stdlib.DateTime.__maximumTicks ()) 10000000 then
        Stdlib.DateTime.__outOfRange ()
    else
        Stdlib.DateTime.__fromValidTicks (seconds * Stdlib.DateTime.__ticksPerSecond ())

let __toSecondsInt (date: DateTime) : Int =
    Stdlib.DateTime.__int64ToInt (
        Stdlib.DateTime.__floorDiv (Stdlib.DateTime.__ticks date) (Stdlib.DateTime.__ticksPerSecond ()))

let __addTicks (date: DateTime) (delta: Int64) : DateTime =
    let ticks = Stdlib.DateTime.__ticks date in
    if delta < Stdlib.DateTime.__minimumTicks () - ticks ||
       delta > Stdlib.DateTime.__maximumTicks () - ticks then
        Stdlib.DateTime.__outOfRange ()
    else
        Stdlib.DateTime.__fromValidTicks (ticks + delta)

let __subtractTicks (date: DateTime) (delta: Int64) : DateTime =
    let ticks = Stdlib.DateTime.__ticks date in
    if delta < ticks - Stdlib.DateTime.__maximumTicks () ||
       delta > ticks - Stdlib.DateTime.__minimumTicks () then
        Stdlib.DateTime.__outOfRange ()
    else
        Stdlib.DateTime.__fromValidTicks (ticks - delta)

let __addSecondsInt (date: DateTime) (seconds: Int) : DateTime =
    let seconds = Stdlib.DateTime.__intToInt64 seconds in
    if seconds < 0 - Stdlib.DateTime.__maximumDeltaSeconds () ||
       seconds > Stdlib.DateTime.__maximumDeltaSeconds () then
        Stdlib.DateTime.__outOfRange ()
    else
        Stdlib.DateTime.__addTicks date (seconds * Stdlib.DateTime.__ticksPerSecond ())

let __subtractSecondsInt (date: DateTime) (seconds: Int) : DateTime =
    let seconds = Stdlib.DateTime.__intToInt64 seconds in
    if seconds < 0 - Stdlib.DateTime.__maximumDeltaSeconds () ||
       seconds > Stdlib.DateTime.__maximumDeltaSeconds () then
        Stdlib.DateTime.__outOfRange ()
    else
        Stdlib.DateTime.__subtractTicks date (seconds * Stdlib.DateTime.__ticksPerSecond ())

let __addMillisecondsInt (date: DateTime) (milliseconds: Int) : DateTime =
    let milliseconds = Stdlib.DateTime.__intToInt64 milliseconds in
    if milliseconds < 0 - Stdlib.DateTime.__maximumDeltaMilliseconds () ||
       milliseconds > Stdlib.DateTime.__maximumDeltaMilliseconds () then
        Stdlib.DateTime.__outOfRange ()
    else
        Stdlib.DateTime.__addTicks date (milliseconds * Stdlib.DateTime.__ticksPerMillisecond ())

let __subtractMillisecondsInt (date: DateTime) (milliseconds: Int) : DateTime =
    let milliseconds = Stdlib.DateTime.__intToInt64 milliseconds in
    if milliseconds < 0 - Stdlib.DateTime.__maximumDeltaMilliseconds () ||
       milliseconds > Stdlib.DateTime.__maximumDeltaMilliseconds () then
        Stdlib.DateTime.__outOfRange ()
    else
        Stdlib.DateTime.__subtractTicks date (milliseconds * Stdlib.DateTime.__ticksPerMillisecond ())

let lessThan (left: DateTime) (right: DateTime) : Bool =
    Stdlib.DateTime.__ticks left < Stdlib.DateTime.__ticks right

let lessThanOrEqualTo (left: DateTime) (right: DateTime) : Bool =
    Stdlib.DateTime.__ticks left <= Stdlib.DateTime.__ticks right

let greaterThan (left: DateTime) (right: DateTime) : Bool =
    Stdlib.DateTime.__ticks left > Stdlib.DateTime.__ticks right

let greaterThanOrEqualTo (left: DateTime) (right: DateTime) : Bool =
    Stdlib.DateTime.__ticks left >= Stdlib.DateTime.__ticks right

let __roundToNearestEven (value: Int64) (divisor: Int64) : Int64 =
    let quotient = value / divisor in
    let remainder = value % divisor in
    let absoluteRemainder = if remainder < 0 then 0 - remainder else remainder in
    let halfway = divisor / 2 in
    if absoluteRemainder < halfway then quotient
    else if absoluteRemainder > halfway then
        if value < 0 then quotient - 1 else quotient + 1
    else if quotient % 2 == 0 then quotient
    else if value < 0 then quotient - 1
    else quotient + 1

let __subtractInt (endDate: DateTime) (startDate: DateTime) : Int =
    Stdlib.DateTime.__int64ToInt (
        Stdlib.DateTime.__roundToNearestEven (Stdlib.DateTime.__ticks endDate - Stdlib.DateTime.__ticks startDate) (Stdlib.DateTime.__ticksPerSecond ()))

let __subtractMsInt (endDate: DateTime) (startDate: DateTime) : Int =
    Stdlib.DateTime.__int64ToInt (
        Stdlib.DateTime.__roundToNearestEven (Stdlib.DateTime.__ticks endDate - Stdlib.DateTime.__ticks startDate) (Stdlib.DateTime.__ticksPerMillisecond ()))

// Convert a proleptic Gregorian civil date to days since 1970-01-01.
let __daysFromCivil (year: Int64) (month: Int64) (day: Int64) : Int64 =
    let adjustedYear = if month <= 2 then year - 1 else year in
    let era = Stdlib.DateTime.__floorDiv adjustedYear 400 in
    let yearOfEra = adjustedYear - era * 400 in
    let adjustedMonth = if month > 2 then month - 3 else month + 9 in
    let dayOfYear = (153 * adjustedMonth + 2) / 5 + day - 1 in
    let dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear in
    era * 146097 + dayOfEra - 719468

// Convert days since 1970-01-01 to (year, month, day) in constant time.
let __civilFromDays (days: Int64) : (Int64 * Int64 * Int64) =
    let shifted = days + 719468 in
    let era = Stdlib.DateTime.__floorDiv shifted 146097 in
    let dayOfEra = shifted - era * 146097 in
    let yearOfEra =
        (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365 in
    let preliminaryYear = yearOfEra + era * 400 in
    let dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100) in
    let monthPrime = (5 * dayOfYear + 2) / 153 in
    let day = dayOfYear - (153 * monthPrime + 2) / 5 + 1 in
    let month = if monthPrime < 10 then monthPrime + 3 else monthPrime - 9 in
    let year = if month <= 2 then preliminaryYear + 1 else preliminaryYear in
    (year, month, day)

let __daysSinceEpoch (date: DateTime) : Int64 =
    Stdlib.DateTime.__floorDiv (Stdlib.DateTime.__ticks date) (Stdlib.DateTime.__ticksPerDay ())

let __yearInt (date: DateTime) : Int =
    let parts = Stdlib.DateTime.__civilFromDays (Stdlib.DateTime.__daysSinceEpoch date) in
    Stdlib.DateTime.__int64ToInt (Stdlib.Tuple3.first parts)

let __monthInt (date: DateTime) : Int =
    let parts = Stdlib.DateTime.__civilFromDays (Stdlib.DateTime.__daysSinceEpoch date) in
    Stdlib.DateTime.__int64ToInt (Stdlib.Tuple3.second parts)

let __dayInt (date: DateTime) : Int =
    let parts = Stdlib.DateTime.__civilFromDays (Stdlib.DateTime.__daysSinceEpoch date) in
    Stdlib.DateTime.__int64ToInt (Stdlib.Tuple3.third parts)

let __weekdayInt (date: DateTime) : Int =
    Stdlib.DateTime.__int64ToInt (
        Stdlib.DateTime.__floorMod (Stdlib.DateTime.__daysSinceEpoch date + 3) 7 + 1)

let __ticksWithinDay (date: DateTime) : Int64 =
    Stdlib.DateTime.__floorMod (Stdlib.DateTime.__ticks date) (Stdlib.DateTime.__ticksPerDay ())

let __hourInt (date: DateTime) : Int =
    Stdlib.DateTime.__int64ToInt (
        Stdlib.DateTime.__ticksWithinDay date / Stdlib.DateTime.__ticksPerHour ())

let __minuteInt (date: DateTime) : Int =
    Stdlib.DateTime.__int64ToInt (
        (Stdlib.DateTime.__ticksWithinDay date / Stdlib.DateTime.__ticksPerMinute ()) % 60)

let __secondInt (date: DateTime) : Int =
    Stdlib.DateTime.__int64ToInt (
        (Stdlib.DateTime.__ticksWithinDay date / Stdlib.DateTime.__ticksPerSecond ()) % 60)

let __millisecondInt (date: DateTime) : Int =
    Stdlib.DateTime.__int64ToInt (
        (Stdlib.DateTime.__ticksWithinDay date / Stdlib.DateTime.__ticksPerMillisecond ()) % 1000)

let atStartOfDay (date: DateTime) : DateTime =
    Stdlib.DateTime.__fromValidTicks (
        Stdlib.DateTime.__daysSinceEpoch date * Stdlib.DateTime.__ticksPerDay ())

// The public DateTime API in the interpreter's types: Int64 seconds and
// milliseconds, small unsigned calendar fields, and Month and Weekday enums.
let __toInt64 (value: Int) : Int64 = Builtin.unwrap (Stdlib.Int.toInt64 value)
let addSeconds (date: DateTime) (seconds: Int64) : DateTime = Stdlib.DateTime.__addSecondsInt date (Stdlib.Int.fromInt64 seconds)
let subtractSeconds (date: DateTime) (seconds: Int64) : DateTime = Stdlib.DateTime.__subtractSecondsInt date (Stdlib.Int.fromInt64 seconds)
let toSeconds (date: DateTime) : Int64 = Stdlib.DateTime.__toInt64 (Stdlib.DateTime.__toSecondsInt date)
let fromSeconds (seconds: Int64) : DateTime = Stdlib.DateTime.__fromSecondsInt (Stdlib.Int.fromInt64 seconds)
let toMilliseconds (date: DateTime) : Int64 = Stdlib.DateTime.__toInt64 (Stdlib.DateTime.__toMillisecondsInt date)
let fromMilliseconds (milliseconds: Int64) : DateTime = Stdlib.DateTime.__fromMillisecondsInt (Stdlib.Int.fromInt64 milliseconds)
let addMilliseconds (date: DateTime) (milliseconds: Int64) : DateTime = Stdlib.DateTime.__addMillisecondsInt date (Stdlib.Int.fromInt64 milliseconds)
let subtractMilliseconds (date: DateTime) (milliseconds: Int64) : DateTime = Stdlib.DateTime.__subtractMillisecondsInt date (Stdlib.Int.fromInt64 milliseconds)
let year (date: DateTime) : Int64 = Stdlib.DateTime.__toInt64 (Stdlib.DateTime.__yearInt date)
let month (date: DateTime) : Stdlib.DateTime.Month =
    Builtin.unwrap (Stdlib.DateTime.Month.fromNumber (Builtin.unwrap (Stdlib.Int.toUInt8 (Stdlib.DateTime.__monthInt date))))
let day (date: DateTime) : UInt8 = Builtin.unwrap (Stdlib.Int.toUInt8 (Stdlib.DateTime.__dayInt date))
let weekday (date: DateTime) : Stdlib.DateTime.Weekday =
    Builtin.unwrap (Stdlib.DateTime.Weekday.fromNumber (Builtin.unwrap (Stdlib.Int.toUInt8 (Stdlib.DateTime.__weekdayInt date))))
let hour (date: DateTime) : UInt8 = Builtin.unwrap (Stdlib.Int.toUInt8 (Stdlib.DateTime.__hourInt date))
let minute (date: DateTime) : UInt8 = Builtin.unwrap (Stdlib.Int.toUInt8 (Stdlib.DateTime.__minuteInt date))
let second (date: DateTime) : UInt8 = Builtin.unwrap (Stdlib.Int.toUInt8 (Stdlib.DateTime.__secondInt date))
let millisecond (date: DateTime) : UInt16 = Builtin.unwrap (Stdlib.Int.toUInt16 (Stdlib.DateTime.__millisecondInt date))
let subtract (endDate: DateTime) (startDate: DateTime) : Stdlib.Duration.Duration =
    Stdlib.Duration.fromSeconds (Stdlib.DateTime.__toInt64 (Stdlib.DateTime.__subtractInt endDate startDate))
let subtractMs (endDate: DateTime) (startDate: DateTime) : Int64 = Stdlib.DateTime.__toInt64 (Stdlib.DateTime.__subtractMsInt endDate startDate)

let now () : DateTime = Stdlib.DateTime.__now ()

let today () : DateTime = Stdlib.DateTime.__today ()

let __padZero2 (value: Int64) : String =
    if value < 10 then "0" + Stdlib.Int64.toString value
    else Stdlib.Int64.toString value

let __padZero3 (value: Int64) : String =
    if value < 10 then "00" + Stdlib.Int64.toString value
    else if value < 100 then "0" + Stdlib.Int64.toString value
    else Stdlib.Int64.toString value

let __padZero4 (value: Int64) : String =
    if value < 10 then "000" + Stdlib.Int64.toString value
    else if value < 100 then "00" + Stdlib.Int64.toString value
    else if value < 1000 then "0" + Stdlib.Int64.toString value
    else Stdlib.Int64.toString value

let __calendarParts (date: DateTime) : (Int64 * Int64 * Int64) =
    Stdlib.DateTime.__civilFromDays (Stdlib.DateTime.__daysSinceEpoch date)

let toString (date: DateTime) : String =
    let parts = Stdlib.DateTime.__calendarParts date in
    let year = Stdlib.Tuple3.first parts in
    let month = Stdlib.Tuple3.second parts in
    let day = Stdlib.Tuple3.third parts in
    let withinDay = Stdlib.DateTime.__ticksWithinDay date in
    let hour = withinDay / Stdlib.DateTime.__ticksPerHour () in
    let minute = (withinDay / Stdlib.DateTime.__ticksPerMinute ()) % 60 in
    let second = (withinDay / Stdlib.DateTime.__ticksPerSecond ()) % 60 in
    let millisecond = (withinDay / Stdlib.DateTime.__ticksPerMillisecond ()) % 1000 in
    let dateAndTime =
        Stdlib.DateTime.__padZero4 year + "-" +
        Stdlib.DateTime.__padZero2 month + "-" +
        Stdlib.DateTime.__padZero2 day + "T" +
        Stdlib.DateTime.__padZero2 hour + ":" +
        Stdlib.DateTime.__padZero2 minute + ":" +
        Stdlib.DateTime.__padZero2 second in
    if millisecond == 0 then dateAndTime + "Z"
    else dateAndTime + "." + Stdlib.DateTime.__padZero3 millisecond + "Z"

let toStringISO8601BasicDate (date: DateTime) : String =
    let parts = Stdlib.DateTime.__calendarParts date in
    Stdlib.DateTime.__padZero4 (Stdlib.Tuple3.first parts) +
    Stdlib.DateTime.__padZero2 (Stdlib.Tuple3.second parts) +
    Stdlib.DateTime.__padZero2 (Stdlib.Tuple3.third parts)

let toStringISO8601BasicDateTime (date: DateTime) : String =
    let withinDay = Stdlib.DateTime.__ticksWithinDay date in
    Stdlib.DateTime.toStringISO8601BasicDate date + "T" +
    Stdlib.DateTime.__padZero2 (withinDay / Stdlib.DateTime.__ticksPerHour ()) +
    Stdlib.DateTime.__padZero2 ((withinDay / Stdlib.DateTime.__ticksPerMinute ()) % 60) +
    Stdlib.DateTime.__padZero2 ((withinDay / Stdlib.DateTime.__ticksPerSecond ()) % 60) + "Z"

let __digitAt (value: String) (index: Int64) : Stdlib.Result.Result<Int64, String> =
    if index >= Stdlib.String.__byteLength value then Error "Invalid date format"
    else
        let byte = Stdlib.String.__byteAtUnchecked value index in
        if byte >= 48 && byte <= 57 then Ok (byte - 48)
        else Error "Invalid date format"

let __parseDigits (value: String) (index: Int64) (remaining: Int64) (total: Int64) : Stdlib.Result.Result<(Int64 * Int64), String> =
    if remaining == 0 then Ok ((total, index))
    else
        match Stdlib.DateTime.__digitAt value index with
        | Error message -> Error message
        | Ok digit ->
            Stdlib.DateTime.__parseDigits value (index + 1) (remaining - 1) (total * 10 + digit)

let __hasByte (value: String) (index: Int64) (expected: Int64) : Bool =
    index < Stdlib.String.__byteLength value && Stdlib.String.__byteAtUnchecked value index == expected

let __isLeapYear (year: Int64) : Bool =
    if year % 4 != 0 then false
    else if year % 100 != 0 then true
    else year % 400 == 0

let __daysInMonth (month: Int64) (year: Int64) : Int64 =
    match month with
    | 1 -> 31
    | 2 -> if Stdlib.DateTime.__isLeapYear year then 29 else 28
    | 3 -> 31
    | 4 -> 30
    | 5 -> 31
    | 6 -> 30
    | 7 -> 31
    | 8 -> 31
    | 9 -> 30
    | 10 -> 31
    | 11 -> 30
    | 12 -> 31
    | _ -> 0

// Shared clock implementation.
/// Clock record decoding, scaling and interrupted-sleep retries in shared Dark.

let __timespec (bytes: Blob) : Result.Result<(Int * Int), Int> =
  let width = if Stdlib.Cli.Posix.__abiArm32 () then 4z else 8z
  let record = Stdlib.Blob.toList bytes
  Stdlib.Cli.Posix.__kernelSignedField record 0z width
  |> Stdlib.Result.andThen (fun seconds ->
    Stdlib.Cli.Posix.__kernelSignedField record width width
    |> Stdlib.Result.map (fun nanos -> (seconds, nanos)))

let __realtimeNanoseconds () : Result.Result<(Int * Int), Int> =
  if Builtin.runtimeTargetOS () == "browser" then
    let ticks = Builtin.runtimeRealtimeTicks ()
    Ok ((ticks / 10000000z, (ticks % 10000000z) * 100z))
  else if Stdlib.Cli.Posix.__abiMac () then
    Builtin.syscallGettimeofday ()
    |> Stdlib.Result.andThen (fun bytes ->
      let record = Stdlib.Blob.toList bytes
      Stdlib.Cli.Posix.__kernelSignedField record 0z 8z
      |> Stdlib.Result.andThen (fun seconds ->
        Stdlib.Cli.Posix.__kernelSignedField record 8z 4z
        |> Stdlib.Result.map (fun micros -> (seconds, micros * 1000z))))
  else Builtin.syscallClockGettime 0z |> Stdlib.Result.andThen __timespec

let __monotonicNanoseconds () : Result.Result<(Int * Int), Int> =
  if Builtin.runtimeTargetOS () == "browser" then
    let (ticks, frequency) = Builtin.runtimeMonotonicCounter ()
    if frequency <= 0z then Error 5z
    else Ok ((ticks / frequency, ((ticks % frequency) * 1000000000z) / frequency))
  else if Stdlib.Cli.Posix.__abiMac () then
    Builtin.syscallMachAbsoluteTime ()
    |> Stdlib.Result.andThen (fun bytes ->
      Stdlib.Cli.Posix.__kernelField (Stdlib.Blob.toList bytes) 0z 8z
      |> Stdlib.Result.andThen (fun ticks ->
        Builtin.syscallMachTimebaseInfo ()
        |> Stdlib.Result.andThen (fun base ->
          let record = Stdlib.Blob.toList base
          Stdlib.Cli.Posix.__kernelField record 0z 4z
          |> Stdlib.Result.andThen (fun numerator ->
            Stdlib.Cli.Posix.__kernelField record 4z 4z
            |> Stdlib.Result.andThen (fun denominator ->
              if denominator == 0z then Error 5z
              else
                let nanos = (ticks / denominator) * numerator + ((ticks % denominator) * numerator) / denominator
                Ok ((nanos / 1000000000z, nanos % 1000000000z)))))))
  else Builtin.syscallClockGettime 1z |> Stdlib.Result.andThen __timespec

let __monotonicMilliseconds () : Int =
  match __monotonicNanoseconds () with
  | Ok ((seconds, nanos)) -> seconds * 1000z + nanos / 1000000z
  | Error e -> Builtin.unwrap (Error e)

let __now () : DateTime =
  match __realtimeNanoseconds () with
  | Ok ((seconds, nanos)) -> Builtin.dateTimeFromUnixTicks (seconds * 10000000z + nanos / 100z)
  | Error e -> Builtin.unwrap (Error e)

let __today () : DateTime =
  let seconds = Stdlib.DateTime.__toSecondsInt (__now ())
  let remainder = seconds % 86400z
  let start = if remainder < 0z then seconds - remainder - 86400z else seconds - remainder
  Stdlib.DateTime.__fromSecondsInt start

let __sleepWith (sleep: Int -> Int -> (Int * Blob)) (seconds: Int) (nanos: Int)
  : Result.Result<Unit, Int> =
  let (rc, remaining) = sleep seconds nanos
  if rc == 0z then Ok ()
  else if rc == -4z then
    __timespec remaining |> Stdlib.Result.andThen (fun pair ->
      let (seconds, nanos) = pair
      __sleepWith sleep seconds nanos)
  else Error (0z - rc)

let __sleepNanoseconds (seconds: Int) (nanos: Int) : Result.Result<Unit, Int> =
  __sleepWith Builtin.syscallNanosleep seconds nanos

let __sleepMilliseconds (milliseconds: Float) : Unit =
  let nanos = Stdlib.Float64.toInt (milliseconds * 1000000.0)
  if Builtin.runtimeTargetOS () == "browser" then Builtin.runtimeDelayTicks (nanos / 100z)
  else __sleepNanoseconds (nanos / 1000000000z) (nanos % 1000000000z) |> Builtin.unwrap

// The interpreter's DateTime representation builtins, 100ns ticks since the Unix epoch.
let toUnixTicks (date: DateTime) : Int64 = Stdlib.DateTime.__ticks date
let fromUnixTicks (ticks: Int64) : DateTime = Stdlib.DateTime.__fromUnixTimeTicks ticks
