// __HttpWire.dark - Byte-bounded HTTP/1.1 and URL primitives written in Dark.

module Darklang.Stdlib.__HttpWire

type Url = {
    scheme: String,
    host: String,
    port: Int64,
    authority: String,
    target: String
}

let __asciiDigit(byte: Int64): Bool = byte >= 48 && byte <= 57

let __asciiHex(byte: Int64): Bool =
    Stdlib.__HttpWire.__asciiDigit(byte) ||
    (byte >= 65 && byte <= 70) ||
    (byte >= 97 && byte <= 102)

let __urlBytesValid(value: String, index: Int64, length: Int64): Bool =
    if index >= length then true
    else
        let byte = Stdlib.String.__byteAtUnchecked(value, index) in
        if byte <= 32 || byte >= 127 then false
        else if byte == 37 then
            index + 2 < length &&
            Stdlib.__HttpWire.__asciiHex(Stdlib.String.__byteAtUnchecked(value, index + 1)) &&
            Stdlib.__HttpWire.__asciiHex(Stdlib.String.__byteAtUnchecked(value, index + 2)) &&
            Stdlib.__HttpWire.__urlBytesValid(value, index + 3, length)
        else Stdlib.__HttpWire.__urlBytesValid(value, index + 1, length)

let __authorityEnd(value: String, index: Int64, length: Int64): Int64 =
    if index >= length then length
    else
        let byte = Stdlib.String.__byteAtUnchecked(value, index) in
        if byte == 47 || byte == 63 || byte == 35 then index
        else Stdlib.__HttpWire.__authorityEnd(value, index + 1, length)

let __hostByte(byte: Int64): Bool =
    Stdlib.__HttpWire.__asciiDigit(byte) ||
    (byte >= 65 && byte <= 90) ||
    (byte >= 97 && byte <= 122) ||
    byte == 45 || byte == 46

let __hostValid(host: String, index: Int64, length: Int64): Bool =
    if index >= length then true
    else
        Stdlib.__HttpWire.__hostByte(Stdlib.String.__byteAtUnchecked(host, index)) &&
        Stdlib.__HttpWire.__hostValid(host, index + 1, length)

let __hostLabelsValid(labels: List<String>): Bool =
    match labels with
    | [] -> true
    | label :: rest ->
        let length = Stdlib.String.__byteLength(label) in
        length > 0 && length <= 63 &&
        Stdlib.String.__byteAtUnchecked(label, 0) != 45 &&
        Stdlib.String.__byteAtUnchecked(label, length - 1) != 45 &&
        Stdlib.__HttpWire.__hostLabelsValid(rest)

let __ipv6GroupBytesValid(group: String, index: Int64, length: Int64): Bool =
    if index >= length then true
    else Stdlib.__HttpWire.__asciiHex(Stdlib.String.__byteAtUnchecked(group, index)) &&
        Stdlib.__HttpWire.__ipv6GroupBytesValid(group, index + 1, length)

let __ipv6GroupValid(group: String): Bool =
    let length = Stdlib.String.__byteLength(group) in
    length > 0 && length <= 4 &&
    Stdlib.__HttpWire.__ipv6GroupBytesValid(group, 0, length)

let __ipv6GroupsValid(groups: List<String>): Bool =
    match groups with
    | [] -> true
    | group :: rest ->
        Stdlib.__HttpWire.__ipv6GroupValid(group) &&
        Stdlib.__HttpWire.__ipv6GroupsValid(rest)

let __ipv6SideValid(side: String): Bool =
    side == "" || Stdlib.__HttpWire.__ipv6GroupsValid(Stdlib.String.split(side, ":"))

let __ipv6Valid(host: String): Bool =
    match Stdlib.String.splitFirst(host, "::") with
    | None ->
        let groups = Stdlib.String.split(host, ":") in
        Stdlib.List.__lengthInt(groups) == 8z && Stdlib.__HttpWire.__ipv6GroupsValid(groups)
    | Some((left, right)) ->
        if Stdlib.String.__containsBytes(right, "::") then false
        else
            let leftCount = if left == "" then 0z else Stdlib.List.__lengthInt(Stdlib.String.split(left, ":")) in
            let rightCount = if right == "" then 0z else Stdlib.List.__lengthInt(Stdlib.String.split(right, ":")) in
            leftCount + rightCount < 8z &&
            Stdlib.__HttpWire.__ipv6SideValid(left) && Stdlib.__HttpWire.__ipv6SideValid(right)

let __portDigits(value: String, index: Int64, length: Int64): Bool =
    if index >= length then true
    else
        Stdlib.__HttpWire.__asciiDigit(Stdlib.String.__byteAtUnchecked(value, index)) &&
        Stdlib.__HttpWire.__portDigits(value, index + 1, length)

let __parsePort(value: String, defaultPort: Int64): Stdlib.Result.Result<Int64, String> =
    if value == "" then Ok(defaultPort)
    else if Stdlib.Bool.not(Stdlib.__HttpWire.__portDigits(value, 0, Stdlib.String.__byteLength(value))) then
        Error("Invalid URL port")
    else
        match Stdlib.Int64.parse(value) with
        | Error(_) -> Error("Invalid URL port")
        | Ok(port) ->
            if port <= 0 || port > 65535 then Error("Invalid URL port") else Ok(port)

let __parseAuthority(authority: String, defaultPort: Int64): Stdlib.Result.Result<(String * Int64), String> =
    let length = Stdlib.String.__byteLength(authority) in
    if length == 0 || Stdlib.String.__containsBytes(authority, "@") then Error("Invalid URL authority")
    else if Stdlib.String.__byteAtUnchecked(authority, 0) == 91 then
        match Stdlib.String.splitFirst(authority, "]") with
        | None -> Error("Invalid URL authority")
        | Some((bracketed, suffix)) ->
            let host = Stdlib.String.__byteSlice(bracketed, 1, Stdlib.String.__byteLength(bracketed)) in
            if Stdlib.Bool.not(Stdlib.__HttpWire.__ipv6Valid(host)) then Error("Invalid URL host")
            else if suffix == "" then Ok((Stdlib.String.toLowercase(host), defaultPort))
            else if Stdlib.String.startsWith(suffix, ":") then
                match Stdlib.__HttpWire.__parsePort(Stdlib.String.__byteSlice(suffix, 1, Stdlib.String.__byteLength(suffix)), defaultPort) with
                | Error(message) -> Error(message)
                | Ok(port) -> Ok((Stdlib.String.toLowercase(host), port))
            else Error("Invalid URL authority")
    else
        let parts = Stdlib.String.split(authority, ":") in
        match parts with
        | [host] ->
            if host == "" || Stdlib.Bool.not(Stdlib.__HttpWire.__hostValid(host, 0, Stdlib.String.__byteLength(host))) ||
                Stdlib.Bool.not(Stdlib.__HttpWire.__hostLabelsValid(Stdlib.String.split(host, "."))) then
                Error("Invalid URL host")
            else Ok((Stdlib.String.toLowercase(host), defaultPort))
        | [host, portText] ->
            if host == "" || Stdlib.Bool.not(Stdlib.__HttpWire.__hostValid(host, 0, Stdlib.String.__byteLength(host))) ||
                Stdlib.Bool.not(Stdlib.__HttpWire.__hostLabelsValid(Stdlib.String.split(host, "."))) then
                Error("Invalid URL host")
            else if portText == "" then Error("Invalid URL port")
            else
                match Stdlib.__HttpWire.__parsePort(portText, defaultPort) with
                | Error(message) -> Error(message)
                | Ok(port) -> Ok((Stdlib.String.toLowercase(host), port))
        | _ -> Error("Invalid URL authority")

let __target(suffix: String): String =
    let withoutFragment =
        match Stdlib.String.splitFirst(suffix, "#") with
        | None -> suffix
        | Some((before, _)) -> before in
    if withoutFragment == "" then "/"
    else if Stdlib.String.startsWith(withoutFragment, "?") then "/" + withoutFragment
    else withoutFragment

let parseUrl(value: String): Stdlib.Result.Result<Stdlib.__HttpWire.Url, String> =
    let length = Stdlib.String.__byteLength(value) in
    if length == 0 || Stdlib.Bool.not(Stdlib.__HttpWire.__urlBytesValid(value, 0, length)) then Error("Invalid URL")
    else
        match Stdlib.String.splitFirst(value, "://") with
        | None -> Error("Invalid URL")
        | Some((rawScheme, rest)) ->
            let scheme = Stdlib.String.toLowercase(rawScheme) in
            if scheme != "http" && scheme != "https" then Error("Unsupported URL scheme")
            else
                let restLength = Stdlib.String.__byteLength(rest) in
                let end_ = Stdlib.__HttpWire.__authorityEnd(rest, 0, restLength) in
                let authority = Stdlib.String.__byteSlice(rest, 0, end_) in
                let suffix = Stdlib.String.__byteSlice(rest, end_, restLength) in
                let defaultPort = if scheme == "https" then 443 else 80 in
                match Stdlib.__HttpWire.__parseAuthority(authority, defaultPort) with
                | Error(message) -> Error(message)
                | Ok((host, port)) ->
                    let target = Stdlib.__HttpWire.__target(suffix) in
                    if Stdlib.String.startsWith(target, "/") then
                        Ok(Stdlib.__HttpWire.Url {
                            scheme = scheme, host = host, port = port,
                            authority = authority, target = target })
                    else Error("Invalid URL target")

type ParseError = Incomplete | Invalid of String

type ParsedResponse = {
    statusCode: Int64,
    headers: List<(String * String)>,
    body: Blob,
    remaining: Blob
}

let __lineEnd(blob: Blob, index: Int64, start: Int64, length: Int64): Stdlib.Result.Result<Int64, Stdlib.__HttpWire.ParseError> =
    if index - start > 8192 then Error(Stdlib.__HttpWire.ParseError.Invalid("HTTP line too long"))
    else if index >= length then Error(Stdlib.__HttpWire.ParseError.Incomplete)
    else
        let byte = Stdlib.Blob.__getByte(blob, index) in
        if byte == 13 then
            if index + 1 >= length then Error(Stdlib.__HttpWire.ParseError.Incomplete)
            else if Stdlib.Blob.__getByte(blob, index + 1) == 10 then Ok(index)
            else Error(Stdlib.__HttpWire.ParseError.Invalid("Malformed HTTP line ending"))
        else if byte == 10 || (byte < 32 && byte != 9) || byte > 126 then
            Error(Stdlib.__HttpWire.ParseError.Invalid("Invalid HTTP header byte"))
        else Stdlib.__HttpWire.__lineEnd(blob, index + 1, start, length)

let __line(blob: Blob, offset: Int64): Stdlib.Result.Result<(String * Int64), Stdlib.__HttpWire.ParseError> =
    let length = Stdlib.Blob.__byteLength(blob) in
    match Stdlib.__HttpWire.__lineEnd(blob, offset, offset, length) with
    | Error(error) -> Error(error)
    | Ok(end_) ->
        let bytes = Stdlib.Blob.slice(blob, Stdlib.Int.fromInt64(offset), Stdlib.Int.fromInt64(end_ - offset)) in
        match Stdlib.Blob.toString(bytes) with
        | Error(_) -> Error(Stdlib.__HttpWire.ParseError.Invalid("Invalid HTTP header byte"))
        | Ok(line) -> Ok((line, end_ + 2))

let __tokenByte(byte: Int64): Bool =
    Stdlib.__HttpWire.__asciiDigit(byte) ||
    (byte >= 65 && byte <= 90) ||
    (byte >= 97 && byte <= 122) ||
    byte == 33 || byte == 35 || byte == 36 || byte == 37 ||
    byte == 38 || byte == 39 || byte == 42 || byte == 43 ||
    byte == 45 || byte == 46 || byte == 94 || byte == 95 ||
    byte == 96 || byte == 124 || byte == 126

let __tokenValid(value: String, index: Int64, length: Int64): Bool =
    if index >= length then true
    else
        Stdlib.__HttpWire.__tokenByte(Stdlib.String.__byteAtUnchecked(value, index)) &&
        Stdlib.__HttpWire.__tokenValid(value, index + 1, length)

let __headers(blob: Blob, offset: Int64, count: Int64, start: Int64, acc: List<(String * String)>): Stdlib.Result.Result<(List<(String * String)> * Int64), Stdlib.__HttpWire.ParseError> =
    if count > 100 || offset - start > 65536 then
        Error(Stdlib.__HttpWire.ParseError.Invalid("HTTP headers too large"))
    else
        match Stdlib.__HttpWire.__line(blob, offset) with
        | Error(error) -> Error(error)
        | Ok((line, next)) ->
            if line == "" then Ok((Stdlib.List.reverse(acc), next))
            else if Stdlib.String.startsWith(line, " ") || Stdlib.String.startsWith(line, "\t") then
                Error(Stdlib.__HttpWire.ParseError.Invalid("Folded HTTP header"))
            else
                match Stdlib.String.splitFirst(line, ":") with
                | None -> Error(Stdlib.__HttpWire.ParseError.Invalid("Malformed HTTP header"))
                | Some((name, value)) ->
                    if name == "" || Stdlib.Bool.not(Stdlib.__HttpWire.__tokenValid(name, 0, Stdlib.String.__byteLength(name))) then
                        Error(Stdlib.__HttpWire.ParseError.Invalid("Malformed HTTP header"))
                    else
                        Stdlib.__HttpWire.__headers(blob, next, count + 1, start,
                            Stdlib.List.push(acc, (name, Stdlib.String.trim(value))))

let __status(line: String): Stdlib.Result.Result<Int64, Stdlib.__HttpWire.ParseError> =
    match Stdlib.String.splitFirst(line, " ") with
    | None -> Error(Stdlib.__HttpWire.ParseError.Invalid("Malformed HTTP status line"))
    | Some((version, rest)) ->
        if version != "HTTP/1.1" && version != "HTTP/1.0" then
            Error(Stdlib.__HttpWire.ParseError.Invalid("Unsupported HTTP version"))
        else if Stdlib.String.__byteLength(rest) < 3 then
            Error(Stdlib.__HttpWire.ParseError.Invalid("Malformed HTTP status line"))
        else
            let code = Stdlib.String.__byteSlice(rest, 0, 3) in
            let validSeparator =
                Stdlib.String.__byteLength(rest) == 3 ||
                Stdlib.String.__byteAtUnchecked(rest, 3) == 32 in
            if Stdlib.Bool.not(validSeparator) || Stdlib.Bool.not(Stdlib.__HttpWire.__portDigits(code, 0, 3)) then
                Error(Stdlib.__HttpWire.ParseError.Invalid("Malformed HTTP status line"))
            else
                match Stdlib.Int64.parse(code) with
                | Error(_) -> Error(Stdlib.__HttpWire.ParseError.Invalid("Malformed HTTP status line"))
                | Ok(status) ->
                    if status < 100 || status > 599 then
                        Error(Stdlib.__HttpWire.ParseError.Invalid("Invalid HTTP status"))
                    else Ok(status)

let __contentLength(headers: List<(String * String)>, found: Stdlib.Option.Option<Int64>): Stdlib.Result.Result<Stdlib.Option.Option<Int64>, Stdlib.__HttpWire.ParseError> =
    match headers with
    | [] -> Ok(found)
    | (name, value) :: rest ->
        if Stdlib.String.toLowercase(name) != "content-length" then
            Stdlib.__HttpWire.__contentLength(rest, found)
        else if value == "" || Stdlib.Bool.not(Stdlib.__HttpWire.__portDigits(value, 0, Stdlib.String.__byteLength(value))) then
            Error(Stdlib.__HttpWire.ParseError.Invalid("Invalid Content-Length"))
        else
            match Stdlib.Int64.parse(value) with
            | Error(_) -> Error(Stdlib.__HttpWire.ParseError.Invalid("Invalid Content-Length"))
            | Ok(length) ->
                if length > 104857600 then Error(Stdlib.__HttpWire.ParseError.Invalid("HTTP body too large"))
                else
                    match found with
                    | Some(previous) ->
                        if previous == length then Stdlib.__HttpWire.__contentLength(rest, found)
                        else Error(Stdlib.__HttpWire.ParseError.Invalid("Conflicting Content-Length"))
                    | None -> Stdlib.__HttpWire.__contentLength(rest, Some(length))

let __transferEncoding(headers: List<(String * String)>, seen: Bool): Stdlib.Result.Result<Bool, Stdlib.__HttpWire.ParseError> =
    match headers with
    | [] -> Ok(seen)
    | (name, value) :: rest ->
        if Stdlib.String.toLowercase(name) != "transfer-encoding" then
            Stdlib.__HttpWire.__transferEncoding(rest, seen)
        else if seen || Stdlib.String.toLowercase(Stdlib.String.trim(value)) != "chunked" then
            Error(Stdlib.__HttpWire.ParseError.Invalid("Unsupported Transfer-Encoding"))
        else Stdlib.__HttpWire.__transferEncoding(rest, true)

let __hexValue(byte: Int64): Int64 =
    if byte >= 48 && byte <= 57 then byte - 48
    else if byte >= 65 && byte <= 70 then byte - 55
    else if byte >= 97 && byte <= 102 then byte - 87
    else -1

let __chunkSizeDigits(value: String, index: Int64, length: Int64, acc: Int64): Stdlib.Result.Result<Int64, Stdlib.__HttpWire.ParseError> =
    if index >= length then Ok(acc)
    else
        let digit = Stdlib.__HttpWire.__hexValue(Stdlib.String.__byteAtUnchecked(value, index)) in
        if digit < 0 then Error(Stdlib.__HttpWire.ParseError.Invalid("Invalid chunk size"))
        else if acc > 6553600 then Error(Stdlib.__HttpWire.ParseError.Invalid("HTTP body too large"))
        else Stdlib.__HttpWire.__chunkSizeDigits(value, index + 1, length, acc * 16 + digit)

let __chunkSize(line: String): Stdlib.Result.Result<Int64, Stdlib.__HttpWire.ParseError> =
    let digits =
        match Stdlib.String.splitFirst(line, ";") with
        | None -> line
        | Some((before, _)) -> before in
    if digits == "" then Error(Stdlib.__HttpWire.ParseError.Invalid("Invalid chunk size"))
    else Stdlib.__HttpWire.__chunkSizeDigits(digits, 0, Stdlib.String.__byteLength(digits), 0)

let __chunksWithLimit(limit: Int64, blob: Blob, offset: Int64, total: Int64, count: Int64, acc: List<Blob>): Stdlib.Result.Result<(Blob * Int64), Stdlib.__HttpWire.ParseError> =
    if count > 100000 then Error(Stdlib.__HttpWire.ParseError.Invalid("Too many HTTP chunks"))
    else
        match Stdlib.__HttpWire.__line(blob, offset) with
        | Error(error) -> Error(error)
        | Ok((line, dataStart)) ->
            match Stdlib.__HttpWire.__chunkSize(line) with
            | Error(error) -> Error(error)
            | Ok(size) ->
                if size == 0 then
                    match Stdlib.__HttpWire.__headers(blob, dataStart, 0, dataStart, []) with
                    | Error(error) -> Error(error)
                    | Ok((_, next)) -> Ok((Stdlib.Blob.concat(Stdlib.List.reverse(acc)), next))
                else if total + size > limit then
                    Error(Stdlib.__HttpWire.ParseError.Invalid("HTTP body too large"))
                else
                    let length = Stdlib.Blob.__byteLength(blob) in
                    if dataStart + size + 2 > length then Error(Stdlib.__HttpWire.ParseError.Incomplete)
                    else if Stdlib.Blob.__getByte(blob, dataStart + size) != 13 ||
                            Stdlib.Blob.__getByte(blob, dataStart + size + 1) != 10 then
                        Error(Stdlib.__HttpWire.ParseError.Invalid("Malformed HTTP chunk"))
                    else
                        let chunk = Stdlib.Blob.slice(blob, Stdlib.Int.fromInt64(dataStart), Stdlib.Int.fromInt64(size)) in
                        Stdlib.__HttpWire.__chunksWithLimit(limit, blob, dataStart + size + 2, total + size, count + 1,
                            Stdlib.List.push(acc, chunk))

let __chunks(blob: Blob, offset: Int64, total: Int64, count: Int64, acc: List<Blob>): Stdlib.Result.Result<(Blob * Int64), Stdlib.__HttpWire.ParseError> =
    Stdlib.__HttpWire.__chunksWithLimit(104857600, blob, offset, total, count, acc)

let __responseAt(status: Int64, headers: List<(String * String)>, body: Blob, blob: Blob, next: Int64): Stdlib.__HttpWire.ParsedResponse =
    let length = Stdlib.Blob.__byteLength(blob) in
    Stdlib.__HttpWire.ParsedResponse {
        statusCode = status, headers = headers, body = body,
        remaining = Stdlib.Blob.slice(blob, Stdlib.Int.fromInt64(next), Stdlib.Int.fromInt64(length - next))
    }

type ResponseBodyMode =
    | NoBody
    | Fixed of Int64
    | Chunked
    | UntilClose

type ParsedResponseHead = {
    statusCode: Int64,
    headers: List<(String * String)>,
    mode: Stdlib.__HttpWire.ResponseBodyMode,
    remaining: Blob
}

let parseResponseHead(method: String, blob: Blob): Stdlib.Result.Result<Stdlib.__HttpWire.ParsedResponseHead, Stdlib.__HttpWire.ParseError> =
    match Stdlib.__HttpWire.__line(blob, 0) with
    | Error(error) -> Error(error)
    | Ok((statusLine, afterStatus)) ->
      match Stdlib.__HttpWire.__status(statusLine) with
      | Error(error) -> Error(error)
      | Ok(status) ->
        match Stdlib.__HttpWire.__headers(blob, afterStatus, 0, afterStatus, []) with
        | Error(error) -> Error(error)
        | Ok((headers, bodyStart)) ->
          match Stdlib.__HttpWire.__contentLength(headers, None) with
          | Error(error) -> Error(error)
          | Ok(maybeLength) ->
            match Stdlib.__HttpWire.__transferEncoding(headers, false) with
            | Error(error) -> Error(error)
            | Ok(chunked) ->
              if chunked && Stdlib.Option.isSome(maybeLength) then
                Error(Stdlib.__HttpWire.ParseError.Invalid("Ambiguous body framing"))
              else
                let noBody = method == "HEAD" || status < 200 ||
                             status == 204 || status == 304 in
                let mode =
                  if noBody then Stdlib.__HttpWire.ResponseBodyMode.NoBody
                  else if chunked then Stdlib.__HttpWire.ResponseBodyMode.Chunked
                  else match maybeLength with
                       | Some(size) -> Stdlib.__HttpWire.ResponseBodyMode.Fixed(size)
                       | None -> Stdlib.__HttpWire.ResponseBodyMode.UntilClose in
                Ok(Stdlib.__HttpWire.ParsedResponseHead {
                  statusCode = status, headers = headers, mode = mode,
                  remaining = Stdlib.Blob.slice(blob, Stdlib.Int.fromInt64(bodyStart),
                                Stdlib.Int.fromInt64(Stdlib.Blob.__byteLength(blob) - bodyStart)) })

let parseResponse(method: String, endOfStream: Bool, blob: Blob): Stdlib.Result.Result<Stdlib.__HttpWire.ParsedResponse, Stdlib.__HttpWire.ParseError> =
    match Stdlib.__HttpWire.__line(blob, 0) with
    | Error(error) -> Error(error)
    | Ok((statusLine, afterStatus)) ->
        match Stdlib.__HttpWire.__status(statusLine) with
        | Error(error) -> Error(error)
        | Ok(status) ->
            match Stdlib.__HttpWire.__headers(blob, afterStatus, 0, afterStatus, []) with
            | Error(error) -> Error(error)
            | Ok((headers, bodyStart)) ->
                let noBody = method == "HEAD" || status < 200 || status == 204 || status == 304 in
                match Stdlib.__HttpWire.__contentLength(headers, None) with
                | Error(error) -> Error(error)
                | Ok(maybeLength) ->
                    match Stdlib.__HttpWire.__transferEncoding(headers, false) with
                    | Error(error) -> Error(error)
                    | Ok(chunked) ->
                        if chunked && Stdlib.Option.isSome(maybeLength) then
                            Error(Stdlib.__HttpWire.ParseError.Invalid("Ambiguous body framing"))
                        else if noBody then
                            Ok(Stdlib.__HttpWire.__responseAt(status, headers, Stdlib.Blob.empty, blob, bodyStart))
                        else if chunked then
                            match Stdlib.__HttpWire.__chunks(blob, bodyStart, 0, 0, []) with
                            | Error(error) -> Error(error)
                            | Ok((body, next)) -> Ok(Stdlib.__HttpWire.__responseAt(status, headers, body, blob, next))
                        else
                            match maybeLength with
                            | Some(size) ->
                                let available = Stdlib.Blob.__byteLength(blob) - bodyStart in
                                if available < size then Error(Stdlib.__HttpWire.ParseError.Incomplete)
                                else
                                    let body = Stdlib.Blob.slice(blob, Stdlib.Int.fromInt64(bodyStart), Stdlib.Int.fromInt64(size)) in
                                    Ok(Stdlib.__HttpWire.__responseAt(status, headers, body, blob, bodyStart + size))
                            | None ->
                                if Stdlib.Bool.not(endOfStream) then Error(Stdlib.__HttpWire.ParseError.Incomplete)
                                else
                                    let size = Stdlib.Blob.__byteLength(blob) - bodyStart in
                                    if size > 104857600 then Error(Stdlib.__HttpWire.ParseError.Invalid("HTTP body too large"))
                                    else
                                        let body = Stdlib.Blob.slice(blob, Stdlib.Int.fromInt64(bodyStart), Stdlib.Int.fromInt64(size)) in
                                        Ok(Stdlib.__HttpWire.__responseAt(status, headers, body, blob, bodyStart + size))

type ParsedRequest = {
    method: String,
    target: String,
    version: String,
    headers: List<(String * String)>,
    body: Blob,
    remaining: Blob
}

let __requestLine(line: String): Stdlib.Result.Result<(String * String * String), Stdlib.__HttpWire.ParseError> =
    match Stdlib.String.split(line, " ") with
    | [method, target, version] ->
        if method == "" || Stdlib.Bool.not(Stdlib.__HttpWire.__tokenValid(method, 0, Stdlib.String.__byteLength(method))) then
            Error(Stdlib.__HttpWire.ParseError.Invalid("Invalid HTTP method"))
        else if target == "" ||
            (Stdlib.Bool.not(Stdlib.String.startsWith(target, "/")) && target != "*") ||
            Stdlib.String.__containsBytes(target, "#") then
            Error(Stdlib.__HttpWire.ParseError.Invalid("Invalid request target"))
        else if version != "HTTP/1.1" && version != "HTTP/1.0" then
            Error(Stdlib.__HttpWire.ParseError.Invalid("Unsupported HTTP version"))
        else Ok((method, target, version))
    | _ -> Error(Stdlib.__HttpWire.ParseError.Invalid("Malformed HTTP request line"))

let __hostCount(headers: List<(String * String)>, count: Int64, empty: Bool): (Int64 * Bool) =
    match headers with
    | [] -> (count, empty)
    | (name, value) :: rest ->
        if Stdlib.String.toLowercase(name) == "host" then
            Stdlib.__HttpWire.__hostCount(rest, count + 1, empty || value == "")
        else Stdlib.__HttpWire.__hostCount(rest, count, empty)

let __parsedRequest(method: String, target: String, version: String, headers: List<(String * String)>, body: Blob, wire: Blob, next: Int64): Stdlib.__HttpWire.ParsedRequest =
    let length = Stdlib.Blob.__byteLength(wire) in
    Stdlib.__HttpWire.ParsedRequest {
        method = method, target = target, version = version,
        headers = headers, body = body,
        remaining = Stdlib.Blob.slice(wire, Stdlib.Int.fromInt64(next), Stdlib.Int.fromInt64(length - next))
    }

let parseRequestWithLimit(limit: Int64, blob: Blob): Stdlib.Result.Result<Stdlib.__HttpWire.ParsedRequest, Stdlib.__HttpWire.ParseError> =
    match Stdlib.__HttpWire.__line(blob, 0) with
    | Error(error) -> Error(error)
    | Ok((requestLine, afterLine)) ->
        match Stdlib.__HttpWire.__requestLine(requestLine) with
        | Error(error) -> Error(error)
        | Ok((method, target, version)) ->
            match Stdlib.__HttpWire.__headers(blob, afterLine, 0, afterLine, []) with
            | Error(error) -> Error(error)
            | Ok((headers, bodyStart)) ->
                let (hostCount, emptyHost) = Stdlib.__HttpWire.__hostCount(headers, 0, false) in
                if hostCount > 1 then
                    Error(Stdlib.__HttpWire.ParseError.Invalid("Duplicate Host header"))
                else if emptyHost then
                    Error(Stdlib.__HttpWire.ParseError.Invalid("Empty Host header"))
                else if version == "HTTP/1.1" && hostCount == 0 then
                    Error(Stdlib.__HttpWire.ParseError.Invalid("Missing Host header"))
                else
                    match Stdlib.__HttpWire.__contentLength(headers, None) with
                    | Error(error) -> Error(error)
                    | Ok(maybeLength) ->
                        match Stdlib.__HttpWire.__transferEncoding(headers, false) with
                        | Error(error) -> Error(error)
                        | Ok(chunked) ->
                            if chunked then
                                match maybeLength with
                                | Some(_) -> Error(Stdlib.__HttpWire.ParseError.Invalid("Ambiguous body framing"))
                                | None ->
                                    match Stdlib.__HttpWire.__chunksWithLimit(limit, blob, bodyStart, 0, 0, []) with
                                    | Error(error) -> Error(error)
                                    | Ok((body, next)) ->
                                        Ok(Stdlib.__HttpWire.__parsedRequest(method, target, version, headers, body, blob, next))
                            else
                                match maybeLength with
                                | None ->
                                    Ok(Stdlib.__HttpWire.__parsedRequest(method, target, version, headers, Stdlib.Blob.empty, blob, bodyStart))
                                | Some(size) ->
                                    if size > limit then
                                        Error(Stdlib.__HttpWire.ParseError.Invalid("HTTP body too large"))
                                    else if Stdlib.Blob.__byteLength(blob) - bodyStart < size then
                                        Error(Stdlib.__HttpWire.ParseError.Incomplete)
                                    else
                                        let body = Stdlib.Blob.slice(blob, Stdlib.Int.fromInt64(bodyStart), Stdlib.Int.fromInt64(size)) in
                                        Ok(Stdlib.__HttpWire.__parsedRequest(method, target, version, headers, body, blob, bodyStart + size))

let parseRequest(blob: Blob): Stdlib.Result.Result<Stdlib.__HttpWire.ParsedRequest, Stdlib.__HttpWire.ParseError> =
    Stdlib.__HttpWire.parseRequestWithLimit(104857600, blob)

let __headerValueValid(value: String, index: Int64, length: Int64): Bool =
    if index >= length then true
    else
        let byte = Stdlib.String.__byteAtUnchecked(value, index) in
        // RFC 9110 field-vchar includes obs-text; CTL and DEL remain invalid.
        (byte == 9 || (byte >= 32 && byte != 127)) &&
        Stdlib.__HttpWire.__headerValueValid(value, index + 1, length)

let __writeHeaders(headers: List<(String * String)>, acc: String): Stdlib.Result.Result<String, String> =
    match headers with
    | [] -> Ok(acc)
    | (name, value) :: rest ->
        let lower = Stdlib.String.toLowercase(name) in
        if name == "" || Stdlib.Bool.not(Stdlib.__HttpWire.__tokenValid(name, 0, Stdlib.String.__byteLength(name))) then
            Error("Invalid HTTP header name")
        else if Stdlib.Bool.not(Stdlib.__HttpWire.__headerValueValid(value, 0, Stdlib.String.__byteLength(value))) then
            Error("Invalid HTTP header value")
        else if lower == "host" || lower == "content-length" || lower == "transfer-encoding" then
            Error("Managed HTTP header cannot be overridden")
        else Stdlib.__HttpWire.__writeHeaders(rest, acc + name + ": " + value + "\r\n")

let serializeRequest(method: String, url: Stdlib.__HttpWire.Url, headers: List<(String * String)>, body: Blob): Stdlib.Result.Result<Blob, String> =
    if method == "" || Stdlib.Bool.not(Stdlib.__HttpWire.__tokenValid(method, 0, Stdlib.String.__byteLength(method))) then
        Error("Invalid HTTP method")
    else if Stdlib.Blob.__byteLength(body) > 104857600 then Error("HTTP body too large")
    else
        match Stdlib.__HttpWire.__writeHeaders(headers, "") with
        | Error(message) -> Error(message)
        | Ok(extra) ->
            let head =
                method + " " + url.target + " HTTP/1.1\r\n" +
                "Host: " + url.authority + "\r\n" + extra +
                "Content-Length: " + Stdlib.Int64.toString(Stdlib.Blob.__byteLength(body)) + "\r\n\r\n" in
            Ok(Stdlib.Blob.concat([Stdlib.String.toBlob(head), body]))

let __reason(status: Int64): String =
    if status == 200 then "OK"
    else if status == 201 then "Created"
    else if status == 204 then "No Content"
    else if status == 301 then "Moved Permanently"
    else if status == 302 then "Found"
    else if status == 304 then "Not Modified"
    else if status == 400 then "Bad Request"
    else if status == 401 then "Unauthorized"
    else if status == 403 then "Forbidden"
    else if status == 404 then "Not Found"
    else if status == 413 then "Payload Too Large"
    else if status == 500 then "Internal Server Error"
    else ""

let serializeResponse(status: Int64, headers: List<(String * String)>, body: Blob): Stdlib.Result.Result<Blob, String> =
    if status < 100 || status > 599 then Error("Invalid HTTP status")
    else if Stdlib.Blob.__byteLength(body) > 104857600 then Error("HTTP body too large")
    else if (status < 200 || status == 204 || status == 304) && Stdlib.Blob.__byteLength(body) > 0 then
        Error("HTTP status cannot have a body")
    else
        match Stdlib.__HttpWire.__writeHeaders(headers, "") with
        | Error(message) -> Error(message)
        | Ok(extra) ->
            let contentLength =
                if status < 200 || status == 204 then ""
                else "Content-Length: " + Stdlib.Int64.toString(Stdlib.Blob.__byteLength(body)) + "\r\n" in
            let head =
                "HTTP/1.1 " + Stdlib.Int64.toString(status) + " " + Stdlib.__HttpWire.__reason(status) + "\r\n" +
                extra + contentLength + "\r\n" in
            Ok(Stdlib.Blob.concat([Stdlib.String.toBlob(head), body]))
