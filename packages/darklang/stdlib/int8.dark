// Stdlib.Int8.dark - Stdlib.Int8 definitions
//
// Split from stdlib.dark for modular stdlib loading.

module Darklang.Stdlib.Int8

type ParseError =
  | BadFormat
  | OutOfRange

// Stdlib.Int8 - Integer operations

let add(a: Int8, b: Int8): Int8 = a + b

let subtract(a: Int8, b: Int8): Int8 = a - b

let multiply(a: Int8, b: Int8): Int8 = a * b

let divide(a: Int8, b: Int8): Int8 =
    if b == 0s8 then Builtin.crash("Cannot divide by 0")
    else if a == -128s8 && b == -1s8 then -128s8
    else a / b

let max(a: Int8, b: Int8): Int8 = if a > b then a else b

let min(a: Int8, b: Int8): Int8 = if a < b then a else b

let mod(a: Int8, b: Int8): Int8 =
    if b == 0s8 then Builtin.crash("Cannot evaluate modulus against 0")
    else if b < 0s8 then Builtin.crash("Cannot evaluate modulus against a negative number")
    else a % b

let remainder(a: Int8, b: Int8): Stdlib.Result.Result<Int8, String> =
    if b == 0s8 then Error("Cannot divide by 0")
    else if b == -1s8 then Ok(0s8)
    else Ok(a - ((a / b) * b))

let absoluteValue(a: Int8): Int8 = if a < 0s8 then 0s8 - a else a

let negate(a: Int8): Int8 = 0s8 - a

let power(base: Int8, exponent: Int8): Int8 =
    if exponent < 0s8 then Builtin.crash("Cannot raise integer to a negative exponent")
    else
        let result =
            Stdlib.Int.__wrapSigned(Stdlib.Int.__power(Stdlib.Int.__fromInt8(base), Stdlib.Int.__fromInt8(exponent)), 8) in
        match Stdlib.Int.__toInt8(result) with
        | Some(value) -> value
        | None -> Builtin.crash("Internal Int8 power normalization invariant failed")

let clamp(value: Int8, limitA: Int8, limitB: Int8): Int8 =
    let lower = Stdlib.Int8.min(limitA, limitB) in
    let upper = Stdlib.Int8.max(limitA, limitB) in
    Stdlib.Int8.max(lower, Stdlib.Int8.min(upper, value))

let greaterThan(a: Int8, b: Int8): Bool = a > b

let greaterThanOrEqualTo(a: Int8, b: Int8): Bool = a >= b

let lessThan(a: Int8, b: Int8): Bool = a < b

let lessThanOrEqualTo(a: Int8, b: Int8): Bool = a <= b

// Count number of set bits (population count)
// Uses parallel bit counting algorithm (SWAR)
let __popcount(x: Int8): Int8 =
    let mask1 = 85s8 in
    let mask2 = 51s8 in
    let mask3 = 15s8 in
    let x = x - Stdlib.Int8.bitwiseAnd(Stdlib.Int8.shiftRight(x, 1s8), mask1) in
    let x = Stdlib.Int8.bitwiseAnd(x, mask2) + Stdlib.Int8.bitwiseAnd(Stdlib.Int8.shiftRight(x, 2s8), mask2) in
    let x = Stdlib.Int8.bitwiseAnd(x + Stdlib.Int8.shiftRight(x, 4s8), mask3) in
    x

// Convert a single digit (0y-9y) to its string representation
let __digitToString(n: Int8): String =
    match n with
    | 0s8 -> "0"
    | 1s8 -> "1"
    | 2s8 -> "2"
    | 3s8 -> "3"
    | 4s8 -> "4"
    | 5s8 -> "5"
    | 6s8 -> "6"
    | 7s8 -> "7"
    | 8s8 -> "8"
    | 9s8 -> "9"
    | _ -> "?"

// Convert an integer to its string representation
let toString(n: Int8): String =
    if n < 0s8 then
        if n < -9s8 then
            let quotient = n / 10s8 in
            Stdlib.Int8.toString(quotient) + Stdlib.Int8.__digitToString(0s8 - (n - (quotient * 10s8)))
        else "-" + Stdlib.Int8.__digitToString(0s8 - n)
    else if n < 10s8 then Stdlib.Int8.__digitToString(n)
    else Stdlib.Int8.toString(n / 10s8) + Stdlib.Int8.__digitToString(n % 10s8)

// Sum all integers in a list
let sum(list: List<Int8>): Int8 =
    Stdlib.List.fold(list, 0s8, fun(acc, x) -> acc + x)

let __fromIntUnchecked(value: Int): Int8 =
    match Stdlib.Int.toInt8(value) with
    | Some(result) -> result
    | None -> Builtin.crash("Internal Int8 conversion invariant failed")

let random(start: Int8, finish: Int8): Int8 =
    Stdlib.Int8.__fromIntUnchecked(Stdlib.Int.random(Stdlib.Int.fromInt8(start), Stdlib.Int.fromInt8(finish)))
let toFloat64(value: Int8): Float = Stdlib.Int.toFloat64(Stdlib.Int.fromInt8(value))
let sqrt(value: Int8): Float = Stdlib.Float64.sqrt(Stdlib.Int8.toFloat64(value))
let parse(value: String): Stdlib.Result.Result<Int8, Stdlib.Int8.ParseError> =
    match Stdlib.Int.parse(value) with
    | Error(_) -> Error(Stdlib.Int8.ParseError.BadFormat)
    | Ok(parsed) ->
        match Stdlib.Int.toInt8(parsed) with
        | None -> Error(Stdlib.Int8.ParseError.OutOfRange)
        | Some(result) -> Ok(result)

let fromUInt8(value: UInt8): Stdlib.Option.Option<Int8> = Stdlib.Int.toInt8(Stdlib.Int.fromUInt8(value))
let fromInt16(value: Int16): Stdlib.Option.Option<Int8> = Stdlib.Int.toInt8(Stdlib.Int.fromInt16(value))
let fromUInt16(value: UInt16): Stdlib.Option.Option<Int8> = Stdlib.Int.toInt8(Stdlib.Int.fromUInt16(value))
let fromInt32(value: Int32): Stdlib.Option.Option<Int8> = Stdlib.Int.toInt8(Stdlib.Int.fromInt32(value))
let fromUInt32(value: UInt32): Stdlib.Option.Option<Int8> = Stdlib.Int.toInt8(Stdlib.Int.fromUInt32(value))
let fromInt64(value: Int64): Stdlib.Option.Option<Int8> = Stdlib.Int.toInt8(Stdlib.Int.fromInt64(value))
let fromUInt64(value: UInt64): Stdlib.Option.Option<Int8> = Stdlib.Int.toInt8(Stdlib.Int.fromUInt64(value))
let fromInt128(value: Int128): Stdlib.Option.Option<Int8> = Stdlib.Int.toInt8(Stdlib.Int.fromInt128(value))
let fromUInt128(value: UInt128): Stdlib.Option.Option<Int8> = Stdlib.Int.toInt8(Stdlib.Int.fromUInt128(value))

// Trait implementations reuse the compiler's existing native operations.

impl Stdlib.Add for Int8 =
  let add = Stdlib.Int8.add

impl Stdlib.Subtract for Int8 =
  let subtract = Stdlib.Int8.subtract

impl Stdlib.Multiply for Int8 =
  let multiply = Stdlib.Int8.multiply

impl Stdlib.Divide for Int8 =
  let divide = Stdlib.Int8.divide

impl Stdlib.Modulo for Int8 =
  let modulo = Stdlib.Int8.mod

impl Stdlib.Power for Int8 =
  let power = Stdlib.Int8.power

impl Stdlib.Negate for Int8 =
  let negate = Stdlib.Int8.negate

impl Stdlib.BitwiseAnd for Int8 =
  let bitwiseAnd = Stdlib.Int8.bitwiseAnd

impl Stdlib.BitwiseOr for Int8 =
  let bitwiseOr = Stdlib.Int8.bitwiseOr

impl Stdlib.BitwiseXor for Int8 =
  let bitwiseXor = Stdlib.Int8.bitwiseXor

impl Stdlib.BitwiseNot for Int8 =
  let bitwiseNot = Stdlib.Int8.bitwiseNot

impl Stdlib.ShiftLeft for Int8 =
  let shiftLeft = Stdlib.Int8.shiftLeft

impl Stdlib.ShiftRight for Int8 =
  let shiftRight = Stdlib.Int8.shiftRight

impl Stdlib.Display for Int8 =
  let display = Stdlib.Int8.toString

impl Stdlib.Compare for Int8 =
  let lessThan = Stdlib.Int8.lessThan
  let lessThanOrEqualTo = Stdlib.Int8.lessThanOrEqualTo
  let greaterThan = Stdlib.Int8.greaterThan
  let greaterThanOrEqualTo = Stdlib.Int8.greaterThanOrEqualTo

impl Stdlib.Zero for Int8 =
  let zero(): Int8 = 0s8

impl Stdlib.One for Int8 =
  let one(): Int8 = 1s8
