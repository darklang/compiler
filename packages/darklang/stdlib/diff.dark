// Diff.dark - interpreter-compatible line-oriented longest-common-subsequence diffing.

module Darklang.Stdlib.Diff

type DiffLine =
  | Same of String
  | Added of String
  | Removed of String

// Safely index a two-dimensional table. Invalid public Int indices retain the
// interpreter's out-of-range default through the canonical List.getAt boundary.
let tableGet(table: List<List<Int>>, row: Int, col: Int): Int =
    let selectedRow = Stdlib.Option.withDefault(Stdlib.List.__getAtInt(table, row), []) in
    Stdlib.Option.withDefault(Stdlib.List.__getAtInt(selectedRow, col), 0z)

// Build the LCS length table. Equality deliberately chooses the upper cell.
let buildTable(oldLines: List<String>, newLines: List<String>): List<List<Int>> =
    let zeroRow =
        Stdlib.List.map(Stdlib.List.__rangeInt(0z, Stdlib.List.__lengthInt(oldLines)), fun _i -> 0z) in
    Stdlib.List.fold(newLines, [zeroRow], fun(table, newLine) ->
        let prevRow = Stdlib.Option.withDefault(Stdlib.List.last(table), []) in
        let pairs = Stdlib.List.__indexedMapInt(oldLines, fun(i, oldLine) -> (i, oldLine)) in
        let nextRow =
            Stdlib.List.fold(pairs, [0z], fun(row, pair) ->
                let (i, oldLine) = pair in
                let above = Stdlib.Option.withDefault(Stdlib.List.__getAtInt(prevRow, i + 1z), 0z) in
                let diag = Stdlib.Option.withDefault(Stdlib.List.__getAtInt(prevRow, i), 0z) in
                let left = Stdlib.Option.withDefault(Stdlib.List.last(row), 0z) in
                let cell =
                    if oldLine == newLine then diag + 1z
                    else if above >= left then above
                    else left in
                Stdlib.List.concat(row, [cell])) in
        Stdlib.List.concat(table, [nextRow]))

// Walk the table backwards and append each classified line in source order.
let trace(oldLines: List<String>, newLines: List<String>, table: List<List<Int>>, i: Int, j: Int): List<Darklang.Stdlib.Diff.DiffLine> =
    if i == 0z && j == 0z then
        []
    else if i > 0z && j > 0z then
        let oldLine = Stdlib.Option.withDefault(Stdlib.List.__getAtInt(oldLines, i - 1z), "") in
        let newLine = Stdlib.Option.withDefault(Stdlib.List.__getAtInt(newLines, j - 1z), "") in
        if oldLine == newLine then
            Stdlib.List.concat(Darklang.Stdlib.Diff.trace(oldLines, newLines, table, i - 1z, j - 1z), [Darklang.Stdlib.Diff.DiffLine.Same(oldLine)])
        else
            let up = Darklang.Stdlib.Diff.tableGet(table, j - 1z, i) in
            let left = Darklang.Stdlib.Diff.tableGet(table, j, i - 1z) in
            if up >= left then
                Stdlib.List.concat(Darklang.Stdlib.Diff.trace(oldLines, newLines, table, i, j - 1z), [Darklang.Stdlib.Diff.DiffLine.Added(newLine)])
            else
                Stdlib.List.concat(Darklang.Stdlib.Diff.trace(oldLines, newLines, table, i - 1z, j), [Darklang.Stdlib.Diff.DiffLine.Removed(oldLine)])
    else if j > 0z then
        let newLine = Stdlib.Option.withDefault(Stdlib.List.__getAtInt(newLines, j - 1z), "") in
        Stdlib.List.concat(Darklang.Stdlib.Diff.trace(oldLines, newLines, table, i, j - 1z), [Darklang.Stdlib.Diff.DiffLine.Added(newLine)])
    else
        let oldLine = Stdlib.Option.withDefault(Stdlib.List.__getAtInt(oldLines, i - 1z), "") in
        Stdlib.List.concat(Darklang.Stdlib.Diff.trace(oldLines, newLines, table, i - 1z, j), [Darklang.Stdlib.Diff.DiffLine.Removed(oldLine)])

let lines(oldText: String, newText: String): List<Darklang.Stdlib.Diff.DiffLine> =
    let oldLines = Stdlib.String.split(oldText, "\n") in
    let newLines = Stdlib.String.split(newText, "\n") in
    let table = Darklang.Stdlib.Diff.buildTable(oldLines, newLines) in
    Darklang.Stdlib.Diff.trace(oldLines, newLines, table, Stdlib.List.__lengthInt(oldLines), Stdlib.List.__lengthInt(newLines))
