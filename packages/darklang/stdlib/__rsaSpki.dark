// Stdlib.__RsaSpki.dark - strict DER rsaEncryption SubjectPublicKeyInfo parsing.

module Darklang.Stdlib.__RsaSpki

type PublicKey = { modulus: Blob, exponent: Blob }

let __lengthBytes(data: Blob, index: Int64, remaining: Int64, limit: Int64, value: Int64): Stdlib.Option.Option<(Int64 * Int64)> =
  if remaining == 0 then Some((index, value))
  else if index >= limit || value > 1048576 then None
  else Stdlib.__RsaSpki.__lengthBytes(data, index + 1, remaining - 1,
         limit, value * 256 + Stdlib.Blob.__getByte(data, index))

// Returns the content start and exclusive end, bounded by the containing TLV.
let __tlv(data: Blob, offset: Int64, limit: Int64, tag: Int64): Stdlib.Option.Option<(Int64 * Int64)> =
  if offset < 0 || limit > Stdlib.Blob.__byteLength(data)
     || offset + 2 > limit || Stdlib.Blob.__getByte(data, offset) != tag then None
  else
    let first = Stdlib.Blob.__getByte(data, offset + 1) in
    let parsed =
      if first < 128 then Some((offset + 2, first))
      else
        let count = first - 128 in
        if count == 0 || count > 4 || offset + 2 + count > limit
           || Stdlib.Blob.__getByte(data, offset + 2) == 0 then None
        else Stdlib.__RsaSpki.__lengthBytes(data, offset + 2, count, limit, 0) in
    match parsed with
    | None -> None
    | Some((start, length)) ->
      if length < 0 || length > 1048576 || length > limit - start
         || (first >= 128 && length < 128) then None
      else Some((start, start + length))

let __algorithm(data: Blob, start: Int64, end_: Int64): Bool =
  match Stdlib.__RsaSpki.__tlv(data, start, end_, 6) with
  | None -> false
  | Some((oidStart, oidEnd)) ->
    let oid = Stdlib.Blob.slice(data, Stdlib.Int.fromInt64(oidStart),
                Stdlib.Int.fromInt64(oidEnd - oidStart)) in
    if Stdlib.Blob.toHex(oid) != "2A864886F70D010101" then false
    else
      match Stdlib.__RsaSpki.__tlv(data, oidEnd, end_, 5) with
      | Some((nullStart, nullEnd)) -> nullStart == nullEnd && nullEnd == end_
      | None -> false

let __positiveInteger(data: Blob, offset: Int64, limit: Int64): Stdlib.Option.Option<(Blob * Int64)> =
  match Stdlib.__RsaSpki.__tlv(data, offset, limit, 2) with
  | None -> None
  | Some((start, end_)) ->
    if start == end_ then None
    else
      let first = Stdlib.Blob.__getByte(data, start) in
      let contentStart =
        if first == 0 then
          if start + 1 == end_ || Stdlib.Blob.__getByte(data, start + 1) < 128
          then -1 else start + 1
        else if first >= 128 then -1
        else start in
      if contentStart < 0 then None
      else Some((Stdlib.Blob.slice(data, Stdlib.Int.fromInt64(contentStart),
                    Stdlib.Int.fromInt64(end_ - contentStart)), end_))

let __rsaKey(data: Blob, offset: Int64, limit: Int64): Stdlib.Option.Option<Stdlib.__RsaSpki.PublicKey> =
  match Stdlib.__RsaSpki.__tlv(data, offset, limit, 48) with
  | None -> None
  | Some((start, end_)) ->
    if end_ != limit then None
    else
      match Stdlib.__RsaSpki.__positiveInteger(data, start, end_) with
      | None -> None
      | Some((modulus, exponentStart)) ->
        match Stdlib.__RsaSpki.__positiveInteger(data, exponentStart, end_) with
        | None -> None
        | Some((exponent, keyEnd)) ->
          let nLength = Stdlib.Blob.__byteLength(modulus) in
          let eLength = Stdlib.Blob.__byteLength(exponent) in
          if keyEnd != end_ || nLength < 256 || nLength > 1024
             || Stdlib.Blob.__getByte(modulus, 0) < 128
             || Stdlib.Blob.__getByte(modulus, nLength - 1) % 2 == 0
             || eLength == 0 || eLength > 4
             || Stdlib.Blob.__getByte(exponent, 0) == 0
             || Stdlib.Blob.__getByte(exponent, eLength - 1) % 2 == 0
             || (eLength == 1 && Stdlib.Blob.__getByte(exponent, 0) < 3) then None
          else Some(Stdlib.__RsaSpki.PublicKey { modulus = modulus, exponent = exponent })

let parse(spki: Blob): Stdlib.Result.Result<Stdlib.__RsaSpki.PublicKey, String> =
  let length = Stdlib.Blob.__byteLength(spki) in
  if length > 1100 then Error("Invalid RSA SubjectPublicKeyInfo")
  else
    match Stdlib.__RsaSpki.__tlv(spki, 0, length, 48) with
    | None -> Error("Invalid RSA SubjectPublicKeyInfo")
    | Some((start, end_)) ->
      if end_ != length then Error("Invalid RSA SubjectPublicKeyInfo")
      else
        match Stdlib.__RsaSpki.__tlv(spki, start, end_, 48) with
        | None -> Error("Invalid RSA SubjectPublicKeyInfo")
        | Some((algorithmStart, algorithmEnd)) ->
          if Stdlib.Bool.not(Stdlib.__RsaSpki.__algorithm(spki, algorithmStart, algorithmEnd)) then
            Error("Invalid RSA SubjectPublicKeyInfo")
          else
            match Stdlib.__RsaSpki.__tlv(spki, algorithmEnd, end_, 3) with
            | None -> Error("Invalid RSA SubjectPublicKeyInfo")
            | Some((bitStart, bitEnd)) ->
              if bitEnd != end_ || bitStart >= bitEnd
                 || Stdlib.Blob.__getByte(spki, bitStart) != 0 then
                Error("Invalid RSA SubjectPublicKeyInfo")
              else
                match Stdlib.__RsaSpki.__rsaKey(spki, bitStart + 1, bitEnd) with
                | None -> Error("Invalid RSA SubjectPublicKeyInfo")
                | Some(key) -> Ok(key)
