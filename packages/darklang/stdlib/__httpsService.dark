// __HttpsService.dark - RFC 9460 HTTPS RDATA validation and explicitly advertised HTTP/3 endpoints.
module Darklang.Stdlib.__HttpsService

type Service = { priority: Int64, host: String, port: Int64, ipv4: List<List<Int64>>, ipv6: List<List<Int64>> }
type Record = Alias of String | Service of Stdlib.__HttpsService.Service
type Parameters = {
  seen: List<Int64>, mandatory: List<Int64>, h3: Bool, port: Int64,
  ipv4: List<List<Int64>>, ipv6: List<List<Int64>>
}

// TargetName is never compressed, including when it is the root name.
let __target (data: Blob) (position: Int64) (parts: List<String>) (length: Int64)
  : Stdlib.Result.Result<(String * Int64), String> =
  if position >= Stdlib.Blob.__byteLength data || length > 253 then Error "Invalid HTTPS target name"
  else
    let size = Stdlib.Blob.__getByte data position in
    if size == 0 then Ok ((Stdlib.String.join (Stdlib.List.reverse parts) ".", position + 1))
    else if size > 63 || size > Stdlib.Blob.__byteLength data - position - 1 then Error "Invalid HTTPS target name"
    else
      match Stdlib.Blob.toString (Stdlib.__Http2Wire.__slice data (position + 1) size) with
      | Error _ -> Error "Invalid HTTPS target name"
      | Ok label ->
        if Stdlib.Bool.not (Stdlib.__DnsWire.__validLabel label 0 size) then Error "Invalid HTTPS target name"
        else Stdlib.__HttpsService.__target data (position + 1 + size) (Stdlib.List.push parts (Stdlib.String.toLowercase label)) (length + size + (if parts == [] then 0 else 1))

let __alpn (data: Blob) (position: Int64) (h3: Bool) : Stdlib.Result.Result<Bool, String> =
  if position == Stdlib.Blob.__byteLength data then Ok h3
  else
    let size = Stdlib.Blob.__getByte data position in
    if size == 0 || size > Stdlib.Blob.__byteLength data - position - 1 then Error "Invalid HTTPS ALPN list"
    else
      let selected = if size != 2 then false else
        Stdlib.Blob.__getByte data (position + 1) == 104 && Stdlib.Blob.__getByte data (position + 2) == 51 in
      Stdlib.__HttpsService.__alpn data (position + 1 + size) (h3 || selected)

let __mandatory (data: Blob) (position: Int64) (previous: Int64) (keys: List<Int64>)
  : Stdlib.Result.Result<List<Int64>, String> =
  if position == Stdlib.Blob.__byteLength data then Ok (Stdlib.List.reverse keys)
  else
    let key = Stdlib.__DnsWire.__u16 data position in
    if key <= previous then Error "Invalid HTTPS mandatory keys"
    else Stdlib.__HttpsService.__mandatory data (position + 2) key (Stdlib.List.push keys key)

let __addresses (data: Blob) (position: Int64) (width: Int64) (addresses: List<List<Int64>>)
  : List<List<Int64>> =
  if position == Stdlib.Blob.__byteLength data then Stdlib.List.reverse addresses
  else Stdlib.__HttpsService.__addresses data (position + width) width (Stdlib.List.push addresses (Stdlib.Blob.__toInt64List (Stdlib.__Http2Wire.__slice data position width)))

let __parameter (state: Stdlib.__HttpsService.Parameters) (key: Int64) (data: Blob)
  : Stdlib.Result.Result<Stdlib.__HttpsService.Parameters, String> =
  let size = Stdlib.Blob.__byteLength data in
  if key == 0 then
    if size == 0 || size % 2 != 0 || size > 128 then Error "Invalid HTTPS mandatory keys"
    else Stdlib.__HttpsService.__mandatory data 0 0 [] |> Stdlib.Result.map (fun keys -> { state with mandatory = keys })
  else if key == 1 then
    if size == 0 then Error "Invalid HTTPS ALPN list"
    else Stdlib.__HttpsService.__alpn data 0 false |> Stdlib.Result.map (fun h3 -> { state with h3 = h3 })
  else if key == 2 then
    if size != 0 then Error "Invalid HTTPS no-default-alpn value" else Ok state
  else if key == 3 then
    if size != 2 then Error "Invalid HTTPS port value" else Ok { state with port = Stdlib.__DnsWire.__u16 data 0 }
  else if key == 4 || key == 6 then
    let width = if key == 4 then 4 else 16 in
    if size == 0 || size % width != 0 || size / width > 16 then Error "Invalid HTTPS address hints"
    else
      let addresses = Stdlib.__HttpsService.__addresses data 0 width [] in
      if key == 4 then Ok { state with ipv4 = addresses } else Ok { state with ipv6 = addresses }
  else Ok state

let __parameters (data: Blob) (position: Int64) (previous: Int64) (state: Stdlib.__HttpsService.Parameters)
  : Stdlib.Result.Result<Stdlib.__HttpsService.Parameters, String> =
  if position == Stdlib.Blob.__byteLength data then Ok state
  else if Stdlib.List.__lengthInt state.seen >= 64z then Error "Too many HTTPS service parameters"
  else if Stdlib.Blob.__byteLength data - position < 4 then Error "Truncated HTTPS service parameter"
  else
    let key = Stdlib.__DnsWire.__u16 data position in
    let size = Stdlib.__DnsWire.__u16 data (position + 2) in
    if key <= previous then Error "Unordered HTTPS service parameters"
    else if size > Stdlib.Blob.__byteLength data - position - 4 then Error "Truncated HTTPS service parameter"
    else
      let next = { state with seen = Stdlib.List.push state.seen key } in
      Stdlib.__HttpsService.__parameter next key (Stdlib.__Http2Wire.__slice data (position + 4) size)
        |> Stdlib.Result.andThen (fun parameters -> Stdlib.__HttpsService.__parameters data (position + 4 + size) key parameters)

// Malformed RDATA rejects the RRset; unknown mandatory keys only make this RR incompatible.
// An absent ALPN or one advertising h2/http1 alone never triggers a QUIC probe.
let parse (owner: String) (port: Int64) (data: Blob)
  : Stdlib.Result.Result<Stdlib.Option.Option<Stdlib.__HttpsService.Record>, String> =
  if port < 1 || port > 65535 || owner == "" then Error "Invalid HTTPS service origin"
  else if Stdlib.Blob.__byteLength data < 3 || Stdlib.Blob.__byteLength data > 4096 then Error "Invalid HTTPS service record size"
  else
    let priority = Stdlib.__DnsWire.__u16 data 0 in
    Stdlib.__HttpsService.__target data 2 [] 0 |> Stdlib.Result.andThen (fun target ->
      let (host, position) = target in
      if priority == 0 then
        if host == "" then Ok None else Ok (Some (Alias host))
      else
        let initial = Stdlib.__HttpsService.Parameters { seen = [], mandatory = [], h3 = false,
          port = port, ipv4 = [], ipv6 = [] } in
        Stdlib.__HttpsService.__parameters data position -1 initial |> Stdlib.Result.andThen (fun parameters ->
          if Stdlib.List.any parameters.mandatory (fun key -> Stdlib.Bool.not (Stdlib.List.contains parameters.seen key)) then
            Error "Missing mandatory HTTPS service parameter"
          else if Stdlib.List.contains parameters.seen 2 && Stdlib.Bool.not (Stdlib.List.contains parameters.seen 1) then
            Error "HTTPS no-default-alpn without ALPN"
          else if parameters.h3 == false || parameters.port == 0 ||
            Stdlib.List.any parameters.mandatory (fun key -> key != 1 && key != 2 && key != 3 && key != 4 && key != 6) then Ok None
          else Ok (Some (Service (Stdlib.__HttpsService.Service { priority = priority,
            host = if host == "" then owner else host, port = parameters.port,
            ipv4 = parameters.ipv4, ipv6 = parameters.ipv6 })))))
