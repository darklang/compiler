        else Stdlib.String.append("Unknown error ", __decimal(errno))
    Stdlib.Cli.Posix.Error { errno = Stdlib.Int.__toInt64Unchecked(errno)
                            message = message }


/// Complete a descriptor write when the kernel accepts only part of a buffer.

let __writeAll(write: Blob -> Result.Result<Int, Stdlib.Cli.Posix.Error>, bytes: Blob, written: Int): Result.Result<Int, Stdlib.Cli.Posix.Error> =
  let length = Stdlib.Blob.length(bytes)
  if length == 0z then Stdlib.Result.Result.Ok(written)
  else
    match write(bytes) with
    | Error(error) ->
      if error.errno == 4 then __writeAll(write, bytes, written)
      else Stdlib.Result.Result.Error(error)
    | Ok(count) ->
      if count <= 0z || count > length then
        Stdlib.Result.Result.Error(Stdlib.Cli.Posix.Error {
          errno = 5, message = "write made invalid progress" })
      else if count == length then Stdlib.Result.Result.Ok(written + count)
      else
        let rest = Stdlib.Blob.slice(bytes, count, length - count)
        __writeAll(write, rest, written + count)


/// Account-file parsing ported from the compiler's Cli.Env implementation.

let __accountFieldFromPasswd(lines: List<String>, uid: String, index: Int): Stdlib.Option.Option<String> =
  match lines with
  | [] -> Stdlib.Option.Option.None
  | line :: rest ->
    let fields = Stdlib.String.split(line, ":")
    match (Stdlib.List.__getAtInt(fields, 2z), Stdlib.List.__getAtInt(fields, index)) with
    | (Some(candidateUid), Some(value)) ->
      if candidateUid == uid then Stdlib.Option.Option.Some(value)
      else __accountFieldFromPasswd(rest, uid, index)
    | _ -> __accountFieldFromPasswd(rest, uid, index)

/// Reading the fixed account file uses the ordinary checked filesystem boundary.
let __accountLookup(uid: String, index: Int): Stdlib.Option.Option<String> =
  match Stdlib.Cli.FileSystem.readFileAsString("/etc/passwd") with
  | Ok(contents) -> __accountFieldFromPasswd(Stdlib.String.splitOnNewline(contents), uid, index)
  | Error(_) -> Stdlib.Option.Option.None


/// Collision retries for exclusive temporary-entry creation.

let __tempEntropy(remaining: Int, reversed: List<Blob>): Result.Result<Blob, Int> =
  if remaining == 0z then Ok(Stdlib.Blob.concat(Stdlib.List.reverse(reversed)))
  else
    match Builtin.syscallGetentropy(remaining) with
    | Error(e) -> if e == 4z then __tempEntropy(remaining, reversed) else Error(e)
    | Ok(bytes) ->
      let count = Stdlib.Blob.length(bytes)
      if count <= 0z || count > remaining then Error(5z)
      else __tempEntropy(remaining - count, Stdlib.List.push(reversed, bytes))

let __tempCandidate(prefix: String): Result.Result<String, Stdlib.Cli.Posix.Error> =
  __tempEntropy(12z, [])
  |> Stdlib.Result.mapError(__fromErrno)
  |> Stdlib.Result.map(fun bytes -> Stdlib.String.append(prefix, Stdlib.Blob.toHex(bytes)))

let __tempRetry(create: Int -> Result.Result<'a, Stdlib.Cli.Posix.Error>, remaining: Int): Result.Result<'a, Stdlib.Cli.Posix.Error> =
  match create(remaining) with
  | Error(error) ->
    if error.errno == 17 && remaining > 0z then __tempRetry(create, remaining - 1z)
    else Stdlib.Result.Result.Error(error)
  | Ok(value) -> Stdlib.Result.Result.Ok(value)

/// Suffix creation and collision policy are shared Dark algorithms. O_EXCL is
/// what makes creation safe; randomness alone does not protect against races.
let __tempFile(prefix: String): Result.Result<(Int * String), Stdlib.Cli.Posix.Error> =
  __tempRetry((fun _ ->
    __tempCandidate(prefix)
    |> Stdlib.Result.andThen(fun path ->
      let flags = 2z | Stdlib.Cli.Posix.__abiOpenCreate()
                    | Stdlib.Cli.Posix.__abiOpenExclusive()
      Stdlib.Cli.Posix.openFile(path, flags, 384z)
      |> Stdlib.Result.map(fun fd -> (fd, path)))), 100z)

let __tempDirectory(prefix: String): Result.Result<String, Stdlib.Cli.Posix.Error> =
  __tempRetry((fun _ ->
    __tempCandidate(prefix)
    |> Stdlib.Result.andThen(fun path ->
      Stdlib.Cli.Posix.mkdir(path, 448z)
      |> Stdlib.Result.map(fun _ -> path))), 100z)


let __uname(): Result.Result<(String * String * String), Posix.Error> =
  let result =
    if Builtin.runtimeTargetOS() == "browser" then Ok(("Browser", "browser", "wasm32"))
    else if Stdlib.Cli.Posix.__abiMac() then
      Stdlib.Cli.Sys.__sysctlText([1z, 1z])
      |> Stdlib.Result.andThen(fun os ->
        Stdlib.Cli.Sys.__sysctlText([1z, 10z])
        |> Stdlib.Result.andThen(fun host ->
          Stdlib.Cli.Sys.__sysctlText([6z, 1z])
          |> Stdlib.Result.map(fun machine -> (os, host, machine))))
    else
      Builtin.syscallUname()
      |> Stdlib.Result.andThen(fun bytes ->
        if Stdlib.Blob.length(bytes) < 390z then Error(5z)
        else Ok((Stdlib.Cli.Sys.__text(bytes, 0z, 65z), Stdlib.Cli.Sys.__text(bytes, 65z, 65z), Stdlib.Cli.Sys.__text(bytes, 260z, 65z))))
  result |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)
