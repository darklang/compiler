/// Posix wrappers for filesystem, process, and system operations.
/// Linux (x86_64, aarch64, armv7) and macOS only. Will not work on Windows.
module Darklang.Stdlib.Cli.Posix


/// Structured error from posix operations, carrying the errno code.
type Error =
  { errno: Int64
    message: String }

/// Result of a stat() call.
type StatResult =
  { mode: Int
    size: Int
    mtimeSec: Int }

/// Standard permission modes
// -- Open flags ---------------------------------------------------
/// Open a file. Returns a file descriptor.
let openFile(path: String, flags: Int, mode: Int): Result.Result<Int, Error> =
  Builtin.syscallOpen(path, flags, mode)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Read up to `count` bytes from an open file descriptor.
let fdRead(fd: Int, count: Int): Result.Result<Blob, Error> =
  Builtin.syscallRead(fd, count)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Write <param bytes> to an open file descriptor. Returns the number
/// of bytes written.
let fdWrite(fd: Int, bytes: Blob): Result.Result<Int, Error> =
  Stdlib.Cli.Posix.__writeAll((fun chunk -> Builtin.syscallWrite(fd, chunk) |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)), bytes, 0z)


/// Close an open file descriptor.
let fdClose(fd: Int): Result.Result<Unit, Error> =
  Builtin.syscallClose(fd)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Read all bytes from a file descriptor until EOF.
/// Accumulates chunks (as Blobs) and concats once at EOF.
let fdReadAll(fd: Int, acc: List<Blob>): Result.Result<Blob, Error> =
  (fdRead(fd, 4096z))
  |> Stdlib.Result.andThen(fun chunk ->
    if Stdlib.Blob.length(chunk) == 0z then
      Stdlib.Result.Result.Ok(Stdlib.Blob.concat(acc))
    else
      fdReadAll(fd, Stdlib.List.concat(acc, [ chunk ])))


/// Seek to a byte offset from the start of an open file.
let fdSeekFromStart(fd: Int, offset: Int): Result.Result<Int, Error> =
  Builtin.syscallLseek(fd, offset, 0z)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Stat a file. Returns mode, size, and modification time.
let stat(path: String): Result.Result<StatResult, Error> =
  Builtin.syscallStatAt(path)
  |> Stdlib.Result.andThen(Stdlib.Cli.Posix.__kernelMetadata)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)
  |> Stdlib.Result.map(fun metadata ->
    StatResult { mode = metadata.mode, size = metadata.size
                 mtimeSec = metadata.mtimeSec })

/// Get the current working directory
let getCwd(): Result.Result<String, Error> =
  Stdlib.Cli.Posix.__pathGetCwd()

/// Change the current working directory
let chdir(path: String): Result.Result<Unit, Error> =
  Builtin.syscallChdir(path)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Create a directory
let mkdir(path: String, mode: Int): Result.Result<Unit, Error> =
  Builtin.syscallMkdir(path, mode)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Remove an empty directory
let rmdir(path: String): Result.Result<Unit, Error> =
  Builtin.syscallUnlinkAt(path, Stdlib.Cli.Posix.__abiRemoveDirectory())
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Remove a file
let unlink(path: String): Result.Result<Unit, Error> =
  Builtin.syscallUnlinkAt(path, 0z)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Rename/move a file or directory
let rename(oldpath: String, newpath: String): Result.Result<Unit, Error> =
  Builtin.syscallRename(oldpath, newpath)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Change file permissions
let chmod(path: String, mode: Int): Result.Result<Unit, Error> =
  Builtin.syscallChmod(path, mode)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Update atime and mtime to now.
let utimesNow(path: String): Result.Result<Unit, Error> =
  let result =
    if Stdlib.Cli.Posix.__abiMac() then
      let seconds = Stdlib.DateTime.__toSecondsInt(Stdlib.DateTime.now())
      Builtin.syscallSetattrlistTimes(path, seconds, 0z, seconds, 0z)
    else Builtin.syscallUtimensAt(path, 0z, 1073741823z, 0z, 1073741823z)
  result |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Create a symbolic link
let symlink(target: String, linkpath: String): Result.Result<Unit, Error> =
  Builtin.syscallSymlink(target, linkpath)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Read the target of a symbolic link
let readlink(path: String): Result.Result<String, Error> =
  Stdlib.Cli.Posix.__pathReadlink(path)

/// Check if a path is a symbolic link.
/// Uses readlink — returns Ok true/false, or Error on permission/other failures.
/// readlink returns EINVAL when the target is not a symlink.
let isSymlink(path: String): Result.Result<Bool, Error> =
  match readlink(path) with
  | Ok(_) -> Stdlib.Result.Result.Ok(true)
  | Error(e) ->
    if e.errno == Errno.einval then
      Stdlib.Result.Result.Ok(false)
    else
      Stdlib.Result.Result.Error(e)


/// Create a unique temporary file. Returns (fd, path).
let mkstemp(prefix: String): Result.Result<(Int * String), Error> =
  Stdlib.Cli.Posix.__tempFile(prefix)

/// Create a unique temporary directory. Returns the path.
let mkdtemp(prefix: String): Result.Result<String, Error> =
  Stdlib.Cli.Posix.__tempDirectory(prefix)

/// Match a string against a glob pattern.
/// If pathMode is true, * does not match /
let flock(fd: Int, exclusive: Bool): Result.Result<Unit, Error> =
  Builtin.syscallFlock(fd, if exclusive then 2z else 8z)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Get the owner username of a file.
let fileOwner(path: String): Result.Result<String, Error> =
  Builtin.syscallStatAt(path)
  |> Stdlib.Result.andThen(Stdlib.Cli.Posix.__kernelMetadata)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)
  |> Stdlib.Result.map(fun metadata ->
    let uid = Stdlib.Cli.Posix.__decimal(metadata.uid)
    match Stdlib.Cli.Posix.__accountLookup(uid, 0z) with
    | Some(name) -> name
    | None -> uid)

/// List entries in a directory (filenames only, no "." or "..")
let listDir(path: String): Result.Result<List<String>, Error> =
  Stdlib.Cli.Posix.__directoryList(path)

/// Get an environment variable
let getenv(name: String): Stdlib.Option.Option<String> =
  Stdlib.Env.get(name)


/// System name info: (sysname, nodename, machine).
let uname(): Result.Result<(String * String * String), Error> =
  Stdlib.Cli.Posix.__uname()


/// Send a signal to a process
let kill(pid: Pid, signal: Signal): Result.Result<Unit, Error> =
  Builtin.syscallKill(Stdlib.Int.fromInt64(Pid.toInt64(pid)), Stdlib.Int.fromInt64(Signal.toInt64(signal)))
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Common errno values (Linux/macOS)
/// Stat file-type mask and constants
/// Sleep for the given number of milliseconds.
let sleep(delayMs: Float): Unit =
  Stdlib.DateTime.__sleepMilliseconds(delayMs)


/// Check if a path is a directory via stat().
/// Returns false if the path doesn't exist or is not a directory.
let isDirectory(path: String): Bool =
  match stat(path) with
  | Ok(result) ->
    (result.mode & StatMode.ifmt) == StatMode.ifdir
  | Error(_) -> false


/// Check if a process is running via kill(pid, 0).
/// Signal 0 checks process existence without sending a signal.
let isProcessRunning(pid: Pid): Bool =
  // EPERM means the process exists but we lack permission to signal it
  match Builtin.syscallKill(Stdlib.Int.fromInt64(Pid.toInt64(pid)), 0z) with
  | Ok(_) -> true
  | Error(errno) -> Stdlib.Int.toInt64(errno) == Some(Errno.eperm)


/// Create a directory and all missing parents (like mkdir -p).
///
/// Tries the target first and walks to its parent only on ENOENT. This avoids
/// issuing mutating mkdir operations for every existing ancestor, some of
/// which may protect host-owned state.
let mkdirRecursive(path: String): Result.Result<Unit, Error> =
  let target = Path.stripTrailing(path)
  match mkdir(target, Modes.defaultDir) with
  | Ok() -> Stdlib.Result.Result.Ok()
  | Error(e) ->
    if e.errno == Errno.eexist then
      // Something is there already; only a directory satisfies mkdir -p.
      if isDirectory(target) then Stdlib.Result.Result.Ok()
      else Stdlib.Result.Result.Error(e)
    else if e.errno == Errno.enoent then
      let parent = Path.parent(target)
      if parent == target || parent == "." || parent == "/" then
        Stdlib.Result.Result.Error(e)
      else
        match mkdirRecursive(parent) with
        | Error(parentError) -> Stdlib.Result.Result.Error(parentError)
        | Ok() ->
          match mkdir(target, Modes.defaultDir) with
          | Ok() -> Stdlib.Result.Result.Ok()
          | Error(again) ->
            // Lost a race to something that created it meanwhile.
            if again.errno == Errno.eexist && isDirectory(target) then
              Stdlib.Result.Result.Ok()
            else
              Stdlib.Result.Result.Error(again)
    else
      Stdlib.Result.Result.Error(e)


/// Target kernel constants and structure layouts. These are Dark data, shared
/// by both execution engines, not compiler-host or interpreter-host guesses.

let __abiMac(): Bool = Builtin.runtimeTargetOS() == "darwin"

let __abiX64(): Bool = Builtin.runtimeTargetArchitecture() == "x64"

let __abiArm32(): Bool = Builtin.runtimeTargetArchitecture() == "arm"

let __abiOpenCreate(): Int = if __abiMac() then 512z else 64z

let __abiOpenTruncate(): Int = if __abiMac() then 1024z else 512z

let __abiOpenAppend(): Int = if __abiMac() then 8z else 1024z

let __abiOpenExclusive(): Int = if __abiMac() then 2048z else 128z

let __abiRemoveDirectory(): Int = if __abiMac() then 128z else 512z

let __abiOpenDirectory(): Int =
  if __abiMac() then 1048576z else if __abiX64() then 65536z else 16384z

let __abiStatModeOffset(): Int =
  if __abiMac() then 4z else if __abiX64() then 24z else if __abiArm32() then 16z else 16z

let __abiStatModeWidth(): Int = if __abiMac() then 2z else 4z

let __abiStatUidOffset(): Int =
  if __abiMac() then 16z else if __abiX64() then 28z else if __abiArm32() then 24z else 24z

let __abiStatSizeOffset(): Int =
  if __abiMac() then 96z else if __abiX64() then 48z else if __abiArm32() then 48z else 48z

let __abiStatMtimeOffset(): Int =
  if __abiMac() then 48z else if __abiX64() then 88z else if __abiArm32() then 80z else 88z

let __abiStatTimeWidth(): Int = if __abiArm32() then 4z else 8z

let __abiStatDeviceWidth(): Int = if __abiMac() then 4z else 8z

let __abiStatInodeOffset(): Int = if __abiArm32() then 96z else 8z

let __abiDirectoryNameOffset(): Int = if __abiMac() then 21z else 19z


/// Bounds-checked decoding of kernel byte records. No OS effects occur here.

let __kernelUnsigned(bytes: List<UInt8>, width: Int): Result.Result<Int, Int> =
  if width == 0z then Ok(0z)
  else
    match bytes with
    | [] -> Error(5z)
    | byte :: rest ->
      match __kernelUnsigned(rest, width - 1z) with
      | Error(e) -> Error(e)
      | Ok(high) -> Ok(Stdlib.Int.fromUInt8(byte) + 256z * high)

let __kernelField(bytes: List<UInt8>, offset: Int, width: Int): Result.Result<Int, Int> =
  __kernelUnsigned(Stdlib.List.__dropInt(bytes, offset), width)

let __kernelSignedField(bytes: List<UInt8>, offset: Int, width: Int): Result.Result<Int, Int> =
  match __kernelField(bytes, offset, width) with
  | Error(e) -> Error(e)
  | Ok(n) ->
    let modulus = 256z ** width
    Ok(if n >= modulus / 2z then n - modulus else n)

type __KernelMetadata =
  { mode: Int, size: Int, mtimeSec: Int, uid: Int, device: Int, inode: Int }

let __kernelMetadata(buffer: Blob): Result.Result<__KernelMetadata, Int> =
  let bytes = Stdlib.Blob.toList(buffer)
  __kernelField(bytes, Stdlib.Cli.Posix.__abiStatModeOffset(), Stdlib.Cli.Posix.__abiStatModeWidth())
  |> Stdlib.Result.andThen(fun mode ->
    __kernelSignedField(bytes, Stdlib.Cli.Posix.__abiStatSizeOffset(), 8z)
    |> Stdlib.Result.andThen(fun size ->
      __kernelSignedField(bytes, Stdlib.Cli.Posix.__abiStatMtimeOffset(), Stdlib.Cli.Posix.__abiStatTimeWidth())
      |> Stdlib.Result.andThen(fun mtime ->
        __kernelField(bytes, Stdlib.Cli.Posix.__abiStatUidOffset(), 4z)
        |> Stdlib.Result.andThen(fun uid ->
          __kernelField(bytes, 0z, Stdlib.Cli.Posix.__abiStatDeviceWidth())
          |> Stdlib.Result.andThen(fun device ->
            __kernelField(bytes, Stdlib.Cli.Posix.__abiStatInodeOffset(), 8z)
            |> Stdlib.Result.map(fun inode ->
              __KernelMetadata { mode = mode, size = size, mtimeSec = mtime, uid = uid
                         device = device, inode = inode }))))))

/// Decode records within one read, consuming each record before the next.
let __kernelEntriesWithLength(bytes: List<UInt8>, remaining: Int, reversed: List<String>): Result.Result<List<String>, Int> =
  match bytes with
  | [] -> Ok(reversed)
  | _ ->
    __kernelField(bytes, 16z, 2z)
    |> Stdlib.Result.andThen(fun length ->
      let nameOffset = Stdlib.Cli.Posix.__abiDirectoryNameOffset()
      if length <= nameOffset || length > remaining then Error(5z)
      else
        let record = Stdlib.List.__takeInt(bytes, length)
        let nameBytes = Stdlib.List.__dropInt(record, nameOffset)
        let name = Stdlib.List.takeWhile(nameBytes, fun byte -> byte != 0u8)
        if Stdlib.List.__lengthInt(name) == Stdlib.List.__lengthInt(nameBytes) then Error(5z)
        else
          let name = Stdlib.String.fromBytesWithReplacement(name)
          let next =
            if name == "." || name == ".." then reversed
            else Stdlib.List.push(reversed, name)
          __kernelEntriesWithLength(Stdlib.List.__dropInt(bytes, length), remaining - length, next))

let __kernelEntries(bytes: List<UInt8>, reversed: List<String>): Result.Result<List<String>, Int> =
  __kernelEntriesWithLength(bytes, Stdlib.List.__lengthInt(bytes), reversed)


/// Directory iteration and record decoding over single-call kernel primitives.

let __directoryReadAll(fd: Int, reversed: List<String>): Result.Result<List<String>, Int> =
  match Builtin.syscallGetdents(fd, 32768z) with
  | Error(e) ->
    if e == 4z then __directoryReadAll(fd, reversed) else Error(e)
  | Ok(bytes) ->
    if Stdlib.Blob.length(bytes) == 0z then Ok(Stdlib.List.reverse(reversed))
    else
      match Stdlib.Cli.Posix.__kernelEntries(Stdlib.Blob.toList(bytes), reversed) with
      | Error(e) -> Error(e)
      | Ok(next) -> __directoryReadAll(fd, next)

let __directoryList(path: String): Result.Result<List<String>, Posix.Error> =
  match Posix.openFile(path, Stdlib.Cli.Posix.__abiOpenDirectory(), 0z) with
  | Error(e) -> Error(e)
  | Ok(fd) ->
    let result = __directoryReadAll(fd, []) |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)
    let closed = Posix.fdClose(fd)
    match result with
    | Error(e) -> Error(e)
    | Ok(entries) -> closed |> Stdlib.Result.map(fun _ -> entries)


/// Path buffer growth and text decoding over one-call kernel primitives.

let __pathReadlinkWith(read: Int -> Result.Result<Blob, Int>, count: Int): Result.Result<Blob, Int> =
  if count <= 0z then Error(22z)
  else
    match read(count) with
    | Error(e) ->
      if e == 4z then __pathReadlinkWith(read, count) else Error(e)
    | Ok(bytes) ->
      if Stdlib.Blob.length(bytes) < count then Ok(bytes)
      else if count >= 1048576z then Error(if Stdlib.Cli.Posix.__abiMac() then 63z else 36z)
      else __pathReadlinkWith(read, count * 2z)

let __pathReadlink(path: String): Result.Result<String, Posix.Error> =
  __pathReadlinkWith((fun count -> Builtin.syscallReadlinkAt(path, count)), 256z)
  |> Stdlib.Result.map(Stdlib.String.fromBlobWithReplacement)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

let __pathCwdWith(read: Int -> Result.Result<Blob, Int>, count: Int): Result.Result<Blob, Int> =
  if count <= 0z then Error(22z)
  else
    match read(count) with
    | Error(4z) -> __pathCwdWith(read, count)
    | Error(34z) ->
      if count >= 1048576z then Error(34z) else __pathCwdWith(read, count * 2z)
    | other -> other

let __pathPathText(bytes: Blob): String =
  bytes |> Stdlib.Blob.toList |> Stdlib.List.takeWhile(fun byte -> byte != 0u8)
  |> Stdlib.Blob.fromList |> Stdlib.String.fromBlobWithReplacement

let __pathGetCwd(): Result.Result<String, Posix.Error> =
  let bytes =
    if Stdlib.Cli.Posix.__abiMac() then
      match Builtin.syscallOpen(".", Stdlib.Cli.Posix.__abiOpenDirectory(), 0z) with
      | Error(e) -> Error(e)
      | Ok(fd) ->
        let result = Builtin.syscallFcntlGetPath(fd)
        let closed = Builtin.syscallClose(fd)
        match result with
        | Error(e) -> Error(e)
        | Ok(bytes) ->
          match closed with
          | Error(e) -> Error(e)
          | Ok(_) -> Ok(bytes)
    else __pathCwdWith(Builtin.syscallGetcwd, 256z)
  bytes |> Stdlib.Result.map(__pathPathText) |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Error messages ported from the compiler's Cli.__Posix implementation.
/// Kernel errno is platform-specific; permission and host diagnostics stay intact.

// Keep errno rendering shared while the engines have different Display APIs.
let __decimal(value: Int): String =
    if value < 0z then Stdlib.String.append("-", __decimal(0z - value))
    else
        let quotient = value / 10z
        let digit = value - quotient * 10z
        let suffix =
            if digit == 0z then "0" else if digit == 1z then "1"
            else if digit == 2z then "2" else if digit == 3z then "3"
            else if digit == 4z then "4" else if digit == 5z then "5"
            else if digit == 6z then "6" else if digit == 7z then "7"
            else if digit == 8z then "8" else "9"
        if quotient == 0z then suffix
        else Stdlib.String.append(__decimal(quotient), suffix)

let __macMessage(errno: Int): String =
    if errno == 1z then "Operation not permitted"
    else if errno == 2z then "No such file or directory"
    else if errno == 3z then "No such process"
    else if errno == 4z then "Interrupted system call"
    else if errno == 5z then "Input/output error"
    else if errno == 6z then "Device not configured"
    else if errno == 7z then "Argument list too long"
    else if errno == 8z then "Exec format error"
    else if errno == 9z then "Bad file descriptor"
    else if errno == 10z then "No child processes"
    else if errno == 11z then "Resource deadlock avoided"
    else if errno == 12z then "Cannot allocate memory"
    else if errno == 13z then "Permission denied"
    else if errno == 14z then "Bad address"
    else if errno == 15z then "Block device required"
    else if errno == 16z then "Device / Resource busy"
    else if errno == 17z then "File exists"
    else if errno == 18z then "Cross-device link"
    else if errno == 19z then "Operation not supported by device"
    else if errno == 20z then "Not a directory"
    else if errno == 21z then "Is a directory"
    else if errno == 22z then "Invalid argument"
    else if errno == 23z then "Too many open files in system"
    else if errno == 24z then "Too many open files"
    else if errno == 25z then "Inappropriate ioctl for device"
    else if errno == 26z then "Text file busy"
    else if errno == 27z then "File too large"
    else if errno == 28z then "No space left on device"
    else if errno == 29z then "Illegal seek"
    else if errno == 30z then "Read-only file system"
    else if errno == 31z then "Too many links"
    else if errno == 32z then "Broken pipe"
    else if errno == 33z then "Numerical argument out of domain"
    else if errno == 34z then "Result too large"
    else if errno == 35z then "Resource temporarily unavailable"
    else if errno == 36z then "Operation now in progress"
    else if errno == 37z then "Operation already in progress"
    else if errno == 38z then "Socket operation on non-socket"
    else if errno == 39z then "Destination address required"
    else if errno == 40z then "Message too long"
    else if errno == 41z then "Protocol wrong type for socket"
    else if errno == 42z then "Protocol not available"
    else if errno == 43z then "Protocol not supported"
    else if errno == 44z then "Socket type not supported"
    else if errno == 45z then "Operation not supported"
    else if errno == 46z then "Protocol family not supported"
    else if errno == 47z then "Address family not supported by protocol family"
    else if errno == 48z then "Address already in use"
    else if errno == 49z then "Can't assign requested address"
    else if errno == 50z then "Network is down"
    else if errno == 51z then "Network is unreachable"
    else if errno == 52z then "Network dropped connection on reset"
    else if errno == 53z then "Software caused connection abort"
    else if errno == 54z then "Connection reset by peer"
    else if errno == 55z then "No buffer space available"
    else if errno == 56z then "Socket is already connected"
    else if errno == 57z then "Socket is not connected"
    else if errno == 58z then "Can't send after socket shutdown"
    else if errno == 59z then "Too many references: can't splice"
    else if errno == 60z then "Operation timed out"
    else if errno == 61z then "Connection refused"
    else if errno == 62z then "Too many levels of symbolic links"
    else if errno == 63z then "File name too long"
    else if errno == 64z then "Host is down"
    else if errno == 65z then "No route to host"
    else if errno == 66z then "Directory not empty"
    else if errno == 67z then "Too many processes"
    else if errno == 68z then "Too many users"
    else if errno == 69z then "Disc quota exceeded"
    else if errno == 70z then "Stale NFS file handle"
    else if errno == 71z then "Too many levels of remote in path"
    else if errno == 72z then "RPC struct is bad"
    else if errno == 73z then "RPC version wrong"
    else if errno == 74z then "RPC prog. not avail"
    else if errno == 75z then "Program version wrong"
    else if errno == 76z then "Bad procedure for program"
    else if errno == 77z then "No locks available"
    else if errno == 78z then "Function not implemented"
    else if errno == 79z then "Inappropriate file type or format"
    else if errno == 80z then "Authentication error"
    else if errno == 81z then "Need authenticator"
    else if errno == 82z then "Device power is off"
    else if errno == 83z then "Device error, e.g. paper out"
    else if errno == 84z then "Value too large to be stored in data type"
    else if errno == 85z then "Bad executable"
    else if errno == 86z then "Bad CPU type in executable"
    else if errno == 87z then "Shared library version mismatch"
    else if errno == 88z then "Malformed Macho file"
    else if errno == 89z then "Operation canceled"
    else if errno == 90z then "Identifier removed"
    else if errno == 91z then "No message of desired type"
    else if errno == 92z then "Illegal byte sequence"
    else if errno == 93z then "Attribute not found"
    else if errno == 94z then "Bad message"
    else if errno == 95z then "Reserved"
    else if errno == 96z then "No message available on STREAM"
    else if errno == 97z then "Reserved"
    else if errno == 98z then "No STREAM resources"
    else if errno == 99z then "Not a STREAM"
    else if errno == 100z then "Protocol error"
    else if errno == 101z then "STREAM ioctl timeout"
    else if errno == 102z then "Operation not supported on socket"
    else if errno == 103z then "No such policy registered"
    else if errno == 104z then "State not recoverable"
    else if errno == 105z then "Previous owner died"
    else if errno == 106z then "Interface output queue is full"
    else if errno == 107z then "Capabilities insufficient"
    else Stdlib.String.append("Unknown error: ", __decimal(errno))

let __fromErrno(errno: Int): Stdlib.Cli.Posix.Error =
    let message =
        if Stdlib.Cli.Posix.__abiMac() then __macMessage(errno)
        else if errno == 1z then "Operation not permitted"
        else if errno == 2z then "No such file or directory"
        else if errno == 3z then "No such process"
        else if errno == 4z then "Interrupted system call"
        else if errno == 5z then "Input/output error"
        else if errno == 6z then "No such device or address"
        else if errno == 7z then "Argument list too long"
        else if errno == 8z then "Exec format error"
        else if errno == 9z then "Bad file descriptor"
        else if errno == 10z then "No child processes"
        else if errno == 11z then "Resource temporarily unavailable"
        else if errno == 12z then "Cannot allocate memory"
        else if errno == 13z then "Permission denied"
        else if errno == 14z then "Bad address"
        else if errno == 15z then "Block device required"
        else if errno == 16z then "Device or resource busy"
        else if errno == 17z then "File exists"
        else if errno == 18z then "Invalid cross-device link"
        else if errno == 19z then "No such device"
        else if errno == 20z then "Not a directory"
        else if errno == 21z then "Is a directory"
