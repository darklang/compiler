// __Http3Uni.dark - Peer critical streams, control grammar and connection-owned QPACK decoding.
module Darklang.Stdlib.__Http3Uni

type Stream = { id: Int64, prefix: Blob, kind: Stdlib.Option.Option<Int64>, finished: Bool }
type State = {
  fromServer: Bool,
  streams: List<Stdlib.__Http3Uni.Stream>,
  controlId: Stdlib.Option.Option<Int64>,
  encoderId: Stdlib.Option.Option<Int64>,
  decoderId: Stdlib.Option.Option<Int64>,
  control: Stdlib.__Http3Control.State,
  table: Stdlib.__QpackDecoder.State,
  outgoing: Stdlib.__QpackEncoder.State
}
type Received = { state: Stdlib.__Http3Uni.State, events: List<Stdlib.__Http3Control.Event>, feedback: Blob }

let createWithCapacity (fromServer: Bool) (maximum: Int64) : Stdlib.Result.Result<Stdlib.__Http3Uni.State, String> =
  Stdlib.__QpackEncoder.create 0 0 |> Stdlib.Result.andThen (fun outgoing ->
  Stdlib.__QpackDecoder.create maximum |> Stdlib.Result.map (fun table ->
    Stdlib.__Http3Uni.State { fromServer = fromServer, streams = [], controlId = None,
      encoderId = None, decoderId = None, control = Stdlib.__Http3Control.create fromServer, table = table, outgoing = outgoing }))

let __setting (parameters: List<(Int64 * Int64)>) (id: Int64) : Int64 =
  match Stdlib.List.findFirst parameters (fun parameter -> let (key, _value) = parameter in key == id) with
  | None -> 0
  | Some parameter -> let (_key, value) = parameter in value

let create (fromServer: Bool) : Stdlib.__Http3Uni.State =
  match Stdlib.__Http3Uni.createWithCapacity fromServer 0 with
  | Ok state -> state
  | Error _ -> Builtin.crash "Zero QPACK capacity is invalid"

let __claim (state: Stdlib.__Http3Uni.State) (id: Int64) (kind: Int64)
  : Stdlib.Result.Result<Stdlib.__Http3Uni.State, Stdlib.__Http3Wire.Failure> =
  if kind == 1 then Error (Stdlib.__Http3Wire.connectionFailure (if state.fromServer then 264 else 259) "Unpermitted HTTP/3 push stream")
  else if kind == 0 then
    if Stdlib.Option.isSome state.controlId then Error (Stdlib.__Http3Wire.connectionFailure 259 "Duplicate HTTP/3 control stream")
    else Ok { state with controlId = Some id }
  else if kind == 2 then
    if Stdlib.Option.isSome state.encoderId then Error (Stdlib.__Http3Wire.connectionFailure 259 "Duplicate QPACK encoder stream")
    else Ok { state with encoderId = Some id }
  else if kind == 3 then
    if Stdlib.Option.isSome state.decoderId then Error (Stdlib.__Http3Wire.connectionFailure 259 "Duplicate QPACK decoder stream")
    else Ok { state with decoderId = Some id }
  else Ok state

let __replace (state: Stdlib.__Http3Uni.State) (stream: Stdlib.__Http3Uni.Stream) : Stdlib.__Http3Uni.State =
  let streams =
    if Stdlib.List.any state.streams (fun previous -> previous.id == stream.id) then
      Stdlib.List.map state.streams (fun previous -> if previous.id == stream.id then stream else previous)
    else Stdlib.List.concat state.streams [stream] in
  { state with streams = streams }

let __payload (state: Stdlib.__Http3Uni.State) (stream: Stdlib.__Http3Uni.Stream)
  (kind: Int64) (data: Blob) (finished: Bool) (reset: Bool)
  : Stdlib.Result.Result<Stdlib.__Http3Uni.Received, Stdlib.__Http3Wire.Failure> =
  if (kind == 0 || kind == 2 || kind == 3) && (finished || reset) then
    Error (Stdlib.__Http3Wire.connectionFailure 260 "Closed critical HTTP/3 stream")
  else
    let next = Stdlib.__Http3Uni.__replace state { stream with prefix = Stdlib.Blob.empty, kind = Some kind, finished = finished || reset } in
    if kind == 0 then
      Stdlib.__Http3Control.feed next.control data |> Stdlib.Result.andThen (fun received ->
        let outgoing =
          if Stdlib.Bool.not next.control.settings && received.state.settings then
            Stdlib.__QpackEncoder.create (Stdlib.__Http3Uni.__setting received.state.parameters 1) (Stdlib.__Http3Uni.__setting received.state.parameters 7) |> Stdlib.Result.mapError (Stdlib.__Http3Wire.connectionFailure 265)
          else Ok next.outgoing in
        outgoing |> Stdlib.Result.map (fun outgoing -> Stdlib.__Http3Uni.Received { state = { next with control = received.state, outgoing = outgoing }, events = received.events, feedback = Stdlib.Blob.empty }))
    else if kind == 2 then
      Stdlib.__QpackDecoder.feed next.table data |> Stdlib.Result.mapError (Stdlib.__Http3Wire.connectionFailure 513) |> Stdlib.Result.map (fun received ->
        let feedback = if received.increment == 0 then Stdlib.Blob.empty else Stdlib.__Hpack.encodeInteger 6 0 received.increment in
        Stdlib.__Http3Uni.Received { state = { next with table = received.state }, events = [], feedback = feedback })
    else if kind == 3 then
      Stdlib.__QpackEncoder.feed next.outgoing data |> Stdlib.Result.mapError (Stdlib.__Http3Wire.connectionFailure 514) |> Stdlib.Result.map (fun outgoing ->
        Stdlib.__Http3Uni.Received { state = { next with outgoing = outgoing }, events = [], feedback = Stdlib.Blob.empty })
    else Ok (Stdlib.__Http3Uni.Received { state = next, events = [], feedback = Stdlib.Blob.empty })

let receive (state: Stdlib.__Http3Uni.State) (id: Int64) (data: Blob) (finished: Bool) (reset: Bool)
  : Stdlib.Result.Result<Stdlib.__Http3Uni.Received, Stdlib.__Http3Wire.Failure> =
  if id < 0 || id > 4611686018427387903 || id % 4 != (if state.fromServer then 3 else 2) then
    Error (Stdlib.__Http3Wire.connectionFailure 259 "Invalid peer HTTP/3 unidirectional stream")
  else if Stdlib.Blob.__byteLength data > 65536 then Error (Stdlib.__Http3Wire.connectionFailure 263 "HTTP/3 read exceeds limit")
  else
    let known = Stdlib.List.findFirst state.streams (fun stream -> stream.id == id) in
    let stream = match known with | Some stream -> stream | None ->
      Stdlib.__Http3Uni.Stream { id = id, prefix = Stdlib.Blob.empty, kind = None, finished = false } in
    if Stdlib.Option.isNone known && Stdlib.List.__lengthInt state.streams >= 16z then Error (Stdlib.__Http3Wire.connectionFailure 263 "HTTP/3 stream profile exhausted")
    else if stream.finished then
      if Stdlib.Blob.__byteLength data == 0 then Ok (Stdlib.__Http3Uni.Received { state = state, events = [], feedback = Stdlib.Blob.empty })
      else Error (Stdlib.__Http3Wire.connectionFailure 257 "Data after HTTP/3 unidirectional stream end")
    else
      match stream.kind with
      | Some kind -> Stdlib.__Http3Uni.__payload state stream kind data finished reset
      | None ->
        let bytes = Stdlib.Blob.concat [stream.prefix, data] in
        match Stdlib.__QuicWire.parseInteger bytes 0 with
        | Error Incomplete ->
          if finished || reset then
            Ok (Stdlib.__Http3Uni.Received { state = Stdlib.__Http3Uni.__replace state { stream with prefix = Stdlib.Blob.empty, finished = true }, events = [], feedback = Stdlib.Blob.empty })
          else Ok (Stdlib.__Http3Uni.Received { state = Stdlib.__Http3Uni.__replace state { stream with prefix = bytes }, events = [], feedback = Stdlib.Blob.empty })
        | Error (Invalid message) -> Error (Stdlib.__Http3Wire.connectionFailure 259 message)
        | Ok kind ->
          Stdlib.__Http3Uni.__claim state id kind.value |> Stdlib.Result.andThen (fun next ->
            Stdlib.__Http3Uni.__payload next stream kind.value
              (Stdlib.__Http2Wire.__slice bytes kind.next (Stdlib.Blob.__byteLength bytes - kind.next)) finished reset)
