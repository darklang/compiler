// Stdlib.Pretty value layout - groups the --syntax=current value printer builds over main's Stdlib.Pretty.

module Darklang.Stdlib.Pretty

// A rendered value's container, as the interpreter's value printer builds it:
// `[a, b]` or `{ a, b }` on one line when it fits, else one item per line.
let __valueGroup (opening: String) (closing: String) (opener: Stdlib.Pretty.Doc) (parts: List<Stdlib.Pretty.Doc>) : Stdlib.Pretty.Doc =
    let inner = Stdlib.Pretty.join parts (Stdlib.Pretty.Doc.Concat(Stdlib.Pretty.Doc.Text ",", Stdlib.Pretty.Doc.Line)) in
    Stdlib.Pretty.Doc.Group(
        Stdlib.Pretty.Doc.Concat(
            Stdlib.Pretty.Doc.Text opening,
            Stdlib.Pretty.Doc.Concat(
                Stdlib.Pretty.Doc.Nest(2L, Stdlib.Pretty.Doc.Concat(opener, inner)),
                Stdlib.Pretty.Doc.Concat(opener, Stdlib.Pretty.Doc.Text closing))))

let __valueBracketed (opening: String) (closing: String) (parts: List<Stdlib.Pretty.Doc>) : Stdlib.Pretty.Doc =
    Stdlib.Pretty.__valueGroup opening closing Stdlib.Pretty.Doc.SoftLine parts

let __valueBraced (opening: String) (closing: String) (parts: List<Stdlib.Pretty.Doc>) : Stdlib.Pretty.Doc =
    Stdlib.Pretty.__valueGroup opening closing Stdlib.Pretty.Doc.Line parts
