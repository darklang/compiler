// Typed, single-call kernel adapters. Raw pointers never escape these adapters.
module Builtin

let __syscallIntResult(rc: Int64): Stdlib.Result.Result<Int, Int64> =
    if rc < 0 then Error(0 - rc)
    else Ok(Stdlib.Int.fromInt64(rc))

let __syscallInt64Result(rc: Int64): Stdlib.Result.Result<Int64, Int64> =
    if rc < 0 then Error(0 - rc) else Ok(rc)

let __syscallUnitResult(rc: Int64): Stdlib.Result.Result<Unit, Int64> =
    if rc < 0 then Error(0 - rc) else Ok()

let syscallRead(fd: Int, count: Int64): Stdlib.Result.Result<Blob, Int64> =
    let fd = Builtin.__posixInt32(fd) in
    let count = Builtin.__posixWidth32(count) in
    if count < 0 then Error(22)
    else
        let ptr = __mapped_alloc(if count == 0 then 1 else count) in
        let rc = Stdlib.Cli.__Posix.__read(fd, ptr, count) in
        let result =
            if rc < 0 then Error(0 - rc)
            else Ok(Stdlib.Cli.__Posix.__bufferBytes(ptr, 0, rc, [])) in
        let _ = __mapped_free(ptr) in
        result

let syscallWrite(fd: Int, bytes: Blob): Stdlib.Result.Result<Int64, Int64> =
    let fd = Builtin.__posixInt32(fd) in
    let count = Stdlib.Blob.__byteLength(bytes) in
    let ptr = __mapped_alloc(if count == 0 then 1 else count) in
    let _ = Stdlib.Cli.__Posix.__writeBytes(bytes, ptr, 0) in
    let rc = Stdlib.Cli.__Posix.__write(fd, ptr, count) in
    let _ = __mapped_free(ptr) in
    Builtin.__syscallInt64Result(rc)

let syscallClose(fd: Int): Stdlib.Result.Result<Unit, Int64> =
    Builtin.__syscallUnitResult(
        Stdlib.Cli.__Posix.__close(Builtin.__posixInt32(fd)))

let syscallLseek(fd: Int, offset: Int64, whence: Int64): Stdlib.Result.Result<Int64, Int64> =
    Builtin.__syscallInt64Result(
        Stdlib.Cli.__Posix.__seek(Builtin.__posixInt32(fd),
            offset, Builtin.__posixWidth32(whence)))

let syscallFlock(fd: Int, operation: Int64): Stdlib.Result.Result<Unit, Int64> =
    Builtin.__syscallUnitResult(
        Stdlib.Cli.__Posix.__flock(Builtin.__posixInt32(fd),
            Builtin.__posixWidth32(operation)))

let syscallKill(pid: Int64, signal: Int64): Stdlib.Result.Result<Unit, Int64> =
    match Stdlib.Cli.__kill(Builtin.__posixWidth32(pid),
        Builtin.__posixWidth32(signal)) with
    | Ok() -> Ok()
    | Error(error) -> Error(error.errno)

let syscallGetpid(): Int64 = Stdlib.Cli.__getpid()

let syscallGetuid(): Int64 = Stdlib.Cli.__getuid()
