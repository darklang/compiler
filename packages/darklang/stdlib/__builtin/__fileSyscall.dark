// Scalar/buffer ABI adaptation for single descriptor syscalls.
module Builtin

let syscallGetentropy(count: Int64): Stdlib.Result.Result<Blob, Int64> =
    let count = Builtin.__posixWidth32(count) in
    if count < 0 || count > 256 then Error(22)
    else
        let ptr = __mapped_alloc(if count == 0 then 1 else count) in
        let rc = Stdlib.Cli.__Posix.__getentropy(ptr, count, 0) in
        let result =
            if rc < 0 then Error(0 - rc)
            else
                let length = if Stdlib.Cli.__Posix.__mac() then count else rc in
                Ok(Stdlib.Cli.__Posix.__bufferBytes(ptr, 0, length, [])) in
        let _ = __mapped_free(ptr) in
        result

let syscallCopyFileRange(source: Int, destination: Int, count: Int64): Stdlib.Result.Result<Int64, Int64> =
    let source = Builtin.__posixInt32(source) in
    let destination = Builtin.__posixInt32(destination) in
    let count = Builtin.__posixWidth32(count) in
    if count < 0 then Error(22)
    else
        Builtin.__syscallInt64Result(
            Stdlib.Cli.__Posix.__copyFileRange(source, 0, destination, 0, count, 0))

let syscallCloneFile(source: Int, destination: Int): Stdlib.Result.Result<Unit, Int64> =
    if Stdlib.Cli.__Posix.__mac() then Error(78)
    else
        Builtin.__syscallUnitResult(
            Stdlib.Cli.__Posix.__ioctlValue(Builtin.__posixInt32(destination),
                1074041865, Builtin.__posixInt32(source)))

let syscallFtruncate(fd: Int, length: Int64): Stdlib.Result.Result<Unit, Int64> =
    Builtin.__syscallUnitResult(
        Stdlib.Cli.__Posix.__ftruncate(Builtin.__posixInt32(fd), length))

let syscallFclonefileAt(source: Int, destination: String, flags: Int64): Stdlib.Result.Result<Unit, Int64> =
    let source = Builtin.__posixInt32(source) in
    let flags = Stdlib.Int64.bitwiseOr(Builtin.__posixWidth32(flags), 1) in
    Stdlib.Cli.__Posix.__withEntry(destination, fun(parent, name) ->
        Stdlib.Cli.__Posix.__unitResult(Stdlib.Cli.__Posix.__fclonefileat(source, parent, name, flags)))
    |> Stdlib.Result.mapError(fun error -> error.errno)

let syscallFchmod(fd: Int, mode: Int64): Stdlib.Result.Result<Unit, Int64> =
    Builtin.__syscallUnitResult(
        Stdlib.Cli.__Posix.__fchmod(Builtin.__posixInt32(fd),
            Builtin.__posixWidth32(mode)))

let syscallFstat(fd: Int): Stdlib.Result.Result<Blob, Int64> =
    let fd = Builtin.__posixInt32(fd) in
    let ptr = __mapped_alloc(256) in
    let _ = Stdlib.Cli.__Posix.__zeroBuffer(ptr, 256) in
    let rc = Stdlib.Cli.__Posix.__fstat(fd, ptr) in
    let result =
        if rc < 0 then Error(0 - rc)
        else Ok(Stdlib.Cli.__Posix.__bufferBytes(ptr, 0, 256, [])) in
    let _ = __mapped_free(ptr) in
    result

let syscallPread(fd: Int, count: Int64, offset: Int64): Stdlib.Result.Result<Blob, Int64> =
    let fd = Builtin.__posixInt32(fd) in
    let count = Builtin.__posixWidth32(count) in
    if count < 0 then Error(22)
    else
        let ptr = __mapped_alloc(if count == 0 then 1 else count) in
        let rc = Stdlib.Cli.__Posix.__pread(fd, ptr, count, offset) in
        let result =
            if rc < 0 then Error(0 - rc)
            else Ok(Stdlib.Cli.__Posix.__bufferBytes(ptr, 0, rc, [])) in
        let _ = __mapped_free(ptr) in
        result

let syscallPwrite(fd: Int, bytes: Blob, offset: Int64): Stdlib.Result.Result<Int64, Int64> =
    let fd = Builtin.__posixInt32(fd) in
    let count = Stdlib.Blob.__byteLength(bytes) in
    let ptr = __mapped_alloc(if count == 0 then 1 else count) in
    let _ = Stdlib.Cli.__Posix.__writeBytes(bytes, ptr, 0) in
    let rc = Stdlib.Cli.__Posix.__pwrite(fd, ptr, count, offset) in
    let _ = __mapped_free(ptr) in
    Builtin.__syscallInt64Result(rc)
