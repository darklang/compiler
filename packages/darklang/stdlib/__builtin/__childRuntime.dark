// Private native child ownership adapter. Shared Dark owns all process algorithms.
module Builtin

let __childState () : RawPtr = __word_to_rawptr 0
let __childLaunch (argv: RawPtr) (environment: RawPtr) (inheritTerminal: Int64) (ports: RawPtr) : Int64 = -38
let __childWait4 (pid: Int64) (status: RawPtr) (options: Int64) (usage: RawPtr) : Int64 = -38

let __childAddress (index: Int64) : RawPtr =
    __word_to_rawptr (__rawptr_to_word (Builtin.__childState ()) + index * 64)

let __childFind (token: Int64) (index: Int64) : Int64 =
    if token <= 0 || index > 63 then 0
    else if __raw_get<Int64> (Builtin.__childAddress index) 0 == token then index
    else Builtin.__childFind token (index + 1)

let __childFree (index: Int64) : Int64 =
    if index > 63 then 0
    else if __raw_get<Int64> (Builtin.__childAddress index) 0 == 0 then index
    else Builtin.__childFree (index + 1)

let __withChildArgv (args: List<String>) (vector: RawPtr) (offset: Int64) (fn: RawPtr -> Int64) : Int64 =
    match args with
    | [] -> let _ = __raw_write_word vector offset 0 in fn vector
    | arg :: rest ->
        Stdlib.Cli.__Posix.__withCString arg (fun ptr ->
            let _ = __raw_write_word vector offset (__rawptr_to_word ptr) in
            Builtin.__withChildArgv rest vector (offset + 8) fn)

let __childStartAt (program: String) (args: List<String>) (inheritTerminal: Bool) (slot: Int64) : Int64 =
    let allArgs = Stdlib.List.push args program in
    let vector = __mapped_alloc (Builtin.__posixInt64 (Stdlib.List.__lengthInt allArgs + 1z) * 8) in
    let record = Builtin.__childAddress slot in
    let _ = __raw_write_word record 16 -1 in
    let _ = __raw_write_word record 24 -1 in
    let _ = __raw_write_word record 32 -1 in
    let stack = Builtin.__startupStack () in
    let argc = __raw_get<Int64> stack 0 in
    let environment = __word_to_rawptr (__rawptr_to_word stack + (argc + 2) * 8) in
    let pid = Builtin.__withChildArgv allArgs vector 0 (fun argv ->
        Builtin.__childLaunch argv environment (if inheritTerminal then 1 else 0)
            (__word_to_rawptr (__rawptr_to_word record + 16))) in
    let _ = __mapped_free vector in
    if pid < 0 then pid
    else
        let state = Builtin.__childState () in
        let token = __raw_get<Int64> state 0 + 1 in
        let _ = __raw_write_word state 0 token in
        let _ = __raw_write_word record 0 token in
        let _ = __raw_write_word record 8 pid in
        let _ = __raw_write_word record 40 -1 in
        let _ = __raw_write_word record 48 0 in
        let _ = __raw_write_word record 56 0 in
        token

let __childCandidates (programs: List<String>) (args: List<String>) (inheritTerminal: Bool) (slot: Int64) : Int64 =
    match programs with
    | [] -> -2
    | program :: rest ->
        let rc = Builtin.__childStartAt program args inheritTerminal slot in
        if rc == -2 then Builtin.__childCandidates rest args inheritTerminal slot else rc

let runtimeChildStart (program: String) (args: List<String>) (inheritTerminal: Bool) : Stdlib.Result.Result<Int, Int> =
    let slot = Builtin.__childFree 1 in
    if slot == 0 || __raw_get<Int64> (Builtin.__childState ()) 0 == 9223372036854775807 then Error 24z
    else if Stdlib.String.__containsBytes program "\0" || Stdlib.List.any args (fun arg -> Stdlib.String.__containsBytes arg "\0") then Error 22z
    else
        let programs = if Stdlib.String.__containsBytes program "/" then [program]
                       else
                         let path = match Stdlib.Cli.Env.get "PATH" with | Some path -> path | None -> "/bin:/usr/bin" in
                         Stdlib.List.map (Stdlib.String.split path ":") (fun directory ->
                             if directory == "" then program else directory + "/" + program) in
        Builtin.__syscallIntResult (Builtin.__childCandidates programs args inheritTerminal slot)

let runtimeChildDescriptors (handle: Int) : Stdlib.Result.Result<List<Int>, Int> =
    let slot = Builtin.__childFind (Builtin.__posixInt64 handle) 1 in
    if slot == 0 then Error 9z
    else
        let record = Builtin.__childAddress slot in
        let stdin = __raw_get<Int64> record 16 in
        let stdout = __raw_get<Int64> record 24 in
        let stderr = __raw_get<Int64> record 32 in
        if stdin == -1 && stdout == -1 && stderr == -1 then Ok []
        else Ok [Stdlib.Int.fromInt64 stdin, Stdlib.Int.fromInt64 stdout, Stdlib.Int.fromInt64 stderr]

let runtimeChildPoll (handle: Int) : Stdlib.Result.Result<Stdlib.Option.Option<Int>, Int> =
    let slot = Builtin.__childFind (Builtin.__posixInt64 handle) 1 in
    if slot == 0 then Error 9z
    else
        let record = Builtin.__childAddress slot in
        let cached = __raw_get<Int64> record 40 in
        if cached >= 0 then Ok (Some (Stdlib.Int.fromInt64 cached))
        else
            let status = __mapped_alloc 8 in
            let _ = __raw_write_word status 0 0 in
            let rc = Builtin.__childWait4 (__raw_get<Int64> record 8) status 1 (__word_to_rawptr 0) in
            let raw = __raw_get<Int64> status 0 in
            let _ = __mapped_free status in
            if rc < 0 then Error (Stdlib.Int.fromInt64 (0 - rc))
            else if rc == 0 then Ok None
            else
                let signal = Stdlib.Int64.bitwiseAnd raw 127 in
                let exitCode = if signal == 0 then Stdlib.Int64.bitwiseAnd (raw / 256) 255 else 128 + signal in
                let _ = __raw_write_word record 40 exitCode in
                Ok (Some (Stdlib.Int.fromInt64 exitCode))

let runtimeChildKill (handle: Int) : Stdlib.Result.Result<Unit, Int> =
    match Builtin.runtimeChildPoll handle with
    | Error e -> Error e
    | Ok (Some _) -> Ok (())
    | Ok None ->
        let slot = Builtin.__childFind (Builtin.__posixInt64 handle) 1 in
        match Stdlib.Cli.__kill (__raw_get<Int64> (Builtin.__childAddress slot) 8) 9 with
        | Ok _ -> Ok (())
        | Error e -> Error (Stdlib.Int.fromInt64 e.errno)

let runtimeChildWait (handle: Int) : Stdlib.Result.Result<Int, Int> =
    let slot = Builtin.__childFind (Builtin.__posixInt64 handle) 1 in
    if slot == 0 then Error 9z
    else
        let record = Builtin.__childAddress slot in
        let cached = __raw_get<Int64> record 40 in
        if cached >= 0 then Ok (Stdlib.Int.fromInt64 cached)
        else
            let status = __mapped_alloc 8 in
            let _ = __raw_write_word status 0 0 in
            let rc = Builtin.__childWait4 (__raw_get<Int64> record 8) status 0 (__word_to_rawptr 0) in
            let raw = __raw_get<Int64> status 0 in
            let _ = __mapped_free status in
            if rc < 0 then Error (Stdlib.Int.fromInt64 (0 - rc))
            else
                let signal = Stdlib.Int64.bitwiseAnd raw 127 in
                let exitCode = if signal == 0 then Stdlib.Int64.bitwiseAnd (raw / 256) 255 else 128 + signal in
                let _ = __raw_write_word record 40 exitCode in
                Ok (Stdlib.Int.fromInt64 exitCode)

let runtimeChildClosePort (handle: Int) (index: Int) : Stdlib.Result.Result<Unit, Int> =
    let slot = Builtin.__childFind (Builtin.__posixInt64 handle) 1 in
    if slot == 0 || index < 0z || index > 2z then Error 9z
    else
        let record = Builtin.__childAddress slot in
        let offset = 16 + Builtin.__posixInt64 index * 8 in
        let fd = __raw_get<Int64> record offset in
        if fd < 0 then Ok (())
        else
            let _ = __raw_write_word record offset -1 in
            Builtin.__syscallUnitResult (Stdlib.Cli.__Posix.__close fd)

let runtimeChildBufferGet (handle: Int) (index: Int) : Stdlib.Result.Result<Blob, Int> =
    let slot = Builtin.__childFind (Builtin.__posixInt64 handle) 1 in
    if slot == 0 || index < 0z || index > 1z then Error 9z
    else
        let address = __raw_get<Int64> (Builtin.__childAddress slot) (48 + Builtin.__posixInt64 index * 8) in
        if address == 0 then Ok (Stdlib.Blob.fromList [])
        else
            let ptr = __word_to_rawptr address in
            Ok (Stdlib.Cli.__Posix.__bufferBytes ptr 8 (8 + __raw_get<Int64> ptr 0) [])

let runtimeChildBufferSet (handle: Int) (index: Int) (bytes: Blob) : Stdlib.Result.Result<Unit, Int> =
    let slot = Builtin.__childFind (Builtin.__posixInt64 handle) 1 in
    if slot == 0 || index < 0z || index > 1z then Error 9z
    else
        let record = Builtin.__childAddress slot in
        let offset = 48 + Builtin.__posixInt64 index * 8 in
        let old = __raw_get<Int64> record offset in
        let length = Stdlib.Blob.__byteLength bytes in
        let ptr = __mapped_alloc (8 + length) in
        let _ = __raw_write_word ptr 0 length in
        let _ = Stdlib.Cli.__Posix.__writeBytes bytes (__word_to_rawptr (__rawptr_to_word ptr + 8)) 0 in
        let _ = __raw_write_word record offset (__rawptr_to_word ptr) in
        let _ = if old == 0 then () else __mapped_free (__word_to_rawptr old) in
        Ok (())

let runtimeChildClose (handle: Int) : Stdlib.Result.Result<Unit, Int> =
    let slot = Builtin.__childFind (Builtin.__posixInt64 handle) 1 in
    if slot == 0 then Error 9z
    else
        let record = Builtin.__childAddress slot in
        let _ = Builtin.runtimeChildClosePort handle 0z in
        let _ = Builtin.runtimeChildClosePort handle 1z in
        let _ = Builtin.runtimeChildClosePort handle 2z in
        match Builtin.runtimeChildKill handle with
        | Error e -> Error e
        | Ok _ ->
            let status = __mapped_alloc 8 in
            let rc = if __raw_get<Int64> record 40 >= 0 then 0
                     else Builtin.__childWait4 (__raw_get<Int64> record 8) status 0 (__word_to_rawptr 0) in
            let _ = __mapped_free status in
            if rc < 0 && rc != -10 then Error (Stdlib.Int.fromInt64 (0 - rc))
            else
                let first = __raw_get<Int64> record 48 in
                let second = __raw_get<Int64> record 56 in
                let _ = if first == 0 then () else __mapped_free (__word_to_rawptr first) in
                let _ = if second == 0 then () else __mapped_free (__word_to_rawptr second) in
                let _ = __raw_write_word record 0 0 in
                Ok (())
