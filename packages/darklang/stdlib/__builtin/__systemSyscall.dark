// Typed byte-record adapters for host-fact syscalls; no decoding or retries.
module Builtin

let syscallUname(): Stdlib.Result.Result<Blob, Int> =
    let buffer = __mapped_alloc(390) in
    let rc = Stdlib.Cli.__Posix.__uname(buffer) in
    let result =
        if rc < 0 then Error(Stdlib.Int.fromInt64(0 - rc))
        else Ok(Stdlib.Cli.__Posix.__bufferBytes(buffer, 0, 390, [])) in
    let _ = __mapped_free(buffer) in
    result

let __writeMib(mib: List<Int>, buffer: RawPtr, offset: Int64): Unit =
    match mib with
    | [] -> ()
    | key :: rest ->
        // Allocate four padding bytes so the last word write remains in bounds.
        let _ = __raw_write_word(buffer, offset, Builtin.__posixInt32(key)) in
        Builtin.__writeMib(rest, buffer, offset + 4)

let syscallSysctl(mib: List<Int>, count: Int): Stdlib.Result.Result<Blob, Int> =
    let count = Builtin.__posixInt32(count) in
    let length = Stdlib.Int.toInt64(Stdlib.List.__lengthInt(mib)) |> Builtin.unwrap in
    if count <= 0 || length == 0 then Error(22z)
    else
        let keys = __mapped_alloc(length * 4 + 4) in
        let _ = Builtin.__writeMib(mib, keys, 0) in
        let buffer = __mapped_alloc(count) in
        let size = __mapped_alloc(8) in
        let _ = __raw_write_word(size, 0, count) in
        let rc = Stdlib.Cli.__Posix.__sysctl(keys, length, buffer, size, __word_to_rawptr(0), 0) in
        let actual = __raw_get(size, 0) in
        let result =
            if rc < 0 then Error(Stdlib.Int.fromInt64(0 - rc))
            else if actual < 0 || actual > count then Error(5z)
            else Ok(Stdlib.Cli.__Posix.__bufferBytes(buffer, 0, actual, [])) in
        let _ = __mapped_free(size) in
        let _ = __mapped_free(buffer) in
        let _ = __mapped_free(keys) in
        result

let syscallSchedGetaffinity(pid: Int, count: Int): Stdlib.Result.Result<Blob, Int> =
    let pid = Builtin.__posixInt32(pid) in
    let count = Builtin.__posixInt32(count) in
    if count <= 0 then Error(22z)
    else
        let buffer = __mapped_alloc(count) in
        let rc = Stdlib.Cli.__Posix.__schedGetaffinity(pid, count, buffer) in
        let result =
            if rc < 0 then Error(Stdlib.Int.fromInt64(0 - rc))
            else Ok(Stdlib.Cli.__Posix.__bufferBytes(buffer, 0, rc, [])) in
        let _ = __mapped_free(buffer) in
        result
