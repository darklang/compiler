// Terminal facts and text inspection for interpreter package APIs.
module Builtin

let __isTerminal (fd: Int64) : Bool =
    // TCGETS on Linux; TIOCGETA on Darwin. Only success matters, so the
    // scratch buffer covers both kernel layouts without decoding termios.
    let request = if Stdlib.Cli.__Posix.__mac () then 1078490131 else 21505 in
    let buffer = __mapped_alloc 128 in
    let result = Stdlib.Cli.__Posix.__ioctl fd request buffer == 0 in
    let _ = __mapped_free buffer in
    result

let cliTerminalSessionInfo () : (Bool * Bool * String) =
    let input = Builtin.__isTerminal 0 in
    let output = Builtin.__isTerminal 1 in
    let name = Stdlib.Option.withDefault (Stdlib.Cli.__getenv "TERM") "" in
    (input, output, name)

let cliTerminalIsatty (fd: Int64) : Bool =
    (fd == 0 || fd == 1 || fd == 2) && Builtin.__isTerminal fd

let cliTerminalColorEnabled () : Bool =
    let noColor = Stdlib.Option.withDefault (Stdlib.Cli.__getenv "NO_COLOR") "" in
    noColor == "" && Builtin.__isTerminal 1

let stdinIsInteractive () : Bool =
    // Match the interpreter: output alone being a terminal also counts.
    Builtin.__isTerminal 0 || Builtin.__isTerminal 1

let cliTerminalInspectRow (text: String) : (Int * Bool) =
    // This measures plain text: escape payloads are not stripped. Control
    // detection also recognizes the single CRLF grapheme cluster.
    let width = Stdlib.String.__displayWidthInt text in
    let controls = Stdlib.List.any (Stdlib.String.toList text) Stdlib.Cli.Tui.Text.__isControl in
    (width, controls)

let __terminalSize (fd: Int64) : Stdlib.Option.Option<(Int * Int)> =
    // TIOCGWINSZ: two unsigned 16-bit dimensions, then two pixel dimensions.
    let request = if Stdlib.Cli.__Posix.__mac () then 1074295912 else 21523 in
    let buffer = __mapped_alloc 8 in
    let size =
        if Stdlib.Cli.__Posix.__ioctl fd request buffer == 0 then
            let rows = Stdlib.Cli.__Posix.__unsigned buffer 0 2 in
            let columns = Stdlib.Cli.__Posix.__unsigned buffer 2 2 in
            if rows > 0 && columns > 0 then
                let dimensions = (Stdlib.Int.fromInt64 columns, Stdlib.Int.fromInt64 rows) in
                Stdlib.Option.Option.Some dimensions
            else Stdlib.Option.Option.None
        else Stdlib.Option.Option.None
    let _ = __mapped_free buffer in
    size

let __terminalDimension (name: String) (fallback: Int) : Int =
    match Stdlib.Cli.__getenv name with
    | None -> fallback
    | Some text ->
        match Stdlib.Int.parse text with
        | Ok value -> if value > 0z && value <= 2147483647z then value else fallback
        | Error _ -> fallback

let cliTerminalSize () : (Int * Int) =
    match Builtin.__terminalSize 1 with
    | Some size -> size
    | None ->
        match Builtin.__terminalSize 0 with
        | Some size -> size
        | None ->
            match Builtin.__terminalSize 2 with
            | Some size -> size
            | None ->
                // Native console dimensions are the same kernel query above.
                (Builtin.__terminalDimension "COLUMNS" 80z,
                 Builtin.__terminalDimension "LINES" 24z)
