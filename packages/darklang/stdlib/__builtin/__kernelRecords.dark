// Raw kernel records; shared Dark libraries own all field/name decoding.
module Builtin

let syscallStatAt(path: String): Stdlib.Result.Result<Blob, Int64> =
    Stdlib.Cli.__Posix.__withStat(path,
        fun ptr -> Stdlib.Cli.__Posix.__bufferBytes(ptr, 0, 256, []))
    |> Stdlib.Result.mapError(fun error -> error.errno)

let syscallGetdents(fd: Int, count: Int64): Stdlib.Result.Result<Blob, Int64> =
    let fd = Builtin.__posixInt32(fd) in
    let count = Builtin.__posixWidth32(count) in
    if count < 0 then Error(22)
    else
        let ptr = __mapped_alloc(if count == 0 then 1 else count) in
        let position = __mapped_alloc(8) in
        let _ = __raw_write_word(position, 0, 0) in
        let rc = Stdlib.Cli.__Posix.__getDents(fd, ptr, count, position) in
        let result =
            if rc < 0 then Error(0 - rc)
            else Ok(Stdlib.Cli.__Posix.__bufferBytes(ptr, 0, rc, [])) in
        let _ = __mapped_free(ptr) in
        let _ = __mapped_free(position) in
        result
