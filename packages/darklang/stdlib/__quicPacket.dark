// __QuicPacket.dark - Bounded QUIC v1 datagram framing and protected packet construction.
module Darklang.Stdlib.__QuicPacket

type Kind = Initial | ZeroRtt | Handshake | OneRtt
type Protected = {
  kind: Stdlib.__QuicPacket.Kind, destination: Blob, source: Blob, token: Blob,
  numberOffset: Int64, bytes: Blob, remaining: Blob
}
type Negotiation = { destination: Blob, source: Blob, versions: List<Int64> }
type RetryPacket = { destination: Blob, source: Blob, token: Blob, bytes: Blob }
type OtherVersion = { version: Int64, destination: Blob, source: Blob }
type Packet =
  | Protected of Stdlib.__QuicPacket.Protected
  | VersionNegotiation of Stdlib.__QuicPacket.Negotiation
  | Retry of Stdlib.__QuicPacket.RetryPacket
  | UnsupportedVersion of Stdlib.__QuicPacket.OtherVersion

let __versions(data: Blob, position: Int64, versions: List<Int64>): List<Int64> =
  if position == Stdlib.Blob.__byteLength(data) then Stdlib.List.reverse(versions)
  else Stdlib.__QuicPacket.__versions(data, position + 4, Stdlib.List.push(versions, Stdlib.__QuicCrypto.__numberBytes(data, position, 4, 0)))

let __protected(kind: Stdlib.__QuicPacket.Kind, destination: Blob, source: Blob, token: Blob, data: Blob, lengthOffset: Int64): Stdlib.Result.Result<Stdlib.__QuicPacket.Packet, String> =
  match Stdlib.__QuicWire.parseInteger(data, lengthOffset) with
  | Error(_) -> Error("Truncated QUIC packet length")
  | Ok(length) ->
    // The header-protection sample starts four bytes after the PN offset.
    // Do not inspect protected PN-length, key-phase, or reserved bits here.
    if length.value < 20 || length.value > Stdlib.Blob.__byteLength(data) - length.next then
      Error("Truncated QUIC protected packet")
    else
      let end_ = length.next + length.value in
      Ok(Protected(Stdlib.__QuicPacket.Protected {
        kind = kind, destination = destination, source = source, token = token,
        numberOffset = length.next, bytes = Stdlib.__Http2Wire.__slice(data, 0, end_),
        remaining = Stdlib.__Http2Wire.__slice(data, end_, Stdlib.Blob.__byteLength(data) - end_) }))

let __long(data: Blob, version: Int64, destination: Blob, source: Blob, position: Int64): Stdlib.Result.Result<Stdlib.__QuicPacket.Packet, String> =
  let size = Stdlib.Blob.__byteLength(data) in
  let first = Stdlib.Blob.__getByte(data, 0) in
  if version == 0 then
    if size == position || (size - position) % 4 != 0 then Error("Invalid QUIC version list")
    else Ok(VersionNegotiation(Stdlib.__QuicPacket.Negotiation {
      destination = destination, source = source, versions = Stdlib.__QuicPacket.__versions(data, position, []) }))
  else if version != 1 then Ok(UnsupportedVersion(Stdlib.__QuicPacket.OtherVersion {
    version = version, destination = destination, source = source }))
  else if Stdlib.Int64.bitwiseAnd(first, 64) == 0 then Error("Invalid QUIC fixed bit")
  else
    let kind = (first / 16) % 4 in
    if kind == 3 then
      if size - position <= 16 then Error("Invalid QUIC Retry token")
      else Ok(Retry(Stdlib.__QuicPacket.RetryPacket {
        destination = destination, source = source,
        token = Stdlib.__Http2Wire.__slice(data, position, size - position - 16), bytes = data }))
    else if kind == 0 then
      let result =
        match Stdlib.__QuicWire.parseInteger(data, position) with
        | Error(_) -> Error("Truncated QUIC Initial token")
        | Ok(length) ->
          if length.value > size - length.next then Error("Truncated QUIC Initial token")
          else Stdlib.__QuicPacket.__protected(Stdlib.__QuicPacket.Kind.Initial, destination, source, Stdlib.__Http2Wire.__slice(data, length.next, length.value), data, length.next + length.value) in
      result
    else Stdlib.__QuicPacket.__protected((if kind == 1 then Stdlib.__QuicPacket.Kind.ZeroRtt else Stdlib.__QuicPacket.Kind.Handshake), destination, source, Stdlib.Blob.empty, data, position)

// Unsupported versions use only version-invariant fields, including 8-bit
// CID lengths. Their payload format must not be interpreted as QUIC v1.
let parse(shortIdLength: Int64, data: Blob): Stdlib.Result.Result<Stdlib.__QuicPacket.Packet, String> =
  let size = Stdlib.Blob.__byteLength(data) in
  if size == 0 then Error("Empty QUIC datagram")
  else if size > 4096 then Error("QUIC datagram exceeds limit")
  else if shortIdLength < 0 || shortIdLength > 20 then Error("Invalid QUIC short connection ID length")
  else if Stdlib.Blob.__getByte(data, 0) < 128 then
    if Stdlib.Int64.bitwiseAnd(Stdlib.Blob.__getByte(data, 0), 64) == 0 then Error("Invalid QUIC fixed bit")
    else if size < 1 + shortIdLength + 20 then Error("Truncated QUIC protected packet")
    else Ok(Protected(Stdlib.__QuicPacket.Protected {
      kind = Stdlib.__QuicPacket.Kind.OneRtt,
      destination = Stdlib.__Http2Wire.__slice(data, 1, shortIdLength),
      source = Stdlib.Blob.empty, token = Stdlib.Blob.empty,
      numberOffset = 1 + shortIdLength, bytes = data, remaining = Stdlib.Blob.empty }))
  else if size < 7 then Error("Truncated QUIC long header")
  else
    let version = Stdlib.__QuicCrypto.__numberBytes(data, 1, 4, 0) in
    let destinationSize = Stdlib.Blob.__getByte(data, 5) in
    if version == 1 && destinationSize > 20 then Error("QUIC connection ID exceeds 20 bytes")
    else if destinationSize > size - 7 then Error("Truncated QUIC connection ID")
    else
      let sourceOffset = 6 + destinationSize in
      let sourceSize = Stdlib.Blob.__getByte(data, sourceOffset) in
      if version == 1 && sourceSize > 20 then Error("QUIC connection ID exceeds 20 bytes")
      else if sourceSize > size - sourceOffset - 1 then Error("Truncated QUIC connection ID")
      else Stdlib.__QuicPacket.__long(data, version, Stdlib.__Http2Wire.__slice(data, 6, destinationSize), Stdlib.__Http2Wire.__slice(data, sourceOffset + 1, sourceSize), sourceOffset + 1 + sourceSize)

let __longPrefix(kind: Stdlib.__QuicPacket.Kind, destination: Blob, source: Blob, token: Blob): Stdlib.Result.Result<Blob, String> =
  if Stdlib.Blob.__byteLength(destination) > 20 || Stdlib.Blob.__byteLength(source) > 20 then
    Error("QUIC connection ID exceeds 20 bytes")
  else
    let code = match kind with | Initial -> 0 | ZeroRtt -> 16 | Handshake -> 32 | OneRtt -> -1 in
    if code < 0 then Error("1-RTT requires a QUIC short header")
    else if kind != Stdlib.__QuicPacket.Kind.Initial && Stdlib.Blob.__byteLength(token) != 0 then
      Error("QUIC token is only valid in Initial packets")
    else
      let prefix = Stdlib.Blob.concat([
        Stdlib.Blob.__fromInt64List([195 + code, 0, 0, 0, 1, Stdlib.Blob.__byteLength(destination)]),
        destination, Stdlib.Blob.__fromInt64List([Stdlib.Blob.__byteLength(source)]), source ]) in
      if kind != Stdlib.__QuicPacket.Kind.Initial then Ok(prefix)
      else
        match Stdlib.__QuicWire.integer(Stdlib.Blob.__byteLength(token)) with
        | Error(message) -> Error(message)
        | Ok(length) -> Ok(Stdlib.Blob.concat([prefix, length, token]))

let __sealLong(keys: Stdlib.__QuicCrypto.Keys, prefix: Blob, payload: Blob, number: Int64): Stdlib.Result.Result<Blob, String> =
  let size = Stdlib.Blob.__byteLength(payload) + 20 in
  // Packet Length may use non-minimal varints. Fix its width at two bytes,
  // so large Initial tokens cannot invalidate the padding calculation.
  if size >= 16384 then Error("QUIC packet exceeds datagram limit")
  else
    let length = Stdlib.Blob.__fromInt64List([64 + size / 256, size % 256]) in
    let head = Stdlib.Blob.concat([prefix, length]) in
    let numberBytes = Stdlib.Blob.__fromInt64List(Stdlib.__QuicWire.__bytes(number % 4294967296, 4, [])) in
    Stdlib.__QuicCrypto.seal(keys, Stdlib.Blob.concat([head, numberBytes]), payload, number, Stdlib.Blob.__byteLength(head))

// Four-byte PN fields keep the sample available even for an empty payload.
// Initial packets are padded to >=1200; coalescing can relax this later.
let sealLong(kind: Stdlib.__QuicPacket.Kind, keys: Stdlib.__QuicCrypto.Keys, destination: Blob, source: Blob, token: Blob, payload: Blob, number: Int64): Stdlib.Result.Result<Blob, String> =
  if number < 0 || number > 4611686018427387903 then Error("Invalid QUIC packet number")
  else if Stdlib.Blob.__byteLength(token) > 2048 || Stdlib.Blob.__byteLength(payload) > 4000 then
    Error("QUIC packet exceeds datagram limit")
  else
    match Stdlib.__QuicPacket.__longPrefix(kind, destination, source, token) with
    | Error(message) -> Error(message)
    | Ok(prefix) ->
      // Padded Initial lengths always occupy at least two varint bytes.
      let minimum = if kind == Stdlib.__QuicPacket.Kind.Initial then 1200 - Stdlib.Blob.__byteLength(prefix) - 22 else 0 in
      let padding = minimum - Stdlib.Blob.__byteLength(payload) in
      let body = if padding > 0 then Stdlib.Blob.concat([
        payload, Stdlib.Blob.__fromInt64List(Stdlib.List.repeatUnsafe(Stdlib.Int.fromInt64(padding), 0)) ]) else payload in
      match Stdlib.__QuicPacket.__sealLong(keys, prefix, body, number) with
      | Error(message) -> Error(message)
      | Ok(packet) -> if Stdlib.Blob.__byteLength(packet) > 4096 then Error("QUIC packet exceeds datagram limit") else Ok(packet)

let sealShort(keys: Stdlib.__QuicCrypto.Keys, destination: Blob, keyPhase: Bool, payload: Blob, number: Int64): Stdlib.Result.Result<Blob, String> =
  if Stdlib.Blob.__byteLength(destination) > 20 then Error("QUIC connection ID exceeds 20 bytes")
  else if Stdlib.Blob.__byteLength(payload) > 4000 then Error("QUIC packet exceeds datagram limit")
  else if number < 0 || number > 4611686018427387903 then Error("Invalid QUIC packet number")
  else
    let header = Stdlib.Blob.concat([
      Stdlib.Blob.__fromInt64List([if keyPhase then 71 else 67]), destination,
      Stdlib.Blob.__fromInt64List(Stdlib.__QuicWire.__bytes(number % 4294967296, 4, [])) ]) in
    Stdlib.__QuicCrypto.seal(keys, header, payload, number, 1 + Stdlib.Blob.__byteLength(destination))
