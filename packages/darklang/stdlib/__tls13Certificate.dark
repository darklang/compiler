// Stdlib.__Tls13Certificate.dark - bounded TLS 1.3 certificate flight framing.

module Darklang.Stdlib.__Tls13Certificate

type Entry = { der: Blob, extensions: Blob }
type Certificate = { entries: List<Stdlib.__Tls13Certificate.Entry> }
type CertificateVerify = { algorithm: Int64, signature: Blob }

let __read16 (data: Blob) (offset: Int64) : Int64 =
  Stdlib.Blob.__getByte data offset * 256 + Stdlib.Blob.__getByte data (offset + 1)

let __read24 (data: Blob) (offset: Int64) : Int64 =
  Stdlib.Blob.__getByte data offset * 65536
  + Stdlib.Blob.__getByte data (offset + 1) * 256
  + Stdlib.Blob.__getByte data (offset + 2)

let __entries (data: Blob) (position: Int64) (end_: Int64) (count: Int64)
              (acc: List<Stdlib.__Tls13Certificate.Entry>)
              : Stdlib.Result.Result<List<Stdlib.__Tls13Certificate.Entry>, String> =
  if position == end_ then
    if count == 0 then Error "TLS certificate list is empty"
    else Ok (Stdlib.List.reverse acc)
  else if count == 8 || position + 3 > end_ then Error "Invalid TLS certificate list"
  else
    let certificateLength = Stdlib.__Tls13Certificate.__read24 data position in
    let certificateStart = position + 3 in
    let certificateEnd = certificateStart + certificateLength in
    if certificateLength == 0 || certificateLength > 65536
       || certificateEnd + 2 > end_ then Error "Invalid TLS certificate list"
    else
      let extensionLength = Stdlib.__Tls13Certificate.__read16 data certificateEnd in
      let extensionStart = certificateEnd + 2 in
      let next = extensionStart + extensionLength in
      if extensionLength > 16384 || next > end_ then Error "Invalid TLS certificate list"
      else
        let der = Stdlib.Blob.slice data (Stdlib.Int.fromInt64 certificateStart)
                    (Stdlib.Int.fromInt64 certificateLength) in
        let extensions = Stdlib.Blob.slice data (Stdlib.Int.fromInt64 extensionStart)
                           (Stdlib.Int.fromInt64 extensionLength) in
        Stdlib.__Tls13Certificate.__entries data next end_ (count + 1)
          (Stdlib.List.push acc (Stdlib.__Tls13Certificate.Entry { der = der, extensions = extensions }))

let parseCertificate (handshake: Blob)
                     : Stdlib.Result.Result<Stdlib.__Tls13Certificate.Certificate, String> =
  let length = Stdlib.Blob.__byteLength handshake in
  if length < 8 || length > 524288 || Stdlib.Blob.__getByte handshake 0 != 11
     || Stdlib.__Tls13Certificate.__read24 handshake 1 != length - 4
     || Stdlib.Blob.__getByte handshake 4 != 0 then
    Error "Invalid TLS Certificate message"
  else
    let listLength = Stdlib.__Tls13Certificate.__read24 handshake 5 in
    if listLength != length - 8 then Error "Invalid TLS Certificate message"
    else
      match Stdlib.__Tls13Certificate.__entries handshake 8 length 0 [] with
      | Error error -> Error error
      | Ok entries -> Ok (Stdlib.__Tls13Certificate.Certificate { entries = entries })

let parseCertificateVerify (handshake: Blob)
                           : Stdlib.Result.Result<Stdlib.__Tls13Certificate.CertificateVerify, String> =
  let length = Stdlib.Blob.__byteLength handshake in
  if length < 8 || length > 1032 || Stdlib.Blob.__getByte handshake 0 != 15
     || Stdlib.__Tls13Certificate.__read24 handshake 1 != length - 4 then
    Error "Invalid TLS CertificateVerify message"
  else
    let algorithm = Stdlib.__Tls13Certificate.__read16 handshake 4 in
    let signatureLength = Stdlib.__Tls13Certificate.__read16 handshake 6 in
    if ((algorithm == 2052 && signatureLength >= 256 && signatureLength <= 1024)
        || (algorithm == 1027 && signatureLength >= 70 && signatureLength <= 72))
       && signatureLength == length - 8 then
      Ok (Stdlib.__Tls13Certificate.CertificateVerify {
            algorithm = algorithm,
            signature = Stdlib.Blob.slice handshake (Stdlib.Int.fromInt64 8)
                          (Stdlib.Int.fromInt64 signatureLength) })
    else
      Error "Invalid TLS CertificateVerify message"

let certificateVerifyInput (transcript: Blob) : Blob =
  // RFC 8446 section 4.4.3: context separation precedes the transcript hash.
  let prefix = Stdlib.Blob.__fromInt64List (Stdlib.List.repeatUnsafe 64z (32)) in
  Stdlib.Blob.concat
    [prefix, Stdlib.String.toBlob "TLS 1.3, server CertificateVerify",
     Stdlib.Blob.__fromInt64List [0], Stdlib.Crypto.sha256 transcript]

let certificateVerifyInput384 (transcript: Blob) : Blob =
  let prefix = Stdlib.Blob.__fromInt64List (Stdlib.List.repeatUnsafe 64z (32)) in
  Stdlib.Blob.concat
    [prefix, Stdlib.String.toBlob "TLS 1.3, server CertificateVerify",
     Stdlib.Blob.__fromInt64List [0], Stdlib.Crypto.sha384 transcript]
