// Nsieve Benchmark - Sieve of Eratosthenes
// Counts primes up to n using a mutable flat bit-packed bitmap.

let isComposite(bitmap: RawPtr, index: Int64) : Bool =
    let byte = __raw_get_byte(bitmap, index / 8L + 8L) in
    let mask = 1L << (index % 8L) in
    (byte & mask) != 0L

let setComposite(bitmap: RawPtr, index: Int64) : Unit =
    let offset = index / 8L + 8L in
    let byte = __raw_get_byte(bitmap, offset) in
    __raw_write_byte(bitmap, offset, Stdlib.Int64.bitwiseOr(byte, 1L << (index % 8L)))

let markMultiples(j: Int64, step: Int64, n: Int64, bitmap: RawPtr) : Unit =
    if j > n then ()
    else
        let _ = setComposite(bitmap, j) in
        markMultiples(j + step, step, n, bitmap)

let sieveLoop(i: Int64, n: Int64, bitmap: RawPtr, count: Int64) : Int64 =
    if i > n then count
    else
        if !isComposite(bitmap, i) then
            let _ = markMultiples(i + i, i, n, bitmap) in
            sieveLoop(i + 1L, n, bitmap, count + 1L)
        else sieveLoop(i + 1L, n, bitmap, count)

let nsieve(n: Int64) : Int64 =
    let bitmap = Stdlib.Blob.__createZeroed((n + 8L) / 8L) in
    sieveLoop(2L, n, __blob_to_rawptr(bitmap), 0L)

let repeat(remaining: Int64, n: Int64, result: Int64) : Int64 =
    if remaining <= 0L then result
    else repeat(remaining - 1L, n, nsieve(n))

let benchmarkArg(index: Int) : Int64 =
    match Stdlib.Cli.Args.int64(index) with
    | Ok(value) -> value
    | Error(message) -> Builtin.testRuntimeError(message)

Builtin.printLine(Stdlib.Int64.toString(repeat(benchmarkArg(1I), benchmarkArg(0I), 0L)))
