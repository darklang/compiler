// main.dark - Closed immutable-list pipeline for array-storage diagnostics.
let pipeline (seed: Int64) : Int64 =
    let xs = [seed, seed + 1L, seed + 2L] in
    let ys = Stdlib.List.map<Int64, Int64> (xs) (fun x -> x + 1L) in
    let zs = Stdlib.List.reverse<Int64> (ys) in
    Stdlib.List.fold<Int64, Int64> (zs) (0L) (fun acc x -> acc * 10L + x)

let loop (n: Int64) (acc: Int64) : Int64 =
    if n == 0L then acc
    else loop (n - 1L) (acc + pipeline (n % 10L))

loop (10000L) (0L)
