// runtime-effects.dark - Cross-target evaluation order, zero and huge negatives.
let printedRuntimeCount () : Int = let _ = Builtin.printLine "count" in 3
let printedRuntimeValue () : Int64 = let _ = Builtin.printLine "value" in 7L

let xs = Stdlib.List.repeatUnsafe (printedRuntimeCount ()) (printedRuntimeValue ()) in
let ys = Stdlib.List.map xs (fun x -> let _ = Builtin.printLine "map" in x + 1L) in
let positive = Stdlib.List.fold ys 5L (fun acc x -> let _ = Builtin.printLine "fold" in acc + x) in
let empty = Stdlib.List.repeatUnsafe 0 (printedRuntimeValue ()) in
let zero = Stdlib.List.fold empty 5L (fun acc x -> acc + x) in
let backwards = Stdlib.List.repeatUnsafe (-999999999999999999999999999999) (printedRuntimeValue ()) in
let negative = Stdlib.List.fold backwards 5L (fun acc x -> acc + x) in
positive + zero + negative
