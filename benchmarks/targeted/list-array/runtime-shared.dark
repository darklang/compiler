// runtime-shared.dark - Runtime-sized copies must preserve retained old versions.
let pipeline (count: Int) : Int64 =
    let xs = Stdlib.List.repeatUnsafe count 2L in
    let alias = xs in
    let ys = Stdlib.List.map xs (fun x -> x + 3L) in
    let old = Stdlib.List.fold alias 0L (fun acc x -> acc + x) in
    let fresh = Stdlib.List.fold (Stdlib.List.reverse ys) 0L (fun acc x -> acc + x) in
    old * 10L + fresh

let loop (n: Int64) (acc: Int64) : Int64 =
    if n == 0L then acc
    else loop (n - 1L) (acc + pipeline (Stdlib.Int.fromInt64 (256L + n % 2L)))

loop 1000L 0L
