/// Returns a random 8-bit signed integer between <param start> and <param end> (inclusive)
// @compiler replace: packages/darklang/stdlib/int8.dark#Darklang.Stdlib.Int8.random reason=compiler-implementation
let random(start: Int8, ``end``: Int8): Int8 =
  Stdlib.BigInt.random(Stdlib.BigInt.fromInt8(start), Stdlib.BigInt.fromInt8(``end``))
  |> Stdlib.BigInt.toInt8
  |> Builtin.unwrap


/// Get the square root of an <type Int8>
// @compiler replace: packages/darklang/stdlib/int8.dark#Darklang.Stdlib.Int8.sqrt reason=compiler-implementation
let sqrt(a: Int8): Float = Stdlib.Float.sqrt(Stdlib.Int8.toFloat(a))


/// The square root of <param a>, or {{Error NotANumber}} where <param a> is negative
let checkedSqrt(a: Int8): Stdlib.Result.Result<Float, Stdlib.Math.NonFinite> =
  Stdlib.Float.checkedSqrt(Stdlib.Int8.toFloat(a))


/// Converts an <type Int8> to a <type Float>
// @compiler replace: packages/darklang/stdlib/int8.dark#Darklang.Stdlib.Int8.toFloat reason=compiler-implementation
let toFloat(a: Int8): Float = Builtin.int8ToFloat(a)


/// Parses a <type String> into an <type Int8>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type Int8> range).
// @compiler replace: packages/darklang/stdlib/int8.dark#Darklang.Stdlib.Int8.parse reason=compiler-implementation
let parse(s: String): Stdlib.Result.Result<Int8, Stdlib.Int8.ParseError> =
  match Stdlib.BigInt.parse(s) with
  | Ok(n) -> Stdlib.Option.toResult(Stdlib.BigInt.toInt8(n), Stdlib.Int8.ParseError.OutOfRange)
  | Error(_) -> Error(Stdlib.Int8.ParseError.BadFormat)


/// Converts a <type UInt8> to an <type Int8>. Returns {{None}} if the value is greater than 127.
// @compiler replace: packages/darklang/stdlib/int8.dark#Darklang.Stdlib.Int8.fromUInt8 reason=compiler-implementation
let fromUInt8(i: UInt8): Stdlib.Option.Option<Int8> =
  Stdlib.BigInt.toInt8(Stdlib.BigInt.fromUInt8(i))


