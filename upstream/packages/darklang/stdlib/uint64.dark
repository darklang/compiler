/// Returns a random integer between <param start> and <param end> (inclusive)
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.random reason=compiler-implementation
let random(start: UInt64, end: UInt64): UInt64 =
  BigInt.random(BigInt.fromUInt64(start), BigInt.fromUInt64(end))
  |> BigInt.toUInt64
  |> Builtin.unwrap


/// Get the square root of an <type UInt64>
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.sqrt reason=compiler-implementation
let sqrt(a: UInt64): Float64 =
  Float64.sqrt(toFloat64(a))


/// Converts an <type UInt64> to a <type Float64>
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.toFloat64 reason=compiler-implementation
let toFloat64(a: UInt64): Float64 =
  Builtin.uint64ToFloat64(a)


/// Converts a <type Float64> to an <type UInt64>, truncating toward zero like
/// <fn BigInt.fromFloat64>. Returns {{None}} for NaN, infinity, or a result that
/// doesn't fit.
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.fromFloat64 reason=compiler-implementation
let fromFloat64(a: Float64): Option<UInt64> =
  if Float64.isFinite(a) then
    a
    |> BigInt.fromFloat64
    |> BigInt.toUInt64
  else
    Option.None


/// Converts a <type Float64> to an <type UInt64>, rounding to the nearest integer
/// (ties to even). Returns {{None}} for NaN, infinity, or a result that
/// doesn't fit.
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.fromFloatRounded reason=compiler-implementation
let fromFloatRounded(a: Float64): Option<UInt64> =
  if Float64.isFinite(a) && a >= 9223372036854775808.0 then
    // every Float64 from 2^63 up is a whole number, so there is nothing to round
    a
    |> BigInt.fromFloat64
    |> BigInt.toUInt64
  else if a >= -1.0 && a < 9223372036854775808.0 then
    a
    |> Float64.round
    |> fromInt64
  else
    Option.None


/// Parses a <type String> into a <type UInt64>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type UInt64> range).
// @compiler replace: packages/darklang/stdlib/uint64.dark#Darklang.Stdlib.UInt64.parse reason=compiler-implementation
let parse(s: String): Result<UInt64, ParseError> =
  // a plain match: the generic Option.toResult call was a quarter of the cost
  match BigInt.parse(s) with
  | Ok(n) ->
    match BigInt.toUInt64(n) with
    | Some(i) -> Result.Ok(i)
    | None -> Result.Error(ParseError.OutOfRange)
  | Error(_) -> Result.Error(ParseError.BadFormat)


