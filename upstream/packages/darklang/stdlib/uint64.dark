// @compiler blocked: container-adaptation diagnostic="Already selected from packages/darklang/stdlib/uint64.dark; importing another declaration of Darklang.Stdlib.UInt64.impl Power for UInt64 requires an explicit replacement contract"
impl Power for UInt64 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  // @compiler blocked: container-adaptation diagnostic="Containing implementation Darklang.Stdlib.UInt64.impl Power for UInt64: Already selected from packages/darklang/stdlib/uint64.dark; importing another declaration of Darklang.Stdlib.UInt64.impl Power for UInt64 requires an explicit replacement contract"
  let power(base: UInt64, exponent: UInt64): UInt64 =
    // The signed types push this into the builtin; here the ladder stays, because an
    // unsigned exponent is never negative, so there is no error case to push.
    if base == 0u64 && exponent == 0u64 then
      1u64
    else if base == 0u64 then
      0u64
    else if base == 1u64 then
      1u64
    else
      Builtin.power(base, exponent)


