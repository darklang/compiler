// Checked arithmetic. The operators wrap on overflow; these return
// {{Error Overflow}} instead, going below 0 included.

/// Adds <param a> and <param b>, or {{Error Overflow}} where `+` would wrap
let checkedAdd(
  a: UInt128,
  b: UInt128)
  : Stdlib.Result.Result<UInt128, Stdlib.Math.Overflow> =
  let sum = a + b
  if sum < a then Error(Stdlib.Math.Overflow.Overflow) else Ok(sum)


/// Subtracts <param b> from <param a>, or {{Error Overflow}} where `-` would wrap
let checkedSubtract(
  a: UInt128,
  b: UInt128)
  : Stdlib.Result.Result<UInt128, Stdlib.Math.Overflow> =
  if b > a then Error(Stdlib.Math.Overflow.Overflow) else Ok(a - b)


/// Multiplies <param a> by <param b>, or {{Error Overflow}} where `*` would wrap
let checkedMultiply(
  a: UInt128,
  b: UInt128)
  : Stdlib.Result.Result<UInt128, Stdlib.Math.Overflow> =
  let product = Stdlib.BigInt.fromUInt128(a) * Stdlib.BigInt.fromUInt128(b)
  match Stdlib.BigInt.toUInt128(product) with
  | Some(fits) -> Ok(fits)
  | None -> Error(Stdlib.Math.Overflow.Overflow)


/// The negation of <param a>: {{Ok 0}} for 0, and {{Error Overflow}} for
/// anything else, which has no unsigned negation
let checkedNegate(a: UInt128): Stdlib.Result.Result<UInt128, Stdlib.Math.Overflow> =
  if a == 0u128 then Ok(a) else Error(Stdlib.Math.Overflow.Overflow)


/// The distance of <param a> from zero, which for an unsigned value is always
/// <param a> itself. Here so every fixed-width type has the same checked set.
let checkedAbsoluteValue(a: UInt128)
  : Stdlib.Result.Result<UInt128, Stdlib.Math.Overflow> =
  Ok(a)


/// <param base> raised to the power of <param exponent>, or {{Error Overflow}}
/// where `**` would wrap
// @compiler blocked: upstream-dependency diagnostic="Darklang.Stdlib.UInt128.checkedPower: Cannot perform numeric operation on UInt128 and UInt128"
let checkedPower(
  ``base``: UInt128,
  exponent: UInt128)
  : Stdlib.Result.Result<UInt128, Stdlib.Math.PowerError> =
  if ``base`` == 0u128 || ``base`` == 1u128 then
    // 0 and 1 never grow, so `**` is exact whatever the exponent
    Ok(``base`` ** exponent)
  else if exponent >= 128u128 then
    // any other base is at least 2 from zero, and 2 ** 128 is past the UInt128 range
    Error(Stdlib.Math.PowerError.Overflow)
  else
    let result = Stdlib.BigInt.fromUInt128(``base``) ** Stdlib.BigInt.fromUInt128(exponent)

    match Stdlib.BigInt.toUInt128(result) with
    | Some(fits) -> Ok(fits)
    | None -> Error(Stdlib.Math.PowerError.Overflow)


// Division. `/` raises on a zero divisor and `%` on a modulus that is not positive;
// these return the reason instead.
// TODO: make `/` and `%` themselves checked by default; see the TODO on the `divide`
// builtin in NoModule.fs.

/// Divides <param a> by <param b>, rounding towards zero, or
/// {{Error DivisionByZero}} where `/` raises.
let checkedDivide(
  a: UInt128,
  b: UInt128)
  : Stdlib.Result.Result<UInt128, Stdlib.Math.DivisionError> =
  if b == 0u128 then Error(Stdlib.Math.DivisionError.DivisionByZero) else Ok(a / b)


/// <param a> wrapped around so that {{0 <= res < b}}, or {{Error ZeroModulus}}
/// where `%` raises
let checkedMod(a: UInt128, b: UInt128): Stdlib.Result.Result<UInt128, Stdlib.Math.ModulusError> =
  if b == 0u128 then Error(Stdlib.Math.ModulusError.ZeroModulus) else Ok(a % b)
