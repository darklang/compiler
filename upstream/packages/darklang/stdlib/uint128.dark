/// Get the square root of an <type UInt128>
// @compiler replace: packages/darklang/stdlib/uint128.dark#Darklang.Stdlib.UInt128.sqrt reason=compiler-implementation
let sqrt(a: UInt128): Float = Stdlib.Float.sqrt(Stdlib.UInt128.toFloat(a))


/// Converts a <type UInt128> to a <type Float>
// @compiler replace: packages/darklang/stdlib/uint128.dark#Darklang.Stdlib.UInt128.toFloat reason=compiler-implementation
let toFloat(a: UInt128): Float = Builtin.uint128ToFloat(a)


/// Parses a <type String> into a <type UInt128>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type UInt128> range).
// @compiler replace: packages/darklang/stdlib/uint128.dark#Darklang.Stdlib.UInt128.parse reason=compiler-implementation
let parse(
  s: String)
  : Stdlib.Result.Result<UInt128, Stdlib.UInt128.ParseError> =
  // a plain match: the generic Option.toResult call was a quarter of the cost
  match Stdlib.BigInt.parse(s) with
  | Ok(n) ->
    match Stdlib.BigInt.toUInt128(n) with
    | Some(i) -> Stdlib.Result.Result.Ok(i)
    | None -> Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.OutOfRange)
  | Error(_) -> Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat)


/// Converts a <type UInt8> to an <type UInt128>.
// @compiler replace: packages/darklang/stdlib/uint128.dark#Darklang.Stdlib.UInt128.fromUInt8 reason=compiler-implementation
let fromUInt8(i: UInt8): UInt128 =
  Stdlib.BigInt.toUInt128(Stdlib.BigInt.fromUInt8(i)) |> Builtin.unwrap


/// Converts a <type UInt16> to an <type UInt128>.
