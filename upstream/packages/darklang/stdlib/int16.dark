/// Returns a random 16-bit signed integer between <param start> and <param end> (inclusive)
// @compiler replace: packages/darklang/stdlib/int16.dark#Darklang.Stdlib.Int16.random reason=compiler-implementation
let random(start: Int16, end: Int16): Int16 =
  BigInt.random(BigInt.fromInt16(start), BigInt.fromInt16(end))
  |> BigInt.toInt16
  |> Builtin.unwrap


/// Get the square root of an <type Int16>
// @compiler replace: packages/darklang/stdlib/int16.dark#Darklang.Stdlib.Int16.sqrt reason=compiler-implementation
let sqrt(a: Int16): Float64 =
  Float64.sqrt(toFloat64(a))


/// The square root of <param a>, or {{Error NotANumber}} where <param a> is negative
let checkedSqrt(a: Int16): Result<Float64, Math.NonFinite> =
  Float64.checkedSqrt(toFloat64(a))


/// Converts an <type Int16> to a <type Float64>
// @compiler replace: packages/darklang/stdlib/int16.dark#Darklang.Stdlib.Int16.toFloat64 reason=compiler-implementation
let toFloat64(a: Int16): Float64 =
  Builtin.int16ToFloat64(a)


/// Parses a <type String> into an <type Int16>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type Int16> range).
// @compiler replace: packages/darklang/stdlib/int16.dark#Darklang.Stdlib.Int16.parse reason=compiler-implementation
let parse(s: String): Result<Int16, ParseError> =
  // a plain match: the generic Option.toResult call was a quarter of the cost
  match BigInt.parse(s) with
  | Ok(n) ->
    match BigInt.toInt16(n) with
    | Some(i) -> Result.Ok(i)
    | None -> Result.Error(ParseError.OutOfRange)
  | Error(_) -> Result.Error(ParseError.BadFormat)


