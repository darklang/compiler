// Checked arithmetic. The operators wrap on overflow; these return
// {{Error Overflow}} instead, going below 0 included.

/// Adds <param a> and <param b>, or {{Error Overflow}} where `+` would wrap
let checkedAdd(
  a: Int16,
  b: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  let sum = a + b
  let wrapped = if b < 0s16 then sum > a else sum < a
  if wrapped then Error(Stdlib.Math.Overflow.Overflow) else Ok(sum)


/// Subtracts <param b> from <param a>, or {{Error Overflow}} where `-` would wrap
let checkedSubtract(
  a: Int16,
  b: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  let difference = a - b
  let wrapped = if b < 0s16 then difference < a else difference > a
  if wrapped then Error(Stdlib.Math.Overflow.Overflow) else Ok(difference)


/// Multiplies <param a> by <param b>, or {{Error Overflow}} where `*` would wrap
let checkedMultiply(
  a: Int16,
  b: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  let product = Stdlib.BigInt.fromInt16(a) * Stdlib.BigInt.fromInt16(b)
  match Stdlib.BigInt.toInt16(product) with
  | Some(fits) -> Ok(fits)
  | None -> Error(Stdlib.Math.Overflow.Overflow)


/// The negation of <param a>, or {{Error Overflow}} for the minimum value,
/// which `-` wraps back to itself
let checkedNegate(a: Int16): Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  if a == -32768s16 then Error(Stdlib.Math.Overflow.Overflow) else Ok(-a)


/// The distance of <param a> from zero, or {{Error Overflow}} for the minimum
/// value, which <fn Stdlib.abs> wraps back to itself
let checkedAbsoluteValue(a: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  if a == -32768s16 then
    Error(Stdlib.Math.Overflow.Overflow)
  else if a < 0s16 then
    Ok(-a)
  else
    Ok(a)


/// <param base> raised to the power of <param exponent>, or where `**` raises or wraps,
/// {{Error NegativeExponent}} or {{Error Overflow}}
let checkedPower(
  ``base``: Int16,
  exponent: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.PowerError> =
  if exponent < 0s16 then
    Error(Stdlib.Math.PowerError.NegativeExponent)
  else if ``base`` == 0s16 || ``base`` == 1s16 || ``base`` == -1s16 then
    // 0, 1 and -1 never grow, so `**` is exact whatever the exponent
    Ok(``base`` ** exponent)
  else if exponent >= 16s16 then
    // any other base is at least 2 from zero, and 2 ** 16 is past the Int16 range
    Error(Stdlib.Math.PowerError.Overflow)
  else
    let result = Stdlib.BigInt.fromInt16(``base``) ** Stdlib.BigInt.fromInt16(exponent)

    match Stdlib.BigInt.toInt16(result) with
    | Some(fits) -> Ok(fits)
    | None -> Error(Stdlib.Math.PowerError.Overflow)


// Division. `/` raises on a zero divisor and `%` on a modulus that is not positive;
// these return the reason instead.
// TODO: make `/` and `%` themselves checked by default; see the TODO on the `divide`
// builtin in NoModule.fs.

/// Divides <param a> by <param b>, rounding towards zero, or
/// {{Error DivisionByZero}} where `/` raises.
/// Dividing the minimum value by -1 wraps back to it, as `/` does.
let checkedDivide(a: Int16, b: Int16): Stdlib.Result.Result<Int16, Stdlib.Math.DivisionError> =
  if b == 0s16 then Error(Stdlib.Math.DivisionError.DivisionByZero) else Ok(a / b)


/// What is left after dividing <param value> by <param divisor>, rounding towards
/// zero: negative only if <param value> is, whatever the sign of <param divisor>.
/// {{Error DivisionByZero}} if <param divisor> is {{0}}.
/// Use <fn Int16.checkedMod> to wrap around into {{0 <= res < b}} instead.
let checkedRemainder(
  value: Int16,
  divisor: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.DivisionError> =
  if divisor == 0s16 then
    Error(Stdlib.Math.DivisionError.DivisionByZero)
  else
    Ok(value - (value / divisor) * divisor)


/// <param a> wrapped around so that {{0 <= res < b}}, or where `%` raises,
/// {{Error ZeroModulus}} or {{Error NegativeModulus}}
let checkedMod(a: Int16, b: Int16): Stdlib.Result.Result<Int16, Stdlib.Math.ModulusError> =
  if b == 0s16 then
    Error(Stdlib.Math.ModulusError.ZeroModulus)
  else if b < 0s16 then
    Error(Stdlib.Math.ModulusError.NegativeModulus)
  else
    Ok(a % b)
