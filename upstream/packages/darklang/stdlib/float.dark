// @compiler replace: packages/darklang/stdlib/float.dark#Darklang.Stdlib.Float.roundDown reason=compiler-implementation
let roundDown(a: Float): Int64 = floor(a)


/// Round to the nearest integer value
// @compiler replace: packages/darklang/stdlib/float.dark#Darklang.Stdlib.Float.round reason=compiler-implementation
