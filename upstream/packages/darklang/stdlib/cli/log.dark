/// Every level writes to stderr: a log line is never the answer, so `dark run x.dark | next` carries
/// only what the program printed with `Stdlib.printLine`.
module Darklang.Stdlib.Cli.Log

/// Log an info message (green prefix)
// @compiler replace: packages/darklang/stdlib/cli/log.dark#Darklang.Stdlib.Cli.Log.info reason=compiler-implementation
let info(msg: String): Unit =
  Stdlib.printErrorLine($"{Stdlib.Cli.UI.Colors.greenText("[INFO]")} {msg}")

/// Log a warning message (yellow prefix)
// @compiler replace: packages/darklang/stdlib/cli/log.dark#Darklang.Stdlib.Cli.Log.warn reason=compiler-implementation
let warn(msg: String): Unit =
  Stdlib.printErrorLine($"{Stdlib.Cli.UI.Colors.yellowText("[WARN]")} {msg}")

/// Log an error message (red prefix)
// @compiler replace: packages/darklang/stdlib/cli/log.dark#Darklang.Stdlib.Cli.Log.error reason=compiler-implementation
let error(msg: String): Unit =
  Stdlib.printErrorLine($"{Stdlib.Cli.UI.Colors.redText("[ERROR]")} {msg}")

/// Log a debug message (gray prefix)
// @compiler replace: packages/darklang/stdlib/cli/log.dark#Darklang.Stdlib.Cli.Log.debug reason=compiler-implementation
let debug(msg: String): Unit =
  Stdlib.printErrorLine($"{Stdlib.Cli.UI.Colors.grayText("[DEBUG]")} {msg}")

/// Log a success message (green prefix with checkmark)
// @compiler replace: packages/darklang/stdlib/cli/log.dark#Darklang.Stdlib.Cli.Log.success reason=compiler-implementation
let success(msg: String): Unit =
  Stdlib.printErrorLine($"{Stdlib.Cli.UI.Colors.greenText("[OK]")} {msg}")
