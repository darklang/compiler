module Darklang.Stdlib.Cli.Sys


/// Get the current user's login name.
/// Checks $LOGNAME, then $USER, then falls back to the passwd database.
// @compiler replace: packages/darklang/stdlib/cli/sys.dark#Darklang.Stdlib.Cli.Sys.currentUser reason=compiler-implementation
let currentUser(): Stdlib.Option.Option<String> =
  match Env.get("LOGNAME") with
  | Some(u) -> Stdlib.Option.Option.Some(u)
  | None ->
    match Env.get("USER") with
    | Some(u) -> Stdlib.Option.Option.Some(u)
    | None -> Stdlib.Cli.Posix.__accountLookup(Stdlib.Cli.Posix.__decimal(Builtin.syscallGetuid()), 0)


/// Get the system hostname.
// @compiler replace: packages/darklang/stdlib/cli/sys.dark#Darklang.Stdlib.Cli.Sys.hostname reason=compiler-implementation
let hostname(): Result.Result<String, Posix.Error> =
  (Posix.uname())
  |> Stdlib.Result.map(fun result -> Stdlib.Tuple3.second(result))


/// Get the operating system name (e.g. "Linux", "Darwin").
// @compiler replace: packages/darklang/stdlib/cli/sys.dark#Darklang.Stdlib.Cli.Sys.os reason=compiler-implementation
let os(): Result.Result<String, Posix.Error> =
  (Posix.uname())
  |> Stdlib.Result.map(fun result -> Stdlib.Tuple3.first(result))


/// Get the CPU architecture (e.g. "x86_64", "aarch64").
// @compiler replace: packages/darklang/stdlib/cli/sys.dark#Darklang.Stdlib.Cli.Sys.arch reason=compiler-implementation
let arch(): Result.Result<String, Posix.Error> =
  (Posix.uname())
  |> Stdlib.Result.map(fun result -> Stdlib.Tuple3.third(result))


/// The path of the running executable.
// @compiler replace: packages/darklang/stdlib/cli/sys.dark#Darklang.Stdlib.Cli.Sys.currentExecutablePath reason=compiler-implementation
let currentExecutablePath(): String =
  Builtin.runtimeExecutablePath()


/// Get the number of available CPUs.
// @compiler blocked: compiler-contract diagnostic="Replacement contract mismatch: upstream Unit -> Int64, replacement Unit -> Int"
let cpuCount(): Int64 =
  Stdlib.Cli.Sys.__cpuCount() |> Builtin.unwrap


/// Get the current process ID.
// @compiler blocked: compiler-contract diagnostic="Replacement contract mismatch: upstream Unit -> Int64, replacement Unit -> Int"
let currentPid(): Int64 =
  Builtin.syscallGetpid()


/// isatty for 0 (stdin), 1 (stdout) or 2 (stderr).
let isTerminal(fd: Int64): Bool =
  Builtin.cliTerminalIsatty(fd)


/// Check if the current user is root (uid 0).
// @compiler replace: packages/darklang/stdlib/cli/sys.dark#Darklang.Stdlib.Cli.Sys.isRoot reason=compiler-implementation
let isRoot(): Bool =
  (Builtin.syscallGetuid()) == 0


/// Host record selection, buffer growth and decoding shared by both engines.

// @compiler blocked: compiler-contract diagnostic="Replacement contract mismatch: upstream Blob -> Int64 -> Int64 -> String, replacement Blob -> Int -> Int -> String"
let __text(buffer: Bytes, offset: Int64, length: Int64): String =
  let field = Stdlib.Bytes.take(Stdlib.Bytes.drop(buffer, offset), length)
  let text =
    match Stdlib.Bytes.indexOf(field, 0u8) with
    | Some(nul) -> Stdlib.Bytes.take(field, nul)
    | None -> field
  Stdlib.Utf8.decodeWithReplacement(text)

// @compiler blocked: compiler-contract diagnostic="Replacement contract mismatch: upstream List<Int64> -> Int64 -> Darklang.Stdlib.Result.Result<Blob, Int64>, replacement List<Int> -> Int -> Darklang.Stdlib.Result.Result<Blob, Int>"
let __sysctlWith(mib: List<Int64>, count: Int64): Result.Result<Bytes, Int64> =
  match Builtin.syscallSysctl(mib, count) with
  | Error(e) ->
    if e == 4 then __sysctlWith(mib, count)
    else if e == 12 && count < 1048576 then __sysctlWith(mib, count * 2)
    else Error(e)
  | Ok(bytes) -> Ok(bytes)

// @compiler blocked: compiler-contract diagnostic="Replacement contract mismatch: upstream List<Int64> -> Darklang.Stdlib.Result.Result<String, Int64>, replacement List<Int> -> Darklang.Stdlib.Result.Result<String, Int>"
let __sysctlText(mib: List<Int64>): Result.Result<String, Int64> =
  __sysctlWith(mib, 256)
  |> Stdlib.Result.map(fun bytes -> __text(bytes, 0, Stdlib.Bytes.length(bytes)))

// @compiler blocked: compiler-contract diagnostic="Replacement contract mismatch: upstream Int64 -> Int64, replacement Int -> Int"
let __countBits(value: Int64): Int64 =
  if value == 0 then 0
  else
    (Stdlib.Int64.checkedMod(value, 2) |> Stdlib.Result.withDefault(0))
    + __countBits(Stdlib.Int64.checkedDivide(value, 2) |> Stdlib.Result.withDefault(0))

// @compiler blocked: compiler-contract diagnostic="Replacement contract mismatch: upstream Int64 -> Darklang.Stdlib.Result.Result<Blob, Int64>, replacement Int -> Darklang.Stdlib.Result.Result<Blob, Int>"
let __affinityWith(count: Int64): Result.Result<Bytes, Int64> =
  match Builtin.syscallSchedGetaffinity(0, count) with
  | Error(e) ->
    if e == 4 then __affinityWith(count)
    else if e == 22 && count < 1048576 then __affinityWith(count * 2)
    else Error(e)
  | Ok(mask) -> Ok(mask)

/// Available CPUs means the calling process's affinity on Linux, hw.ncpu on
/// Darwin, and one on the interpreter's single-threaded browser runtime.
// @compiler blocked: compiler-contract diagnostic="Replacement contract mismatch: upstream Unit -> Darklang.Stdlib.Result.Result<Int64, Int64>, replacement Unit -> Darklang.Stdlib.Result.Result<Int, Int>"
let __cpuCount(): Result.Result<Int64, Int64> =
  let result =
    if Builtin.runtimeTargetOS() == "browser" then Ok(1)
    else if Stdlib.Cli.Posix.__abiMac() then
      __sysctlWith([6, 3], 4)
      |> Stdlib.Result.andThen(fun bytes -> Stdlib.Cli.Posix.__kernelField(bytes, 0, 4))
    else
      __affinityWith(128)
      |> Stdlib.Result.map(fun bytes ->
        Stdlib.List.fold(Stdlib.Bytes.toList(bytes), 0,
          fun(total, byte) -> total + __countBits(Stdlib.Int64.fromUInt8(byte))))
  result |> Stdlib.Result.andThen(fun count -> if count > 0 then Ok(count) else Error(5))
