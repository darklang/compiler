// @compiler blocked: container-adaptation diagnostic="Already selected from packages/darklang/stdlib/char.dark; importing another declaration of Darklang.Stdlib.Char.impl Display for Char requires an explicit replacement contract"
impl Display for Char =
  /// Stringify <param c>
  // @compiler blocked: container-adaptation diagnostic="Containing implementation Darklang.Stdlib.Char.impl Display for Char: Already selected from packages/darklang/stdlib/char.dark; importing another declaration of Darklang.Stdlib.Char.impl Display for Char requires an explicit replacement contract"
  let display(c: Char): String = Builtin.charToString(c)


/// Return {{Some <var c>}} for the Unicode codepoint <param codepoint>,
/// or {{None}} if the value is not a valid scalar (> 0x10FFFF or a surrogate).
/// See <fn Codepoint.isValidScalar>.
// @compiler replace: packages/darklang/stdlib/char.dark#Darklang.Stdlib.Char.fromCodepoint reason=compiler-implementation
let fromCodepoint(codepoint: UInt32): Stdlib.Option.Option<Char> =
  if Stdlib.Codepoint.isValidScalar(codepoint) then
    Builtin.charFromCodepoint(codepoint)
  else Stdlib.Option.Option.None


/// Return the codepoint when <param c> contains exactly one Unicode scalar.
/// This is the inverse of <fn Char.fromCodepoint>.
// @compiler replace: packages/darklang/stdlib/char.dark#Darklang.Stdlib.Char.toCodepoint reason=compiler-implementation
let toCodepoint(c: Char): Stdlib.Option.Option<UInt32> =
  match Stdlib.String.toCodepoints(Stdlib.display(c)) with
  | [codepoint] -> Stdlib.Option.Option.Some(codepoint)
  | _ -> Stdlib.Option.Option.None
