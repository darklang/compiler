module Darklang.Stdlib.Base16


/// Base16 (hex) encodes <param bytes> using an uppercase alphabet.
/// Complies with RFC 4648 section 8.
// @compiler blocked: upstream-dependency diagnostic="Darklang.Stdlib.Base16.encode: Unknown function or value 'Builtin.base16Encode'"
let encode(bytes: Bytes): String = Builtin.base16Encode(bytes)


/// Parses <param s> as an uppercase or lowercase Base16 (hex) string into a Bytes.
// @compiler blocked: upstream-dependency diagnostic="Darklang.Stdlib.Base16.decode: Unknown function or value 'Builtin.base16Decode'"
let decode(s: String): Stdlib.Result.Result<Bytes, String> =
  Builtin.base16Decode(s)
