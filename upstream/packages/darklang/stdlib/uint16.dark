/// Returns a random 16-bit unsigned integer between <param start> and <param end> (inclusive)
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.random reason=compiler-implementation
let random(start: UInt16, ``end``: UInt16): UInt16 =
  Stdlib.BigInt.random(Stdlib.BigInt.fromUInt16(start), Stdlib.BigInt.fromUInt16(``end``))
  |> Stdlib.BigInt.toUInt16
  |> Builtin.unwrap


/// Get the square root of an <type UInt16>
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.sqrt reason=compiler-implementation
let sqrt(a: UInt16): Float = Stdlib.Float.sqrt(Stdlib.UInt16.toFloat(a))


/// Converts an <type UInt16> to a <type Float>
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.toFloat reason=compiler-implementation
let toFloat(a: UInt16): Float = Builtin.uint16ToFloat(a)


/// Parses a <type String> into a <type UInt16>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type UInt16> range).
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.parse reason=compiler-implementation
let parse(
  s: String)
  : Stdlib.Result.Result<UInt16, Stdlib.UInt16.ParseError> =
  // a plain match: the generic Option.toResult call was a quarter of the cost
  match Stdlib.BigInt.parse(s) with
  | Ok(n) ->
    match Stdlib.BigInt.toUInt16(n) with
    | Some(i) -> Stdlib.Result.Result.Ok(i)
    | None -> Stdlib.Result.Result.Error(Stdlib.UInt16.ParseError.OutOfRange)
  | Error(_) -> Stdlib.Result.Result.Error(Stdlib.UInt16.ParseError.BadFormat)


/// Converts an <type Int8> to a <type UInt16>. Returns {{None}} if the value is less than 0.
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.fromInt8 reason=compiler-implementation
let fromInt8(i: Int8): Stdlib.Option.Option<UInt16> =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromInt8(i))


/// Converts a <type UInt8> to a <type UInt16>.
// @compiler replace: packages/darklang/stdlib/uint16.dark#Darklang.Stdlib.UInt16.fromUInt8 reason=compiler-implementation
let fromUInt8(i: UInt8): UInt16 =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromUInt8(i)) |> Builtin.unwrap


