// @compiler blocked: container-adaptation diagnostic="Already selected from packages/darklang/stdlib/uint16.dark; importing another declaration of Darklang.Stdlib.UInt16.impl Power for UInt16 requires an explicit replacement contract"
impl Power for UInt16 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  // @compiler blocked: container-adaptation diagnostic="Containing implementation Darklang.Stdlib.UInt16.impl Power for UInt16: Already selected from packages/darklang/stdlib/uint16.dark; importing another declaration of Darklang.Stdlib.UInt16.impl Power for UInt16 requires an explicit replacement contract"
  let power(``base``: UInt16, exponent: UInt16): UInt16 =
    // The signed types push this into the builtin; here the ladder stays, because an
    // unsigned exponent is never negative, so there is no error case to push.
    if ``base`` == 0u16 && exponent == 0u16 then 1u16
    else if ``base`` == 0u16 then 0u16
    else if ``base`` == 1u16 then 1u16
    else Builtin.power(``base``, exponent)


