/// Tests of branches, commits, merges, rebases and conflicts, driven through the CLI.
///
/// Each test starts with a fresh store of its own, runs real `dark` commands in it, and checks
/// only what a person could see: what a command printed, its exit code, its `--json`, and what
/// `status`, `conflicts`, `branches`, `commits` and `eval` say afterwards. No test reads a table
/// or calls an SCM function, so the tests keep working whatever the store looks like underneath.
///
/// When both sides changed one name, the rule is: the newer edit wins, and the losing version is
/// recorded as a conflict.
///
/// A check wrapped in `bugToday` states what SHOULD happen. It passes while the bug is still
/// there, and fails once someone fixes it, telling them to remove the wrapper.
///
/// This file holds the helpers; the tests are grouped by command in the files beside it.
module Darklang.SCM.Tests.Cli


// ─── running a test ─────────────────────────────────────────────────────────

/// Run the steps against a fresh store, which is thrown away afterwards. Every step runs, in
/// order, and the test fails if any of them did.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.scenario: Unknown function or value 'Darklang.Cli.Tests.Instance.withInstance'"
let scenario(
  steps: Darklang.Cli.Tests.Instance.T -> List<Stdlib.Test.Result>)
  : Stdlib.Test.Result =
  Darklang.Cli.Tests.Instance.withInstance(fun dark -> Stdlib.Test.all(steps(dark)))

let shown(args: List<String>): String =
  "dark " + (Stdlib.String.join(args, " "))

/// Run `dark <args>` with extra environment variables. Gives the exit code, stdout, and both
/// streams together.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.runWithEnv: Expected TInt64, got TInt"
let runWithEnv(
  dark: Darklang.Cli.Tests.Instance.T,
  env: List<(String * String)>,
  args: List<String>)
  : (Int64 * String * String) =
  match
    Stdlib.Cli.Process.runWithEnv(
      dark.cli,
      args,
      Stdlib.List.concat(Darklang.Cli.Tests.Instance.env(dark), env))
  with
  | Error(e) -> (-1, "", $"could not run: {e}")
  | Ok(out) -> (out.exitCode, out.stdout, out.stdout + out.stderr)

// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.exec: Unknown function or value 'runWithEnv'"
let exec(
  dark: Darklang.Cli.Tests.Instance.T,
  args: List<String>)
  : (Int64 * String * String) =
  runWithEnv(dark, [], args)


// ─── setup steps ────────────────────────────────────────────────────────────

/// Run `dark <args>`. It must succeed; if it doesn't, the test fails at this step.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.run: Unknown function or value 'exec'"
let run(dark: Darklang.Cli.Tests.Instance.T, args: List<String>): Stdlib.Test.Result =
  let (code, _, said) = exec(dark, args)

  if code == 0 then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"`{shown(args)}` exited {Stdlib.toString(code)}: {said}")

/// `dark fn <name> <body>`: save a function.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.save: Unknown function or value 'run'"
let save(dark: Darklang.Cli.Tests.Instance.T, name: String, body: String): Stdlib.Test.Result =
  run(dark, [ "fn", name, body ])

/// Save a function that takes nothing and returns <param number>.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.saveNumber: Unknown function or value 'save'"
let saveNumber(
  dark: Darklang.Cli.Tests.Instance.T,
  name: String,
  number: String)
  : Stdlib.Test.Result =
  save(dark, name, $"(): Int64 = {number}")

/// `dark commit <message> -y`: commit the whole draft without asking.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.commit: Unknown function or value 'run'"
let commit(dark: Darklang.Cli.Tests.Instance.T, message: String): Stdlib.Test.Result =
  run(dark, [ "commit", message, "-y" ])

/// `dark switch <branch>`: move onto a branch, starting it if it is new.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.switch: Unknown function or value 'run'"
let switch(dark: Darklang.Cli.Tests.Instance.T, branch: String): Stdlib.Test.Result =
  run(dark, [ "switch", branch ])

/// `dark merge <branch> -y`: merge a branch into its parent without asking.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.merge: Unknown function or value 'run'"
let merge(dark: Darklang.Cli.Tests.Instance.T, branch: String): Stdlib.Test.Result =
  run(dark, [ "merge", branch, "-y" ])

/// The usual setup for a conflict: branch `feat` changes <param name> and commits, then main
/// changes it too and commits. Main's edit is the newer one. Leaves you on main.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.featThenMainEdit: Unknown function or value 'switch'"
let featThenMainEdit(
  dark: Darklang.Cli.Tests.Instance.T,
  name: String,
  onFeat: String,
  onMain: String)
  : Stdlib.Test.Result =
  Stdlib.Test.all(
    [ switch(dark, "feat")
      saveNumber(dark, name, onFeat)
      commit(dark, "feat edits")
      switch(dark, "main")
      saveNumber(dark, name, onMain)
      commit(dark, "main edits") ])


// ─── checks ─────────────────────────────────────────────────────────────────

/// `dark <args>` prints <param needle> (on stdout or stderr).
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.says: Unknown function or value 'exec'"
let says(
  dark: Darklang.Cli.Tests.Instance.T,
  args: List<String>,
  needle: String,
  why: String)
  : Stdlib.Test.Result =
  let (code, _, said) = exec(dark, args)

  if Stdlib.String.contains(said, needle) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"{why}: `{shown(args)}` should say '{needle}'. It said (exit {Stdlib.toString(code)}): {said}")

/// `dark <args>` prints something, and it does not include <param needle>.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.doesNotSay: Unknown function or value 'exec'"
let doesNotSay(
  dark: Darklang.Cli.Tests.Instance.T,
  args: List<String>,
  needle: String,
  why: String)
  : Stdlib.Test.Result =
  let (_, _, said) = exec(dark, args)

  if Stdlib.String.trim(said) == "" then
    Stdlib.Test.fail($"{why}: `{shown(args)}` printed nothing, so its silence proves nothing")
  else if Stdlib.String.contains(said, needle) then
    Stdlib.Test.fail($"{why}: `{shown(args)}` should not say '{needle}'. It said: {said}")
  else
    Stdlib.Test.Result.Pass

/// `dark <args>` fails (nonzero exit) and its output includes <param reason>.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.refuses: Unknown function or value 'exec'"
let refuses(
  dark: Darklang.Cli.Tests.Instance.T,
  args: List<String>,
  reason: String,
  why: String)
  : Stdlib.Test.Result =
  let (code, _, said) = exec(dark, args)

  if code == 0 then
    Stdlib.Test.fail($"{why}: `{shown(args)}` should refuse, but exited 0: {said}")
  else if Stdlib.String.contains(said, reason) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"{why}: `{shown(args)}` refused without saying '{reason}': {said}")

/// `dark <flags> eval <expr>` prints exactly <param expected>, with extra environment <param env>.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.evalsWith: Unknown function or value 'runWithEnv'"
let evalsWith(
  dark: Darklang.Cli.Tests.Instance.T,
  env: List<(String * String)>,
  flags: List<String>,
  expr: String,
  expected: String,
  why: String)
  : Stdlib.Test.Result =
  let args = Stdlib.List.concat(flags, [ "eval", expr ])
  let (code, out, said) = runWithEnv(dark, env, args)

  if (code == 0) && ((Stdlib.String.trim(out)) == expected) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"{why}: `{shown(args)}` should print {expected}. It said (exit {Stdlib.toString(code)}): {said}")

/// `dark eval <expr>` prints exactly <param expected>, on the branch you are on.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.evals: Unknown function or value 'evalsWith'"
let evals(
  dark: Darklang.Cli.Tests.Instance.T,
  expr: String,
  expected: String,
  why: String)
  : Stdlib.Test.Result =
  evalsWith(dark, [], [], expr, expected, why)

/// `dark --branch <branch> eval <expr>` prints exactly <param expected>.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.evalsOn: Unknown function or value 'evalsWith'"
let evalsOn(
  dark: Darklang.Cli.Tests.Instance.T,
  branch: String,
  expr: String,
  expected: String,
  why: String)
  : Stdlib.Test.Result =
  evalsWith(dark, [], [ "--branch", branch ], expr, expected, why)

// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.notFoundWith: Unknown function or value 'exec'"
let notFoundWith(
  dark: Darklang.Cli.Tests.Instance.T,
  flags: List<String>,
  expr: String,
  why: String)
  : Stdlib.Test.Result =
  let args = Stdlib.List.concat(flags, [ "eval", expr ])
  let (code, _, said) = exec(dark, args)

  if (code != 0) && (Stdlib.String.contains(said, "not found")) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"{why}: `{shown(args)}` should say the name is not found. It said (exit {Stdlib.toString(code)}): {said}")

/// `dark eval <expr>` fails because a name in it does not exist on the branch you are on.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.notFound: Unknown function or value 'notFoundWith'"
let notFound(dark: Darklang.Cli.Tests.Instance.T, expr: String, why: String): Stdlib.Test.Result =
  notFoundWith(dark, [], expr, why)

/// The same, on another branch: `dark --branch <branch> eval <expr>`.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.notFoundOn: Unknown function or value 'notFoundWith'"
let notFoundOn(
  dark: Darklang.Cli.Tests.Instance.T,
  branch: String,
  expr: String,
  why: String)
  : Stdlib.Test.Result =
  notFoundWith(dark, [ "--branch", branch ], expr, why)

/// Two values are equal.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.same: Unknown function or value 'Stdlib.toRepr'"
let same(actual: 'a, expected: 'a, why: String): Stdlib.Test.Result =
  if actual == expected then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"{why}: expected {Stdlib.toRepr(expected)}, got {Stdlib.toRepr(actual)}")

/// A bug we know about. <param shouldBe> checks what SHOULD happen, so it fails today and this
/// passes. When the bug is fixed, <param shouldBe> passes and this fails, asking for the wrapper
/// to be removed so the test then guards the fix.
let bugToday(bug: String, shouldBe: Stdlib.Test.Result): Stdlib.Test.Result =
  match shouldBe with
  | Fail(_) -> Stdlib.Test.Result.Pass
  | Pass ->
    Stdlib.Test.fail(
      $"this bug looks fixed: {bug}. Remove `bugToday` (and the line pinning today's behaviour) so the test guards the fix.")


// ─── reading --json ─────────────────────────────────────────────────────────

/// The last line of stdout as JSON, or `Null` when it is not JSON.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.json: Unknown function or value 'exec'"
let json(dark: Darklang.Cli.Tests.Instance.T, args: List<String>): Stdlib.AltJson.Json =
  let (_, out, _) = exec(dark, args)

  let line =
    out
    |> Stdlib.String.trim
    |> Stdlib.String.split("\n")
    |> Stdlib.List.last
    |> Stdlib.Option.withDefault("")

  match Stdlib.AltJson.parse(line) with
  | Ok(j) -> j
  | Error(_) -> Stdlib.AltJson.Json.Null

let field(j: Stdlib.AltJson.Json, name: String): Stdlib.AltJson.Json =
  Darklang.Cli.Tests.JsonShapes.field(j, name)

let rows(j: Stdlib.AltJson.Json): List<Stdlib.AltJson.Json> =
  Darklang.Cli.Tests.JsonShapes.rows(j)

let text(j: Stdlib.AltJson.Json, name: String): String =
  Darklang.Cli.Tests.JsonShapes.string(j, name)

// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.number: Unknown function or value 'Darklang.Cli.Tests.JsonShapes.int'"
let number(j: Stdlib.AltJson.Json, name: String): Int64 =
  Darklang.Cli.Tests.JsonShapes.int(j, name)

let flag(j: Stdlib.AltJson.Json, name: String): Bool =
  field(j, name) == Stdlib.AltJson.Json.Bool(true)


// ─── the draft ──────────────────────────────────────────────────────────────

/// `dark status --json`.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.status: Unknown function or value 'json'"
let status(dark: Darklang.Cli.Tests.Instance.T): Stdlib.AltJson.Json =
  json(dark, [ "status", "--json" ])

/// What a `status --json` says the draft changes, one line per name, sorted:
/// `new Tests.A.f`, `updated Tests.A.f`, or `followed Tests.A.caller` for a caller that was
/// repointed because something it calls changed.
let draftIn(s: Stdlib.AltJson.Json): List<String> =
  rows(field(s, "changed"))
  |> Stdlib.List.map(fun row ->
    let change = if flag(row, "followed") then "followed" else text(row, "change")
    $"{change} {text(row, "name")}")
  |> Stdlib.List.sort

/// What the draft changes on the branch you are on.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.draft: Unknown function or value 'status'"
let draft(dark: Darklang.Cli.Tests.Instance.T): List<String> =
  draftIn(status(dark))

/// What the draft changes on another branch.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.draftOn: Unknown function or value 'json'"
let draftOn(dark: Darklang.Cli.Tests.Instance.T, branch: String): List<String> =
  draftIn(json(dark, [ "--branch", branch, "status", "--json" ]))

/// How many draft entries point at a version of a name that the name no longer has.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.staleCallers: Unknown function or value 'number'"
let staleCallers(dark: Darklang.Cli.Tests.Instance.T): Int64 =
  number(status(dark), "constraints")

/// The draft holds nothing.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.draftIsEmpty: Unknown function or value 'status'"
let draftIsEmpty(dark: Darklang.Cli.Tests.Instance.T, why: String): Stdlib.Test.Result =
  let s = status(dark)

  if (number(s, "draftOps") == 0) && (Stdlib.List.isEmpty(rows(field(s, "changed")))) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"{why}: the draft should be empty, status says {Stdlib.AltJson.format(s)}")

/// The draft holds something.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.draftIsNotEmpty: Unknown function or value 'status'"
let draftIsNotEmpty(dark: Darklang.Cli.Tests.Instance.T, why: String): Stdlib.Test.Result =
  let s = status(dark)

  if number(s, "draftOps") > 0 then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"{why}: the draft should hold something, status says {Stdlib.AltJson.format(s)}")

/// `status` says you are on <param expected>.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.onBranch: Unknown function or value 'same'"
let onBranch(dark: Darklang.Cli.Tests.Instance.T, expected: String, why: String): Stdlib.Test.Result =
  same(text(status(dark), "branch"), expected, why)


// ─── conflicts ──────────────────────────────────────────────────────────────

/// One conflict as a sentence naming the branches: who was kept, who lost, and why.
/// For example `Tests.A.f: main kept over feat (later-origin-ts)`.
let conflictLine(c: Stdlib.AltJson.Json): String =
  let winner = text(c, "autoResolvedTo")
  let sides = rows(field(c, "candidates"))

  let kept =
    sides
    |> Stdlib.List.findFirst(fun s -> text(s, "hash") == winner)
    |> Stdlib.Option.map(fun s -> text(s, "author"))
    |> Stdlib.Option.withDefault("?")

  let lost =
    sides
    |> Stdlib.List.findFirst(fun s -> text(s, "hash") != winner)
    |> Stdlib.Option.map(fun s -> text(s, "author"))
    |> Stdlib.Option.withDefault("?")

  // `status --json` gives owner, modules and name but no `fqn`; `conflicts --json` gives both.
  let name =
    match text(c, "fqn") with
    | "" ->
      match text(c, "modules") with
      | "" -> $"{text(c, "owner")}.{text(c, "name")}"
      | modules -> $"{text(c, "owner")}.{modules}.{text(c, "name")}"
    | fqn -> fqn

  $"{name}: {kept} kept over {lost} ({text(c, "reason")})"

/// The conflicts a `--json` command reports, one sentence each, sorted.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.conflictsReportedBy: Unknown function or value 'json'"
let conflictsReportedBy(dark: Darklang.Cli.Tests.Instance.T, args: List<String>): List<String> =
  rows(field(json(dark, args), "conflicts"))
  |> Stdlib.List.map(conflictLine)
  |> Stdlib.List.sort

/// The conflicts recorded and not yet settled, on the branch you are on.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.conflicts: Unknown function or value 'conflictsReportedBy'"
let conflicts(dark: Darklang.Cli.Tests.Instance.T): List<String> =
  conflictsReportedBy(dark, [ "conflicts", "--json" ])

/// The conflicts merging <param branch> would record, without merging it.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.mergePreview: Unknown function or value 'conflictsReportedBy'"
let mergePreview(dark: Darklang.Cli.Tests.Instance.T, branch: String): List<String> =
  conflictsReportedBy(dark, [ "conflicts", "branch", branch, "--json" ])

/// The conflict ids a `--json` command reports, in order.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.conflictIds: Unknown function or value 'json'"
let conflictIds(dark: Darklang.Cli.Tests.Instance.T, args: List<String>): List<String> =
  rows(field(json(dark, args), "conflicts")) |> Stdlib.List.map(fun c -> text(c, "id"))


// ─── history and branches ───────────────────────────────────────────────────

/// Commit messages from a `--json` listing, newest first, leaving out the store's own baseline.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.commitMessages: Unknown function or value 'json'"
let commitMessages(dark: Darklang.Cli.Tests.Instance.T, args: List<String>): List<String> =
  rows(json(dark, args))
  |> Stdlib.List.map(fun c -> text(c, "message"))
  |> Stdlib.List.filter(fun m -> m != "package reload (baseline)")

/// Commit messages on the branch you are on, newest first.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.commits: Unknown function or value 'commitMessages'"
let commits(dark: Darklang.Cli.Tests.Instance.T): List<String> =
  commitMessages(dark, [ "commits", "--json" ])

/// Commit messages on main, newest first, from wherever you are.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.commitsOnMain: Unknown function or value 'commitMessages'"
let commitsOnMain(dark: Darklang.Cli.Tests.Instance.T): List<String> =
  commitMessages(dark, [ "--branch", "main", "commits", "--json" ])

/// The newest commit's id.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.newestCommit: Unknown function or value 'json'"
let newestCommit(dark: Darklang.Cli.Tests.Instance.T): String =
  rows(json(dark, [ "commits", "--json" ]))
  |> Stdlib.List.head
  |> Stdlib.Option.map(fun c -> text(c, "hash"))
  |> Stdlib.Option.withDefault("")

/// The newest op's id, from the last line of `ops 1` (`ops` has no `--json`).
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.newestOp: Unknown function or value 'exec'"
let newestOp(dark: Darklang.Cli.Tests.Instance.T): String =
  let (_, out, _) = exec(dark, [ "ops", "1" ])

  out
  |> Stdlib.String.trim
  |> Stdlib.String.split("\n")
  |> Stdlib.List.last
  |> Stdlib.Option.withDefault("")
  |> Stdlib.String.split(" ")
  |> Stdlib.List.head
  |> Stdlib.Option.withDefault("")

/// How many lines of `show <newest commit>` set <param name>.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.timesNewestCommitSets: Unknown function or value 'exec'"
let timesNewestCommitSets(dark: Darklang.Cli.Tests.Instance.T, name: String): Int64 =
  let (_, out, _) = exec(dark, [ "show", newestCommit(dark) ])

  out
  |> Stdlib.String.split("\n")
  |> Stdlib.List.filter(fun l -> Stdlib.String.startsWith(l, $"SetName {name} "))
  |> Stdlib.List.length

/// Branches from a `--json` listing as `name <- parent`, sorted, with ` [merged]` on merged ones.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.branchesListedBy: Unknown function or value 'json'"
let branchesListedBy(dark: Darklang.Cli.Tests.Instance.T, args: List<String>): List<String> =
  let listed = rows(json(dark, args))

  // `parentName` is empty when the parent is main, which has no row of its own.
  let parentOf(b: Stdlib.AltJson.Json): String =
    match text(b, "parentName") with
    | "" ->
      listed
      |> Stdlib.List.findFirst(fun p -> text(p, "id") == text(b, "parent"))
      |> Stdlib.Option.map(fun p -> text(p, "name"))
      |> Stdlib.Option.withDefault("main")
    | name -> name

  listed
  |> Stdlib.List.map(fun b ->
    let merged = if flag(b, "merged") then " [merged]" else ""
    $"{text(b, "name")} <- {parentOf(b)}{merged}")
  |> Stdlib.List.sort

/// `dark branches --json`, as `name <- parent` lines.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.branches: Unknown function or value 'branchesListedBy'"
let branches(dark: Darklang.Cli.Tests.Instance.T): List<String> =
  branchesListedBy(dark, [ "branches", "--json" ])

/// `dark branches --all --json`.
// @compiler blocked: upstream-dependency diagnostic="Darklang.SCM.Tests.Cli.allBranches: Unknown function or value 'branchesListedBy'"
let allBranches(dark: Darklang.Cli.Tests.Instance.T): List<String> =
  branchesListedBy(dark, [ "branches", "--all", "--json" ])
