module Darklang.Cli.Tests.Scripts


// @compiler xfail compile: "Unknown function or value 'Darklang.Cli.Run.exitCode'" class=missing-support reason=upstream-dependency
test unitSucceeds =
  Darklang.Cli.Run.exitCode(Darklang.LanguageTools.RuntimeTypes.Dval.DUnit)
  |> Stdlib.Test.equal(Ok(0))


// @compiler xfail compile: "Unknown function or value 'Darklang.Cli.Run.exitCode'" class=missing-support reason=upstream-dependency
test integerExitCodes =
  Stdlib.Test.all(
    [ Darklang.Cli.Run.exitCode(Darklang.LanguageTools.RuntimeTypes.Dval.DBigInt(7z))
      |> Stdlib.Test.equal(Ok(7))
      Darklang.Cli.Run.exitCode(Darklang.LanguageTools.RuntimeTypes.Dval.DInt64(3))
      |> Stdlib.Test.equal(Ok(3))
      Darklang.Cli.Run.exitCode(
        Darklang.LanguageTools.RuntimeTypes.Dval.DBigInt(9223372036854775808z))
      |> Stdlib.Test.equal(Ok(1)) ])


// @compiler xfail compile: "Unknown function or value 'Darklang.Cli.Run.exitCode'" class=missing-support reason=upstream-dependency
test invalidResultKeepsValue =
  let returned = Darklang.LanguageTools.RuntimeTypes.Dval.DBool(true)
  match Darklang.Cli.Run.exitCode(returned) with
  | Error(Runtime(CLI(NonIntReturned(actual)), [])) ->
    actual |> Stdlib.Test.equal(returned)
  | _ -> Stdlib.Test.fail("Expected a script result error with the returned value")


module Eval =
  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'Darklang.Cli.ExecutionError.ExecutionError'"
  let evaluate(
    source: String)
    : Stdlib.Result.Result<
        Stdlib.Option.Option<String>, Darklang.Cli.ExecutionError.ExecutionError> =
    Darklang.Cli.Eval.evaluateRaw(
      None, Darklang.SCM.Branch.mainBranchId, source, [], false)

  // @compiler xfail compile: "Unknown function or value 'evaluate'" class=missing-support reason=upstream-dependency
  test unitIsSilent =
    evaluate("()") |> Stdlib.Test.equal(Ok(None))

  // @compiler xfail compile: "Unknown function or value 'evaluate'" class=missing-support reason=upstream-dependency
  test stringsAreUnquoted =
    evaluate("\"hello\\nworld\"")
    |> Stdlib.Test.equal(Ok(Some("hello\nworld")))

  // @compiler xfail compile: "Unknown function or value 'evaluate'" class=missing-support reason=upstream-dependency
  test otherValuesArePrinted =
    evaluate("[1, 2]") |> Stdlib.Test.equal(Ok(Some("[1, 2]")))


module CallStack =
  let source(): Darklang.LanguageTools.RuntimeTypes.ExecutionPoint =
    Darklang.LanguageTools.RuntimeTypes.ExecutionPoint.Source

  let builtin(): Darklang.LanguageTools.RuntimeTypes.ExecutionPoint =
    Darklang.LanguageTools.RuntimeTypes.ExecutionPoint.Function(Darklang.LanguageTools.RuntimeTypes.FQFnName.FQFnName.Builtin(Darklang.LanguageTools.RuntimeTypes.FQFnName.Builtin
          { name = "bigIntDivide", version = 0s32 }))

  // @compiler blocked: upstream-dependency diagnostic="Darklang.Cli.Tests.Scripts.CallStack.render: Unknown function or value 'Darklang.PrettyPrinter.RuntimeTypes.callStack'"
  let render(
    frames: List<Darklang.LanguageTools.RuntimeTypes.ExecutionPoint>)
    : String =
    Darklang.PrettyPrinter.RuntimeTypes.callStack(
      Darklang.SCM.Branch.mainBranchId, frames)

  // @compiler xfail compile: "Unknown function or value 'render'" class=missing-support reason=upstream-dependency
  test emptyStack =
    render([]) |> Stdlib.Test.equal("Call stack (last call at bottom):")

  // @compiler xfail compile: "Unknown function or value 'render'" class=missing-support reason=upstream-dependency
  test groupsOnlyConsecutiveFrames =
    render([ source(), builtin(), builtin(), source() ])
    |> Stdlib.Test.equal(
      "Call stack (last call at bottom):\n- Source\n- Builtin Function bigIntDivide (×2)\n- Source")

  // @compiler blocked: upstream-dependency diagnostic="Darklang.Cli.Tests.Scripts.CallStack.denied: Unknown function or value 'Darklang.Cli.ExecutionError.deniedCallStack'"
  let denied(
    frames: List<Darklang.LanguageTools.RuntimeTypes.ExecutionPoint>)
    : String =
    Darklang.Cli.ExecutionError.deniedCallStack(Darklang.SCM.Branch.mainBranchId, frames)

  // A denial lists the caller's frames and the first bundled function, and counts the rest.
  // @compiler xfail compile: "Unknown function or value 'denied'" class=missing-support reason=upstream-dependency
  test deniedStackStopsAtTheFirstBundledFunction =
    denied([ source(), builtin(), builtin(), builtin() ])
    |> Stdlib.Test.equal(
      "Call stack (last call at bottom):\n- Source\n- Builtin Function bigIntDivide\n  (2 calls inside it)")

  // @compiler xfail compile: "Unknown function or value 'denied'" class=missing-support reason=upstream-dependency
  test deniedStackWithOneBundledFrameIsWhole =
    denied([ source(), builtin() ])
    |> Stdlib.Test.equal(
      "Call stack (last call at bottom):\n- Source\n- Builtin Function bigIntDivide")

  // @compiler xfail compile: "Unknown function or value 'Darklang.PrettyPrinter.RuntimeTypes.executionPoint'" class=missing-support reason=upstream-dependency
  test lambdaLabel =
    Darklang.PrettyPrinter.RuntimeTypes.executionPoint(
      Darklang.SCM.Branch.mainBranchId,
      (Darklang.LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        source(), 23u64, Stdlib.Option.Option.None)))
    |> Stdlib.Test.equal("Lambda 23")

  // A lambda is shown with the fn it was written in, when that is known.
  // @compiler xfail compile: "Unknown function or value 'Darklang.PrettyPrinter.RuntimeTypes.executionPoint'" class=missing-support reason=upstream-dependency
  test lambdaLabelSaysWhereItWasWritten =
    Darklang.PrettyPrinter.RuntimeTypes.executionPoint(
      Darklang.SCM.Branch.mainBranchId,
      (Darklang.LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        builtin(), 23u64, Stdlib.Option.Option.Some(source()))))
    |> Stdlib.Test.equal("Lambda in Source (23)")

  test entryOnlyStacksAreHidden =
    let lambda =
      Darklang.LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        source(), 23u64, Stdlib.Option.Option.None)
    Stdlib.Test.all(
      [ Darklang.Cli.ExecutionError.hasReadableFrames([ source(), lambda ])
        |> Stdlib.Test.equal(false)
        Darklang.Cli.ExecutionError.hasReadableFrames([ source(), builtin() ])
        |> Stdlib.Test.equal(true) ])


  // @compiler xfail compile: "Unknown function or value 'Darklang.PrettyPrinter.RuntimeTypes.executionPoint'" class=missing-support reason=upstream-dependency
  test processStacksUseTheSharedType =
    let frame =
      LanguageTools.Exec.ExecutionPoint.Lambda(
        LanguageTools.Exec.ExecutionPoint.Source,
        18446744073709551615u64,
        Stdlib.Option.Option.None)
    Darklang.PrettyPrinter.RuntimeTypes.executionPoint(
      Darklang.SCM.Branch.mainBranchId, frame)
    |> Stdlib.Test.equal("Lambda 18446744073709551615")
