module Test =
  /// Valid only inside the withStoreSnapshot callback that created it.
  type Run = { id: Uuid }

  /// Whether this test runs inside the runner rather than in a fresh process
  /// with its own store copy: true only when analysis shows it needs no effect
  /// at all, and false once a run of it reached an impure builtin.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.runsInProcess: Unknown function or value 'Builtin.pmTestRunsInProcess'"
  let runsInProcess(hash: ProgramTypes.Hash): Bool =
    Builtin.pmTestRunsInProcess(hash)

  /// Share a read-only starting store on <param branchId> across the tests executed
  /// by <param run>. Every test that cannot run in-process gets a fresh process on
  /// it; one that writes reruns on a private copy. Cached-only runs create no
  /// snapshot; cleanup also runs if the callback fails.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.withStoreSnapshot: Unknown function or value 'Builtin.pmTestWithStoreSnapshot'"
  let withStoreSnapshot(branchId: Uuid, run: Run -> 'a): 'a =
    Builtin.pmTestWithStoreSnapshot(branchId, fun id -> run(Run { id = id }))

  /// Whether the test <param hash> wrote to <param run>'s shared snapshot and so
  /// ran again on a private copy.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.reran: Unknown function or value 'Builtin.pmTestReran'"
  let reran(run: Run, hash: ProgramTypes.Hash): Bool =
    Builtin.pmTestReran(run.id, hash)

  /// Conservative proof that a passing result is reusable, one answer per hash,
  /// in order. Dynamic calls and branch-dependent rendering are not treated as
  /// cache-safe.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.areCacheSafe: Unknown function or value 'Builtin.pmTestsAreCacheSafe'"
  let areCacheSafe(hashes: List<ProgramTypes.Hash>): List<Bool> =
    Builtin.pmTestsAreCacheSafe(hashes)

  /// Where `dark test run` keeps one result: the test's hash, plus everything
  /// that hash does not cover. `runtime` is the build and the judging code,
  /// `branch` the branch id, and `resultType` the branch's binding of
  /// `Stdlib.Test.Result`.
  type ResultKey =
    { test: String
      runtime: String
      branch: String
      resultType: String }

  /// The outcome stored under <param key>, as the runner serialized it.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.storedResult: Unknown function or value 'Builtin.pmTestResultGet'"
  let storedResult(key: ResultKey): Stdlib.Option.Option<String> =
    Builtin.pmTestResultGet(key)

  /// <fn storedResult> for each of <param keys>, in order, in one read.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.storedResults: Unknown function or value 'Builtin.pmTestResultGetMany'"
  let storedResults(keys: List<ResultKey>): List<Stdlib.Option.Option<String>> =
    Builtin.pmTestResultGetMany(keys)

  /// Store <param outcome> under <param key>, replacing what was there.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.storeResult: Unknown function or value 'Builtin.pmTestResultPut'"
  let storeResult(key: ResultKey, outcome: String): Unit =
    Builtin.pmTestResultPut(key, outcome)

  /// The result type as this branch currently binds it. Judging an ordinary
  /// test depends on this binding, even when the test's own hash is unchanged.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.resultTypeHash: Unknown function or value 'Type.find'"
  let resultTypeHash(branchId: Uuid): Stdlib.Option.Option<ProgramTypes.Hash> =
    Type.find(
      branchId,
      (ProgramTypes.PackageLocation
        { owner = "Darklang"
          modules = [ "Stdlib", "Test" ]
          name = "Result" }))

  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.find: Unknown function or value 'PackageManager.findItem'"
  let find(
    branchId: Uuid,
    location: ProgramTypes.PackageLocation)
    : Stdlib.Option.Option<ProgramTypes.Hash> =
    PackageManager.findItem(branchId, ProgramTypes.ItemKind.Test, location)

  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageTest.PackageTest'"
  let get(
    hash: ProgramTypes.Hash)
    : Stdlib.Option.Option<ProgramTypes.PackageTest.PackageTest> =
    PackageManager.getItem(ProgramTypes.ItemKind.Test, hash)

  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.locations: Unknown function or value 'PackageManager.itemLocations'"
  let locations(
    branchId: Uuid,
    hash: ProgramTypes.Hash)
    : List<ProgramTypes.PackageLocation> =
    PackageManager.itemLocations(branchId, ProgramTypes.ItemKind.Test, hash)

  /// Whether <param name> resolved to `Stdlib.Test.all`.
  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.FQFnName.FQFnName'"
  let __isAll(name: ProgramTypes.NameResolution<ProgramTypes.FQFnName.FQFnName>): Bool =
    match name.resolved with
    | Ok(resolved) ->
      resolved.location
      == Stdlib.Option.Option.Some(
        ProgramTypes.PackageLocation
          { owner = "Darklang"
            modules = [ "Stdlib", "Test" ]
            name = "all" })
    | Error(_) -> false

  /// How many tests the test group <param body> holds, read from its code, so a
  /// cached or unrun group has a count too. Each item of a `Stdlib.Test.all([ ... ])`
  /// list is a test, nested `all`s add up, a `let` counts what follows it, and an
  /// `if` or `match` counts its biggest branch. Anything else is one test, including a list built at run
  /// time (`Stdlib.List.map(cases, f) |> Stdlib.Test.all`).
  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.Expr'"
  let testCount(body: ProgramTypes.Expr): Int64 =
    let sum(items: List<ProgramTypes.Expr>): Int64 =
      Stdlib.List.fold(items, 0, fun(total, item) -> total + testCount(item))
    let most(branches: List<ProgramTypes.Expr>): Int64 =
      Stdlib.List.fold(branches, 1, fun(best, branch) ->
        let n = testCount(branch)
        if n > best then n else best)
    match body with
    | ELet(_, _, _, next) -> testCount(next)
    | EStatement(_, _, next) -> testCount(next)
    | EApply(_, EFnName(_, name, _, _), _, [ EList(_, items) ]) when __isAll(name) -> sum(items)
    | EPipe(_, EList(_, items), [ EPipeFnCall(_, name, _, [], _) ]) when __isAll(name) -> sum(items)
    | EIf(_, _, thenExpr, Some(elseExpr)) -> most([ thenExpr, elseExpr ])
    | EMatch(_, _, cases) -> most(Stdlib.List.map(cases, fun c -> c.rhs))
    | _ -> 1

  /// Run this test's body with an allow-all test instance policy and ordinary
  /// called-function approvals and ceilings: what it evaluated to,
  /// reflected, or the error it raised. Nothing is judged here; see `execute`.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.executeBody: Unknown function or value 'Builtin.pmExecuteTest'"
  let executeBody(
    run: Run,
    branchId: Uuid,
    hash: ProgramTypes.Hash)
    : Stdlib.Result.Result<LanguageTools.RuntimeTypes.Dval, LanguageTools.RuntimeTypes.RuntimeError.Error> =
    // Keep the worker in the dependency graph, just like the result checker.
    Builtin.pmExecuteTest(run.id, branchId, hash, Worker.main)

  /// <param value> as a `Stdlib.Test.Result`, or None if it is anything else. The
  /// enum's type is checked by hash, as <param branchId> sees `Stdlib.Test.Result`,
  /// so a look-alike `Pass`/`Fail` enum from elsewhere is not taken for one.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.asTestResult: Unknown function or value 'resultTypeHash'"
  let asTestResult(
    branchId: Uuid,
    value: LanguageTools.RuntimeTypes.Dval)
    : Stdlib.Option.Option<Stdlib.Test.Result> =
    let testType = resultTypeHash(branchId)
    match value, testType with
    | DEnum(Package(Hash(actual)), _, [], caseName, fields), Some(Hash(expected)) ->
      if actual == expected then
        // `caseName` is matched on its own: a string literal inside a tuple
        // pattern can silently fall through.
        match caseName with
        | "Pass" ->
          match fields with
          | [] -> Stdlib.Option.Option.Some(Stdlib.Test.Result.Pass)
          | _ -> Stdlib.Option.Option.None
        | "Fail" ->
          match fields with
          | [ DList(_, messages) ] ->
            let strings =
              Stdlib.List.filterMap(messages, fun m ->
                match m with
                | DString(s) -> Stdlib.Option.Option.Some(s)
                | _ -> Stdlib.Option.Option.None)
            if Stdlib.List.length(strings) == Stdlib.List.length(messages) then
              Stdlib.Option.Option.Some(Stdlib.Test.Result.Fail(strings))
            else
              Stdlib.Option.Option.None
          | _ -> Stdlib.Option.Option.None
        | _ -> Stdlib.Option.Option.None
      else
        Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None

  /// Run this test and judge it. A declaration-level error expectation
  /// compares the rendered runtime error; otherwise the body must return a
  /// `Stdlib.Test.Result`. An Error is a test that could not be judged (missing,
  /// refused an effect, raised unexpectedly, returned a non-test value), not
  /// a failing assertion. <param branchId> is the branch names in error
  /// messages are resolved against.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.executeInRun: Unknown function or value 'get'"
  let executeInRun(
    run: Run,
    branchId: Uuid,
    hash: ProgramTypes.Hash)
    : Stdlib.Result.Result<Stdlib.Test.Result, LanguageTools.RuntimeTypes.RuntimeError.Error> =
    let expected =
      Stdlib.Option.andThen(get(hash), fun test -> test.expectedError)
    match expected, executeBody(run, branchId, hash) with
    | Some(expected), Ok(value) ->
      let actual = PrettyPrinter.RuntimeTypes.dval(branchId, value)
      let expectedText =
        match expected with
        | RuntimeError(message) -> $"error `{message}`"
      Stdlib.Result.Result.Ok(
        Stdlib.Test.fail($"expected the {expectedText}, got the value {actual}")
      )
    | Some(expected), Error(error) ->
      let actual =
        PrettyPrinter.RuntimeTypes.RuntimeError.toString(branchId, error)
      match expected with
      | RuntimeError(message) ->
        if actual == message then
          Stdlib.Result.Result.Ok(Stdlib.Test.pass())
        else
          Stdlib.Result.Result.Ok(
            Stdlib.Test.fail($"expected the error `{message}`, got `{actual}`")
          )
    | None, Ok(value) ->
      match asTestResult(branchId, value) with
      | Some(result) -> Stdlib.Result.Result.Ok(result)
      | None ->
        Stdlib.Result.Result.Error(
          LanguageTools.RuntimeTypes.RuntimeError.Error.UncaughtException(
            "the test body did not return a Stdlib.Test.Result",
            []
          )
        )
    | None, Error(error) -> Stdlib.Result.Result.Error(error)

  /// Run one test without keeping a starting snapshot for subsequent tests.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Test.execute: Unknown function or value 'withStoreSnapshot'"
  let execute(
    branchId: Uuid,
    hash: ProgramTypes.Hash)
    : Stdlib.Result.Result<Stdlib.Test.Result, LanguageTools.RuntimeTypes.RuntimeError.Error> =
    withStoreSnapshot(branchId, fun run -> executeInRun(run, branchId, hash))


/// Replace provisional hashes with SCC-aware content hashes, including references
/// between items in the batch.
// @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageOp'"
let stabilizeHashes(
  ops: List<ProgramTypes.PackageOp>)
  : List<ProgramTypes.PackageOp> =
  Builtin.pmStabilizeHashes(ops)


/// Write onto each trait-method call the implementation it resolves to, so a saved item goes on
/// running what it was written against, and a newer implementation arrives as an ordinary
/// repoint instead of changing the call underneath it.
///
/// Before `stabilizeHashes`, so a choice at a placeholder hash moves with everything else. A call
/// whose self type is only known at run time (inside a bounded generic) comes back unchanged.
// @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageOp'"
let resolveTraitCalls(
  ops: List<ProgramTypes.PackageOp>)
  : List<ProgramTypes.PackageOp> =
  Builtin.pmResolveTraitCalls(ops)


/// One declaration, when <param op> is the `SetName` binding the `Add*` just
/// before it: `"fn Owner.Module.name"`. A `SetName` without its own `Add*` is a
/// bare rename.
// @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageOp'"
let declaration(
  previous: ProgramTypes.PackageOp,
  op: ProgramTypes.PackageOp)
  : Stdlib.Option.Option<String> =
  let named(
    kind: String,
    loc: ProgramTypes.PackageLocation)
    : Stdlib.Option.Option<String> =
    let path = Stdlib.List.flatten([ [ loc.owner ], loc.modules, [ loc.name ] ])
    let fqn = Stdlib.String.join(path, ".")
    Stdlib.Option.Option.Some($"{kind} {fqn}")

  match (previous, op) with
  | (AddType(_), SetName(loc, PackageType(_), _)) -> named("type", loc)
  | (AddFn(_), SetName(loc, PackageFn(_), _)) -> named("fn", loc)
  | (AddValue(_), SetName(loc, PackageValue(_), _)) -> named("value", loc)
  | (AddTrait(_), SetName(loc, PackageTrait(_), _)) -> named("trait", loc)
  | (AddTraitImpl(_), SetName(loc, PackageTraitImpl(_), _)) -> named("impl", loc)
  | (AddTest(_), SetName(loc, PackageTest(_), _)) -> named("test", loc)
  | _ -> Stdlib.Option.Option.None


/// Duplicate declaration names in <param ops>, formatted as
/// `"fn Owner.Module.name"`, each once, in the order first declared. Reject
/// before `stabilizeHashes`, which keys by name.
// @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageOp'"
let duplicateDeclarations(
  ops: List<ProgramTypes.PackageOp>)
  : List<String> =
  let declarations =
    Stdlib.List.zipShortest(ops, Stdlib.List.drop(ops, 1))
    |> Stdlib.List.filterMap(fun((previous, op)) -> declaration(previous, op))
  let counts =
    Stdlib.List.fold(declarations, Dict { }, fun(counts, d) ->
      let n = Stdlib.Option.withDefault(Stdlib.Dict.get(counts, d), 0)
      Stdlib.Dict.set(counts, d, n + 1))
  declarations
  |> Stdlib.List.filter(fun d ->
    (Stdlib.Dict.get(counts, d)) != Stdlib.Option.Option.Some(1))
  |> Stdlib.List.unique


/// Find any item (type, fn, value, trait or impl) at a location.
/// Returns the hash and what kind of item it is.
// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.findAny: Unknown function or value 'Type.find'"
let findAny(
  branchId: Uuid,
  location: ProgramTypes.PackageLocation)
  : Stdlib.Option.Option<(ProgramTypes.Hash * ProgramTypes.ItemKind)> =
  match Type.find(branchId, location) with
  | Some(hash) ->
    Stdlib.Option.Option.Some((hash, ProgramTypes.ItemKind.Type))
  | None ->
    match Function.find(branchId, location) with
    | Some(hash) ->
      Stdlib.Option.Option.Some((hash, ProgramTypes.ItemKind.Fn))
    | None ->
      match Value.find(branchId, location) with
      | Some(hash) ->
        Stdlib.Option.Option.Some((hash, ProgramTypes.ItemKind.Value))
      | None ->
        match Trait.find(branchId, location) with
        | Some(hash) ->
          Stdlib.Option.Option.Some((hash, ProgramTypes.ItemKind.Trait))
        | None ->
          match TraitImpl.find(branchId, location) with
          | Some(hash) ->
            Stdlib.Option.Option.Some((hash, ProgramTypes.ItemKind.TraitImpl))
          | None ->
            match Test.find(branchId, location) with
            | Some(hash) ->
              Stdlib.Option.Option.Some((hash, ProgramTypes.ItemKind.Test))
            | None -> Stdlib.Option.Option.None


/// The deprecation IN EFFECT for this item on <param branchId>, if any: its
/// kind and its message.
///
/// `None` covers both "never deprecated" and "deprecated and then
/// undeprecated", which is the distinction a caller usually does NOT want; it
/// is the current state, not the history.
///
/// Deprecation is said at a name, so this answers about `hash` at `location`:
/// another name holding the same content has its own answer.
// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.currentDeprecation: Unknown function or value 'Builtin.pmGetCurrentDeprecation'"
let currentDeprecation(
  branchId: Uuid,
  location: ProgramTypes.PackageLocation,
  hash: ProgramTypes.Hash,
  itemKind: ProgramTypes.ItemKind)
  : Stdlib.Option.Option<ProgramTypes.DeprecationKind * String> =
  Builtin.pmGetCurrentDeprecation(branchId, location, hash, itemKind)


module Search =
  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.Search.SearchResults'"
  let search(
    branchId: Uuid,
    query: ProgramTypes.Search.SearchQuery)
    : ProgramTypes.Search.SearchResults =
    let searchResults = Builtin.pmSearch(branchId, query)

    ProgramTypes.Search.SearchResults
      { submodules = searchResults.submodules
        types = searchResults.types
        values = searchResults.values
        fns = searchResults.fns
        traits = searchResults.traits
        impls = searchResults.impls
        tests = searchResults.tests }


  /// The submodules a READER should see.
  ///
  /// An impl's method fns live in a module named for the trait, so every impl leaves a submodule
  /// beside it with the same name. The impl is already a row of its own, and a numeric type has
  /// seventeen of them, which buries the functions somebody came to read. Every listing asks here
  /// -- `dark ls`, `dark tree`, `dark view`, the workbench and the editor's tree view -- so what
  /// counts as a submodule is decided once rather than five times. It lives beside `search`
  /// because it is a fact about search results, and because the editor cannot reach into the CLI.
  let readerSubmodules(submodules: List<String>, implNames: List<String>): List<String> =
    submodules
    |> Stdlib.List.filter(fun name ->
      Stdlib.Bool.not(Stdlib.List.contains(implNames, name)))


  /// Search returning only names: (direct submodules, types, values, fns, traits, impls,
  /// tests). `searchNamesAndHashes` with the hashes dropped.
  ///
  /// `search` converts every matched item's full definition, parameters and body AST included, into Dark
  /// values. Completion reads `.location.name` and throws the rest away, which is most of a millisecond
  /// per item.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Search.searchNames: Tuple pattern does not match the value type"
  let searchNames(
    branchId: Uuid,
    query: ProgramTypes.Search.SearchQuery)
    : (List<String> * List<String> * List<String> * List<String> * List<String> * List<String> * List<String>) =
    let names = fun(pairs) -> Stdlib.List.map(pairs, fun((name, _hash)) -> name)
    let (submodules, types, values, fns, traits, impls, tests) =
      searchNamesAndHashes(branchId, query)
    (submodules, names(types), names(values), names(fns), names(traits), names(impls), names(tests))


  /// Search returning (name, hash) pairs: (direct submodules, types, values, fns, traits, impls, tests).
  /// Listings need the hash for the deprecation mark. Submodules come back already reduced to the direct
  /// children of the query's module, because doing that reduction in Dark means walking every module path
  /// under the store root.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Search.searchNamesAndHashes: Unknown function or value 'Builtin.pmSearchNamesAndHashes'"
  let searchNamesAndHashes(
    branchId: Uuid,
    query: ProgramTypes.Search.SearchQuery)
    : (List<String> *
       List<(String * ProgramTypes.Hash)> *
       List<(String * ProgramTypes.Hash)> *
       List<(String * ProgramTypes.Hash)> *
       List<(String * ProgramTypes.Hash)> *
       List<(String * ProgramTypes.Hash)> *
       List<(String * ProgramTypes.Hash)>) =
    Builtin.pmSearchNamesAndHashes(branchId, query)

/// Create a PackageManager
// @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageManager.PackageManager'"
let pm(): ProgramTypes.PackageManager.PackageManager =
  ProgramTypes.PackageManager.PackageManager
    { findType =
        fun((branchId, location)) -> PackageManager.Type.find(branchId, location)
      findValue =
        fun((branchId, location)) -> PackageManager.Value.find(branchId, location)
      findFn =
        fun((branchId, location)) -> PackageManager.Function.find(branchId, location)
      findTrait =
        fun((branchId, location)) -> PackageManager.Trait.find(branchId, location)

      getFn = PackageManager.Function.get
      getValue = PackageManager.Value.get
      getType = PackageManager.Type.get
      getTrait = PackageManager.Trait.get

      search =
        fun((branchId, query)) -> PackageManager.Search.search(branchId, query) }
