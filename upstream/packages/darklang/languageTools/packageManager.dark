module Value =
  /// Find stored values whose runtime value type matches exactly.
  let findByValueType(
    valueType: RuntimeTypes.ValueType)
    : List<ProgramTypes.Hash> =
    Builtin.pmFindValuesByValueType(valueType)

  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Value.find: Unknown function or value 'PackageManager.findItem'"
  let find(
    branchId: Uuid,
    location: ProgramTypes.PackageLocation)
    : Stdlib.Option.Option<ProgramTypes.FQValueName.Package> =
    PackageManager.findItem(branchId, ProgramTypes.ItemKind.Value, location)

  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageValue.PackageValue'"
  let get(
    hash: ProgramTypes.FQValueName.Package)
    : Stdlib.Option.Option<ProgramTypes.PackageValue.PackageValue> =
    PackageManager.getItem(ProgramTypes.ItemKind.Value, hash)

  /// Every name this value is bound to on <param branchId>.
  // @compiler blocked: compiler-gap diagnostic="Darklang.LanguageTools.PackageManager.Value.locations: Expected TString, got TSum (\"Uuid\", [])"
  let locations(
    branchId: Uuid,
    hash: ProgramTypes.FQValueName.Package)
    : List<ProgramTypes.PackageLocation> =
    PackageManager.itemLocations(branchId, ProgramTypes.ItemKind.Value, hash)

  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageValue.PackageValue'"
  let getWithLocation(
    branchId: Uuid,
    hash: ProgramTypes.FQValueName.Package)
    : Stdlib.Option.Option<
      ProgramTypes.LocatedItem<ProgramTypes.PackageValue.PackageValue>> =
    match get(hash) with
    | Some(entity) ->
      match PackageManager.pickLocation(PackageManager.PickContext.empty, locations(branchId, hash)) with
      | Some(location) ->
        Stdlib.Option.Option.Some(
          ProgramTypes.LocatedItem { entity = entity, location = location }
        )
      | None -> Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None


  /// The stored value at <param hash>, evaluated. `None` when the store does not hold it.
  let evaluate(
    hash: ProgramTypes.FQValueName.Package)
    : Stdlib.Option.Option<'a> =
    Builtin.pmEvaluateValue(hash)

  /// A value found by <fn findByType>, with the dotted name it is bound to.
  type Found<'a> =
    { path: String
      value: 'a }

  /// Every value of the custom type <param typeHash> named on <param branchId>, evaluated.
  /// <param namespace_> keeps only names under that dotted prefix; `""` keeps all of them.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Value.findByType: Unknown function or value 'locations'"
  let findByType(
    branchId: Uuid,
    namespace_: String,
    typeHash: ProgramTypes.Hash)
    : List<Found<'a>> =
    let prefix =
      if namespace_ == "" then [] else Stdlib.String.split(namespace_, ".")

    let valueType =
      RuntimeTypes.ValueType.Known(
        RuntimeTypes.KnownType.KTCustomType(
          RuntimeTypes.FQTypeName.FQTypeName.Package(
            RuntimeTypes.Hash.Hash(ProgramTypes.hashToString(typeHash))),
          []))

    findByValueType(valueType)
    |> Stdlib.List.filterMap(fun hash ->
      match PackageManager.pickLocation(PackageManager.PickContext.empty, locations(branchId, hash)) with
      | Some(location) ->
        let path = Stdlib.List.prepend(location.modules, location.owner)

        if Stdlib.List.take(path, Stdlib.List.length(prefix)) == prefix then
          match evaluate(hash) with
          | Some(value) ->
            Stdlib.Option.Option.Some(
              Found
                { path = Stdlib.String.join(Stdlib.List.append(path, location.name), ".")
                  value = value }
            )
          | None -> Stdlib.Option.Option.None
        else
          Stdlib.Option.Option.None
      | None -> Stdlib.Option.Option.None)


