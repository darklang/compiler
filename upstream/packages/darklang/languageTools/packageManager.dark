/// For interacting with the "dark matter",
/// where package items (types, values, fns, etc) are maintained.
/// i.e. the packages + manager
///
/// Of note, this is the Dev-time PackageManager, not the Runtime PackageManager.
module Darklang.LanguageTools.PackageManager


/// Context for choosing among multiple locations that share the same hash.
/// When a hash maps to multiple named locations (e.g. Person and Person2 are
/// structurally identical), we use context to pick the best display name.
// @compiler replace: packages/darklang/languageTools/packageManager.dark#Darklang.LanguageTools.PackageManager.PickContext reason=compiler-implementation
type PickContext =
  { currentModule: List<String>

    /// Which name to pick when the hash has several, if this is one of them.
    ///
    /// A hash can be bound to more than one location -- two items with identical
    /// bodies are one item -- and the scoring below cannot tell those apart. It
    /// scores by module prefix, which is right for a name appearing inside someone
    /// else's code and arbitrary for the item a caller is displaying: without this,
    /// `dark view Zz.alpha` prints a definition headed `Zz.beta`.
    ///
    /// Ignored when it is not among the candidates, so a caller can set it whenever
    /// it knows which location it is displaying, without checking first.
    preferredLocation: Stdlib.Option.Option<ProgramTypes.PackageLocation> }

module PickContext =
  // @compiler blocked: compiler-contract diagnostic="Imported initializer sets preferredLocation, absent from the compiler PickContext substitute."
  val empty =
    PickContext { currentModule = [], preferredLocation = Stdlib.Option.Option.None }

/// Count how many leading segments of two lists match.
// @compiler replace: packages/darklang/languageTools/packageManager.dark#Darklang.LanguageTools.PackageManager.countMatchingPrefix reason=compiler-implementation
let countMatchingPrefix(a: List<String>, b: List<String>): Int64 =
  match (a, b) with
  | ([aHead, ...aTail], [bHead, ...bTail]) ->
    if aHead == bHead then
      1 + (countMatchingPrefix(aTail, bTail))
    else
      0
  | _ -> 0

/// Given a list of locations for a hash, pick the best one using context.
/// Scoring: most matching prefix segments with currentModule, then shortest path,
/// then original ordering (SQL order: branch priority, commit status, recency).
// @compiler replace: packages/darklang/languageTools/packageManager.dark#Darklang.LanguageTools.PackageManager.pickLocation reason=compiler-implementation
let pickLocation(
  ctx: PickContext,
  locations: List<ProgramTypes.PackageLocation>)
  : Stdlib.Option.Option<ProgramTypes.PackageLocation> =
  // The asked-for name wins outright when it is one of the candidates. Only then: a
  // preference for a name this hash is not bound to would be a lie, and the scoring
  // below is right for every other case.
  let asked =
    match ctx.preferredLocation with
    | Some(p) ->
      locations
      |> Stdlib.List.findFirst(fun l ->
        (l.owner == p.owner) && (l.modules == p.modules) && (l.name == p.name))
    | None -> Stdlib.Option.Option.None

  match asked with
  | Some(a) -> Stdlib.Option.Option.Some(a)
  | None ->

  match locations with
  | [] -> Stdlib.Option.Option.None
  | [ single ] -> Stdlib.Option.Option.Some(single)
  | [first, ...rest] ->
    let firstPath = Stdlib.List.prepend(first.modules, first.owner)
    let firstScore = countMatchingPrefix(ctx.currentModule, firstPath)
    let firstLen = Stdlib.List.length(firstPath)

    let (_, _, bestLoc) =
      Stdlib.List.fold(rest, (firstScore, firstLen, first), fun(acc, loc) ->
        let (bestScore, bestLen, bestLoc) = acc
        let locPath = Stdlib.List.prepend(loc.modules, loc.owner)
        let score = countMatchingPrefix(ctx.currentModule, locPath)
        let len = Stdlib.List.length(locPath)

        if score > bestScore then
          (score, len, loc)
        else if score == bestScore && len < bestLen then
          (score, len, loc)
        else
          (bestScore, bestLen, bestLoc))

    Stdlib.Option.Option.Some(bestLoc)


/// location -> hash for an item of <param kind>, resolved on <param branchId>. The per-kind
/// `Type.find`, `Value.find`, ... are this with the kind filled in.
// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.findItem: Unknown function or value 'Builtin.pmFind'"
let findItem(
  branchId: Uuid,
  kind: ProgramTypes.ItemKind,
  location: ProgramTypes.PackageLocation)
  : Stdlib.Option.Option<ProgramTypes.Hash> =
  Builtin.pmFind(branchId, kind, location)


/// The stored item of <param kind> at <param hash>. The per-kind `Type.get`, `Value.get`, ...
/// are this with the kind and the item's type filled in.
// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.getItem: Unknown function or value 'Builtin.pmGet'"
let getItem(
  kind: ProgramTypes.ItemKind,
  hash: ProgramTypes.Hash)
  : Stdlib.Option.Option<'a> =
  Builtin.pmGet(kind, hash)


/// Every name a hash of <param kind> is bound to on <param branchId>. The per-kind
/// `Type.locations`, `Value.locations`, ... are this with the kind filled in.
// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.itemLocations: Unknown function or value 'Builtin.pmLocations'"
let itemLocations(
  branchId: Uuid,
  kind: ProgramTypes.ItemKind,
  hash: ProgramTypes.Hash)
  : List<ProgramTypes.PackageLocation> =
  Builtin.pmLocations(branchId, kind, hash)


module Type =
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Type.find: Unknown function or value 'PackageManager.findItem'"
  let find(
    branchId: Uuid,
    location: ProgramTypes.PackageLocation)
    : Stdlib.Option.Option<ProgramTypes.FQTypeName.Package> =
    PackageManager.findItem(branchId, ProgramTypes.ItemKind.Type, location)

  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageType.PackageType'"
  let get(
    hash: ProgramTypes.FQTypeName.Package)
    : Stdlib.Option.Option<ProgramTypes.PackageType.PackageType> =
    PackageManager.getItem(ProgramTypes.ItemKind.Type, hash)

  /// Every name this type is bound to on <param branchId>. More than one
  /// when structurally identical types share a hash.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Type.locations: Unknown function or value 'PackageManager.itemLocations'"
  let locations(
    branchId: Uuid,
    hash: ProgramTypes.FQTypeName.Package)
    : List<ProgramTypes.PackageLocation> =
    PackageManager.itemLocations(branchId, ProgramTypes.ItemKind.Type, hash)

  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.PackageType.PackageType'"
  let getWithLocation(
    branchId: Uuid,
    hash: ProgramTypes.FQTypeName.Package)
    : Stdlib.Option.Option<
      ProgramTypes.LocatedItem<ProgramTypes.PackageType.PackageType>> =
    match get(hash) with
    | Some(entity) ->
      match PackageManager.pickLocation(PackageManager.PickContext.empty, locations(branchId, hash)) with
      | Some(location) ->
        Stdlib.Option.Option.Some(
          ProgramTypes.LocatedItem { entity = entity, location = location }
        )
      | None -> Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None


module Trait =
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Trait.find: Unknown function or value 'PackageManager.findItem'"
  let find(
    branchId: Uuid,
    location: ProgramTypes.PackageLocation)
    : Stdlib.Option.Option<ProgramTypes.FQTraitName.Package> =
    PackageManager.findItem(branchId, ProgramTypes.ItemKind.Trait, location)

  // @compiler blocked: upstream-dependency diagnostic="Unknown type 'ProgramTypes.Trait.Trait'"
  let get(
    hash: ProgramTypes.FQTraitName.Package)
    : Stdlib.Option.Option<ProgramTypes.Trait.Trait> =
    PackageManager.getItem(ProgramTypes.ItemKind.Trait, hash)

  /// Every name this trait is bound to on <param branchId>.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Trait.locations: Unknown function or value 'PackageManager.itemLocations'"
  let locations(
    branchId: Uuid,
    hash: ProgramTypes.FQTraitName.Package)
    : List<ProgramTypes.PackageLocation> =
    PackageManager.itemLocations(branchId, ProgramTypes.ItemKind.Trait, hash)

  /// The impls of a trait bound on <param branchId>: what `Trait.method x` can
  /// dispatch to.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Trait.impls: Unknown function or value 'Builtin.pmImplCandidates'"
  let impls(
    branchId: Uuid,
    traitHash: ProgramTypes.FQTraitName.Package)
    : List<RuntimeTypes.ImplCandidate> =
    Builtin.pmImplCandidates(branchId, traitHash)

  /// The trait an operator is, and the method it maps to.
  ///
  /// None for an operator that is not a trait: `==` and `!=` are structural equality for
  /// every value, and `++` is no longer in the language.
  ///
  /// The operator-to-trait table is not duplicated here on purpose. It lives once in F#
  /// (`NumericTraits`), which is also what the lowering uses, so the checker and the
  /// runtime cannot come to disagree about what `+` means.
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.Trait.operatorTrait: Unknown function or value 'Builtin.pmOperatorTrait'"
  let operatorTrait(
    op: ProgramTypes.Operator)
    : Stdlib.Option.Option<(ProgramTypes.FQTraitName.Package * String)> =
    Builtin.pmOperatorTrait(op)


module TraitImpl =
  // @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.PackageManager.TraitImpl.find: Unknown function or value 'PackageManager.findItem'"
