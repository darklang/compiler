module Darklang.LanguageTools.RuntimeTypes


// <aliases>
type Option<'a> = Stdlib.Option.Option<'a>
// </aliases>

// @compiler replace: packages/darklang/languageTools/runtimeTypes.dark#Darklang.LanguageTools.RuntimeTypes.Hash reason=compiler-implementation
type Hash = | Hash(String)

// @compiler replace: packages/darklang/languageTools/runtimeTypes.dark#Darklang.LanguageTools.RuntimeTypes.hashToString reason=compiler-implementation
let hashToString(hash: Hash): String =
  match hash with
  | Hash(h) -> h

module FQTypeName =
  type Package = Hash
  // @compiler blocked: compiler-contract diagnostic="Already selected from packages/darklang/languageTools/runtimeTypes/fqTypeName.dark; importing another declaration of Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName requires an explicit replacement contract"
  type FQTypeName = Package(Package)

module FQTraitName =
  type Package = Hash
  type FQTraitName = Package(Package)

module FQValueName =
  // @compiler replace: packages/darklang/languageTools/runtimeTypes/fqValueName.dark#Darklang.LanguageTools.RuntimeTypes.FQValueName.Builtin reason=compiler-implementation
  type Builtin = { name: String, version: Int32 }
  type Package = Hash

  // @compiler blocked: compiler-contract diagnostic="Already selected from packages/darklang/languageTools/runtimeTypes/fqValueName.dark; importing another declaration of Darklang.LanguageTools.RuntimeTypes.FQValueName.FQValueName requires an explicit replacement contract"
  type FQValueName =
    | Builtin(Builtin)
    | Package(Package)

module FQFnName =
  // @compiler replace: packages/darklang/languageTools/runtimeTypes/fqFnName.dark#Darklang.LanguageTools.RuntimeTypes.FQFnName.Builtin reason=compiler-implementation
  type Builtin = { name: String, version: Int32 }
  type Package = Hash

  /// How much of a trait call's implementation is decided; the runtime's half of
  /// `ProgramTypes.FQFnName.ImplChoice`.
  type ImplChoice =
    /// That fn runs
    | Chosen(Package)
    /// Read from the frame the caller filled, rather than asked of the store
    | FromTypeParam(String)
    /// Resolve at the call; the only path that asks the store
    | Unknown

  /// A trait method call: the trait, the method name (`Display.display`), and how
  /// much the save could say about which implementation runs.
  type TraitMethod =
    { trait_: FQTraitName.Package
      method_: String
      implFn: ImplChoice }

  // @compiler blocked: compiler-contract diagnostic="Imported FQFnName includes TraitMethod; the compiler substitute contains only Builtin and Package."
  type FQFnName =
    | Builtin(Builtin)
    | Package(Package)
    | TraitMethod(TraitMethod)

/// Where a call frame is executing.
type ExecutionPoint =
  | Source
  | Function(FQFnName.FQFnName)
  /// `parent` is the frame that called the lambda. `writtenIn` is the fn (or
  /// `Source`) the lambda is written in, or `None` when that isn't known.
  | Lambda(
    parent: ExecutionPoint,
    exprId: UInt64,
    writtenIn: Option<ExecutionPoint>)

// @compiler replace: packages/darklang/languageTools/runtimeTypes/base.dark#Darklang.LanguageTools.RuntimeTypes.NameResolutionError reason=compiler-implementation
type NameResolutionError =
  | NotFound
  | InvalidName

// @compiler replace: packages/darklang/languageTools/runtimeTypes/base.dark#Darklang.LanguageTools.RuntimeTypes.NameResolution reason=compiler-implementation
type NameResolution<'a> =
  { originalName: List<String>
    resolved: Stdlib.Result.Result<'a, NameResolutionError> }


// @compiler blocked: compiler-contract diagnostic="Already selected from packages/darklang/languageTools/runtimeTypes/typeReference.dark; importing another declaration of Darklang.LanguageTools.RuntimeTypes.TypeReference requires an explicit replacement contract"
type TypeReference =
  | TUnit
  | TBool
  | TInt8
  | TUInt8
  | TInt16
  | TUInt16
  | TInt32
  | TUInt32
  | TInt64
  | TUInt64
  | TInt128
  | TUInt128
  | TBigInt
  | TFloat
  | TFloat32
  | TDecimal
  | TChar
  | TString
  | TUuid
  | TDateTime
  | TBytes
  | TStream(TypeReference)
  | TTuple(TypeReference, TypeReference, List<TypeReference>)
  | TList(TypeReference)
  | TDict(key: TypeReference, value: TypeReference)
  | TCustomType(
    NameResolution<FQTypeName.FQTypeName>,
    typeArgs: List<TypeReference>)
  | TFn(List<TypeReference>, TypeReference)
  | TVariable(String)

type TypeSymbolTable = Dict<String, TypeReference>


// @compiler blocked: compiler-contract diagnostic="Already selected from packages/darklang/languageTools/runtimeTypes/valueType.dark; importing another declaration of Darklang.LanguageTools.RuntimeTypes.KnownType requires an explicit replacement contract"
type KnownType =
  | KTUnit
  | KTBool
  | KTInt8
  | KTUInt8
  | KTInt16
  | KTUInt16
  | KTInt32
  | KTUInt32
  | KTInt64
  | KTUInt64
  | KTInt128
  | KTUInt128
  | KTBigInt
  | KTFloat
  | KTFloat32
  | KTDecimal
  | KTChar
  | KTString
  | KTUuid
  | KTDateTime
  | KTBytes
  | KTStream(ValueType)
  | KTTuple(ValueType, ValueType, List<ValueType>)
  | KTList(ValueType)
  | KTDict(key: ValueType, value: ValueType)

  | KTFn(List<ValueType>, ValueType)

  | KTCustomType(FQTypeName.FQTypeName, typeArgs: List<ValueType>)


// @compiler replace: packages/darklang/languageTools/runtimeTypes/valueType.dark#Darklang.LanguageTools.RuntimeTypes.ValueType reason=compiler-implementation
type ValueType =
  | Unknown
  | Known(KnownType)


// @compiler blocked: compiler-contract diagnostic="Already selected from packages/darklang/languageTools/runtimeTypes/dval.dark; importing another declaration of Darklang.LanguageTools.RuntimeTypes.LetPattern requires an explicit replacement contract"
type LetPattern =
  | LPVariable(reg: Register, name: String)
  | LPWildcard
  | LPUnit
  | LPTuple(
    first: LetPattern,
    second: LetPattern,
    theRest: List<LetPattern>)

// @compiler blocked: constructor-identity diagnostic="Constructor identity collision 1941: Darklang.Language.Tests.Equality.EEnumInt8.E3, Darklang.LanguageTools.RuntimeTypes.MatchPattern.MPInt16"
type MatchPattern =
  | MPUnit
  | MPBool(Bool)
  | MPInt8(Int8)
  | MPUInt8(UInt8)
  | MPInt16(Int16)
  | MPUInt16(UInt16)
  | MPInt32(Int32)
  | MPUInt32(UInt32)
  | MPInt64(Int64)
  | MPUInt64(UInt64)
  | MPInt128(Int128)
  | MPUInt128(UInt128)
  | MPBigInt(BigInt)
  | MPFloat(Float)
  | MPFloat32(Float32)
  | MPDecimal(Decimal)
  | MPChar(String)
  | MPString(String)
  | MPTuple(MatchPattern, MatchPattern, List<MatchPattern>)
  | MPList(List<MatchPattern>)
  | MPListCons(head: MatchPattern, tail: MatchPattern)
  | MPEnum(caseName: String, fieldPatterns: List<MatchPattern>)
  | MPVariable(Register)
  | MPOr(List<MatchPattern>)
  | MPAs(MatchPattern, Register)
  | MPRecord(fields: List<(String * MatchPattern)>)

type Register = Int32

type DvalMap = Dict<String, Dval>

type DictMap = Dict<Dval, Dval>

type StringSegment =
  | Text(String)
  | Interpolated(Register)


/// The register-machine instruction set the interpreter actually runs.
///
/// Mirrors `LibExecution.RuntimeTypes.Instruction`. Dark code compiles to this, so it's what a
/// disassembly view shows; see `PrettyPrinter.RuntimeTypes.instructions`.
///
/// Jump offsets are relative to the jumping instruction, so a listing has to add the index back to make
/// them readable.
// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.RuntimeTypes.Instruction: Unknown type 'MatchPattern'"
type Instruction =
  | LoadVal(loadTo: Register, value: Dval)
  | CopyVal(copyTo: Register, copyFrom: Register)
  /// One side of `a || b`. The left side's has `skipRhs`, to skip the right side.
  | Or(createTo: Register, operand: Register, skipRhs: Stdlib.Option.Option<Int32>)
  /// One side of `a && b`, as `Or`.
  | And(createTo: Register, operand: Register, skipRhs: Stdlib.Option.Option<Int32>)
  | CreateString(createTo: Register, segments: List<StringSegment>)
  | CheckLetPatternAndExtractVars(valueReg: Register, pat: LetPattern)
  | JumpByIfFalse(instrsToJump: Int32, conditionReg: Register)
  | JumpBy(instrsToJump: Int32)
  | Unwrap(
    extractTo: Register,
    valueReg: Register,
    returns: Stdlib.Option.Option<FQTypeName.FQTypeName>)
  | CheckMatchPatternAndExtractVars(
    valueReg: Register,
    pat: MatchPattern,
    failJump: Int32)
  | MatchUnmatched(valueReg: Register)
  | CreateTuple(
    createTo: Register,
    first: Register,
    second: Register,
    theRest: List<Register>)
  | CreateList(createTo: Register, itemsToAdd: List<Register>)
  | CreateDict(createTo: Register, entries: List<(Register * Register)>)
  | CreateRecord(
    createTo: Register,
    typeName: FQTypeName.FQTypeName,
    typeArgs: List<TypeReference>,
    fields: List<(String * Register)>)
  | CloneRecordWithUpdates(
    createTo: Register,
    originalRecordReg: Register,
    updates: List<(String * Register)>)
  | GetRecordField(
    targetReg: Register,
    recordReg: Register,
    fieldName: String)
  | CreateEnum(
    createTo: Register,
    typeName: FQTypeName.FQTypeName,
    typeArgs: List<TypeReference>,
    caseName: String,
    fields: List<Register>)
  | LoadValue(createTo: Register, value: FQValueName.FQValueName)
  | CreateLambda(createTo: Register, lambda: LambdaImpl)
  | Apply(
    createTo: Register,
    thingToApply: Register,
    typeArgs: List<TypeReference>,
    args: List<Register>)
  | RaiseNRE(names: List<String>, error: NameResolutionError)
  | VarNotFound(targetRegIfDB: Register, name: String)
  | CheckIfFirstExprIsUnit(exprId: UInt64, reg: Register)
  /// The value in `valueReg` is the result of the source expression `exprId`, for live values.
  | TraceExpr(exprId: UInt64, valueReg: Register)


// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.RuntimeTypes.Instructions: Unknown type 'Instruction'"
type Instructions =
  { registerCount: Int32
    instructions: List<Instruction>
    resultIn: Register }


// @compiler blocked: upstream-dependency diagnostic="Darklang.LanguageTools.RuntimeTypes.LambdaImpl: Unknown type 'Instructions'"
type LambdaImpl =
  { exprId: UInt64
    patterns: List<LetPattern>
    registersToCloseOver: List<(Register * Register)>
    selfRegister: Option<Register>
    instructions: Instructions }

// @compiler replace: packages/darklang/languageTools/runtimeTypes/dval.dark#Darklang.LanguageTools.RuntimeTypes.ApplicableNamedFn reason=compiler-implementation
type ApplicableNamedFn =
  { name: FQFnName.FQFnName
    typeArgs: List<TypeReference>
    argsSoFar: List<Dval> }

// @compiler blocked: compiler-contract diagnostic="Already selected from packages/darklang/languageTools/runtimeTypes/dval.dark; importing another declaration of Darklang.LanguageTools.RuntimeTypes.ApplicableLambda requires an explicit replacement contract"
type ApplicableLambda =
  { exprId: UInt64
    closedRegisters: List<(Register * Dval)>
    typeSymbolTable: TypeSymbolTable }

// @compiler replace: packages/darklang/languageTools/runtimeTypes/dval.dark#Darklang.LanguageTools.RuntimeTypes.Applicable reason=compiler-implementation
type Applicable =
  | AppLambda(ApplicableLambda)
  | AppNamedFn(ApplicableNamedFn)


/// One impl of a trait as dispatch sees it: what it is for, and the fn behind each method
type ImplCandidate =
  { trait_: FQTraitName.Package
    self: TypeReference
    methods: Dict<String, Hash>
    source: Hash
    /// When the op that added this implementation was written. Two implementations of
    /// one trait for one type are ordered by it: the newer one runs. Empty for an
    /// implementation that never came from an op, and then neither one wins.
    stamp: String }

// @compiler blocked: compiler-contract diagnostic="Already selected from packages/darklang/languageTools/runtimeTypes/dval.dark; importing another declaration of Darklang.LanguageTools.RuntimeTypes.Dval requires an explicit replacement contract"
type Dval =
  | DUnit
  | DBool(Bool)
  | DInt8(Int8)
  | DUInt8(UInt8)
  | DInt16(Int16)
  | DUInt16(UInt16)
  | DInt32(Int32)
  | DUInt32(UInt32)
  | DInt64(Int64)
  | DUInt64(UInt64)
  | DInt128(Int128)
  | DUInt128(UInt128)
  | DBigInt(BigInt)
  | DFloat(Float)
  | DFloat32(Float32)
  | DDecimal(Decimal)
  | DChar(Char)
  | DString(String)
  | DDateTime(DateTime)
  | DUuid(Uuid)

  | DTuple(Dval, Dval, List<Dval>)
  | DList(ValueType, List<Dval>)
  | DDict(keyType: ValueType, valueType: ValueType, entries: DictMap)

  | DRecord(
    sourceTypeName: FQTypeName.FQTypeName,
    runtimeTypeName: FQTypeName.FQTypeName,
    typeArgs: List<ValueType>,
    fields: DvalMap)

  | DEnum(
    sourceTypeName: FQTypeName.FQTypeName,
    runtimeTypeName: FQTypeName.FQTypeName,
    typeArgs: List<ValueType>,
    caseName: String,
    fields: List<Dval>)

  | DApplicable(Applicable)

  // References

  | DBytes(Bytes)

  | DStreamStub(elemType: ValueType)

type BuiltInParam =
  { name: String
    typ: TypeReference
    blockArgs: List<String>
    description: String }


/// Convert a value into a Dval that Dark code can inspect.
/// For records and enums, the result includes the package type's hash.
// @compiler excluded: runtime-reflection
let reflect(value: 'a): Dval = Builtin.reflect(value)
