#!/usr/bin/env bash
# mergetrain-status - Continuously refresh the local merge-train status.

set -euo pipefail

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$script_root"
interval_seconds=2
clear_screen=true
run_once=false
interactive_redraw=false

usage() {
  cat <<EOF
Usage: ./mergetrain-status [OPTIONS]

Continuously display merge-train health, active jobs, the latest integration
merge, and recent benchmarks/RESULTS.md changes. Interactive terminals are
redrawn in place as complete frames.

Options:
  --repo PATH          Repository whose merge-train status is displayed.
                       Default: $repo_root
  --interval SECONDS   Delay between status refreshes.
                       Default: $interval_seconds
  --no-clear           Append each refresh instead of redrawing in place.
  --once               Display one status snapshot, then exit.
  -h, --help           Show this help and exit.

Example:
  ./mergetrain-status --interval 5
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      repo_root="$2"
      shift 2
      ;;
    --interval)
      interval_seconds="$2"
      shift 2
      ;;
    --no-clear)
      clear_screen=false
      shift
      ;;
    --once)
      run_once=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ ! "$interval_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "--interval must be a positive integer" >&2
  exit 2
fi
for required_command in git mergetrain python3; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "Required command not found: $required_command" >&2
    exit 1
  fi
done

repo_root="$(cd "$repo_root" && pwd -P)"
if [[ "$clear_screen" == true && -t 1 ]]; then
  interactive_redraw=true
  printf '\033[?25l'
  trap 'printf "\033[?25h\n"' EXIT
fi

while true; do
  status_output=""
  if ! status_output="$(
    mergetrain --repo "$repo_root" status --json --limit 1000 \
      | python3 "$script_root/scripts/render_mergetrain_status.py" --repo "$repo_root"
  )"; then
    status_output="Status refresh failed; retrying in $interval_seconds second(s)"
  fi
  if [[ "$interactive_redraw" == true ]]; then
    printf '\033[H\033[J%s\n' "$status_output"
  else
    printf '%s\n' "$status_output"
  fi

  if [[ "$run_once" == true ]]; then
    exit 0
  fi
  sleep "$interval_seconds"
done
