{"id": "stdlib/tuple.dark:Darklang.Stdlib.Tuple.Tests.tuple3#5", "expr": "Darklang.Stdlib.Tuple3.second((1, \"two\", 3.14))", "eval": "two"}
{"id": "stdlib/tuple.dark:Darklang.Stdlib.Tuple.Tests.tuple3#10", "expr": "Darklang.Stdlib.Tuple3.mapFirst((1, \"two\", 3.14), fun x -> x - 2)", "eval": "(-1, \"two\", 3.14)"}
{"id": "stdlib/tuple.dark:Darklang.Stdlib.Tuple.Tests.tuple3#13", "expr": "Darklang.Stdlib.Tuple3.mapThird((\"one\", 2, \"pi\"), fun x -> Darklang.Stdlib.String.toUppercase(x))", "eval": "(\"one\", 2, \"PI\")"}
{"id": "stdlib/tuple.dark:Darklang.Stdlib.Tuple.Tests.tuple3MapsAllThree#2", "expr": "Darklang.Stdlib.Tuple3.mapAllThree(\n  (1, \"two\", 3.14),\n  (fun x -> x - 2),\n  (fun x -> Darklang.Stdlib.String.toUppercase(x)),\n  fun x -> Darklang.Stdlib.Float.roundDown(x))", "eval": "(-1, \"TWO\", 3)"}
{"id": "stdlib/url.dark:Darklang.Stdlib.Url.Tests.parseWithoutAuthority#8", "expr": "Darklang.Stdlib.Url.parse(\"localhost:8080\")\n|> Darklang.Stdlib.Result.map(fun u -> (u.scheme, u.host, u.path))", "eval": "Ok((Some(\"localhost\"), None, \"8080\"))"}
{"id": "stdlib/url.dark:Darklang.Stdlib.Url.Tests.parseReference#1", "expr": "Darklang.Stdlib.Url.parseReference(\"../a/b?q#f\")", "eval": "Ok(\n  Stdlib.Url.Url {\n    scheme: None,\n    userinfo: None,\n    host: None,\n    port: None,\n    path: \"../a/b\",\n    query: Some(\"q\"),\n    fragment: Some(\"f\")\n  }\n)"}
{"id": "stdlib/url.dark:Darklang.Stdlib.Url.Tests.parseLenient#3", "expr": "Darklang.Stdlib.Url.parseLenient(\"http://x:port/\")", "eval": "Error(Stdlib.Url.ParseError.InvalidPort(\"port\"))"}
{"id": "stdlib/utf8.dark:Darklang.Stdlib.Utf8.Tests.decode#3", "expr": "Darklang.Stdlib.Base64.decode(\"ww==\")\n|> Darklang.Stdlib.Result.map(fun b -> Darklang.Stdlib.Result.isError(Darklang.Stdlib.Utf8.decode(b)))", "eval": "Ok(true)"}
{"id": "stdlib/x509.dark:Darklang.Stdlib.X509.Tests.errors#1", "expr": "Darklang.Stdlib.X509.pemCertificatePublicKey(\"\")", "eval": "Error(\"No certificates\")"}
{"id": "gen:Darklang.Stdlib.AltJson.Parse.codepointText#3", "expr": "Darklang.Stdlib.AltJson.Parse.codepointText(-1)", "eval": "None"}
{"id": "gen:Darklang.Stdlib.AltJson.Parse.skipComments#2", "expr": "Darklang.Stdlib.AltJson.Parse.skipComments([ \"\" ])", "eval": "[\"\"]"}
{"id": "gen:Darklang.Stdlib.BigInt.fromInt128#1", "expr": "Darklang.Stdlib.BigInt.fromInt128(0s128)", "eval": "0z"}
{"id": "gen:Darklang.Stdlib.BigInt.sqrt#1", "expr": "Darklang.Stdlib.BigInt.sqrt(0z)", "eval": "0.0"}
{"id": "gen:Darklang.Stdlib.BigInt.toUInt16#1", "expr": "Darklang.Stdlib.BigInt.toUInt16(0z)", "eval": "Some(0u16)"}
{"id": "gen:Darklang.Stdlib.BigInt.toUInt64#1", "expr": "Darklang.Stdlib.BigInt.toUInt64(0z)", "eval": "Some(0u64)"}
{"id": "gen:Darklang.Stdlib.DateTime.zeroPadded#1", "expr": "Darklang.Stdlib.DateTime.zeroPadded(0, 1)", "eval": "0"}
{"id": "gen:Darklang.Stdlib.Int16.sqrt#1", "expr": "Darklang.Stdlib.Int16.sqrt(0s16)", "eval": "0.0"}
