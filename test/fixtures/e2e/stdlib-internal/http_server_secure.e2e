// http_server_secure.e2e - Reject invalid secure listener configuration before touching identity or sockets.
let invalidSecure (port: Int64) (limit: Int64) : Stdlib.Result.Result<Unit, String> =
  let config = Stdlib.HttpServer.Config.Config { address = "127.0.0.1", port = Stdlib.Net.Port { __port = port }, maxBodyBytes = limit, injectStandardHeaders = false, canonicalizeFromForwardedProto = false, logRequests = false } in
  let identity = Stdlib.TlsServerIdentity.Identity { certificates = [], key = Stdlib.__RsaPrivate.Key { modulus = Stdlib.Blob.empty, exponent = Stdlib.Blob.empty, privateExponent = Stdlib.Blob.empty } } in
  Stdlib.HttpServer.Secure.serve config identity (fun _request -> Stdlib.Http.responseWithText 200L "unused") (fun _unit -> ())
invalidSecure 0L 1024L = Error "Invalid secure HTTP server configuration"
invalidSecure 65536L 1024L = Error "Invalid secure HTTP server configuration"
invalidSecure 443L (-1L) = Error "Invalid secure HTTP server configuration"
invalidSecure 443L 104857601L = Error "Invalid secure HTTP server configuration"
