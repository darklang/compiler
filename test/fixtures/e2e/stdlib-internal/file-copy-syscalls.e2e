// Pure progress/short-write tests, plus descriptor identity and metadata.
Stdlib.Cli.File.__copyWriteAt (fun _ _ -> Ok 1z) (Stdlib.Blob.fromString "abc") 0z = Ok ()
Stdlib.Cli.File.__copyWriteAt (fun _ _ -> Ok 0z) (Stdlib.Blob.fromString "abc") 0z = Error 5z
Stdlib.Cli.Dir.withTemp (fun dir -> let destination = Stdlib.String.append dir "/not-a-file" in let copied = Stdlib.Cli.File.copy dir destination in (match copied with | Error e -> e.errno == 21L | Ok _ -> false) && (Stdlib.Cli.File.exists destination) == false) = Ok true isolated=true
Stdlib.Cli.File.__copyWriteAt (fun _ _ -> Ok 4z) (Stdlib.Blob.fromString "abc") 0z = Error 5z
Stdlib.Cli.File.__copyWriteAt (fun _ _ -> Error 28z) (Stdlib.Blob.fromString "abc") 0z = Error 28z
Stdlib.Cli.File.__copyBuffered (fun count offset -> if count != 65536z then Error 22z else if offset == 2z then Ok (Stdlib.Blob.fromString "abc") else if offset == 5z then Ok Stdlib.Blob.empty else Error 22z) (fun _ offset -> if offset >= 2z && offset < 5z then Ok 1z else Error 22z) 2z = Ok ()
Stdlib.Cli.Dir.withTemp (fun dir -> let path = dir + "/same" in let _ = Stdlib.Cli.File.writeText path "kept" in let rejected = match Stdlib.Cli.File.copy path path with | Error e -> e.errno == 22L | Ok _ -> false in rejected && Stdlib.Cli.File.readText path == Ok "kept") = Ok true isolated=true
Stdlib.Cli.Dir.withTemp (fun dir -> let source = dir + "/source" in let destination = dir + "/destination" in let _ = Stdlib.Cli.File.writeText source "new" in let _ = Stdlib.Cli.File.setPermissions source 384z in let _ = Stdlib.Cli.File.writeText destination "old contents" in let _ = Stdlib.Cli.File.setPermissions destination 420z in let copied = Stdlib.Cli.File.copy source destination in let mode = match Stdlib.Cli.Posix.stat destination with | Error _ -> 0z | Ok stat -> stat.mode & 511z in (copied, Stdlib.Cli.File.readText destination, mode) == (Ok (), Ok "new", 384z)) = Ok true isolated=true
