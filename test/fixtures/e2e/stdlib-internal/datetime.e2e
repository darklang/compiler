// Internal tick probes make sub-millisecond DateTime behavior deterministic.

Stdlib.DateTime.__fromUnixTimeTicks 1L != Stdlib.DateTime.__fromUnixTimeTicks 2L = true
Stdlib.DateTime.toMilliseconds (Stdlib.DateTime.__fromUnixTimeTicks (-1L)) = -1L
Stdlib.Duration.toSeconds (Stdlib.DateTime.subtract (Stdlib.DateTime.__fromUnixTimeTicks 5000000L) (Stdlib.DateTime.__fromUnixTimeTicks 0L)) = 0L
Stdlib.Duration.toSeconds (Stdlib.DateTime.subtract (Stdlib.DateTime.__fromUnixTimeTicks 15000000L) (Stdlib.DateTime.__fromUnixTimeTicks 0L)) = 2L
Stdlib.DateTime.subtractMs (Stdlib.DateTime.__fromUnixTimeTicks 5000L) (Stdlib.DateTime.__fromUnixTimeTicks 0L) = 0L
Stdlib.DateTime.subtractMs (Stdlib.DateTime.__fromUnixTimeTicks 15000L) (Stdlib.DateTime.__fromUnixTimeTicks 0L) = 2L
