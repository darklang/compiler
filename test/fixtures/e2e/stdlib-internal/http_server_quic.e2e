// http_server_quic.e2e - Invalid HTTP/3 configuration fails before sockets or private signing.
Stdlib.HttpServer.Quic.serve (Stdlib.HttpServer.Config.Config { address = "127.0.0.1", port = Stdlib.Net.Port { __port = 0L }, maxBodyBytes = 1024L, injectStandardHeaders = false, canonicalizeFromForwardedProto = false, logRequests = false }) (Stdlib.TlsServerIdentity.Identity { certificates = [], key = Stdlib.__RsaPrivate.Key { modulus = Stdlib.Blob.empty, exponent = Stdlib.Blob.empty, privateExponent = Stdlib.Blob.empty } }) (fun _request -> Stdlib.Http.responseWithText 200L "unused") (fun _unit -> ()) = Error "Invalid HTTP/3 server configuration"
