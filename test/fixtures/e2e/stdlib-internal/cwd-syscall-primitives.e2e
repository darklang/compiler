match Builtin.syscallGetcwd 1z with | Error e -> e == (if Stdlib.Cli.Posix.__abiMac () then 78z else 34z) | Ok _ -> false = true
Stdlib.Cli.Posix.__pathCwdWith (fun count -> if count == 2z then Error 34z else Ok (Stdlib.Blob.fromString "/x\0")) 2z |> Stdlib.Result.map Stdlib.Blob.toList = Ok [47uy, 120uy, 0uy]
Stdlib.Cli.Posix.getCwd () |> Stdlib.Result.map (fun path -> Stdlib.String.startsWith path "/") = Ok true
Builtin.posixGetcwd () = compileerror="Unknown function"
