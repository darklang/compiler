// Raw errno and single-call behavior; high-level retries live in shared Dark.
Builtin.syscallRead (-1z) 1z = Error 9z
Builtin.syscallRead (-1z) (-1z) = Error 22z
Builtin.syscallClose (-1z) = Error 9z
Builtin.syscallLseek (-1z) 0z 0z = Error 9z
Builtin.syscallFlock (-1z) 2z = Error 9z
Builtin.syscallGetpid () > 0z = true
Builtin.syscallGetuid () >= 0z = true
Stdlib.Cli.Posix.__decimal 0z = "0"
Stdlib.Cli.Posix.__decimal (-1z) = "-1"
Stdlib.Cli.Posix.__macMessage 999z = "Unknown error: 999"
Builtin.syscallUnlinkAt "/dark-syscall-missing-entry" 0z = Error 2z
Builtin.syscallUnlinkAt "/dark-syscall-missing-entry" 64z = Error 22z
Stdlib.Cli.Dir.withTemp (fun dir -> let path = dir + "/child" in let created = Stdlib.Cli.Posix.mkdir path 448z in let removed = Builtin.syscallUnlinkAt path (Stdlib.Cli.Posix.__abiRemoveDirectory ()) in (created, removed, Stdlib.Cli.File.exists path) == (Ok (), Ok (), false)) = Ok true isolated=true
Builtin.posixRmdir "/missing" = compileerror="Unknown function"
Builtin.posixUnlink "/missing" = compileerror="Unknown function"
Stdlib.Cli.Env.set "NAME" "value" = compileerror="Unknown function"
Stdlib.Cli.Env.unset "NAME" = compileerror="Unknown function"
Stdlib.Cli.Posix.fnmatch "*" "text" false = compileerror="Unknown function"
