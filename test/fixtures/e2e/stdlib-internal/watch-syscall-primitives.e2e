match Builtin.syscallInotifyInit1 (-1) with | Error e -> e == (if Stdlib.Cli.Posix.__abiMac () then 78 else 22) | Ok _ -> false = true
Builtin.syscallPpoll [] (-1) = Error 22
Builtin.syscallPpoll [] 0 |> Stdlib.Result.map Stdlib.Blob.length = Ok 0z
match Builtin.syscallPpoll [(-1z, 1)] 0 with | Ok bytes -> Stdlib.Blob.length bytes == 8z | Error _ -> false = true
