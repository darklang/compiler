match Builtin.syscallInotifyInit1 (-1z) with | Error e -> e == (if Stdlib.Cli.Posix.__abiMac () then 78z else 22z) | Ok _ -> false = true
Builtin.syscallPpoll [] (-1z) = Error 22z
Builtin.syscallPpoll [] 0z |> Stdlib.Result.map Stdlib.Blob.length = Ok 0z
match Builtin.syscallPpoll [(-1z, 1z)] 0z with | Ok bytes -> Stdlib.Blob.length bytes == 8z | Error _ -> false = true
