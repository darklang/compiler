// http_server.e2e - Exercise server configuration, routing, request body limits, and listener ownership.

(Stdlib.HttpServer.Config.defaults Stdlib.Net.Port.httpAlt).maxBodyBytes = 31457280L
Stdlib.HttpServer.serve (Stdlib.HttpServer.Config.defaults (Stdlib.Net.Port { __port = 0L })) (fun req -> Stdlib.Http.success req.body) (fun _ -> Stdlib.printLine "unexpected listening") = Error "Invalid HTTP server configuration"
Stdlib.HttpServer.matchRoute "/users/:id" "/users/42" = Stdlib.HttpServer.RouteMatch { matched = true, vars = [("id", "42")] }
Stdlib.HttpServer.matchRoute "/files/*path" "/files/a/b" = Stdlib.HttpServer.RouteMatch { matched = false, vars = [] }
Stdlib.HttpServer.routeRequest [Stdlib.HttpServer.get "/ping" (fun _ -> Stdlib.Http.responseWithText 200L "pong")] (Stdlib.Http.Request { method = "GET", url = "http://localhost/ping?x=1", headers = [], body = Stdlib.Blob.empty }) |> fun response -> response.statusCode = 200L
Stdlib.HttpServer.routeRequest [] (Stdlib.Http.Request { method = "GET", url = "http://localhost/missing", headers = [], body = Stdlib.Blob.empty }) |> fun response -> response.statusCode = 404L
Stdlib.__HttpWire.parseRequestWithLimit 3L (Stdlib.String.toBlob "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\n\r\n") = Error (Stdlib.__HttpWire.ParseError.Invalid "HTTP body too large")
Stdlib.__HttpWire.parseRequestWithLimit 3L (Stdlib.String.toBlob "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n4\r\n") = Error (Stdlib.__HttpWire.ParseError.Invalid "HTTP body too large")
Stdlib.__Network.listenTcp4 [127L, 0L, 0L, 1L] 0L |> Stdlib.Result.map (fun listener -> let _ = Stdlib.__Network.closeListener listener in Stdlib.__Network.closeListener listener) = stdout="Darklang.Stdlib.Result.Result<Unit, Int64>.Ok(())\n" stderr=""
Stdlib.__Network.listenTcp4 [127L, 0L, 0L, 1L] 0L |> Stdlib.Result.andThen (fun listener -> let _ = Stdlib.__Network.closeListener listener in Stdlib.__Network.acceptTcp listener 100L) = Error 9L

Stdlib.__Network.listenTcp4 [127L, 0L, 0L] 8080L = Error 22L
Stdlib.__Network.listenTcp4 [127L, 0L, 0L, 1L] 65536L = Error 22L
match Stdlib.__Network.monotonicMillis () with | Ok now -> now >= 0L | Error _ -> false = true
match Stdlib.__Network.monotonicMillis () with | Error _ -> false | Ok before -> let _ = Stdlib.Cli.Posix.sleep 20.0 in match Stdlib.__Network.monotonicMillis () with | Ok after -> after >= before + 10L | Error _ -> false = true
Stdlib.__Network.shutdownSignals () |> Stdlib.Result.map Stdlib.__Network.closeShutdownSignals = stdout="Darklang.Stdlib.Result.Result<Unit, Int64>.Ok(())\n" stderr=""
Stdlib.HttpServer.serve (Stdlib.HttpServer.Config.Config { address = "127.0.0.1", port = Stdlib.Net.Port.httpAlt, maxBodyBytes = -1L, injectStandardHeaders = true, canonicalizeFromForwardedProto = true, logRequests = false }) (fun req -> Stdlib.Http.success req.body) (fun _ -> Stdlib.printLine "unexpected listening") = Error "Invalid HTTP server configuration"
Stdlib.HttpServer.matchRoute "/files/*path" "/files/a" = Stdlib.HttpServer.RouteMatch { matched = true, vars = [("path", "a")] }
Stdlib.HttpServer.getPathParam (Stdlib.Http.Request { method = "GET", url = "http://localhost/users/42?x=1", headers = [], body = Stdlib.Blob.empty }) "/users/:id" "id" = Some "42"
Stdlib.__HttpWire.parseRequestWithLimit 3L (Stdlib.String.toBlob "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nab\r\n2\r\n") = Error (Stdlib.__HttpWire.ParseError.Invalid "HTTP body too large")
Stdlib.__HttpWire.parseRequestWithLimit 0L (Stdlib.String.toBlob "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n") |> Stdlib.Result.map (fun request -> Stdlib.Blob.length request.body) = Ok 0

let pollfd = __raw_alloc 8L in let timeout = __raw_alloc 16L in let _ = __raw_write_word pollfd 0L 4294967295L in let _ = __raw_write_word timeout 0L 1L in let _ = __raw_write_word timeout 8L 30000000L in let before = Stdlib.__Network.monotonicMillis () in let code = Stdlib.__Network.__poll pollfd timeout in let after = Stdlib.__Network.monotonicMillis () in let _ = __raw_free pollfd in let _ = __raw_free timeout in match before, after with | Ok start, Ok finish -> code == 0L && finish >= start + 1000L | _, _ -> false = true
Stdlib.HttpServer.__bindAddress "localhost" = Ok [127L, 0L, 0L, 1L]
Stdlib.HttpServer.__bindAddress "0.0.0.0" = Ok [0L, 0L, 0L, 0L]
Stdlib.HttpServer.__bindAddress "10.0.0.256" = Error "Invalid bind address: 10.0.0.256; use an IPv4 address or localhost"
Stdlib.HttpServer.__bindAddress "01.2.3.4" = Error "Invalid bind address: 01.2.3.4; use an IPv4 address or localhost"
Stdlib.HttpServer.serve { Stdlib.HttpServer.Config.defaults Stdlib.Net.Port.httpAlt with address = "::1" } (fun req -> Stdlib.Http.success req.body) (fun _ -> Stdlib.printLine "unexpected listening") = Error "Invalid bind address: ::1; use an IPv4 address or localhost"
