// Duplicate-key rendering must survive concrete Dict literals compiled in a preamble.
let computedKey<'a> (value: a) : a = value
let duplicateStringKey () : Dict<String, String> = Dict { (computedKey "key"): "before", "key": "after" }
let duplicateIntKey () : Dict<Int64, String> = Dict { (computedKey 7L): "before", 7L: "after" }
type RenderedKey = { keyText: String }
let duplicateRecordKey () : Dict<RenderedKey, String> = Dict { (computedKey (RenderedKey { keyText = "x" })): "before", RenderedKey { keyText = "x" }: "after" }
let duplicateDictKey () : Dict<Dict<String, Int64>, String> = Dict { (computedKey (Dict { "nested": 7L })): "before", Dict { "nested": 7L }: "after" }
duplicateStringKey () = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key \"key\"\n"
duplicateIntKey () = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key 7\n"
duplicateRecordKey () = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key RenderedKey { keyText: \"x\" }\n"
duplicateDictKey () = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key Dict { nested = 7 }\n"
