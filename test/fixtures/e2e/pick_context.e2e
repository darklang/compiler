// PickContext.preferredLocation (darklang/dark main): the asked-for location wins when it
// is a candidate, and is ignored when it is not.
Darklang.LanguageTools.PackageManager.pickLocation (Darklang.LanguageTools.PackageManager.PickContext { currentModule = ["A"], preferredLocation = Stdlib.Option.Option.Some (Darklang.LanguageTools.ProgramTypes.PackageLocation { owner = "B", modules = [], name = "x" }) }) [Darklang.LanguageTools.ProgramTypes.PackageLocation { owner = "A", modules = [], name = "x" }, Darklang.LanguageTools.ProgramTypes.PackageLocation { owner = "B", modules = [], name = "x" }] = Stdlib.Option.Option.Some (Darklang.LanguageTools.ProgramTypes.PackageLocation { owner = "B", modules = [], name = "x" })
Darklang.LanguageTools.PackageManager.pickLocation (Darklang.LanguageTools.PackageManager.PickContext { currentModule = ["A"], preferredLocation = Stdlib.Option.Option.Some (Darklang.LanguageTools.ProgramTypes.PackageLocation { owner = "C", modules = [], name = "x" }) }) [Darklang.LanguageTools.ProgramTypes.PackageLocation { owner = "A", modules = [], name = "x" }, Darklang.LanguageTools.ProgramTypes.PackageLocation { owner = "B", modules = [], name = "x" }] = Stdlib.Option.Option.Some (Darklang.LanguageTools.ProgramTypes.PackageLocation { owner = "A", modules = [], name = "x" })
