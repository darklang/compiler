// Duplicate-key errors from Dict literals render the concrete key type chosen at the construction site.
let key = 1L in Dict { key: "a", 1L: "b" } = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key 1\n"
type ErrorKey = { value: Int64 }
let key = ErrorKey { value = 1L } in Dict { key: "a", ErrorKey { value = 1L }: "b" } = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key ErrorKey { value: 1 }\n"
