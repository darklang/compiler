// Duplicate-key errors render keys even when the literal is built in a polymorphic function.
let pairChecked<'k, 'v> (first: k) (second: k) (value: v) : Dict<k, v> = Dict { first: value, second: value }
pairChecked "a" "a" 2L = exit=1 stderr="Uncaught exception: Cannot add two dictionary entries with the same key \"a\"\n"
