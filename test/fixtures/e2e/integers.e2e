// Integer Tests - Comprehensive integer arithmetic test suite
//
// Tests covering:
// - Boundary values (8-bit, 32-bit, 64-bit)
// - Zero and identity operations
// - Powers of 2
// - Overflow and underflow at 32-bit and 64-bit boundaries
// - Special cases (INT64_MIN negation overflow, etc.)


// ===================================================================
// Basic Boundary Values
// ===================================================================

// Boundary values - basic
1z = 1z// minimum positive
254z = 254z
255z = 255z
256z = 256z
257z = 257z

// Boundary values - edge of byte boundaries
127z = 127z// max signed byte (if using signed)
128z = 128z// min negative as unsigned
253z = 253z


// ===================================================================
// Zero and Identity Operations
// ===================================================================

// Zero operations
0z + 0z = 0z
0z - 0z = 0z
0z * 0z = 0z
0z * 1z = 0z
0z * 255z = 0z
1z * 0z = 0z
255z * 0z = 0z

// Identity operations
1z + 0z = 1z
0z + 1z = 1z
5z - 0z = 5z
1z * 1z = 1z
5z * 1z = 5z
1z * 5z = 5z
10z / 1z = 10z
5z / 5z = 1z


// ===================================================================
// Powers of 2
// ===================================================================

2z = 2z// 2^1
4z = 4z// 2^2
8z = 8z// 2^3
16z = 16z// 2^4
32z = 32z// 2^5
64z = 64z// 2^6
2z * 2z = 4z
2z * 2z * 2z = 8z
2z * 2z * 2z * 2z = 16z
4z * 4z = 16z
8z * 8z = 64z
16z * 16z = 256z


// ===================================================================
// Addition and Subtraction with Large Results
// ===================================================================

// Addition tests with large results
255z + 1z = 256z
255z + 2z = 257z
255z + 255z = 510z
200z + 100z = 300z
128z + 128z = 256z
127z + 129z = 256z
100z + 200z = 300z
150z + 150z = 300z

// Subtraction tests (positive results)
10z - 3z = 7z
20z - 5z = 15z
100z - 50z = 50z
255z - 1z = 254z
255z - 100z = 155z


// ===================================================================
// Multiplication and Division with Large Results
// ===================================================================

// Multiplication tests with large results
16z * 17z = 272z
15z * 17z = 255z
15z * 18z = 270z
20z * 20z = 400z
25z * 25z = 625z
50z * 50z = 2500z
100z * 100z = 10000z
128z * 2z = 256z
64z * 4z = 256z
32z * 8z = 256z

// Division edge cases
1z / 1z = 1z
255z / 1z = 255z
255z / 255z = 1z
256z / 2z = 128z// 256 doesn't wrap before division
100z / 10z = 10z
99z / 10z = 9z// integer division truncates
10z / 3z = 3z// 10 / 3 = 3 remainder 1
7z / 2z = 3z// 7 / 2 = 3 remainder 1
1z / 2z = 0z// rounds down to 0


// ===================================================================
// Large Number Combinations
// ===================================================================

1000z + 2000z = 3000z
1000z * 1000z = 1000000z
10000z - 5000z = 5000z
500z + 500z = 1000z
999z = 999z
1024z = 1024z
2048z = 2048z
4096z = 4096z


// ===================================================================
// Sequential and Mixed Operations
// ===================================================================

// Sequential operations
255z + 1z + 1z = 257z
128z + 128z + 1z = 257z
100z + 100z + 100z = 300z

// Mixed operations (positive results)
255z + 1z - 1z = 255z
200z + 100z - 50z = 250z
100z * 3z - 50z = 250z
50z * 2z + 100z = 200z


// ===================================================================
// 32-bit Boundary Tests
// ===================================================================

// INT32_MAX = 2,147,483,647
// INT32_MIN = -2,147,483,648

// 32-bit maximum and minimum
2147483647z = 2147483647z// INT32_MAX
-2147483648z = -2147483648z// INT32_MIN

// Operations at 32-bit boundaries
2147483647z + 1z = 2147483648z// INT32_MAX + 1
2147483647z + 2147483647z = 4294967294z// INT32_MAX + INT32_MAX
-2147483648z - 1z = -2147483649z// INT32_MIN - 1
-2147483648z + -2147483648z = -4294967296z// INT32_MIN + INT32_MIN

// Multiplication near 32-bit boundaries
65536z * 65536z = 4294967296z// 2^32
32768z * 65536z = 2147483648z// 2^31
100000z * 100000z = 10000000000z
1000000z * 1000z = 1000000000z

// Division with 32-bit values
2147483647z / 2z = 1073741823z// INT32_MAX / 2
-2147483648z / 2z = -1073741824z// INT32_MIN / 2
4294967296z / 2z = 2147483648z// 2^32 / 2


// ===================================================================
// 64-bit Boundary Tests
// ===================================================================

// INT64_MAX = 9,223,372,036,854,775,807
// INT64_MIN = -9,223,372,036,854,775,808

// 64-bit maximum and minimum
9223372036854775807z = 9223372036854775807z// INT64_MAX
-9223372036854775808z = -9223372036854775808z// INT64_MIN

// Arbitrary-width Int arithmetic does not wrap at the Int64 boundary.
9223372036854775807z + 2z = 9223372036854775809z// INT64_MAX + 2
-9223372036854775808z - 2z = -9223372036854775810z// INT64_MIN - 2

// Addition remains exact beyond Int64.
9223372036854775807z + 9223372036854775807z = 18446744073709551614z// INT64_MAX + INT64_MAX
9000000000000000000z + 9000000000000000000z = 18000000000000000000z// Large + Large
5000000000000000000z + 5000000000000000000z = 10000000000000000000z// Large + Large

// Subtraction underflow
-9000000000000000000z - 9000000000000000000z = -18000000000000000000z
-5000000000000000000z - 5000000000000000000z = -10000000000000000000z

// Multiplication (large values within 64-bit range)
1000000000z * 1000000000z = 1000000000000000000z// 10^9 * 10^9 = 10^18 (fits in 64-bit)
3000000000z * 3000000000z = 9000000000000000000z// 3*10^9 * 3*10^9 = 9*10^18 (fits in 64-bit)
4294967296z * 4294967296z = 18446744073709551616z// 2^32 * 2^32 = 2^64

// Powers of 2 at boundaries
4611686018427387904z = 4611686018427387904z// 2^62

// Large number operations
1000000000000000000z = 1000000000000000000z// 10^18

// UInt64 values above Int64 max must format as unsigned decimal, not signed bits
Stdlib.UInt64.toString 9223372036854775808UL = "9223372036854775808"
1000000000000000000z + 1000000000000000000z = 2000000000000000000z
1000000000000000000z * 2z = 2000000000000000000z
1000000000000000000z * 10z = 10000000000000000000z// 10^19


// ===================================================================
// Mixed Boundary Operations
// ===================================================================

// Crossing from 32-bit to 64-bit range
2147483647z * 2z = 4294967294z// INT32_MAX * 2 (still in 64-bit range)
2147483647z * 4z = 8589934588z// INT32_MAX * 4
2147483647z * 1000000z = 2147483647000000z

// Operations that stay within 32-bit range
1000000000z + 1000000000z = 2000000000z
1000000z * 2000z = 2000000000z
2000000000z / 2z = 1000000000z

// Near-boundary division
9223372036854775807z / 2z = 4611686018427387903z// INT64_MAX / 2
9223372036854775807z / 9223372036854775807z = 1z// INT64_MAX / INT64_MAX


// ===================================================================
// Special INT64_MIN Cases
// ===================================================================

// Arbitrary-width Int can represent the negation of INT64_MIN.
-(-9223372036854775808z) = 9223372036854775808z// -INT64_MIN

// INT64_MIN operations
-9223372036854775808z + 1z = -9223372036854775807z
-9223372036854775808z * 1z = -9223372036854775808z
-9223372036854775808z * -1z = 9223372036854775808z
-9223372036854775808z / 1z = -9223372036854775808z
-9223372036854775808z / -1z = 9223372036854775808z


// ===================================================================
// Modulo Operations
// ===================================================================

// Basic modulo
10z % 3z = 1z
7z % 2z = 1z
8z % 2z = 0z
17z % 5z = 2z
100z % 7z = 2z
255z % 10z = 5z

// Modulo with larger numbers
1000z % 7z = 6z
12345z % 100z = 45z
1000000z % 999z = 1z
2147483647z % 10z = 7z

// Modulo with negative dividend
-10z % 3z = 2z
-7z % 2z = 1z
-17z % 5z = 3z

// Modulo with negative divisor
10z % -3z = error="Cannot evaluate modulus against a negative number"
7z % -2z = error="Cannot evaluate modulus against a negative number"
17z % -5z = error="Cannot evaluate modulus against a negative number"

// Modulo with both negative
-10z % -3z = error="Cannot evaluate modulus against a negative number"
-7z % -2z = error="Cannot evaluate modulus against a negative number"
-17z % -5z = error="Cannot evaluate modulus against a negative number"

// Modulo edge cases
1z % 1z = 0z
0z % 5z = 0z
5z % 1z = 0z
255z % 256z = 255z

// Modulo with powers of 2 (common optimization case)
16z % 8z = 0z
17z % 8z = 1z
18z % 8z = 2z
31z % 16z = 15z
32z % 16z = 0z
33z % 16z = 1z


// ===================================================================
// Deeply Nested Expressions (Bug: Segfault with 4+ levels of nesting)
// ===================================================================

// Regression cases discovered by differential testing
(((209z * 1z) * (-55z - -3z)) / (-1z + (-29z - -809z))) = -13z
(((-3z - -40z) + (-790z * 426z)) * ((-970z + -535z) * (-608z - 996z))) = -812324972060z


// ===================================================================
// Int64 Suffix (L) Tests
// ===================================================================

// The L suffix explicitly marks fixed-width Int64 literals.
1L + 2L = 3L
100L * 100L = 10000L
42L + 1L = 43L
1L + 42L = 43L
9223372036854775807L = 9223372036854775807L
-9223372036854775808z = -9223372036854775808z


// ===================================================================
// Unary Negation for Sized Integers
// ===================================================================

let x = 1y in -x = -1y// neg int8 var
let x = 1s16 in -x = -1s16// neg int16 var
let x = 1l in -x = -1l// neg int32 var
let x = 1L in -x = -1L// neg int64 var


// ===================================================================
// Int128/UInt128 Literal Identity Tests
// ===================================================================

// These literals are > 64-bit and must not wrap into Int64/UInt64 space.
(18446744073709551616Q == 0Q) = false
(18446744073709551617Q == 1Q) = false
(18446744073709551616Z == 0Z) = false
(18446744073709551617Z == 1Z) = false

// Literal boundaries and identity checks.
0Q = 0Q
-1Q = -1Q
170141183460469231731687303715884105727Q = 170141183460469231731687303715884105727Q
-170141183460469231731687303715884105728Q = -170141183460469231731687303715884105728Q
0Z = 0Z
340282366920938463463374607431768211455Z = 340282366920938463463374607431768211455Z

let i128 = 170141183460469231731687303715884105727Q in i128 == 170141183460469231731687303715884105727Q = true
let u128 = 340282366920938463463374607431768211455Z in u128 == 340282366920938463463374607431768211455Z = true
