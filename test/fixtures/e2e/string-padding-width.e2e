// Space padding measures display cells and preserves text when no padding is needed.

Stdlib.String.padStartToWidth "abc" -3z = "abc"
Stdlib.String.padStartToWidth "" 3z = "   "
Stdlib.String.padEndToWidth "" 3z = "   "
Stdlib.String.padStartToWidth "👩‍👩‍👧‍👦" 4z = "  👩‍👩‍👧‍👦"
Stdlib.String.padEndToWidth "👩‍👩‍👧‍👦" 4z = "👩‍👩‍👧‍👦  "
Stdlib.String.padStartToWidth "e\u0301" 3z = "  e\u0301"
let value = "界" + "abc" in (Stdlib.String.padEndToWidth value 2z, value) = ("界abc", "界abc")
Stdlib.String.padEndToWidth "abc" -999999999999999999999999999999999999999z = "abc"
