// Selected unchanged named tests from darklang/dark a9d93efc853486244630dad693fe79f6f4882cf6
// packages/darklang/tests/stdlib/char.dark
module Darklang.Stdlib.Char.Tests

let smiley () : Char =
  "😂" |> Stdlib.String.head |> Builtin.unwrap

let hand () : Char =
  "✋🏿" |> Stdlib.String.head |> Builtin.unwrap

// `e` followed by a combining acute accent: one grapheme, two code units
let eCombiningAcute () : Char =
  "e\u0301" |> Stdlib.String.head |> Builtin.unwrap

let family () : Char =
  "👩‍👩‍👧‍👦" |> Stdlib.String.head |> Builtin.unwrap

test toString =
  Stdlib.Test.all
    [ Stdlib.display 'A' |> Stdlib.Test.equal "A"
      Stdlib.display 'a' |> Stdlib.Test.equal "a"
      Stdlib.display 'Á' |> Stdlib.Test.equal "Á"
      Stdlib.display '3' |> Stdlib.Test.equal "3"
      Stdlib.display (smiley ()) |> Stdlib.Test.equal "😂"
      Stdlib.display 'Ż' |> Stdlib.Test.equal "Ż"
      Stdlib.display 'Ó' |> Stdlib.Test.equal "Ó"
      Stdlib.display 'Ł' |> Stdlib.Test.equal "Ł"
      Stdlib.display (hand ()) |> Stdlib.Test.equal "✋🏿"
      Stdlib.display 'Ჾ' |> Stdlib.Test.equal "Ჾ"
      Stdlib.display 'ჾ' |> Stdlib.Test.equal "ჾ" ]

