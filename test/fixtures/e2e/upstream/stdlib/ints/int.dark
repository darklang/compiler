// Arbitrary-precision `Int` — the small/big representation split.
//
// `Int` is stored as a small (Int64-backed) value when it fits, and only
// promotes to a big representation on overflow. Values are NORMALIZED: any
// result that fits Int64 always uses the small representation. These tests
// exercise the boundary, promotion, demotion, normalization, and finite/infinite
// ordering — the properties that break if normalization is wrong. Literals use
// the F# `I` suffix because these testfiles are parsed by the F# parser.

// --- boundary: largest small value vs first big value ---
9223372036854775807z + 0z = 9223372036854775807z // Int64.MAX stays small
9223372036854775807z + 1z = 9223372036854775808z // promotes past Int64.MAX
-9223372036854775808z - 1z = -9223372036854775809z // promotes past Int64.MIN

// --- demotion: a big-arithmetic result that fits Int64 collapses to small ---
9223372036854775808z - 1z = 9223372036854775807z
(2z ** 100z) - (2z ** 100z) = 0z
(2z ** 100z) / (2z ** 100z) = 1z

// --- normalization: a promoted-then-demoted result equals the small literal ---
// (this is the property that fails if a small value is left as the big rep)
(9223372036854775808z - 9223372036854775808z) == 0z = true
9223372036854775807z == (9223372036854775806z + 1z) = true

// --- equality and ordering across representations ---
(2z ** 64z) == (2z ** 64z) = true
9223372036854775808z > 5z = true
5z < 9223372036854775808z = true
9223372036854775808z == 5z = false

// --- arithmetic correctness at scale ---
2z ** 64z = 18446744073709551616z
2z ** 200z
  = 1606938044258990275541962092341162602522202993782792835301376z

// --- round-trips (stringify / parse / Int64 conversions) ---
Stdlib.Int.toString 5z = "5"
Stdlib.Int.toString 9223372036854775808z = "9223372036854775808"
Stdlib.Int.parse "9223372036854775808" = Stdlib.Result.Result.Ok 9223372036854775808z
Stdlib.Int.parse "5" = Stdlib.Result.Result.Ok 5z
Stdlib.Int.parse "not a number" = Stdlib.Result.Result.Error Stdlib.Int.ParseError.BadFormat
Stdlib.Int.parse "" = Stdlib.Result.Result.Error Stdlib.Int.ParseError.BadFormat
Stdlib.Int.parse "5.0" = Stdlib.Result.Result.Error Stdlib.Int.ParseError.BadFormat
Stdlib.Int.parse "5_000" = Stdlib.Result.Result.Error Stdlib.Int.ParseError.BadFormat
// arbitrary precision: a value past Int64.MinValue still parses
Stdlib.Int.parse "-9223372036854775809" = Stdlib.Result.Result.Ok -9223372036854775809z
Stdlib.Int.fromInt64 5L = 5z

// toInt64 relies on the invariant: a small Int always fits, a big Int never does
Stdlib.Int.toInt64 5z = Stdlib.Option.Option.Some 5L
Stdlib.Int.toInt64 9223372036854775808z = Stdlib.Option.Option.None


// --- conversions from the fixed-width types (always succeed) ---
Stdlib.Int.fromInt8 127y = 127z
Stdlib.Int.fromUInt8 255uy = 255z
Stdlib.Int.fromInt16 32767s16 = 32767z
Stdlib.Int.fromUInt32 4294967295ul = 4294967295z
// values past Int64 still convert exactly
Stdlib.Int.fromUInt64 18446744073709551615UL = 18446744073709551615z
Stdlib.Int.fromUInt128 340282366920938463463374607431768211455Z =
  340282366920938463463374607431768211455z

// --- conversions into the fixed-width types (Some if it fits, else None) ---
Stdlib.Int.toInt8 100z = Stdlib.Option.Option.Some 100y
Stdlib.Int.toInt8 200z = Stdlib.Option.Option.None
Stdlib.Int.toUInt8 (Stdlib.Int.negate 1z) = Stdlib.Option.Option.None
Stdlib.Int.toInt32 (2z ** 40z) = Stdlib.Option.Option.None
Stdlib.Int.toInt128 (2z ** 100z) =
  Stdlib.Option.Option.Some 1267650600228229401496703205376Q
Stdlib.Int.toInt128 (2z ** 200z) = Stdlib.Option.Option.None
Stdlib.Int.toUInt128 (2z ** 200z) = Stdlib.Option.Option.None

// --- fromFloat64: truncates toward zero; NaN/Infinity have no Int, so OutOfRange ---
Stdlib.Int.fromFloat64 3.9 = 3z
Stdlib.Int.fromFloat64 -3.9 = -3z
Stdlib.Int.fromFloat64 (0.0 / 0.0) =
  error="Encountered an out-of-range integer value"
Stdlib.Int.fromFloat64 (1.0 / 0.0) =
  error="Encountered an out-of-range integer value"
Stdlib.Int.fromFloat64 (-1.0 / 0.0) =
  error="Encountered an out-of-range integer value"


// --- remainder: Result<Int>; sign follows the dividend; Error only if divisor is 0 ---
Stdlib.Int.remainder 15z 6z = Stdlib.Result.Result.Ok 3z
Stdlib.Int.remainder 20z 8z = Stdlib.Result.Result.Ok 4z
Stdlib.Int.remainder -20z 8z = Stdlib.Result.Result.Ok -4z
Stdlib.Int.remainder -20z -8z = Stdlib.Result.Result.Ok -4z
Stdlib.Int.remainder -15z 6z = Stdlib.Result.Result.Ok -3z
Stdlib.Int.remainder 5z 0z = Stdlib.Result.Result.Error "Cannot divide by 0"
// arbitrary precision: 2^100 mod 7 == 2, with a dividend well past Int64
Stdlib.Int.remainder (2z ** 100z) 7z = Stdlib.Result.Result.Ok 2z

// --- mod: wraps into [0, b); RTE if b <= 0 ---
Stdlib.Int.mod 15z 5z = 0z
Stdlib.Int.mod 15z 6z = 3z
Stdlib.Int.mod 0z 15z = 0z
Stdlib.Int.mod -1z 2z = 1z
Stdlib.Int.mod -754z 53z = 41z
Stdlib.Int.mod (2z ** 100z) 7z = 2z
Stdlib.Int.mod 5z 0z = error="Cannot evaluate modulus against 0"
Stdlib.Int.mod 5z -5z = error="Cannot evaluate modulus against a negative number"

// the % operator dispatches to mod
15z % 5z = 0z
5z % 0z = error="Cannot evaluate modulus against 0"
5z % -5z = error="Cannot evaluate modulus against a negative number"

// --- shiftLeft / shiftRight: count must fit Int32, else OutOfRange ---
Stdlib.Int.shiftLeft 1z 4z = 16z
Stdlib.Int.shiftLeft 1z 64z = 18446744073709551616z
Stdlib.Int.shiftRight 256z 4z = 16z
Stdlib.Int.shiftLeft 1z (2z ** 40z) =
  error="Encountered an out-of-range integer value"
Stdlib.Int.shiftRight 1z (2z ** 40z) =
  error="Encountered an out-of-range integer value"
