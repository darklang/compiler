Stdlib.Int16.bitwiseAnd 12s16 10s16 = 8s16
Stdlib.Int16.bitwiseAnd 0s16 0s16 = 0s16
Stdlib.Int16.bitwiseAnd (-1s16) 0s16 = 0s16
Stdlib.Int16.bitwiseAnd 32767s16 32767s16 = 32767s16
Stdlib.Int16.bitwiseAnd (-32768s16) (-1s16) = -32768s16
Stdlib.Int16.bitwiseAnd 32767s16 (-32768s16) = 0s16
Stdlib.Int16.bitwiseAnd (-1s16) (-1s16) = -1s16

Stdlib.Int16.bitwiseOr 12s16 10s16 = 14s16
Stdlib.Int16.bitwiseOr 0s16 0s16 = 0s16
Stdlib.Int16.bitwiseOr (-1s16) 0s16 = -1s16
Stdlib.Int16.bitwiseOr 32767s16 0s16 = 32767s16
Stdlib.Int16.bitwiseOr (-32768s16) 0s16 = -32768s16
Stdlib.Int16.bitwiseOr 32767s16 (-32768s16) = -1s16

Stdlib.Int16.bitwiseXor 12s16 10s16 = 6s16
Stdlib.Int16.bitwiseXor 0s16 0s16 = 0s16
Stdlib.Int16.bitwiseXor (-1s16) (-1s16) = 0s16
Stdlib.Int16.bitwiseXor 32767s16 (-1s16) = -32768s16
Stdlib.Int16.bitwiseXor (-32768s16) (-1s16) = 32767s16
Stdlib.Int16.bitwiseXor 32767s16 32767s16 = 0s16

Stdlib.Int16.bitwiseNot 0s16 = -1s16
Stdlib.Int16.bitwiseNot (-1s16) = 0s16
Stdlib.Int16.bitwiseNot 32767s16 = -32768s16
Stdlib.Int16.bitwiseNot (-32768s16) = 32767s16
Stdlib.Int16.bitwiseNot 1s16 = -2s16

Stdlib.Int16.shiftLeft 1s16 2s16 = 4s16
Stdlib.Int16.shiftLeft 0s16 5s16 = 0s16
Stdlib.Int16.shiftLeft 1s16 0s16 = 1s16
Stdlib.Int16.shiftLeft 1s16 14s16 = 16384s16
Stdlib.Int16.shiftLeft 5s16 3s16 = 40s16

Stdlib.Int16.shiftRight 8s16 2s16 = 2s16
Stdlib.Int16.shiftRight 0s16 5s16 = 0s16
Stdlib.Int16.shiftRight 1s16 0s16 = 1s16
Stdlib.Int16.shiftRight 16384s16 14s16 = 1s16
Stdlib.Int16.shiftRight (-1s16) 1s16 = -1s16
Stdlib.Int16.shiftRight 40s16 3s16 = 5s16
