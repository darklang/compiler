Stdlib.Int16.clamp -100s16 1s16 0s16 = 0s16
Stdlib.Int16.clamp 100s16 1s16 0s16 = 1s16

Stdlib.Int16.add 10s16 9s16 = 19s16
Stdlib.Int16.add 88s16 9s16 = 97s16
Stdlib.Int16.add -1s16 2s16 = 1s16
Stdlib.Int16.add 1s16 0s16 = 1s16
Stdlib.Int16.add -55s16 55s16 = 0s16
Stdlib.Int16.add 30000s16 2767s16 = 32767s16
Stdlib.Int16.add -30000s16 -2768s16 = -32768s16
Stdlib.Int16.add -30000s16 -2769s16 = 32767s16
Stdlib.Int16.add 30000s16 2768s16 = -32768s16
Stdlib.Int16.subtract 10s16 9s16 = 1s16
Stdlib.Int16.subtract 88s16 9s16 = 79s16
Stdlib.Int16.subtract 0s16 1s16 = -1s16
Stdlib.Int16.subtract 1s16 0s16 = 1s16
Stdlib.Int16.subtract -55s16 -55s16 = 0s16
Stdlib.Int16.subtract -2769s16 30000s16 = 32767s16
Stdlib.Int16.multiply 8s16 8s16 = 64s16
Stdlib.Int16.multiply 1s16 0s16 = 0s16
Stdlib.Int16.multiply 5145s16 5145s16 = -5519s16
Stdlib.Int16.power 2s16 3s16 = 8s16
Stdlib.Int16.power 0s16 1s16 = 0s16
Stdlib.Int16.power 1s16 0s16 = 1s16
Stdlib.Int16.power 0s16 0s16 = 1s16
Stdlib.Int16.power -2s16 5s16 = -32s16
Stdlib.Int16.power -1s16 5s16 = -1s16
Stdlib.Int16.power -1s16 6s16 = 1s16
Stdlib.Int16.power 1s16 32767s16 = 1s16
Stdlib.Int16.power 2s16 15s16 = -32768s16
Stdlib.Int16.power 120s16 20s16 = 0s16
Stdlib.Int16.power 2s16 -3s16 = error="Cannot raise integer to a negative exponent"
Stdlib.Int16.divide 10s16 5s16 = 2s16
Stdlib.Int16.divide 17s16 3s16 = 5s16
Stdlib.Int16.divide -8s16 5s16 = -1s16
Stdlib.Int16.divide 0s16 1s16 = 0s16
Stdlib.Int16.divide 1s16 0s16 = error="Cannot divide by 0"
Stdlib.Int16.divide -32768s16 -1s16 = -32768s16
Stdlib.Int16.divide -32768s16 1s16 = -32768s16


Stdlib.Int16.negate -5s16 = 5s16
Stdlib.Int16.negate 5s16 = -5s16
Stdlib.Int16.negate 0s16 = 0s16
Stdlib.Int16.negate -0s16 = 0s16
Stdlib.Int16.negate -32768s16 = -32768s16
Stdlib.Int16.greaterThan 20s16 1s16 = true
Stdlib.Int16.greaterThan 20s16 130s16 = false

Stdlib.Int16.greaterThanOrEqualTo 0s16 1s16 = false
Stdlib.Int16.greaterThanOrEqualTo 1s16 0s16 = true
Stdlib.Int16.greaterThanOrEqualTo 6s16 1s16 = true
Stdlib.Int16.greaterThanOrEqualTo 6s16 8s16 = false
Stdlib.Int16.greaterThanOrEqualTo -5s16 -20s16 = true
Stdlib.Int16.greaterThanOrEqualTo -20s16 -1s16 = false
Stdlib.Int16.greaterThanOrEqualTo -20s16 -20s16 = true
Stdlib.Int16.greaterThanOrEqualTo -130s16 -20s16 = false

Stdlib.Int16.lessThan 6s16 8s16 = true
Stdlib.Int16.lessThan 10s16 1s16 = false
Stdlib.Int16.lessThan 0s16 1s16 = true
Stdlib.Int16.lessThan 1s16 0s16 = false
Stdlib.Int16.lessThan -100s16 22544s16 = true
Stdlib.Int16.lessThan -999s16 -9999s16 = false
Stdlib.Int16.lessThan -8888s16 -8888s16 = false

Stdlib.Int16.lessThanOrEqualTo 6s16 8s16 = true
Stdlib.Int16.lessThanOrEqualTo 10s16 1s16 = false
Stdlib.Int16.lessThanOrEqualTo 0s16 1s16 = true
Stdlib.Int16.lessThanOrEqualTo 1s16 0s16 = false
Stdlib.Int16.lessThanOrEqualTo -100s16 22544s16 = true
Stdlib.Int16.lessThanOrEqualTo -999s16 -9999s16 = false
Stdlib.Int16.lessThanOrEqualTo -8888s16 -8888s16 = true

Stdlib.Int16.toString 0s16 = "0"
Stdlib.Int16.toString 1s16 = "1"
Stdlib.Int16.toString -1s16 = "-1"
Stdlib.Int16.toString -32768s16 = "-32768" // Int16 lower limit
Stdlib.Int16.toString 32767s16 = "32767" // Int16 upper limit

Stdlib.Int16.toFloat64 2s16 = 2.0
Stdlib.Int16.toFloat64 -10s16 = -10.0

(Stdlib.List.range 1L 5L)
|> Stdlib.List.map (fun x -> Stdlib.Int16.random 1s16 2s16)
|> Stdlib.List.map (fun x ->
  (Stdlib.Int16.greaterThanOrEqualTo x 1s16)
  && (Stdlib.Int16.lessThanOrEqualTo x 2s16)) = [ true, true, true, true, true ]

(Stdlib.List.range 1L 5L)
|> Stdlib.List.map (fun x -> Stdlib.Int16.random 10s16 20s16)
|> Stdlib.List.map (fun x ->
  (Stdlib.Int16.greaterThanOrEqualTo x 10s16)
  && (Stdlib.Int16.lessThanOrEqualTo x 20s16)) = [ true, true, true, true, true ]

(Stdlib.List.range 1L 5L)
|> Stdlib.List.map (fun x -> Stdlib.Int16.random 2s16 1s16)
|> Stdlib.List.map (fun x ->
  (Stdlib.Int16.greaterThanOrEqualTo x 1s16)
  && (Stdlib.Int16.lessThanOrEqualTo x 2s16)) = [ true, true, true, true, true ]

(Stdlib.List.range 1L 5L)
|> Stdlib.List.map (fun x -> Stdlib.Int16.random 20s16 10s16)
|> Stdlib.List.map (fun x ->
  (Stdlib.Int16.greaterThanOrEqualTo x 10s16)
  && (Stdlib.Int16.lessThanOrEqualTo x 20s16)) = [ true, true, true, true, true ]

((Stdlib.List.range 1L 100L)
 |> Stdlib.List.map (fun x -> Stdlib.Int16.random 0s16 1s16)
 |> Stdlib.List.unique |> Stdlib.List.sort) = [ 0s16, 1s16 ]

((Stdlib.List.range 1L 100L)
 |> Stdlib.List.map (fun x -> Stdlib.Int16.random 0s16 2s16)
 |> Stdlib.List.unique |> Stdlib.List.sort) = [ 0s16, 1s16, 2s16 ]


Stdlib.Int16.parse "0" = Stdlib.Result.Result.Ok 0s16
Stdlib.Int16.parse "1" = Stdlib.Result.Result.Ok 1s16
Stdlib.Int16.parse " 1" = Stdlib.Result.Result.Ok 1s16
Stdlib.Int16.parse "1 " = Stdlib.Result.Result.Ok 1s16
Stdlib.Int16.parse "+1" = Stdlib.Result.Result.Ok 1s16
Stdlib.Int16.parse " +1 " = Stdlib.Result.Result.Ok 1s16
Stdlib.Int16.parse "-1" = Stdlib.Result.Result.Ok -1s16
Stdlib.Int16.parse "078" = Stdlib.Result.Result.Ok 78s16 // "octal" format ignored
Stdlib.Int16.parse "-00001" = Stdlib.Result.Result.Ok -1s16
Stdlib.Int16.parse "32767" = Stdlib.Result.Result.Ok 32767s16
Stdlib.Int16.parse "-32768" = Stdlib.Result.Result.Ok -32768s16

// out of range
Stdlib.Int16.parse "32768" = Stdlib.Result.Result.Error Stdlib.Int16.ParseError.OutOfRange
Stdlib.Int16.parse "-32769" = Stdlib.Result.Result.Error Stdlib.Int16.ParseError.OutOfRange
Stdlib.Int16.parse "1 2 3" = Stdlib.Result.Result.Error Stdlib.Int16.ParseError.BadFormat
Stdlib.Int16.parse "+ 1" = Stdlib.Result.Result.Error Stdlib.Int16.ParseError.BadFormat
Stdlib.Int16.parse "- 1" = Stdlib.Result.Result.Error Stdlib.Int16.ParseError.BadFormat
