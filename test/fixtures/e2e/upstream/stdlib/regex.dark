module IsMatch =
  // Basic matching
  Stdlib.Regex.isMatch "hello world" "hello" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "hello world" "world" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "hello world" "goodbye" = Stdlib.Result.Result.Ok (false)
  Stdlib.Regex.isMatch "" "" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "test" "" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "" "test" = Stdlib.Result.Result.Ok (false)

  // Pattern matching
  Stdlib.Regex.isMatch "test123" "\\d+" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "test" "\\d+" = Stdlib.Result.Result.Ok (false)
  Stdlib.Regex.isMatch "hello@example.com" "\\w+@\\w+\\.\\w+" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "hello.example.com" "\\w+@\\w+\\.\\w+" = Stdlib.Result.Result.Ok (false)

  // Case sensitivity (default is case-sensitive)
  Stdlib.Regex.isMatch "Hello" "hello" = Stdlib.Result.Result.Ok (false)
  Stdlib.Regex.isMatch "Hello" "Hello" = Stdlib.Result.Result.Ok (true)

  // Special characters
  Stdlib.Regex.isMatch "test.txt" ".*\\.txt" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "test-file" "test-file" = Stdlib.Result.Result.Ok (true)

module Find =
  // Basic find
  Stdlib.Regex.find "hello world" "world" = Stdlib.Result.Result.Ok (Stdlib.Option.Option.Some "world")
  Stdlib.Regex.find "hello world" "goodbye" = Stdlib.Result.Result.Ok (Stdlib.Option.Option.None)
  Stdlib.Regex.find "" "test" = Stdlib.Result.Result.Ok (Stdlib.Option.Option.None)
  Stdlib.Regex.find "test" "" = Stdlib.Result.Result.Ok (Stdlib.Option.Option.Some "")

  // Pattern matching - finds first match
  Stdlib.Regex.find "test123abc456" "\\d+" = Stdlib.Result.Result.Ok (Stdlib.Option.Option.Some "123")
  Stdlib.Regex.find "hello world" "\\w+" = Stdlib.Result.Result.Ok (Stdlib.Option.Option.Some "hello")
  Stdlib.Regex.find "contact: email@example.com" "\\w+@\\w+\\.\\w+" = Stdlib.Result.Result.Ok (Stdlib.Option.Option.Some "email@example.com")

  // No match returns None
  Stdlib.Regex.find "hello" "\\d+" = Stdlib.Result.Result.Ok (Stdlib.Option.Option.None)

module FindAll =
  // Basic findAll
  Stdlib.Regex.findAll "hello world" "o" = Stdlib.Result.Result.Ok ([ "o", "o" ])
  Stdlib.Regex.findAll "hello world" "x" = Stdlib.Result.Result.Ok ([])
  Stdlib.Regex.findAll "" "test" = Stdlib.Result.Result.Ok ([])
  Stdlib.Regex.findAll "test" "" = Stdlib.Result.Result.Ok ([ "", "", "", "", "" ])

  // Pattern matching - finds all matches
  Stdlib.Regex.findAll "test123abc456def789" "\\d+" = Stdlib.Result.Result.Ok ([ "123", "456", "789" ])
  Stdlib.Regex.findAll "hello world foo bar" "\\w+" = Stdlib.Result.Result.Ok ([ "hello", "world", "foo", "bar" ])
  Stdlib.Regex.findAll "one two three" "[a-z]+" = Stdlib.Result.Result.Ok ([ "one", "two", "three" ])

  // No matches returns empty list
  Stdlib.Regex.findAll "hello" "\\d+" = Stdlib.Result.Result.Ok ([])

module Replace =
  // Basic replace - only first match
  Stdlib.Regex.replace "hello world" "world" "universe" = Stdlib.Result.Result.Ok ("hello universe")
  Stdlib.Regex.replace "hello world" "goodbye" "universe" = Stdlib.Result.Result.Ok ("hello world")
  Stdlib.Regex.replace "test test test" "test" "result" = Stdlib.Result.Result.Ok ("result test test")

  // Empty string cases
  Stdlib.Regex.replace "" "test" "result" = Stdlib.Result.Result.Ok ("")
  Stdlib.Regex.replace "test" "test" "" = Stdlib.Result.Result.Ok ("")

  // Pattern replacement
  Stdlib.Regex.replace "test123abc" "\\d+" "NUM" = Stdlib.Result.Result.Ok ("testNUMabc")
  Stdlib.Regex.replace "hello123world456" "\\d+" "X" = Stdlib.Result.Result.Ok ("helloXworld456")

module ReplaceAll =
  // Basic replaceAll
  Stdlib.Regex.replaceAll "hello world" "o" "0" = Stdlib.Result.Result.Ok ("hell0 w0rld")
  Stdlib.Regex.replaceAll "test test test" "test" "result" = Stdlib.Result.Result.Ok ("result result result")
  Stdlib.Regex.replaceAll "hello world" "x" "y" = Stdlib.Result.Result.Ok ("hello world")

  // Empty string cases
  Stdlib.Regex.replaceAll "" "test" "result" = Stdlib.Result.Result.Ok ("")
  Stdlib.Regex.replaceAll "test" "test" "" = Stdlib.Result.Result.Ok ("")

  // Pattern replacement
  Stdlib.Regex.replaceAll "test123abc456def789" "\\d+" "NUM" = Stdlib.Result.Result.Ok ("testNUMabcNUMdefNUM")
  Stdlib.Regex.replaceAll "hello world foo bar" "\\w+" "X" = Stdlib.Result.Result.Ok ("X X X X")

  // Remove all digits
  Stdlib.Regex.replaceAll "abc123def456" "\\d" "" = Stdlib.Result.Result.Ok ("abcdef")

module Split =
  // Basic split
  Stdlib.Regex.split "hello world foo bar" " " = Stdlib.Result.Result.Ok ([ "hello", "world", "foo", "bar" ])
  Stdlib.Regex.split "a,b,c,d" "," = Stdlib.Result.Result.Ok ([ "a", "b", "c", "d" ])
  Stdlib.Regex.split "test" "x" = Stdlib.Result.Result.Ok ([ "test" ])
  Stdlib.Regex.split "" "," = Stdlib.Result.Result.Ok ([ "" ])

  // Pattern split
  Stdlib.Regex.split "test123abc456def789" "\\d+" = Stdlib.Result.Result.Ok ([ "test", "abc", "def", "" ])
  Stdlib.Regex.split "one1two22three333four" "\\d+" = Stdlib.Result.Result.Ok ([ "one", "two", "three", "four" ])

  // Split by whitespace
  Stdlib.Regex.split "hello  world\tfoo\nbar" "\\s+" = Stdlib.Result.Result.Ok ([ "hello", "world", "foo", "bar" ])

module RealWorld =
  // Email validation
  Stdlib.Regex.isMatch "user@example.com" "^[\\w\\.-]+@[\\w\\.-]+\\.[a-zA-Z]{2,}$" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "invalid.email" "^[\\w\\.-]+@[\\w\\.-]+\\.[a-zA-Z]{2,}$" = Stdlib.Result.Result.Ok (false)

  // Extract domain from email
  Stdlib.Regex.find "contact@example.com" "@([\\w\\.-]+)" = Stdlib.Result.Result.Ok (Stdlib.Option.Option.Some "@example.com")

  // Phone number patterns
  Stdlib.Regex.isMatch "123-456-7890" "\\d{3}-\\d{3}-\\d{4}" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "1234567890" "\\d{3}-\\d{3}-\\d{4}" = Stdlib.Result.Result.Ok (false)

  // URL matching
  Stdlib.Regex.isMatch "https://example.com" "https?://[\\w\\.-]+" = Stdlib.Result.Result.Ok (true)
  Stdlib.Regex.isMatch "http://test.org" "https?://[\\w\\.-]+" = Stdlib.Result.Result.Ok (true)

  // Extract all numbers from text
  Stdlib.Regex.findAll "The price is 99.99 and quantity is 5" "\\d+\\.?\\d*" = Stdlib.Result.Result.Ok ([ "99.99", "5" ])

  // Clean up whitespace
  Stdlib.Regex.replaceAll "hello    world   foo" "\\s+" " " = Stdlib.Result.Result.Ok ("hello world foo")

  // Remove HTML tags (simplified)
  Stdlib.Regex.replaceAll "<div>Hello <b>world</b></div>" "<[^>]+>" "" = Stdlib.Result.Result.Ok ("Hello world")
