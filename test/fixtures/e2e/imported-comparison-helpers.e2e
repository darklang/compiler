Darklang.Stdlib.Cli.UI.Canvas.compose 2L 2L [Darklang.Stdlib.Cli.UI.Layout.Span { row = 0L, col = 0L, text = "a" }, Darklang.Stdlib.Cli.UI.Layout.Span { row = 0L, col = 1L, text = "b" }, Darklang.Stdlib.Cli.UI.Layout.Span { row = 9L, col = 0L, text = "ignored" }] = ["ab\u001b[0m", ""]
Darklang.Stdlib.Cli.UI.Canvas.compose 1L 2L [Darklang.Stdlib.Cli.UI.Layout.Span { row = 0L, col = 0L, text = "a" }, Darklang.Stdlib.Cli.UI.Layout.Span { row = 1L, col = 0L, text = "b" }] = ["a\u001b[0m", "b\u001b[0m"]
