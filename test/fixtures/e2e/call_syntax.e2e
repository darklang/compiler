// The interpreter's call syntax since darklang/dark@74dca94: a paren list
// written against the callee passes each element as its own argument.

let callAdd (a: Int64) (b: Int64) : Int64 = a + b
let callFirst (pair: (Int64 * Int64)) : Int64 = Stdlib.Tuple2.first pair
let callAnswer (u: Unit) : Int64 = 42L

callAdd(20L, 22L) = 42L
Stdlib.Int64.add(20L, 22L) = 42L
Stdlib.List.map([1L, 2L], fun x -> x + 1L) = [2L, 3L]
[1L, 2L] |> Stdlib.List.map(fun x -> x * 2L) = [2L, 4L]
callAdd(callAdd(1L, 2L), callAdd(3L, 36L)) = 42L
callAnswer() = 42L

// A tuple argument is written with its own parens, or with a space as before.
callFirst((1L, 2L)) = 1L
callFirst (1L, 2L) = 1L

// Juxtaposed arguments keep their meaning.
callAdd 20L 22L = 42L
callAdd (20L) (22L) = 42L

// `f(x)?` unwraps the call's result, and `f(x).field` selects from it.
type CallPoint = { x: Int64, y: Int64 }
let callPoint (n: Int64) : CallPoint = CallPoint { x = n, y = n + 1L }
let callSome (n: Int64) : Stdlib.Option.Option<Int64> = Stdlib.Option.Option.Some n
let callUnwrapped () : Stdlib.Option.Option<Int64> = Stdlib.Option.Option.Some (callSome(41L)? + 1L)
callUnwrapped () = Stdlib.Option.Option.Some 42L
callPoint(41L).y = 42L
