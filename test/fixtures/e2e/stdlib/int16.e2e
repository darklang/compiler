// Stdlib.Int16 Tests
// Ported from https://github.com/darklang/dark/tree/main/backend/testfiles/execution/stdlib
//
// Tests for Int16 module functions

// ===================================================================
// Stdlib.Int16.add - Add two integers
// ===================================================================

Stdlib.Int16.add 0s16 0s16 = 0s16
Stdlib.Int16.add (-5s16) 5s16 = 0s16
Stdlib.Int16.add 100s16 200s16 = 300s16

// ===================================================================
// Stdlib.Int16.subtract - Subtract two integers
// ===================================================================

Stdlib.Int16.subtract 0s16 0s16 = 0s16
Stdlib.Int16.subtract 100s16 50s16 = 50s16
Stdlib.Int16.subtract 5s16 10s16 = -5s16

// ===================================================================
// Stdlib.Int16.multiply - Multiply two integers
// ===================================================================

Stdlib.Int16.multiply 0s16 100s16 = 0s16
Stdlib.Int16.multiply (-5s16) 5s16 = -25s16
Stdlib.Int16.multiply 100s16 100s16 = 10000s16

// ===================================================================
// Stdlib.Int16.divide - Divide two integers
// ===================================================================

Stdlib.Int16.divide 10s16 3s16 = 3s16
Stdlib.Int16.divide 100s16 10s16 = 10s16
Stdlib.Int16.divide (-10s16) 2s16 = -5s16

// ===================================================================
// Stdlib.Int16.mod - Modulo operation
// ===================================================================

Stdlib.Int16.mod 15s16 6s16 = 3s16
Stdlib.Int16.mod 10s16 3s16 = 1s16
Stdlib.Int16.mod 100s16 7s16 = 2s16
Stdlib.Int16.mod (-10s16) 3s16 = 2s16

// ===================================================================
// Stdlib.Int16.max - Maximum of two integers
// ===================================================================

Stdlib.Int16.max 6s16 5s16 = 6s16
Stdlib.Int16.max (-5s16) (-10s16) = -5s16
Stdlib.Int16.max 0s16 0s16 = 0s16

// ===================================================================
// Stdlib.Int16.min - Minimum of two integers
// ===================================================================

Stdlib.Int16.min 6s16 5s16 = 5s16
Stdlib.Int16.min (-5s16) (-10s16) = -10s16
Stdlib.Int16.min 0s16 0s16 = 0s16

// ===================================================================
// Stdlib.Int16.absoluteValue - Absolute value
// ===================================================================

Stdlib.Int16.absoluteValue 0s16 = 0s16
Stdlib.Int16.absoluteValue (-100s16) = 100s16

// ===================================================================
// Stdlib.Int16.negate - Negate an integer
// ===================================================================

Stdlib.Int16.negate 100s16 = -100s16

// ===================================================================
// Stdlib.Int16.power - Raise to a power
// ===================================================================

Stdlib.Int16.power 8s16 4s16 = 4096s16
Stdlib.Int16.power 2s16 10s16 = 1024s16
Stdlib.Int16.power 5s16 0s16 = 1s16
Stdlib.Int16.power 5s16 1s16 = 5s16
Stdlib.Int16.power 2s16 8s16 = 256s16

// ===================================================================
// Stdlib.Int16.clamp - Clamp value between limits
// ===================================================================

Stdlib.Int16.clamp 1s16 0s16 5s16 = 1s16
Stdlib.Int16.clamp 10s16 5s16 15s16 = 10s16
Stdlib.Int16.clamp 0s16 5s16 10s16 = 5s16

// ===================================================================
// Stdlib.Int16.greaterThan - Greater than comparison
// ===================================================================

Stdlib.Int16.greaterThan 1s16 20s16 = false
Stdlib.Int16.greaterThan 5s16 5s16 = false

// ===================================================================
// Stdlib.Int16.greaterThanOrEqualTo - Greater than or equal comparison
// ===================================================================

Stdlib.Int16.greaterThanOrEqualTo 1s16 6s16 = false
Stdlib.Int16.greaterThanOrEqualTo 5s16 5s16 = true

// ===================================================================
// Stdlib.Int16.lessThan - Less than comparison
// ===================================================================

Stdlib.Int16.lessThan 8s16 6s16 = false
Stdlib.Int16.lessThan 5s16 5s16 = false

// ===================================================================
// Stdlib.Int16.lessThanOrEqualTo - Less than or equal comparison
// ===================================================================

Stdlib.Int16.lessThanOrEqualTo 8s16 6s16 = false
Stdlib.Int16.lessThanOrEqualTo 5s16 5s16 = true

// ===================================================================
// Stdlib.Int16.toString - Convert integer to string
// ===================================================================

Stdlib.Int16.toString 42s16 = "42"
Stdlib.Int16.toString (-5s16) = "-5"
Stdlib.Int16.toString 12345s16 = "12345"

// ===================================================================
// Stdlib.Int16.isEven - Check if integer is even
// ===================================================================


// ===================================================================
// Stdlib.Int16.isOdd - Check if integer is odd
// ===================================================================


// ===================================================================
// Stdlib.Int16.sum - Sum all integers in a list
// ===================================================================

Stdlib.Int16.sum ([1s16, 2s16, 3s16, 4s16, 5s16]) = 15s16
Stdlib.Int16.sum ([]) = 0s16
Stdlib.Int16.sum ([100s16]) = 100s16
Stdlib.Int16.sum ([1s16, -1s16, 2s16, -2s16]) = 0s16
Stdlib.Int16.sum ([10s16, 20s16, 30s16]) = 60s16

