// Stdlib.Float tests

// Stdlib.Float64.add - IEEE 754 addition
Stdlib.Float64.add 1.2 1.3 = 2.5

// sqrt - now with full precision
Stdlib.Float64.sqrt 4.0 = 2.0
Stdlib.Float64.sqrt 9.0 = 3.0
Stdlib.Float64.sqrt 2.0 = 1.4142135623730951
Stdlib.Float64.sqrt 0.0 = 0.0
Stdlib.Float64.sqrt 1.0 = 1.0
Stdlib.Float64.sqrt 100.0 = 10.0

// abs - now with full precision
Stdlib.Float64.absoluteValue 5.5 = 5.5
Stdlib.Float64.absoluteValue (-5.5) = 5.5
Stdlib.Float64.absoluteValue 0.0 = 0.0
Stdlib.Float64.absoluteValue (-0.0) = 0.0
Stdlib.Float64.absoluteValue (-123.456) = 123.456

// negate
Stdlib.Float64.negate 3.14 = -3.14
Stdlib.Float64.negate (-3.14) = 3.14
// Stdlib.Float64.negate(0.0) correctly displays as -0.0 (IEEE 754 signed zero)
Stdlib.Float64.negate 0.0 = -0.0

// toInt (truncates toward zero)
Stdlib.Float64.toInt 3.2 = 3
Stdlib.Float64.toInt (-3.7) = -3
Stdlib.Float64.toInt (-3.2) = -3
Stdlib.Float64.toInt 0.0 = 0
Stdlib.Float64.toInt 100.99 = 100

// The shared interpreter API returns None for non-finite or out-of-range inputs.
Stdlib.Int64.fromFloat64 3.9 = Some 3L
Stdlib.Int64.fromFloat64 (-3.9) = Some -3L
Stdlib.Int64.fromFloat64 (-9223372036854775808.0) = Some -9223372036854775808L
Stdlib.Int64.fromFloat64 9223372036854775808.0 = None
Stdlib.Int64.fromFloat64 Builtin.testNan = None
Stdlib.Int64.fromFloat64 Builtin.testInfinity = None

// Stdlib.Int64.toFloat64
Stdlib.Int64.toFloat64 42L = 42.0
Stdlib.Int64.toFloat64 0L = 0.0
Stdlib.Int64.toFloat64 (-100L) = -100.0

// Combined operations
Stdlib.Float64.sqrt (Stdlib.Float64.absoluteValue (-16.0)) = 4.0
Stdlib.Float64.absoluteValue (Stdlib.Float64.negate 5.0) = 5.0
Stdlib.Float64.toInt (Stdlib.Float64.sqrt 100.0) = 10
Stdlib.Int.toFloat64 (Stdlib.Float64.toInt 9.99) = 9.0

// Float comparisons (already work, but good to test with new functions)
Stdlib.Float64.sqrt 4.0 > 1.0 = true
Stdlib.Float64.sqrt 4.0 == 2.0 = true
Stdlib.Float64.absoluteValue (-5.0) > 4.0 = true

// Stdlib.Float64.toBits - IEEE 754 bit representation
// Public bits use the upstream signed Int64 interpretation, returned as Int.
Stdlib.Float64.toBits 1.0 = 4607182418800017408UL
Stdlib.Float64.toBits (-1.0) = 13830554455654793216UL
Stdlib.Float64.toBits 0.0 = 0UL

// Stdlib.Float64.toString - special cases
// -0.0 correctly displays as "-0.0" (IEEE 754 signed zero)
Stdlib.Float64.toString 0.0 = "0.0"
Stdlib.Float64.toString (-0.0) = "-0.0"

// Interpreter parity: arbitrary-precision directed and nearest rounding
Stdlib.Float64.ceiling 1.25 = 2L
Stdlib.Float64.roundUp (-1.25) = -1L
Stdlib.Float64.floor (-1.25) = -2L
Stdlib.Float64.roundDown 1.25 = 1L
Stdlib.Float64.round 2.5 = 2L
Stdlib.Float64.round 3.5 = 4L
Stdlib.Float64.roundTowardsZero (-1.75) = -1L
Stdlib.Float64.truncate (-1.75) = -1L
Stdlib.Float64.toInt 100000000000000000000.0 = 100000000000000000000
Stdlib.Float64.ceiling (1.0 / 0.0) = error="Encountered an out-of-range integer value"

// IEEE classification and clamp deliberately reject only NaN limits
Stdlib.Float64.isNaN Builtin.testNan = true
Stdlib.Float64.isNaN (1.0 / 0.0) = false
Stdlib.Float64.clampRefusingNaN 3.0 2.0 1.0 = Ok 2.0
match Stdlib.Float64.clampRefusingNaN Builtin.testNan (-1.0) 1.0 with | Ok value -> Stdlib.Float64.isNaN value | Error _ -> false = true
Stdlib.Float64.clampRefusingNaN 0.0 Builtin.testNan 1.0 = Error "clampRefusingNaN requires limits that are numbers"

// Culture-independent runtime parsing, including whitespace and signed zero
Stdlib.Float64.parse " +.5\t" = Ok 0.5
Stdlib.Float64.parse "1.0000000000000002" = Ok 1.0000000000000002
Stdlib.Float64.parse "5e-324" = Ok (5e-324)
Stdlib.Float64.toBits (Stdlib.Result.withDefault (Stdlib.Float64.parse "-0") 1.0) = 9223372036854775808UL
Stdlib.Float64.parse "" = Error Stdlib.Float64.ParseError.BadFormat
Stdlib.Float64.parse "1e" = Error Stdlib.Float64.ParseError.BadFormat
Stdlib.Float64.parse "1.8e308" = Ok (1.0 / 0.0)
Stdlib.Float64.parse "1.00000000000000011102230246251565404236316680908203125" = Ok 1.0
Stdlib.Float64.parse "2e-324" = Ok 0.0
Stdlib.Float64.isNaN (Stdlib.Result.withDefault (Stdlib.Float64.parse "NaN") 0.0) = true
Stdlib.Float64.parse "1.25" = stdout="Darklang.Stdlib.Result.Result<Float, Darklang.Stdlib.Float64.ParseError>.Ok(1.25)\n"
Stdlib.Float64.parse "bad" = stdout="Darklang.Stdlib.Result.Result<Float, Darklang.Stdlib.Float64.ParseError>.Error(Darklang.Stdlib.Float64.ParseError.BadFormat)\n"

// Shortest round-trip formatting is shared by public and aggregate rendering
Stdlib.Float64.toString 0.1 = "0.1"
Stdlib.Float64.toString 1.0000000000000002 = "1.0000000000000002"
Stdlib.Float64.toString 0.0001 = "0.0001"
Stdlib.Float64.toString 0.00001 = "1e-5"
Stdlib.Float64.toString 100000000000.0 = "100000000000.0"
Stdlib.Float64.toString 1000000000000.0 = "1000000000000.0"
Stdlib.Float64.toString (5e-324) = "5e-324"
Stdlib.Float64.toString (1.0 / 0.0) = "Infinity"
Stdlib.Float64.toString (-1.0 / 0.0) = "-Infinity"
Stdlib.Float64.toString Builtin.testNan = "NaN"
Stdlib.Float64.toBits (Stdlib.Result.withDefault (Stdlib.Float64.parse (Stdlib.Float64.toString (1.7976931348623157e308))) 0.0) = Stdlib.Float64.toBits (1.7976931348623157e308)
Stdlib.Float64.toString (1.7976931348623155e308) = "1.7976931348623155e+308"
Stdlib.Float64.toString (-1.7976931348623157e308) = "-1.7976931348623157e+308"
Stdlib.Float64.toBits (Stdlib.Result.withDefault (Stdlib.Float64.parse (Stdlib.Float64.toString (1.2676506002282294e30))) 0.0) = Stdlib.Float64.toBits (1.2676506002282294e30)
Stdlib.Float64.toBits (Stdlib.Result.withDefault (Stdlib.Float64.parse (Stdlib.Float64.toString (5e-324))) 0.0) = Stdlib.Float64.toBits (5e-324)
[1.0000000000000002] = stdout="[1.0000000000000002]\n"
(0.1, 1.0000000000000002) = stdout="(0.1, 1.0000000000000002)\n"

// IEEE power behavior
Stdlib.Float64.power 4.0 (-0.5) = 0.5
Stdlib.Float64.power (-2.0) 3.0 = -8.0
Stdlib.Float64.isNaN (Stdlib.Float64.power (-2.0) 0.5) = true
Stdlib.Float64.toBits (Stdlib.Float64.power (-0.0) 3.0) = 9223372036854775808UL
Stdlib.Float64.power (1e308) 2.0 = 1.0 / 0.0
Stdlib.Float64.power (1e-300) 2.0 = 0.0
Stdlib.Float64.toBits (Stdlib.Float64.power 2.0 0.5) = 4609047870845172685UL
