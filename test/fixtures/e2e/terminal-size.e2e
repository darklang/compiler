// Window-size fallbacks when E2E descriptors are redirected.
Builtin.cliTerminalSize () = (132z, 43z) env="COLUMNS=132" env="LINES=43"
Builtin.cliTerminalSize () = (80z, 24z) env="COLUMNS=0" env="LINES=-1"
Builtin.cliTerminalSize () = (80z, 24z) env="COLUMNS=invalid" env="LINES=2147483648"
Builtin.cliTerminalSize () = (81z, 25z) env="COLUMNS=+81" env="LINES=25"
Darklang.Cli.Terminal.getSize () = (91L, 32L) env="COLUMNS=91" env="LINES=32"
