// Function arrows belong outside all closed generic arguments.
type NestedListFunction = List<List<Int>> -> Int
let nestedListLength (values: List<List<Int>>) : Int = Stdlib.Int.fromInt64 (Stdlib.List.length values)
let callNestedListFunction (f: NestedListFunction) : Int = f [[1z], [2z]]
callNestedListFunction nestedListLength = 2z

// Numeric postfix selectors compose and can select callable values.
((1z, (2z, 3z)).2.1) = 2z
((fun x -> x + 1z, 0z).1 4z) = 5z
((1z, 2z).0) = compileerror="Tuple index"
((1z, 2z).3) = compileerror="Tuple index"
